<%- include('partials/header', { title }) %>

<%
    const campaignList = Array.isArray(campaigns) ? campaigns : [];
    const merchantOptions = [...new Set(campaignList.map((campaign) => campaign.salonName).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const activeCount = campaignList.filter((campaign) => campaign.status === 'active').length;
    const highestCashback = campaignList.reduce((max, campaign) => Math.max(max, Number(campaign.cashbackPercent || 0)), 0);
    const formatCampaignDate = (value) => {
        const date = value instanceof Date ? value : new Date(value);
        if (Number.isNaN(date.getTime())) return '';
        return date.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' });
    };
%>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <%- include('partials/admin-marketplace-tabs') %>

        <header class="admin-dashboard-header marketplace-admin-header">
            <div>
                <p class="eyebrow">Admin Marketplace</p>
                <h1>Cashback campaigns</h1>
                <p>Manage merchant-scoped cashback campaigns. These boosts apply only to the selected merchant, while platform-wide cashback stays in Loyalty Settings.</p>
            </div>
            <a class="button primary" href="/admin/cashback/new">Add campaign</a>
        </header>

        <% if (success) { %><div class="notice success"><p><%= success %></p></div><% } %>
        <% if (error) { %><div class="notice error"><p><%= error %></p></div><% } %>

        <section class="marketplace-admin-panel">
            <div class="marketplace-stat-grid">
                <article><span>Campaigns</span><strong><%= campaignList.length %></strong></article>
                <article><span>Active</span><strong><%= activeCount %></strong></article>
                <article><span>Merchants</span><strong><%= merchantOptions.length %></strong></article>
                <article><span>Highest Earn</span><strong><%= highestCashback.toFixed(2) %>%</strong></article>
            </div>

            <div class="marketplace-admin-toolbar">
                <div>
                    <p class="eyebrow">Campaign Records</p>
                    <h2>Merchant cashback</h2>
                </div>
                <div class="marketplace-filter-row">
                    <label>
                        <span class="sr-only">Search campaigns</span>
                        <input class="js-marketplace-search" type="search" placeholder="Search campaign or merchant">
                    </label>
                    <label>
                        <span class="sr-only">Filter by merchant</span>
                        <select data-readable-select class="js-marketplace-merchant-filter">
                            <option value="">All merchants</option>
                            <% merchantOptions.forEach((merchantName) => { %>
                                <option value="<%= merchantName %>"><%= merchantName %></option>
                            <% }) %>
                        </select>
                    </label>
                </div>
            </div>

            <% if (campaignList.length === 0) { %>
                <div class="empty-state marketplace-empty-state">
                    <h2>No cashback campaigns yet</h2>
                    <p class="muted">Create a campaign for a selected merchant or let merchants create their own.</p>
                    <a class="button primary" href="/admin/cashback/new">Add campaign</a>
                </div>
            <% } else { %>
                <div class="admin-table-wrap marketplace-table-wrap">
                    <table class="admin-table marketplace-admin-table">
                        <thead>
                            <tr>
                                <th>Campaign</th>
                                <th>Merchant</th>
                                <th>Earn</th>
                                <th>Minimum</th>
                                <th>Applies To</th>
                                <th>Dates</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% campaignList.forEach((campaign) => { %>
                                <tr class="js-marketplace-row" data-merchant="<%= campaign.salonName || '' %>" data-search="<%= `${campaign.title || ''} ${campaign.salonName || ''} ${campaign.applicableType || ''}` %>">
                                    <td><strong><%= campaign.title %></strong></td>
                                    <td><%= campaign.salonName %></td>
                                    <td><%= Number(campaign.cashbackPercent || 0).toFixed(2) %>%</td>
                                    <td>$<%= Number(campaign.minimumSpend || 0).toFixed(2) %></td>
                                    <td><span class="sync-pill"><%= campaign.applicableType %></span></td>
                                    <td>
                                        <%= formatCampaignDate(campaign.startAt) %>
                                        <small>to <%= formatCampaignDate(campaign.endAt) %></small>
                                    </td>
                                    <td><span class="sync-pill"><%= campaign.status %></span></td>
                                    <td>
                                        <div class="marketplace-action-row">
                                            <a class="button secondary compact" href="/admin/cashback/<%= campaign.id %>/edit">Edit</a>
                                            <form action="/admin/cashback/<%= campaign.id %>/delete" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button class="button secondary compact danger-button" type="submit">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </div>
</section>

<script>
    (() => {
        const search = document.querySelector('.js-marketplace-search');
        const merchant = document.querySelector('.js-marketplace-merchant-filter');
        const rows = Array.from(document.querySelectorAll('.js-marketplace-row'));

        const applyFilters = () => {
            const query = (search?.value || '').trim().toLowerCase();
            const selectedMerchant = (merchant?.value || '').trim().toLowerCase();

            rows.forEach((row) => {
                const haystack = (row.dataset.search || '').toLowerCase();
                const merchantName = (row.dataset.merchant || '').toLowerCase();
                row.hidden = Boolean(query && !haystack.includes(query)) || Boolean(selectedMerchant && merchantName !== selectedMerchant);
            });
        };

        search?.addEventListener('input', applyFilters);
        merchant?.addEventListener('change', applyFilters);
    })();
</script>

<%- include('partials/footer') %>

