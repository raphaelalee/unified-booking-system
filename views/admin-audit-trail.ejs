<%- include('partials/header', { title }) %>

<%
    const auditLogs = [
        { admin: currentUser?.name || 'Admin', action: 'Viewed platform dashboard', entity: 'Admin overview', time: 'Now' },
        { admin: currentUser?.name || 'Admin', action: 'Reviewed booking records', entity: `${(bookings || []).length} bookings`, time: 'Today' },
        { admin: currentUser?.name || 'Admin', action: 'Checked merchant health', entity: `${(merchants || []).length} merchants`, time: 'Today' },
        { admin: currentUser?.name || 'Admin', action: 'Loaded automation logs', entity: 'AI automation', time: 'Today' }
    ];
%>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <header class="admin-dashboard-header">
            <div><p class="eyebrow">System</p><h1>Audit Trail</h1><p>Admin activity, AI automation logs, and system settings activity.</p></div>
        </header>

        <section class="admin-grid">
            <article class="admin-panel span-7">
                <div class="admin-panel-heading"><div><p class="eyebrow">Audit Trail</p><h2>Recent admin activity</h2></div></div>
                <div class="admin-log-list">
                    <% auditLogs.forEach((log) => { %>
                        <article><strong><%= log.admin %></strong><span><%= log.action %></span><small><%= log.entity %> - <%= log.time %></small></article>
                    <% }) %>
                </div>
            </article>
            <article class="admin-panel span-5">
                <div class="admin-panel-heading"><div><p class="eyebrow">Operations</p><h2>System settings</h2></div></div>
                <div class="admin-quick-link-grid">
                    <a class="button secondary" href="/admin/loyalty">Loyalty rules</a>
                    <a class="button secondary" href="/admin/reward-shop">Reward shop</a>
                    <a class="button secondary" href="/admin/rewards-game">Game rewards</a>
                    <a class="button secondary" href="/admin/platform-health">Platform health</a>
                </div>
            </article>
        </section>
    </div>
</section>

<%- include('partials/footer') %>
