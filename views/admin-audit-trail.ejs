<%- include('partials/header', { title }) %>

<% const safeAuditLogs = Array.isArray(auditLogs) ? auditLogs : []; %>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <header class="admin-dashboard-header">
            <div><p class="eyebrow">System</p><h1>Audit Trail</h1><p>Admin activity, AI automation logs, and system settings activity.</p></div>
        </header>

        <section class="admin-grid">
            <article class="admin-panel span-7">
                <div class="admin-panel-heading"><div><p class="eyebrow">Audit Trail</p><h2>Recent admin activity</h2></div></div>
                <div class="admin-log-list">
                    <% if (!safeAuditLogs.length) { %>
                        <article><strong>System</strong><span>No audit entries yet</span><small>Rule changes and reward redemptions will appear here.</small></article>
                    <% } %>
                    <% safeAuditLogs.forEach((log) => { %>
                        <article>
                            <strong><%= log.actorName %></strong>
                            <span><%= String(log.action || '').replace(/_/g, ' ') %></span>
                            <small>
                                <%= log.entityType %><%= log.entityId ? ` #${log.entityId}` : '' %>
                                -
                                <%= new Date(log.createdAt).toLocaleString('en-SG', { dateStyle: 'medium', timeStyle: 'short' }) %>
                            </small>
                        </article>
                    <% }) %>
                </div>
            </article>
            <article class="admin-panel span-5">
                <div class="admin-panel-heading"><div><p class="eyebrow">Operations</p><h2>System settings</h2></div></div>
                <div class="admin-quick-link-grid">
                    <a class="button secondary" href="/admin/loyalty">Loyalty rules</a>
                    <a class="button secondary" href="/admin/reward-shop">Reward shop</a>
                    <a class="button secondary" href="/admin/promotions">Promotions</a>
                    <a class="button secondary" href="/admin/platform-health">Platform health</a>
                </div>
            </article>
        </section>
    </div>
</section>

<%- include('partials/footer') %>
