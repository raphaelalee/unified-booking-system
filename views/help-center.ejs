<%- include('partials/header', { title, useBootstrap: true }) %>

<%
    const finalStatuses = ['resolved_approved', 'resolved_rejected', 'cancelled', 'closed'];
    const visibleRequests = Array.isArray(requests) ? requests : [];
    const safeBookings = Array.isArray(bookings) ? bookings : [];
    const safeOrders = Array.isArray(orders) ? orders : [];
    const formatMoney = (value) => `$${Number(value || 0).toFixed(2)}`;
    const formatDate = (value) => {
        const date = value instanceof Date ? value : new Date(value);
        return Number.isNaN(date.getTime()) ? '-' : date.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' });
    };
    const formatDateTime = (value) => {
        const date = value instanceof Date ? value : new Date(value);
        return Number.isNaN(date.getTime()) ? '-' : date.toLocaleString('en-SG', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    };
    const requestLabel = (type) => requestLabels[type] || String(type || 'Support request').replace(/_/g, ' ');
    const statusClass = (status) => `status-${String(status || 'pending').replace(/_/g, '-')}`;
    const supportStatusLabel = (status) => ({
        pending_admin_review: 'Under Review',
        pending_merchant_review: 'Waiting for Merchant',
        merchant_approved: 'Under Review',
        merchant_declined: 'Under Review',
        resolved_approved: 'Resolved',
        resolved_rejected: 'Resolved',
        cancelled: 'Closed',
        closed: 'Closed'
    }[status] || 'Open');
    const isClosed = (request) => finalStatuses.includes(request.status);
    const priorityLabel = (request) => {
        if (request.requestType === 'booking_refund' || request.requestType === 'order_refund') return 'High';
        if (request.status === 'pending_merchant_review') return 'Medium';
        return 'Normal';
    };
    const responseTimeLabel = (request) => priorityLabel(request) === 'High' ? 'Within 1 business day' : '1-2 business days';
    const canCancelOrder = (order) => !['shipped', 'delivered', 'cancelled'].includes(order.deliveryStatus);
    const buildTimeline = (request) => {
        const timeline = [{ label: 'Submitted', time: formatDateTime(request.createdAt) }];
        if (request.merchantNote || request.merchantDecision !== 'pending') timeline.push({ label: 'Merchant replied', time: formatDateTime(request.updatedAt) });
        if (request.adminNote || request.adminDecision !== 'pending') timeline.push({ label: 'Admin replied', time: formatDateTime(request.updatedAt) });
        if (request.refundAmount > 0 && request.status === 'resolved_approved') timeline.push({ label: 'Refund processed', time: formatDateTime(request.resolvedAt || request.updatedAt) });
        if (isClosed(request)) timeline.push({ label: 'Issue resolved', time: formatDateTime(request.resolvedAt || request.updatedAt) });
        return timeline;
    };
    const helpCategories = [
        { icon: 'P', title: 'Payment Issues', description: 'Troubleshoot failed charges, double payments, and receipt problems.', href: '#faq', keywords: 'payment card charge receipt failed' },
        { icon: 'R', title: 'Refund Disputes', description: 'Understand refund eligibility and escalate unresolved refund cases.', href: '#faq', keywords: 'refund dispute money late cancellation' },
        { icon: 'T', title: 'Technical Problems', description: 'Get help with QR, login, checkout, upload, and page errors.', href: '#faq', keywords: 'technical qr login error upload checkout' },
        { icon: 'M', title: 'Merchant Complaints', description: 'Report unresolved salon, appointment, or service experience problems.', href: '#faq', keywords: 'merchant salon complaint service rejected' },
        { icon: 'A', title: 'Account & Security', description: 'Protect your account, password, contact details, and notifications.', href: '#faq', keywords: 'account security password phone email login' },
        { icon: 'G', title: 'Promotions & Rewards', description: 'Check voucher, cashback, VaniGlints, and reward eligibility.', href: '#faq', keywords: 'promotions rewards voucher cashback glints loyalty' }
    ];
    const faqs = [
        { question: 'When am I eligible for a refund?', answer: 'Refund requests are accepted only for paid bookings or paid product orders. Orders must not already be shipped or refunded. Vaniday admin reviews the case first, then requests merchant approval before any refund is processed. Late booking cancellations may include a fee.', keywords: 'refund policy eligible late cancellation' },
        { question: 'How do I reschedule a booking?', answer: 'Go to Profile > Bookings and use Reschedule on the booking card. Help Center is only for unresolved refund, payment, technical, or merchant issues.', keywords: 'booking policy reschedule profile bookings merchant' },
        { question: 'My payment failed but I was charged. What should I do?', answer: 'Check your receipt and bank status first. If the charge remains after a short delay, create a Payment Issues ticket with a screenshot.', keywords: 'payment troubleshooting failed charged bank' },
        { question: 'Why are my rewards or vouchers missing?', answer: 'Rewards are linked to paid receipts and eligible campaigns. Some vouchers exclude cancelled, refunded, or already discounted purchases.', keywords: 'loyalty rewards voucher glints cashback' },
        { question: 'How fast will support reply?', answer: 'High priority refund and payment cases are usually reviewed within one business day. Other issues normally take one to two business days.', keywords: 'response time support priority' }
    ];
%>

<section class="support-hub-hero <%= role !== 'customer' ? 'role-desk-hero' : '' %>">
    <div>
        <p class="eyebrow"><%= roleCopy.eyebrow %></p>
        <h1><%= roleCopy.heading %></h1>
        <p><%= roleCopy.description %></p>
        <% if (role === 'customer') { %>
            <div class="support-search-wrap">
                <input type="search" class="form-control" placeholder="Search help articles or FAQs" data-help-search aria-label="Search help articles or FAQs">
                <button class="button primary" type="button" data-help-search-button>Search</button>
            </div>
            <div class="support-smart-row">
                <span>Estimated response: 1-2 business days</span>
                <a href="#contact-support" data-open-support-form>Contact Support</a>
                <button type="button" data-open-support-assistant>AI assistant</button>
            </div>
        <% } else if (role === 'merchant') { %>
            <div class="support-smart-row role-desk-actions">
                <span>Only admin-forwarded refund requests appear here.</span>
                <a href="#support-tickets">Review merchant queue</a>
            </div>
        <% } else { %>
            <div class="support-smart-row role-desk-actions">
                <span>Admin reviews first, merchant approval second, final refund last.</span>
                <a href="#support-tickets">Review refund queue</a>
            </div>
        <% } %>
    </div>
</section>

<section class="section compact help-center-page support-hub-page">
    <% if (flash) { %>
        <div class="notice <%= flash.type === 'success' ? 'success' : 'error' %>" data-support-toast>
            <p><%= flash.message %></p>
        </div>
    <% } %>

    <section class="support-hub-layout support-hub-layout-simple">
        <div class="support-main-column">
            <% if (role === 'customer') { %>
                <section class="support-section">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Quick help</p>
                            <h2>Choose a support category</h2>
                        </div>
                    </div>
                    <div class="support-category-grid">
                        <% helpCategories.forEach((category) => { %>
                            <%- include('partials/support-category-card', { category }) %>
                        <% }) %>
                    </div>
                </section>

                <section id="faq" class="support-section support-faq-section">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Self-service</p>
                            <h2>Common questions and policies</h2>
                        </div>
                        <span>Try these before contacting support</span>
                    </div>
                    <%- include('partials/support-faq-section', { faqs, accordionId: 'supportFaq' }) %>
                    <div class="support-after-faq">
                        <div>
                            <strong>Still need help?</strong>
                            <span>Create a ticket only if the FAQ or booking self-service flow did not solve it.</span>
                        </div>
                        <button class="button primary" type="button" data-open-support-form>Contact Support</button>
                    </div>
                </section>

                <section class="support-section support-policy-panel">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Refund terms</p>
                            <h2>Before you submit</h2>
                        </div>
                    </div>
                    <ul class="giftcard-terms">
                        <li>Only paid bookings and paid orders may be reviewed for refund.</li>
                        <li>Product orders that are already shipped, delivered, cancelled, or previously refunded are not eligible through this flow.</li>
                        <li>Vaniday admin reviews the request first, then asks the merchant to approve or decline before a refund is issued.</li>
                        <li>Booking cancellations made within 24 hours may include a late-cancellation fee deducted from the approved refund.</li>
                        <li>Submitting false information or duplicate claims may cause the request to be rejected.</li>
                    </ul>
                </section>
                <section id="contact-support" class="support-section support-contact-panel is-collapsed" data-support-form-panel>
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Contact Support</p>
                            <h2>Escalate an unresolved issue</h2>
                        </div>
                        <button class="button secondary" type="button" data-close-support-form>Hide</button>
                    </div>
                    <div class="support-suggestions compact">
                        <strong>Suggested articles</strong>
                        <a href="#faq">Refund policies</a>
                        <a href="#faq">Booking policies</a>
                        <a href="#faq">Payment troubleshooting</a>
                    </div>
                    <form action="/help-center/requests?_csrf=<%= encodeURIComponent(typeof csrfToken !== 'undefined' ? csrfToken : '') %>" method="POST" enctype="multipart/form-data" data-support-create-form>
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <input type="hidden" name="responseType" value="json">
                        <label>
                            Issue
                            <select name="requestType" class="form-select" required>
                                <option value="booking_refund">Refund dispute</option>
                                <option value="order_refund">Payment or order refund</option>
                            </select>
                        </label>
                        <label>
                            Reference
                            <select name="targetId" class="form-select" required>
                                <option value="">Choose booking or order</option>
                                <% safeBookings.forEach((booking) => { %>
                                    <option value="<%= booking.id %>" data-target-type="booking" <%= String(selectedTarget.bookingId) === String(booking.id) ? 'selected' : '' %>>
                                        Booking #<%= booking.id %> - <%= booking.service_name %>
                                    </option>
                                <% }) %>
                                <% safeOrders.forEach((order) => { %>
                                    <option value="<%= order.targetId || order.id %>" data-target-type="order" <%= String(selectedTarget.orderId) === String(order.id) ? 'selected' : '' %>>
                                        <%= order.receiptId %> - <%= order.itemNames %>
                                    </option>
                                <% }) %>
                            </select>
                        </label>
                        <input type="hidden" name="targetType" value="booking" data-support-target-type>
                        <label>
                            Reason
                            <select name="reason" class="form-select">
                                <option value="Refund dispute">Refund dispute</option>
                                <option value="Payment issue">Payment issue</option>
                                <option value="Merchant rejection">Merchant rejection</option>
                                <option value="Technical issue">Technical issue</option>
                                <option value="Other">Other</option>
                            </select>
                        </label>
                        <label>
                            Details
                            <textarea name="customerNote" class="form-control" rows="3" maxlength="1200" placeholder="Briefly explain what happened and what help you need." required></textarea>
                        </label>
                        <label>
                            Screenshot
                            <input type="file" name="screenshot" class="form-control" accept="image/*">
                        </label>
                        <label class="merchant-toggle-row">
                            <input type="checkbox" name="acceptRefundTerms" required>
                            <span><strong>I accept the refund terms</strong><small>I confirm the information is accurate and understand the merchant must approve before Vaniday can process a refund.</small></span>
                        </label>
                        <p class="support-form-note" data-support-create-feedback>For rescheduling, use Profile > Bookings instead.</p>
                        <button class="button primary full" type="submit">Create Ticket</button>
                    </form>
                </section>
            <% } else if (role === 'merchant') { %>
                <section class="support-section role-desk-summary">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Merchant responsibility</p>
                            <h2>What you do here</h2>
                        </div>
                    </div>
                    <div class="support-role-steps">
                        <article><span>1</span><strong>Review</strong><p>Read only the refund requests Vaniday admin has already sent to your business.</p></article>
                        <article><span>2</span><strong>Decide</strong><p>Approve or decline with a clear merchant note based on the service or order record.</p></article>
                        <article><span>3</span><strong>Hand back</strong><p>Vaniday admin makes the final customer-facing decision and processes money movement.</p></article>
                    </div>
                </section>
            <% } else { %>
                <section class="support-section role-desk-summary">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Admin workflow</p>
                            <h2>Refund control path</h2>
                        </div>
                    </div>
                    <div class="support-role-steps">
                        <article><span>1</span><strong>Validate</strong><p>Check payment status, shipping state, duplicate claims, and refund policy terms.</p></article>
                        <article><span>2</span><strong>Ask merchant</strong><p>Forward only eligible requests to the correct merchant for approval or decline.</p></article>
                        <article><span>3</span><strong>Resolve</strong><p>Issue or reject the final refund after merchant response and record the reason.</p></article>
                    </div>
                </section>
            <% } %>

            <section id="support-tickets" class="support-section">
                <div class="support-section-heading">
                    <div>
                        <p class="eyebrow"><%= role === 'customer' ? 'Tickets' : role === 'merchant' ? 'Merchant queue' : 'Admin queue' %></p>
                        <h2>
                            <%= role === 'customer'
                                ? 'Unresolved and escalated issues'
                                : role === 'merchant'
                                    ? 'Refund requests awaiting merchant review'
                                    : 'Customer refund submissions' %>
                        </h2>
                    </div>
                    <span><%= visibleRequests.length %> ticket<%= visibleRequests.length === 1 ? '' : 's' %></span>
                </div>

                <% if (!visibleRequests.length) { %>
                    <div class="help-empty-state support-ticket-empty">
                        <span>?</span>
                        <h2>No support tickets yet</h2>
                        <% if (role === 'customer') { %>
                            <p class="muted">Most issues can be solved with FAQs or booking self-service. If something remains unresolved, create a ticket.</p>
                            <a class="button secondary" href="#faq">Browse Help Articles</a>
                        <% } else if (role === 'merchant') { %>
                            <p class="muted">No refund requests have been sent to this merchant yet.</p>
                        <% } else { %>
                            <p class="muted">No customer refund submissions are waiting for admin review.</p>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="support-ticket-list">
                        <% visibleRequests.forEach((request) => { %>
                            <%- include('partials/support-ticket-card', {
                                request,
                                role,
                                requestLabel,
                                supportStatusLabel,
                                statusClass,
                                formatDateTime,
                                priorityLabel,
                                responseTimeLabel,
                                buildTimeline,
                                isClosed,
                                csrfToken
                            }) %>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </div>

    </section>
</section>

<% if (role === 'customer') { %>
    <button class="support-assistant-button" type="button" data-open-support-assistant>AI</button>
    <div class="support-assistant-panel" data-support-assistant hidden>
        <div>
            <strong>Vaniday assistant</strong>
            <button type="button" data-close-support-assistant aria-label="Close assistant">&times;</button>
        </div>
        <p>Search the FAQs first. If your issue remains unresolved, create a ticket with the related booking or order reference.</p>
        <a class="button primary full" href="#contact-support">Contact Support</a>
    </div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (() => {
        const searchInput = document.querySelector('[data-help-search]');
        const helpCards = Array.from(document.querySelectorAll('[data-help-card]'));
        const toast = document.querySelector('[data-support-toast]');
        const assistant = document.querySelector('[data-support-assistant]');
        const supportFormPanel = document.querySelector('[data-support-form-panel]');
        const token = document.querySelector('meta[name="csrf-token"]')?.content || '';

        const applySearch = () => {
            const query = (searchInput?.value || '').trim().toLowerCase();
            helpCards.forEach((card) => {
                const text = `${card.textContent} ${card.dataset.helpKeywords || ''}`.toLowerCase();
                card.hidden = Boolean(query) && !text.includes(query);
            });
        };

        searchInput?.addEventListener('input', applySearch);
        document.querySelector('[data-help-search-button]')?.addEventListener('click', applySearch);

        if (toast) {
            setTimeout(() => toast.classList.add('is-fading'), 4200);
        }

        document.querySelectorAll('[data-open-support-assistant]').forEach((button) => {
            button.addEventListener('click', () => {
                assistant.hidden = false;
            });
        });
        document.querySelector('[data-close-support-assistant]')?.addEventListener('click', () => {
            assistant.hidden = true;
        });
        document.querySelectorAll('[data-open-support-form]').forEach((button) => {
            button.addEventListener('click', (event) => {
                event.preventDefault();
                supportFormPanel?.classList.remove('is-collapsed');
                supportFormPanel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
        document.querySelector('[data-close-support-form]')?.addEventListener('click', () => {
            supportFormPanel?.classList.add('is-collapsed');
        });

        document.querySelectorAll('[data-support-create-form]').forEach((form) => {
            const requestType = form.querySelector('[name="requestType"]');
            const targetSelect = form.querySelector('[name="targetId"]');
            const targetType = form.querySelector('[data-support-target-type]');
            const feedback = form.querySelector('[data-support-create-feedback]');
            const submitButton = form.querySelector('button[type="submit"]');
            const syncTarget = () => {
                const selected = targetSelect.selectedOptions[0];
                const inferredType = selected?.dataset.targetType || (requestType.value === 'order_refund' ? 'order' : 'booking');
                targetType.value = inferredType;
                if (requestType.value === 'order_refund') {
                    Array.from(targetSelect.options).forEach((option) => option.hidden = option.dataset.targetType === 'booking');
                } else {
                    Array.from(targetSelect.options).forEach((option) => option.hidden = option.dataset.targetType === 'order');
                }
                if (targetSelect.selectedOptions[0]?.hidden) {
                    targetSelect.value = '';
                }
            };
            requestType.addEventListener('change', syncTarget);
            targetSelect.addEventListener('change', syncTarget);
            syncTarget();

            form.addEventListener('submit', (event) => {
                event.preventDefault();
                feedback.textContent = '';
                submitButton.disabled = true;
                submitButton.textContent = 'Creating...';

                fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        Accept: 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': token
                    }
                })
                    .then(async (response) => {
                        const data = await response.json();
                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Ticket could not be created.');
                        }
                        return data;
                    })
                    .then((data) => {
                        feedback.textContent = data.message || 'Ticket created.';
                        window.setTimeout(() => {
                            window.location.href = '/help-center#support-tickets';
                            window.location.reload();
                        }, 700);
                    })
                    .catch((error) => {
                        feedback.textContent = error.message;
                    })
                    .finally(() => {
                        submitButton.disabled = false;
                        submitButton.textContent = 'Create Ticket';
                    });
            });
        });

        document.querySelectorAll('[data-support-reply-form]').forEach((form) => {
            form.addEventListener('submit', (event) => {
                event.preventDefault();
                const feedback = form.querySelector('[data-support-reply-feedback]');
                const button = form.querySelector('button[type="submit"]');
                const conversation = form.closest('[data-ticket-card]')?.querySelector('[data-conversation]');
                feedback.textContent = '';
                button.disabled = true;
                button.textContent = 'Sending...';

                fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        Accept: 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': token
                    }
                })
                    .then(async (response) => {
                        const data = await response.json();
                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Reply could not be sent.');
                        }
                        return data;
                    })
                    .then((data) => {
                        const reply = data.reply || {};
                        const node = document.createElement('div');
                        node.className = `support-message ${reply.senderRole === 'customer' ? 'from-customer' : 'from-support'}`;
                        node.innerHTML = `
                            <div><strong>${reply.senderName || 'You'}</strong><span>Just now</span></div>
                            ${reply.messageBody ? `<p>${reply.messageBody.replace(/[<>&]/g, '')}</p>` : ''}
                            ${reply.screenshotPath ? `<a href="${reply.screenshotPath}" target="_blank" rel="noopener"><img src="${reply.screenshotPath}" alt="Support screenshot"></a>` : ''}
                        `;
                        conversation.querySelector('.muted')?.remove();
                        conversation.appendChild(node);
                        form.reset();
                        feedback.textContent = data.message || 'Reply sent.';
                    })
                    .catch((error) => {
                        feedback.textContent = error.message;
                    })
                    .finally(() => {
                        button.disabled = false;
                        button.textContent = 'Send Reply';
                    });
            });
        });
    })();
</script>

<%- include('partials/footer') %>
