<%- include('partials/header', { title, useBootstrap: true }) %>

<%
    const finalStatuses = ['partially_refunded', 'refunded', 'rejected', 'cancelled', 'closed'];
    const visibleRequests = Array.isArray(requests) ? requests : [];
    const safeBookings = Array.isArray(bookings) ? bookings : [];
    const safeOrders = Array.isArray(orders) ? orders : [];
    const refundAdminFeeAmount = Number(typeof refundAdministrationFeeAmount !== 'undefined' ? refundAdministrationFeeAmount : 2);
    const formatMoney = (value) => `$${Number(value || 0).toFixed(2)}`;
    const formatDate = (value) => {
        const date = value instanceof Date ? value : new Date(value);
        return Number.isNaN(date.getTime()) ? '-' : date.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' });
    };
    const formatDateTime = (value) => {
        const date = value instanceof Date ? value : new Date(value);
        return Number.isNaN(date.getTime()) ? '-' : date.toLocaleString('en-SG', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    };
    const requestLabel = (type) => requestLabels[type] || String(type || 'Support request').replace(/_/g, ' ');
    const statusClass = (status) => `status-${String(status || 'pending').replace(/_/g, '-')}`;
    const supportStatusLabel = (status) => ({
        pending_merchant_review: 'Waiting for Merchant',
        under_review: 'Under Review',
        more_information_required: 'More Information Required',
        approved: 'Approved',
        refund_processing: 'Refund Processing',
        return_required: 'Return Required',
        partially_refunded: 'Partially Refunded',
        refunded: 'Refunded',
        rejected: 'Rejected',
        refund_failed: 'Refund Failed',
        refund_reconciliation_required: 'Manual Review Required',
        cancelled: 'Closed',
        closed: 'Closed'
    }[status] || 'Open');
    const isClosed = (request) => finalStatuses.includes(request.status);
    const priorityLabel = (request) => {
        if (request.requestType === 'booking_refund' || request.requestType === 'order_refund') return 'High';
        if (request.status === 'pending_merchant_review' || request.status === 'under_review') return 'Medium';
        if (request.status === 'more_information_required') return 'Customer Action';
        return 'Normal';
    };
    const responseTimeLabel = (request) => priorityLabel(request) === 'High' ? 'Within 1 business day' : '1-2 business days';
    const actionLabel = (type) => ({
        cancellation: 'Cancellation',
        return_refund: 'Return and refund',
        refund_only: 'Refund review'
    }[type] || 'Refund review');
    const optionReasonJson = (eligibility) => JSON.stringify((eligibility?.eligibleReasons || []).map((reason) => ({
        code: reason.code,
        label: reason.label,
        responsibility: reason.responsibility,
        evidenceRequired: Boolean(reason.evidenceRequired),
        returnRequired: Boolean(reason.returnRequired)
    }))).replace(/'/g, '&#39;');
    const buildTimeline = (request) => {
        const timeline = [{ label: 'Submitted', time: formatDateTime(request.createdAt) }];
        if (request.reviewedAt || request.merchantDecision !== 'pending') timeline.push({ label: 'Merchant decision', time: formatDateTime(request.reviewedAt || request.updatedAt) });
        if (request.status === 'more_information_required') timeline.push({ label: 'More information requested', time: formatDateTime(request.reviewedAt || request.updatedAt) });
        if (request.status === 'under_review') timeline.push({ label: 'Returned to review', time: formatDateTime(request.updatedAt) });
        if (request.status === 'return_required') timeline.push({ label: 'Return required', time: formatDateTime(request.reviewedAt || request.updatedAt) });
        if (request.status === 'refund_processing') timeline.push({ label: 'Refund processing', time: formatDateTime(request.updatedAt) });
        if (request.status === 'refund_failed') timeline.push({ label: 'Refund failed', time: formatDateTime(request.updatedAt) });
        if (request.status === 'refund_reconciliation_required') timeline.push({ label: 'Manual reconciliation required', time: formatDateTime(request.updatedAt) });
        if (request.status === 'refunded') timeline.push({ label: 'Refund completed', time: formatDateTime(request.refundedAt || request.resolvedAt || request.updatedAt) });
        if (isClosed(request)) timeline.push({ label: 'Request closed', time: formatDateTime(request.resolvedAt || request.updatedAt) });
        return timeline;
    };
    const helpCategories = [
        { icon: 'P', title: 'Payment Issues', description: 'Troubleshoot failed charges, double payments, and receipt problems.', href: '#faq', keywords: 'payment card charge receipt failed' },
        { icon: 'R', title: 'Refund Disputes', description: 'Understand refund eligibility and escalate unresolved refund cases.', href: '#faq', keywords: 'refund dispute money late cancellation' },
        { icon: 'T', title: 'Technical Problems', description: 'Get help with QR, login, checkout, upload, and page errors.', href: '#faq', keywords: 'technical qr login error upload checkout' },
        { icon: 'M', title: 'Merchant Complaints', description: 'Report unresolved salon, appointment, or service experience problems.', href: '#faq', keywords: 'merchant salon complaint service rejected' },
        { icon: 'A', title: 'Account & Security', description: 'Protect your account, password, contact details, and notifications.', href: '#faq', keywords: 'account security password phone email login' },
        { icon: 'G', title: 'Promotions & Rewards', description: 'Check voucher, cashback, VaniGlints, and reward eligibility.', href: '#faq', keywords: 'promotions rewards voucher cashback glints loyalty' }
    ];
    const faqs = [
        { question: 'When am I eligible for a refund?', answer: 'Refund requests are accepted only for paid bookings or paid product orders. Orders must not already be shipped, delivered, cancelled, or refunded. The request is sent directly to the merchant linked to the booking or order for review. Late booking cancellations may include a fee.', keywords: 'refund policy eligible late cancellation' },
        { question: 'How do I reschedule a booking?', answer: 'Go to Profile > Bookings and use Reschedule on the booking card. Help Center is only for unresolved refund, payment, technical, or merchant issues.', keywords: 'booking policy reschedule profile bookings merchant' },
        { question: 'My payment failed but I was charged. What should I do?', answer: 'Check your receipt and bank status first. If the charge remains after a short delay, create a Payment Issues ticket with a screenshot.', keywords: 'payment troubleshooting failed charged bank' },
        { question: 'Why are my rewards or vouchers missing?', answer: 'Rewards are linked to paid receipts and eligible campaigns. Some vouchers exclude cancelled, refunded, or already discounted purchases.', keywords: 'loyalty rewards voucher glints cashback' },
        { question: 'How fast will support reply?', answer: 'High priority refund and payment cases are usually reviewed within one business day. Other issues normally take one to two business days.', keywords: 'response time support priority' }
    ];
%>

<section class="support-hub-hero <%= role !== 'customer' ? 'role-desk-hero' : '' %>">
    <div>
        <p class="eyebrow"><%= roleCopy.eyebrow %></p>
        <h1><%= roleCopy.heading %></h1>
        <p><%= roleCopy.description %></p>
        <% if (role === 'customer') { %>
            <div class="support-search-wrap">
                <input type="search" class="form-control" placeholder="Search help articles or FAQs" data-help-search aria-label="Search help articles or FAQs">
                <button class="button primary" type="button" data-help-search-button>Search</button>
            </div>
            <div class="support-smart-row">
                <span>Estimated response: 1-2 business days</span>
                <a href="#contact-support" data-open-support-form>Contact Support</a>
                <button type="button" data-open-support-assistant>AI assistant</button>
            </div>
        <% } else if (role === 'merchant') { %>
            <div class="support-smart-row role-desk-actions">
                <span>New refund requests from your customers appear here directly.</span>
                <a href="#support-tickets">Review merchant queue</a>
            </div>
        <% } else { %>
            <div class="support-smart-row role-desk-actions">
                <span>Monitor merchant decisions, processing, failures, and escalations.</span>
                <a href="#support-tickets">Monitor refund queue</a>
            </div>
        <% } %>
    </div>
</section>

<section class="section compact help-center-page support-hub-page">
    <% if (flash) { %>
        <div class="notice <%= flash.type === 'success' ? 'success' : 'error' %>" data-support-toast>
            <p><%= flash.message %></p>
        </div>
    <% } %>

    <section class="support-hub-layout support-hub-layout-simple">
        <div class="support-main-column">
            <% if (role === 'customer') { %>
                <section class="support-section">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Quick help</p>
                            <h2>Choose a support category</h2>
                        </div>
                    </div>
                    <div class="support-category-grid">
                        <% helpCategories.forEach((category) => { %>
                            <%- include('partials/support-category-card', { category }) %>
                        <% }) %>
                    </div>
                </section>

                <section id="faq" class="support-section support-faq-section">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Self-service</p>
                            <h2>Common questions and policies</h2>
                        </div>
                        <span>Try these before contacting support</span>
                    </div>
                    <%- include('partials/support-faq-section', { faqs, accordionId: 'supportFaq' }) %>
                    <div class="support-after-faq">
                        <div>
                            <strong>Still need help?</strong>
                            <span>Create a ticket only if the FAQ or booking self-service flow did not solve it.</span>
                        </div>
                        <button class="button primary" type="button" data-open-support-form>Contact Support</button>
                    </div>
                </section>

                <section class="support-section support-policy-panel">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Refund terms</p>
                            <h2>Before you submit</h2>
                        </div>
                    </div>
                    <ul class="giftcard-terms">
                        <li>Only captured paid bookings and paid product orders may be reviewed for cancellation, return, or refund.</li>
                        <li>Delivered or collected product issues may require a return step before any payment refund is approved.</li>
                        <li>The request is sent directly to the merchant linked to the booking or order for approval or rejection.</li>
                        <li>Booking cancellations made within 24 hours may include a late-cancellation fee deducted from the approved refund.</li>
                        <li>Submitting false information or duplicate claims may cause the request to be rejected.</li>
                    </ul>
                </section>
                <section id="contact-support" class="support-section support-contact-panel is-collapsed" data-support-form-panel>
                    <div class="support-section-heading support-form-heading">
                        <div>
                            <p class="eyebrow">Contact Support</p>
                            <h2>Request help with a refund or cancellation</h2>
                            <span>Six quick steps. Your merchant receives the request after the server confirms eligibility.</span>
                        </div>
                        <button class="button secondary" type="button" data-close-support-form>Hide</button>
                    </div>
                    <div class="support-suggestions compact">
                        <strong>Quick help</strong>
                        <a href="#faq">Refund policy</a>
                        <a href="#faq">Booking changes</a>
                        <a href="#faq">Payment issue</a>
                    </div>
                    <form action="/help-center/requests?_csrf=<%= encodeURIComponent(typeof csrfToken !== 'undefined' ? csrfToken : '') %>" method="POST" enctype="multipart/form-data" class="support-guided-form" data-support-create-form>
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <input type="hidden" name="responseType" value="json">
                        <input type="hidden" name="requestType" value="booking_refund" data-support-request-type>
                        <input type="hidden" name="targetType" value="booking" data-support-target-type>
                        <input type="hidden" name="reason" value="customer_cancellation" data-refund-reason-hidden>

                        <div class="support-form-main">
                            <section class="support-form-step">
                                <div class="support-step-title"><span>1</span><div><strong>What do you need help with?</strong><small>Choose the closest issue so the form can show matching references.</small></div></div>
                                <div class="support-issue-grid" role="radiogroup" aria-label="Issue type">
                                    <button type="button" class="support-issue-card is-selected" data-issue-card data-request-type="booking_refund">
                                        <strong>Booking refund</strong>
                                        <span>Cancel a booking or ask for service refund review.</span>
                                    </button>
                                    <button type="button" class="support-issue-card" data-issue-card data-request-type="order_refund">
                                        <strong>Order refund or return</strong>
                                        <span>Report cancellation, delivery, pickup, damage, or return issues.</span>
                                    </button>
                                </div>
                            </section>

                            <section class="support-form-step">
                                <div class="support-step-title"><span>2</span><div><strong>Select the booking or order</strong><small>Unavailable references stay blocked and show the reason.</small></div></div>
                                <label class="support-field">
                                    Reference
                                    <select data-readable-select name="targetId" class="form-select" required data-support-reference-select>
                                        <option value="">Choose booking or order</option>
                                        <% safeBookings.forEach((booking) => {
                                            const eligibility = booking.refundEligibility || {};
                                        %>
                                            <option value="<%= booking.id %>"
                                                data-target-type="booking"
                                                data-eligible="<%= eligibility.eligible ? '1' : '0' %>"
                                                data-action-type="<%= eligibility.actionType || '' %>"
                                                data-action-label="<%= actionLabel(eligibility.actionType) %>"
                                                data-status-code="<%= eligibility.statusCode || '' %>"
                                                data-blocked-reason="<%= eligibility.blockedReason || '' %>"
                                                data-deadline="<%= eligibility.deadlineLabel || '' %>"
                                                data-return-required="<%= eligibility.returnRequired ? '1' : '0' %>"
                                                data-reasons='<%- optionReasonJson(eligibility) %>'
                                                data-refund-amount="<%= Number(eligibility.refundableAmount || booking.service_price || booking.price || 0).toFixed(2) %>"
                                                data-payment-method="<%= booking.paymentMethodLabel || booking.payment_method || 'Original payment method' %>"
                                                <%= !eligibility.eligible ? 'disabled' : '' %>
                                                <%= String(selectedTarget.bookingId) === String(booking.id) ? 'selected' : '' %>>
                                                Booking #<%= booking.id %> - <%= booking.service_name %>
                                                <%= !eligibility.eligible && eligibility.blockedReason ? ` (${eligibility.blockedReason})` : '' %>
                                            </option>
                                        <% }) %>
                                        <% safeOrders.forEach((order) => {
                                            const eligibility = order.refundEligibility || {};
                                        %>
                                            <option value="<%= order.targetId || order.id %>"
                                                data-target-type="order"
                                                data-eligible="<%= eligibility.eligible ? '1' : '0' %>"
                                                data-action-type="<%= eligibility.actionType || '' %>"
                                                data-action-label="<%= actionLabel(eligibility.actionType) %>"
                                                data-status-code="<%= eligibility.statusCode || '' %>"
                                                data-blocked-reason="<%= eligibility.blockedReason || '' %>"
                                                data-deadline="<%= eligibility.deadlineLabel || '' %>"
                                                data-return-required="<%= eligibility.returnRequired ? '1' : '0' %>"
                                                data-reasons='<%- optionReasonJson(eligibility) %>'
                                                data-refund-amount="<%= Number(eligibility.refundableAmount || order.remainingRefundableAmount || order.totalAmount || 0).toFixed(2) %>"
                                                data-payment-method="<%= order.paymentMethodLabel || order.paymentMethod || 'Original payment method' %>"
                                                <%= !eligibility.eligible ? 'disabled' : '' %>
                                                <%= String(selectedTarget.orderId) === String(order.id) ? 'selected' : '' %>>
                                                Order <%= order.order_number || order.orderNumber || order.receiptId || ('#' + order.id) %> - <%= order.itemNames %>
                                                <%= !eligibility.eligible && eligibility.blockedReason ? ` (${eligibility.blockedReason})` : '' %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </label>
                                <div class="support-reference-card" data-reference-summary>
                                    <strong>Choose a reference to continue</strong>
                                    <span>The next steps will show only reasons supported for that booking or order.</span>
                                </div>
                            </section>

                            <section class="support-form-step" data-reason-stage>
                                <div class="support-step-title"><span>3</span><div><strong>Pick the reason</strong><small>Reason availability follows the selected reference and current eligibility rules.</small></div></div>
                                <label class="support-field support-native-select">
                                    Refund reason category
                                    <select data-readable-select name="reasonCategory" class="form-select" data-refund-reason-category required>
                                        <option value="">Choose a reference first</option>
                                    </select>
                                </label>
                                <div class="support-reason-list" data-reason-card-list aria-live="polite"></div>
                            </section>

                            <section class="support-form-step support-two-fields" data-amount-stage>
                                <div class="support-step-title"><span>4</span><div><strong>Refund amount</strong><small>The server caps this against the remaining refundable amount.</small></div></div>
                                <label class="support-field">
                                    Requested refund amount
                                    <input type="number" name="requestedRefundAmount" class="form-control" min="0.01" step="0.01" data-requested-refund-amount>
                                </label>
                                <section class="support-refund-preview" data-refund-preview>
                                    <div><span>Requested refund amount</span><strong data-preview-gross>S$0.00</strong></div>
                                    <div><span>Refund Administration Fee</span><strong data-preview-fee>S$<%= refundAdminFeeAmount.toFixed(2) %></strong></div>
                                    <div class="support-refund-net"><span>Estimated amount returned</span><strong data-preview-net>S$0.00</strong></div>
                                    <p data-preview-note>A fixed S$<%= refundAdminFeeAmount.toFixed(2) %> Refund Administration Fee will be deducted from the approved refund amount, regardless of the original payment method.</p>
                                </section>
                            </section>

                            <section class="support-form-step">
                                <div class="support-step-title"><span>5</span><div><strong>Tell us what happened</strong><small>Include dates, item names, and what outcome you expect.</small></div></div>
                                <label class="support-field">
                                    Details
                                    <textarea name="customerNote" class="form-control" rows="5" maxlength="1200" placeholder="Example: The item arrived damaged. I uploaded photos and would like a refund for the affected quantity." required data-support-details></textarea>
                                </label>
                                <div class="support-character-row"><span data-details-counter>0 / 1200</span><span>Minimum 8 characters</span></div>
                            </section>

                            <section class="support-form-step">
                                <div class="support-step-title"><span>6</span><div><strong>Add evidence</strong><small>Photos help merchants review damage, missing items, payment errors, and return claims.</small></div></div>
                                <label class="support-upload-zone" data-upload-zone>
                                    <input type="file" name="screenshot" accept="image/png,image/jpeg,image/webp,image/gif" multiple data-support-evidence-input>
                                    <span>Drop images here or browse</span>
                                    <small>PNG, JPG, WEBP or GIF. Keep the original issue visible.</small>
                                </label>
                                <div class="support-evidence-preview" data-evidence-preview></div>
                            </section>
                        </div>

                        <aside class="support-form-sidebar">
                            <section class="support-refund-preview support-eligibility-preview" data-eligibility-preview>
                                <div><span>Request type</span><strong data-eligibility-action>Choose a reference</strong></div>
                                <div><span>Deadline</span><strong data-eligibility-deadline>-</strong></div>
                                <div><span>Payment method</span><strong data-preview-payment-method>Choose a reference</strong></div>
                                <p data-eligibility-message>Eligibility is checked again by the server before the request is stored.</p>
                            </section>
                            <label class="merchant-toggle-row support-fee-ack" data-processing-fee-ack-row hidden>
                                <input type="checkbox" name="processingFeeAcknowledged" data-processing-fee-ack>
                                <span><strong>I understand that a fixed S$<%= refundAdminFeeAmount.toFixed(2) %> Refund Administration Fee will be deducted from the approved refund amount.</strong><small data-processing-fee-ack-copy>The server recalculates the final amount before the request is stored.</small></span>
                            </label>
                            <label class="merchant-toggle-row support-terms-row">
                                <input type="checkbox" name="acceptRefundTerms" required data-support-terms>
                                <span><strong>I accept the refund terms</strong><small>I confirm the information is accurate and understand the merchant must approve before a refund can be processed.</small></span>
                            </label>
                            <p class="support-form-note" data-support-create-feedback>For rescheduling, use Profile > Bookings instead.</p>
                            <div class="support-form-actions">
                                <button class="button secondary" type="button" data-close-support-form>Cancel</button>
                                <button class="button primary" type="submit" disabled>Submit Refund Request</button>
                            </div>
                        </aside>
                    </form>
                    <div class="support-confirm-modal" data-refund-confirm-modal hidden>
                        <div class="support-confirm-dialog">
                            <h3>Confirm Refund Request</h3>
                            <p data-confirm-reference>Review the refund request before submitting.</p>
                            <dl>
                                <dt>Original payment method</dt><dd data-confirm-method></dd>
                                <dt>Requested refund amount</dt><dd data-confirm-gross></dd>
                                <dt>Refund Administration Fee</dt><dd data-confirm-fee></dd>
                                <dt>Estimated amount returned</dt><dd data-confirm-net></dd>
                                <dt>Refund destination</dt><dd>Original payment method where supported</dd>
                            </dl>
                            <label class="merchant-toggle-row" data-confirm-ack-row hidden>
                                <input type="checkbox" data-confirm-ack>
                                <span><strong data-confirm-ack-copy>I understand that a fixed S$<%= refundAdminFeeAmount.toFixed(2) %> Refund Administration Fee will be deducted from the approved refund amount.</strong></span>
                            </label>
                            <div class="inline-actions">
                                <button class="button secondary" type="button" data-confirm-back>Go Back</button>
                                <button class="button primary" type="button" data-confirm-submit>Confirm Refund Request</button>
                            </div>
                        </div>
                    </div>
                </section>
            <% } else if (role === 'merchant') { %>
                <section class="support-section role-desk-summary">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Merchant responsibility</p>
                            <h2>What you do here</h2>
                        </div>
                    </div>
                    <div class="support-role-steps">
                        <article><span>1</span><strong>Review</strong><p>Read refund requests linked to your own bookings, services, products, or orders.</p></article>
                        <article><span>2</span><strong>Decide</strong><p>Approve or reject with a clear customer-facing reason when needed.</p></article>
                        <article><span>3</span><strong>Process</strong><p>Approved refunds are processed against the original payment where automatic refunds are available.</p></article>
                    </div>
                </section>
            <% } else { %>
                <section class="support-section role-desk-summary">
                    <div class="support-section-heading">
                        <div>
                            <p class="eyebrow">Admin oversight</p>
                            <h2>Refund monitoring</h2>
                        </div>
                    </div>
                    <div class="support-role-steps">
                        <article><span>1</span><strong>Monitor</strong><p>View all refund requests and merchant decisions across the platform.</p></article>
                        <article><span>2</span><strong>Investigate</strong><p>Track failed refunds, disputes, and unusual decision patterns.</p></article>
                        <article><span>3</span><strong>Audit</strong><p>Use ticket history and notes for oversight without owning standard approval.</p></article>
                    </div>
                </section>
            <% } %>

            <section id="support-tickets" class="support-section">
                <div class="support-section-heading">
                    <div>
                        <p class="eyebrow"><%= role === 'customer' ? 'Tickets' : role === 'merchant' ? 'Merchant queue' : 'Admin queue' %></p>
                        <h2>
                            <%= role === 'customer'
                                ? 'Unresolved and escalated issues'
                                : role === 'merchant'
                                    ? 'Refund requests for your business'
                                    : 'Platform refund monitoring' %>
                        </h2>
                    </div>
                    <span><%= visibleRequests.length %> ticket<%= visibleRequests.length === 1 ? '' : 's' %></span>
                </div>

                <% if (!visibleRequests.length) { %>
                    <div class="help-empty-state support-ticket-empty">
                        <span>?</span>
                        <h2>No support tickets yet</h2>
                        <% if (role === 'customer') { %>
                            <p class="muted">Most issues can be solved with FAQs or booking self-service. If something remains unresolved, create a ticket.</p>
                            <a class="button secondary" href="#faq">Browse Help Articles</a>
                        <% } else if (role === 'merchant') { %>
                            <p class="muted">No refund requests are assigned to this merchant yet.</p>
                        <% } else { %>
                            <p class="muted">No refund requests are available for monitoring.</p>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="support-ticket-list">
                        <% visibleRequests.forEach((request) => { %>
                            <%- include('partials/support-ticket-card', {
                                request,
                                role,
                                requestLabel,
                                supportStatusLabel,
                                statusClass,
                                formatDateTime,
                                priorityLabel,
                                responseTimeLabel,
                                buildTimeline,
                                isClosed,
                                csrfToken
                            }) %>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </div>

    </section>
</section>

<% if (role === 'customer') { %>
    <button class="support-assistant-button" type="button" data-open-support-assistant>AI</button>
    <div class="support-assistant-panel" data-support-assistant hidden>
        <div>
            <strong>Vaniday assistant</strong>
            <button type="button" data-close-support-assistant aria-label="Close assistant">&times;</button>
        </div>
        <p>Search the FAQs first. If your issue remains unresolved, create a ticket with the related booking or order reference.</p>
        <a class="button primary full" href="#contact-support">Contact Support</a>
    </div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (() => {
        const searchInput = document.querySelector('[data-help-search]');
        const helpCards = Array.from(document.querySelectorAll('[data-help-card]'));
        const toast = document.querySelector('[data-support-toast]');
        const assistant = document.querySelector('[data-support-assistant]');
        const supportFormPanel = document.querySelector('[data-support-form-panel]');
        const token = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const debounce = (callback, delay = 240) => {
            let timer = null;

            return (...args) => {
                window.clearTimeout(timer);
                timer = window.setTimeout(() => callback(...args), delay);
            };
        };

        const applySearch = () => {
            const query = (searchInput?.value || '').trim().toLowerCase();
            let visibleCount = 0;

            helpCards.forEach((card) => {
                const text = `${card.textContent} ${card.dataset.helpKeywords || ''}`.toLowerCase();
                const isVisible = !query || text.includes(query);
                card.hidden = !isVisible;

                if (isVisible) {
                    visibleCount += 1;
                }
            });

            let empty = document.querySelector('[data-help-empty]');

            if (!empty) {
                empty = document.createElement('div');
                empty.className = 'live-search-empty';
                empty.dataset.helpEmpty = 'true';
                empty.textContent = 'No results found.';
                document.querySelector('.support-category-grid')?.after(empty);
            }

            if (empty) {
                empty.hidden = visibleCount > 0;
            }
        };

        searchInput?.addEventListener('input', debounce(applySearch));
        document.querySelector('[data-help-search-button]')?.addEventListener('click', applySearch);

        if (toast) {
            setTimeout(() => toast.classList.add('is-fading'), 4200);
        }

        document.querySelectorAll('[data-open-support-assistant]').forEach((button) => {
            button.addEventListener('click', () => {
                assistant.hidden = false;
            });
        });
        document.querySelector('[data-close-support-assistant]')?.addEventListener('click', () => {
            assistant.hidden = true;
        });
        document.querySelectorAll('[data-open-support-form]').forEach((button) => {
            button.addEventListener('click', (event) => {
                event.preventDefault();
                supportFormPanel?.classList.remove('is-collapsed');
                supportFormPanel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
        document.querySelectorAll('[data-close-support-form]').forEach((button) => button.addEventListener('click', () => {
            supportFormPanel?.classList.add('is-collapsed');
        }));

        document.querySelectorAll('[data-support-create-form]').forEach((form) => {
            const requestType = form.querySelector('[data-support-request-type]');
            const issueCards = Array.from(form.querySelectorAll('[data-issue-card]'));
            const targetSelect = form.querySelector('[name="targetId"]');
            const targetType = form.querySelector('[data-support-target-type]');
            const reasonCategory = form.querySelector('[data-refund-reason-category]');
            const reasonCardList = form.querySelector('[data-reason-card-list]');
            const reasonHidden = form.querySelector('[data-refund-reason-hidden]');
            const requestedAmount = form.querySelector('[data-requested-refund-amount]');
            const feeAckRow = form.querySelector('[data-processing-fee-ack-row]');
            const feeAck = form.querySelector('[data-processing-fee-ack]');
            const terms = form.querySelector('[data-support-terms]');
            const details = form.querySelector('[data-support-details]');
            const detailsCounter = form.querySelector('[data-details-counter]');
            const referenceSummary = form.querySelector('[data-reference-summary]');
            const evidenceInput = form.querySelector('[data-support-evidence-input]');
            const evidencePreview = form.querySelector('[data-evidence-preview]');
            const previewMethod = form.querySelector('[data-preview-payment-method]');
            const previewGross = form.querySelector('[data-preview-gross]');
            const previewFee = form.querySelector('[data-preview-fee]');
            const previewNet = form.querySelector('[data-preview-net]');
            const previewNote = form.querySelector('[data-preview-note]');
            const eligibilityAction = form.querySelector('[data-eligibility-action]');
            const eligibilityDeadline = form.querySelector('[data-eligibility-deadline]');
            const eligibilityMessage = form.querySelector('[data-eligibility-message]');
            const confirmModal = document.querySelector('[data-refund-confirm-modal]');
            const confirmAckRow = confirmModal?.querySelector('[data-confirm-ack-row]');
            const confirmAck = confirmModal?.querySelector('[data-confirm-ack]');
            const confirmSubmit = confirmModal?.querySelector('[data-confirm-submit]');
            const feedback = form.querySelector('[data-support-create-feedback]');
            const submitButton = form.querySelector('button[type="submit"]');
            let submitConfirmed = false;
            let selectedFiles = [];
            const money = (value) => `S$${Number(value || 0).toFixed(2)}`;
            const selectedRefundAmount = () => Number(requestedAmount?.value || targetSelect.selectedOptions[0]?.dataset.refundAmount || 0);
            const selectedReasonOption = () => reasonCategory?.selectedOptions?.[0] || null;
            const refundAdministrationFee = <%- JSON.stringify(refundAdminFeeAmount) %>;
            const feeAcknowledgementLikelyRequired = () => selectedRefundAmount() > refundAdministrationFee;
            const reasonCopy = {
                customer_cancellation: { label: 'I changed my mind or cannot attend', description: 'Customer-requested cancellation. Any allowed deduction must be confirmed before submission.' },
                merchant_cancellation: { label: 'Merchant cancelled or cannot fulfil', description: 'Use when the merchant cancelled, cannot provide the service, or cannot supply the item.' },
                duplicate_charge: { label: 'Duplicate charge', description: 'Use when you were charged more than once for the same booking or order.' },
                incorrect_charge: { label: 'Incorrect charge', description: 'Use when the amount charged does not match the confirmed price.' },
                platform_error: { label: 'Platform or payment error', description: 'Use for checkout, payment, voucher, or system problems that affected the transaction.' },
                damaged_defective: { label: 'Damaged or defective item', description: 'Upload clear photos showing the product condition and packaging where possible.' },
                missing_item: { label: 'Missing item', description: 'Tell the merchant which item or quantity was missing from the order.' },
                wrong_item: { label: 'Wrong item received', description: 'Upload photos of the received item and the order details.' },
                return_refund: { label: 'Return and refund request', description: 'Use when the item must be returned before the merchant makes a final decision.' },
                other: { label: 'Other refund issue', description: 'Explain the issue clearly so support can route it correctly.' }
            };
            const getReasonCopy = (reason) => {
                const copy = reasonCopy[reason.code] || {};
                return {
                    label: copy.label || reason.label || String(reason.code || 'Reason').replace(/_/g, ' '),
                    description: copy.description || (reason.evidenceRequired
                        ? 'Evidence is required for this reason.'
                        : 'The merchant will review this reason against the selected reference.')
                };
            };
            const parseReasons = (selected) => {
                try {
                    return JSON.parse(selected?.dataset.reasons || '[]');
                } catch (error) {
                    return [];
                }
            };
            const populateReasons = (selected) => {
                if (!reasonCategory) return;
                const previous = reasonCategory.value;
                const reasons = parseReasons(selected);
                reasonCategory.innerHTML = '';
                if (reasonCardList) reasonCardList.innerHTML = '';
                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = reasons.length ? 'Choose reason' : 'No valid reasons available';
                reasonCategory.appendChild(placeholder);
                if (!reasons.length && reasonCardList) {
                    const empty = document.createElement('p');
                    empty.className = 'support-reason-empty';
                    empty.textContent = selected?.value
                        ? 'No refund reasons are available for this reference.'
                        : 'Choose an eligible booking or order to see available reasons.';
                    reasonCardList.appendChild(empty);
                }
                reasons.forEach((reason) => {
                    const copy = getReasonCopy(reason);
                    const option = document.createElement('option');
                    option.value = reason.code;
                    option.textContent = copy.label;
                    option.dataset.responsibility = reason.responsibility || '';
                    option.dataset.evidenceRequired = reason.evidenceRequired ? '1' : '0';
                    option.dataset.returnRequired = reason.returnRequired ? '1' : '0';
                    reasonCategory.appendChild(option);
                    if (reasonCardList) {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'support-reason-card';
                        button.dataset.reasonCode = reason.code;
                        const title = document.createElement('strong');
                        title.textContent = copy.label;
                        const description = document.createElement('span');
                        description.textContent = copy.description;
                        button.append(title, description);
                        if (reason.evidenceRequired) {
                            const badge = document.createElement('em');
                            badge.textContent = 'Evidence required';
                            button.appendChild(badge);
                        }
                        button.addEventListener('click', () => {
                            reasonCategory.value = reason.code;
                            syncPreview();
                        });
                        reasonCardList.appendChild(button);
                    }
                });
                if (reasons.some((reason) => reason.code === previous)) {
                    reasonCategory.value = previous;
                } else if (reasons.length === 1) {
                    reasonCategory.value = reasons[0].code;
                }
            };
            const syncReasonCards = () => {
                const value = reasonCategory?.value || '';
                form.querySelectorAll('[data-reason-code]').forEach((card) => {
                    card.classList.toggle('is-selected', card.dataset.reasonCode === value);
                });
            };
            const syncReferenceSummary = (selected, isEligible) => {
                if (!referenceSummary) return;
                const label = selected?.value ? selected.textContent.trim() : 'Choose a reference to continue';
                const amount = selected?.dataset.refundAmount ? money(selected.dataset.refundAmount) : '-';
                const deadline = selected?.dataset.deadline || '-';
                const blocked = selected?.dataset.blockedReason || '';
                referenceSummary.replaceChildren();
                const title = document.createElement('strong');
                title.textContent = label;
                const description = document.createElement('span');
                description.textContent = isEligible ? `Remaining refundable amount: ${amount}` : (blocked || 'Select an eligible booking or order.');
                const deadlineCopy = document.createElement('small');
                deadlineCopy.textContent = `Deadline: ${deadline}`;
                referenceSummary.append(title, description, deadlineCopy);
                referenceSummary.classList.toggle('is-blocked', Boolean(selected?.value) && !isEligible);
            };
            const syncDetailsCounter = () => {
                if (!detailsCounter || !details) return;
                detailsCounter.textContent = `${details.value.length} / ${details.getAttribute('maxlength') || 1200}`;
            };
            const syncFiles = () => {
                if (!evidencePreview || !evidenceInput) return;
                evidencePreview.innerHTML = '';
                selectedFiles.forEach((file, index) => {
                    const item = document.createElement('div');
                    item.className = 'support-evidence-item';
                    const image = document.createElement('img');
                    image.alt = file.name;
                    image.src = URL.createObjectURL(file);
                    image.addEventListener('load', () => URL.revokeObjectURL(image.src), { once: true });
                    const meta = document.createElement('span');
                    meta.textContent = file.name;
                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.textContent = 'Remove';
                    remove.addEventListener('click', () => {
                        selectedFiles.splice(index, 1);
                        const transfer = new DataTransfer();
                        selectedFiles.forEach((nextFile) => transfer.items.add(nextFile));
                        evidenceInput.files = transfer.files;
                        syncFiles();
                        syncPreview();
                    });
                    item.append(image, meta, remove);
                    evidencePreview.appendChild(item);
                });
            };
            const syncPreview = () => {
                const selected = targetSelect.selectedOptions[0];
                const gross = selectedRefundAmount();
                const isEligible = selected?.dataset.eligible === '1';
                const showAck = feeAcknowledgementLikelyRequired();
                if (reasonHidden) reasonHidden.value = reasonCategory?.value || 'other';
                if (requestedAmount && selected?.dataset.refundAmount && (!requestedAmount.value || Number(requestedAmount.value) <= 0)) {
                    requestedAmount.value = Number(selected.dataset.refundAmount || 0).toFixed(2);
                }
                if (previewMethod) previewMethod.textContent = selected?.dataset.paymentMethod || 'Original payment method';
                if (previewGross) previewGross.textContent = money(gross);
                if (previewFee) previewFee.textContent = money(gross > 0 ? Math.min(refundAdministrationFee, gross) : 0);
                if (previewNet) previewNet.textContent = gross > refundAdministrationFee ? money(gross - refundAdministrationFee) : 'Not available';
                if (previewNote) {
                    previewNote.textContent = !isEligible
                        ? (selected?.dataset.blockedReason || 'Choose an eligible booking or order.')
                        : gross <= refundAdministrationFee
                        ? `The requested refund amount must be more than the S$${refundAdministrationFee.toFixed(2)} Refund Administration Fee.`
                        : `A fixed S$${refundAdministrationFee.toFixed(2)} Refund Administration Fee will be deducted from the approved refund amount, regardless of the original payment method.`;
                }
                if (eligibilityAction) eligibilityAction.textContent = selected?.dataset.actionLabel || 'Choose a reference';
                if (eligibilityDeadline) eligibilityDeadline.textContent = selected?.dataset.deadline || '-';
                if (eligibilityMessage) {
                    const returnCopy = selected?.dataset.returnRequired === '1'
                        ? ' A product return step may be required before refund approval.'
                        : '';
                    eligibilityMessage.textContent = !isEligible
                        ? (selected?.dataset.blockedReason || 'This reference cannot be submitted for refund review.')
                        : `Eligible for ${selected?.dataset.actionLabel || 'refund review'}.${returnCopy}`;
                }
                if (feeAckRow) feeAckRow.hidden = !showAck;
                if (feeAck && !showAck) feeAck.checked = false;
                syncReasonCards();
                syncReferenceSummary(selected, isEligible);
                syncDetailsCounter();
                const detailsValid = !details || details.value.trim().length >= 8;
                const termsAccepted = !terms || terms.checked;
                const evidenceRequired = selectedReasonOption()?.dataset.evidenceRequired === '1';
                const evidenceProvided = !evidenceRequired || selectedFiles.length > 0 || (evidenceInput?.files?.length || 0) > 0;
                const amountValid = gross > refundAdministrationFee;
                if (submitButton) submitButton.disabled = !isEligible || !reasonCategory?.value || !detailsValid || !termsAccepted || !evidenceProvided || !amountValid;
                if (feedback) {
                    feedback.textContent = !isEligible
                        ? 'Choose an eligible booking or order.'
                        : evidenceRequired && !evidenceProvided
                        ? 'This reason needs at least one evidence image.'
                        : !detailsValid
                        ? 'Add a short explanation before submitting.'
                        : !termsAccepted
                        ? 'Accept the refund terms to continue.'
                        : 'Ready to review before submission.';
                }
            };
            const syncTarget = () => {
                const selected = targetSelect.selectedOptions[0];
                const inferredType = selected?.dataset.targetType || (requestType.value === 'order_refund' ? 'order' : 'booking');
                if (targetType) targetType.value = inferredType;
                if (requestType.value === 'order_refund') {
                    Array.from(targetSelect.options).forEach((option) => option.hidden = option.dataset.targetType === 'booking');
                } else {
                    Array.from(targetSelect.options).forEach((option) => option.hidden = option.dataset.targetType === 'order');
                }
                if (targetSelect.selectedOptions[0]?.hidden || targetSelect.selectedOptions[0]?.disabled) {
                    const nextOption = Array.from(targetSelect.options).find((option) => option.value && !option.hidden && !option.disabled);
                    targetSelect.value = nextOption?.value || '';
                }
                if (requestedAmount) {
                    requestedAmount.value = targetSelect.selectedOptions[0]?.dataset.refundAmount || '';
                }
                populateReasons(targetSelect.selectedOptions[0]);
                syncPreview();
            };
            issueCards.forEach((card) => {
                card.addEventListener('click', () => {
                    if (requestType) requestType.value = card.dataset.requestType || 'booking_refund';
                    issueCards.forEach((nextCard) => nextCard.classList.toggle('is-selected', nextCard === card));
                    syncTarget();
                });
            });
            targetSelect.addEventListener('change', syncTarget);
            reasonCategory?.addEventListener('change', syncPreview);
            requestedAmount?.addEventListener('input', syncPreview);
            details?.addEventListener('input', syncPreview);
            terms?.addEventListener('change', syncPreview);
            evidenceInput?.addEventListener('change', () => {
                selectedFiles = Array.from(evidenceInput.files || []);
                syncFiles();
                syncPreview();
            });
            const initialTargetType = targetSelect.selectedOptions[0]?.dataset.targetType;
            if (initialTargetType === 'order' && requestType) requestType.value = 'order_refund';
            issueCards.forEach((card) => {
                card.classList.toggle('is-selected', card.dataset.requestType === requestType?.value);
            });
            syncTarget();

            form.addEventListener('submit', (event) => {
                event.preventDefault();
                if (submitButton?.disabled) {
                    feedback.textContent = 'Choose an eligible booking or order and refund reason.';
                    return;
                }
                if (!submitConfirmed && confirmModal) {
                    const selected = targetSelect.selectedOptions[0];
                    const showAck = feeAcknowledgementLikelyRequired();
                    confirmModal.hidden = false;
                    confirmModal.querySelector('[data-confirm-back]')?.focus();
                    confirmModal.querySelector('[data-confirm-reference]').textContent = selected?.textContent?.trim() || 'Selected refund request';
                    confirmModal.querySelector('[data-confirm-method]').textContent = selected?.dataset.paymentMethod || 'Original payment method';
                    confirmModal.querySelector('[data-confirm-gross]').textContent = money(selectedRefundAmount());
                    confirmModal.querySelector('[data-confirm-fee]').textContent = money(Math.min(refundAdministrationFee, selectedRefundAmount()));
                    confirmModal.querySelector('[data-confirm-net]').textContent = money(selectedRefundAmount() - refundAdministrationFee);
                    if (confirmAckRow) confirmAckRow.hidden = !showAck;
                    if (confirmAck) {
                        confirmAck.checked = false;
                        confirmAck.disabled = !showAck;
                    }
                    if (confirmSubmit) confirmSubmit.disabled = showAck;
                    return;
                }
                submitConfirmed = false;
                feedback.textContent = '';
                submitButton.disabled = true;
                submitButton.textContent = 'Creating...';

                fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        Accept: 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': token
                    }
                })
                    .then(async (response) => {
                        const data = await response.json();
                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Ticket could not be created.');
                        }
                        return data;
                    })
                    .then((data) => {
                        feedback.textContent = data.message || 'Ticket created.';
                        window.setTimeout(() => {
                            window.location.href = '/help-center#support-tickets';
                            window.location.reload();
                        }, 700);
                    })
                    .catch((error) => {
                        feedback.textContent = error.message;
                    })
                    .finally(() => {
                        submitButton.disabled = false;
                        submitButton.textContent = 'Submit Refund Request';
                    });
            });

            confirmModal?.querySelector('[data-confirm-back]')?.addEventListener('click', () => {
                confirmModal.hidden = true;
            });
            confirmModal?.addEventListener('click', (event) => {
                if (event.target === confirmModal) {
                    confirmModal.hidden = true;
                }
            });
            confirmModal?.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    confirmModal.hidden = true;
                }
            });
            confirmAck?.addEventListener('change', () => {
                if (confirmSubmit) confirmSubmit.disabled = !confirmAck.checked;
                if (feeAck) feeAck.checked = confirmAck.checked;
            });
            confirmSubmit?.addEventListener('click', () => {
                confirmModal.hidden = true;
                submitConfirmed = true;
                form.requestSubmit();
            });
        });

        document.querySelectorAll('[data-merchant-refund-review]').forEach((review) => {
            const form = review.querySelector('form');
            const tokenInput = form?.querySelector('input[name="_csrf"]');
            const decisions = Array.from(review.querySelectorAll('[data-refund-decision]'));
            const partialControls = review.querySelector('[data-partial-controls]');
            const rejectControls = review.querySelector('[data-reject-controls]');
            const moreInfoControls = review.querySelector('[data-more-info-controls]');
            const percentageInput = review.querySelector('[data-refund-percentage]');
            const presetButtons = Array.from(review.querySelectorAll('[data-refund-preset]'));
            const partialReason = review.querySelector('[data-partial-reason]');
            const partialReasonSelect = review.querySelector('[data-partial-reason-select]');
            const rejectionReason = review.querySelector('textarea[name="rejectionReason"]');
            const moreInfoMessage = review.querySelector('textarea[name="moreInfoMessage"]');
            const confirmCheck = review.querySelector('[data-refund-confirm]');
            const submitButton = review.querySelector('[data-refund-submit]');
            const previewButton = review.querySelector('[data-refund-preview]');
            const feedback = review.querySelector('[data-refund-feedback]');
            const previewUrl = review.dataset.previewUrl;
            let latestCalculation = null;
            let submitting = false;
            const moneyText = (value) => Number(value || 0).toFixed(2);
            const validPartialPercentages = new Set(['25', '50', '75']);
            const selectedDecision = () => decisions.find((input) => input.checked)?.value || '';
            const selectedPartialReason = () => {
                const customReason = String(partialReason?.value || '').trim();
                const presetReason = String(partialReasonSelect?.value || '').trim();
                if (customReason) return customReason;
                return presetReason && presetReason !== 'Other.' ? presetReason : '';
            };
            const syncPartialReason = () => {
                const presetReason = String(partialReasonSelect?.value || '').trim();
                if (partialReason && presetReason && presetReason !== 'Other.' && !String(partialReason.value || '').trim()) {
                    partialReason.value = presetReason;
                }
            };
            const setText = (selector, value) => {
                const node = review.querySelector(selector);
                if (node) node.textContent = value;
            };
            const syncVisibility = () => {
                const decision = selectedDecision();
                if (partialControls) partialControls.hidden = decision !== 'partial_refund';
                if (rejectControls) rejectControls.hidden = decision !== 'rejected';
                if (moreInfoControls) moreInfoControls.hidden = decision !== 'request_more_information';
                if (submitButton) {
                    submitButton.textContent = decision === 'rejected'
                        ? 'Reject Refund Request'
                        : decision === 'request_more_information'
                            ? 'Request More Information'
                        : decision === 'return_required'
                            ? 'Require Product Return'
                        : decision === 'partial_refund'
                            ? 'Review Partial Refund'
                            : 'Approve Full Refund';
                }
                if (confirmCheck) confirmCheck.checked = false;
                latestCalculation = null;
            };
            const validateLocal = () => {
                const decision = selectedDecision();
                if (decision === 'partial_refund') {
                    const raw = String(percentageInput?.value || '').trim();
                    if (!validPartialPercentages.has(raw)) return 'Please select a valid partial refund percentage: 25%, 50% or 75%.';
                    if (String(partialReasonSelect?.value || '').trim() === 'Other.' && !String(partialReason?.value || '').trim()) {
                        return 'Type the customer-facing reason for this partial refund.';
                    }
                    if (!selectedPartialReason()) return 'Add a reason for the partial refund.';
                }
                if (decision === 'rejected' && String(rejectionReason?.value || '').trim().length < 8) {
                    return 'Add a rejection reason for the customer.';
                }
                if (decision === 'request_more_information' && String(moreInfoMessage?.value || '').trim().length < 12) {
                    return 'Explain what evidence or information is missing for the customer.';
                }
                if (decision === 'return_required' && String(review.querySelector('textarea[name="merchantNote"]')?.value || '').trim().length < 8) {
                    return 'Tell the customer what return action is required.';
                }
                return '';
            };
            const applyCalculation = (calculation, rewardEffects = {}) => {
                latestCalculation = calculation;
                setText('[data-preview-previous]', moneyText(calculation.previousGrossRefunds));
                setText('[data-preview-remaining]', moneyText(calculation.remainingRefundableAmount));
                setText('[data-preview-percentage]', moneyText(calculation.approvedRefundPercentage));
                setText('[data-preview-gross]', moneyText(calculation.approvedGrossRefund));
                setText('[data-preview-fee]', moneyText(calculation.processingFeeDeduction));
                setText('[data-preview-other]', moneyText(calculation.otherDeductions));
                setText('[data-preview-external]', moneyText(rewardEffects.externalRefundAmount));
                setText('[data-preview-wallet]', moneyText(rewardEffects.walletRestoredAmount));
                setText('[data-preview-points-restored]', Number(rewardEffects.pointsRestored || 0).toFixed(0));
                setText('[data-preview-points-reversed]', Number(rewardEffects.pointsReversed || 0).toFixed(0));
                setText('[data-preview-cashback-restored]', moneyText(rewardEffects.cashbackRestoredAmount));
                setText('[data-preview-cashback-reversed]', moneyText(rewardEffects.cashbackReversedAmount));
                setText('[data-preview-net]', moneyText(calculation.netCustomerRefund));
                setText('[data-preview-after]', moneyText(calculation.remainingRefundableAfterRefund));
            };
            const requestPreview = async () => {
                const localError = validateLocal();
                if (localError) {
                    if (feedback) feedback.textContent = localError;
                    return null;
                }
                if (['rejected', 'return_required', 'request_more_information'].includes(selectedDecision())) return null;
                syncPartialReason();
                const body = new URLSearchParams(new FormData(form));
                body.set('decision', selectedDecision());
                body.set('approvedPercentage', selectedDecision() === 'full_refund' ? '100' : (percentageInput?.value || ''));
                if (selectedDecision() === 'partial_refund') body.set('partialReason', selectedPartialReason());
                if (feedback) feedback.textContent = 'Calculating...';
                const response = await fetch(`${previewUrl}?_csrf=${encodeURIComponent(tokenInput?.value || '')}`, {
                    method: 'POST',
                    body,
                    headers: {
                        Accept: 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': tokenInput?.value || ''
                    }
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Refund preview failed.');
                applyCalculation(data.calculation || {}, data.rewardEffects || {});
                if (feedback) feedback.textContent = data.message || 'Preview updated.';
                return data.calculation;
            };
            decisions.forEach((input) => input.addEventListener('change', syncVisibility));
            presetButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    if (percentageInput) percentageInput.value = button.dataset.refundPreset || '';
                    presetButtons.forEach((preset) => preset.classList.toggle('is-active', preset === button));
                    latestCalculation = null;
                });
            });
            percentageInput?.addEventListener('input', () => {
                presetButtons.forEach((preset) => preset.classList.toggle('is-active', preset.dataset.refundPreset === percentageInput.value));
                latestCalculation = null;
            });
            partialReasonSelect?.addEventListener('change', () => {
                syncPartialReason();
                latestCalculation = null;
            });
            previewButton?.addEventListener('click', () => {
                requestPreview().catch((error) => {
                    if (feedback) feedback.textContent = error.message;
                });
            });
            form?.addEventListener('submit', async (event) => {
                if (submitting) {
                    event.preventDefault();
                    return;
                }
                const localError = validateLocal();
                if (localError) {
                    event.preventDefault();
                    if (feedback) feedback.textContent = localError;
                    return;
                }
                if (['rejected', 'return_required', 'request_more_information'].includes(selectedDecision())) {
                    submitting = true;
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.textContent = 'Saving...';
                    }
                    return;
                }

                if (!['rejected', 'return_required', 'request_more_information'].includes(selectedDecision())) {
                    event.preventDefault();
                    try {
                        if (selectedDecision() === 'partial_refund') syncPartialReason();
                        if (!latestCalculation) await requestPreview();
                        if (!latestCalculation) {
                            if (feedback) feedback.textContent = 'Refund preview could not be calculated. Recalculate and try again.';
                            return;
                        }
                        if (!confirmCheck?.checked) {
                            if (feedback) feedback.textContent = `Confirm that S$${moneyText(latestCalculation?.netCustomerRefund)} will be returned to the customer.`;
                            return;
                        }
                        submitting = true;
                        if (submitButton) {
                            submitButton.disabled = true;
                            submitButton.textContent = 'Processing...';
                        }
                        form.submit();
                    } catch (error) {
                        if (feedback) feedback.textContent = error.message;
                    } finally {
                        if (!submitting && submitButton) submitButton.disabled = false;
                    }
                }
            });
            syncVisibility();
            requestPreview().catch(() => {});
        });

        document.querySelectorAll('[data-support-reply-form]').forEach((form) => {
            form.addEventListener('submit', (event) => {
                event.preventDefault();
                const feedback = form.querySelector('[data-support-reply-feedback]');
                const button = form.querySelector('button[type="submit"]');
                const conversation = form.closest('[data-ticket-card]')?.querySelector('[data-conversation]');
                feedback.textContent = '';
                button.disabled = true;
                button.textContent = 'Sending...';

                fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        Accept: 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': token
                    }
                })
                    .then(async (response) => {
                        const data = await response.json();
                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Reply could not be sent.');
                        }
                        return data;
                    })
                    .then((data) => {
                        const reply = data.reply || {};
                        const node = document.createElement('div');
                        node.className = `support-message ${reply.senderRole === 'customer' ? 'from-customer' : 'from-support'}`;
                        const header = document.createElement('div');
                        const sender = document.createElement('strong');
                        const time = document.createElement('span');
                        sender.textContent = reply.senderName || 'You';
                        time.textContent = 'Just now';
                        header.append(sender, time);
                        node.appendChild(header);
                        if (reply.messageBody) {
                            const body = document.createElement('p');
                            body.textContent = reply.messageBody;
                            node.appendChild(body);
                        }
                        if (reply.screenshotPath && /^\/[A-Za-z0-9/_ .%#?=&-]+$/.test(reply.screenshotPath)) {
                            const link = document.createElement('a');
                            const image = document.createElement('img');
                            link.href = reply.screenshotPath;
                            link.target = '_blank';
                            link.rel = 'noopener';
                            image.src = reply.screenshotPath;
                            image.alt = 'Support screenshot';
                            link.appendChild(image);
                            node.appendChild(link);
                        }
                        conversation?.querySelector('.muted')?.remove();
                        conversation?.appendChild(node);
                        form.reset();
                        feedback.textContent = data.message || 'Reply sent.';
                    })
                    .catch((error) => {
                        feedback.textContent = error.message;
                    })
                    .finally(() => {
                        button.disabled = false;
                        button.textContent = 'Send Reply';
                    });
            });
        });
    })();
</script>

<%- include('partials/footer') %>

