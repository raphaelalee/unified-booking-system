<%- include('partials/header', { title }) %>

<section class="page-title">
    <p class="eyebrow">E-wallet security</p>
    <h1>Verify your top-up</h1>
    <p>Enter the 6-digit sample code shown in your server terminal.</p>
</section>

<section class="section compact wallet-page">
    <% if (success) { %>
        <div class="notice success"><%= success %></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><%= error %></div>
    <% } %>

    <div class="wallet-shell">
        <div class="wallet-grid" style="grid-template-columns: minmax(280px, 520px); justify-content: center;">
            <form class="account-panel wallet-topup-card" method="POST" action="/profile/wallet/topup/verify">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                <div>
                    <p class="eyebrow">Sample 2FA</p>
                    <h2>Security check</h2>
                    <p class="muted">Top-up amount: <strong>$<%= Number(amount || 0).toFixed(2) %></strong></p>
                    <p class="muted">Payment method: <strong><%= paymentMethodLabel %></strong></p>
                    <p class="muted">Code expires in about <strong><%= Number(expiresInSeconds || 0) %>s</strong>.</p>
                </div>

                <label>
                    Verification code
                    <input
                        type="text"
                        name="topup2faCode"
                        inputmode="numeric"
                        pattern="[0-9]{6}"
                        minlength="6"
                        maxlength="6"
                        autocomplete="one-time-code"
                        placeholder="123456"
                        required
                    >
                </label>

                <div class="hero-actions" style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.75rem;">
                    <button class="button primary" type="submit">Verify and continue</button>
                    <a class="button secondary" href="/profile/wallet">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
