<%- include('partials/header', { title }) %>

<section class="section compact signin-page">
    <div class="signin-shell">
        <form class="login-form signin-card" action="/login" method="POST" data-login-form novalidate>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <% if (form.returnTo) { %>
                <input type="hidden" name="returnTo" value="<%= form.returnTo %>">
            <% } %>
            <header class="signin-card-header">
                <p class="eyebrow">Customer Account</p>
                <h1>Welcome back</h1>
                <p>Continue to bookings, rewards, wallet, and saved merchants.</p>
            </header>

            <% if (error) { %>
                <div class="notice error"><p><%= error %></p></div>
            <% } %>
            <% if (success) { %>
                <div class="notice success"><p><%= success %></p></div>
            <% } %>

            <div class="signin-validation-summary" data-login-summary hidden></div>

            <div class="signin-field-stack">
                <label class="signin-field">
                    <span>Email</span>
                    <input type="email" name="email" value="<%= form.email || '' %>" placeholder="name@example.com" autocomplete="email" data-login-validate="email" required>
                    <small data-field-message></small>
                </label>

                <label class="signin-field">
                    <span>Password</span>
                    <input type="password" name="password" placeholder="Enter your password" autocomplete="current-password" data-login-validate="password" required>
                    <small data-field-message></small>
                </label>
            </div>

            <button class="button primary full" type="submit">Log In</button>
            <div class="auth-divider"><span>or</span></div>
            <a class="button google-login-button full" href="/auth/google<%= form.returnTo ? `?returnTo=${encodeURIComponent(form.returnTo)}` : '' %>" aria-label="Log in with Google">
                <span class="google-mark" aria-hidden="true">G</span>
                Continue with Google
            </a>
            <div class="auth-switch-card">
                <span>New to Vaniday?</span>
                <a class="button secondary auth-switch-action" href="/signup">Create account</a>
            </div>
        </form>

        <aside class="signin-aside">
            <div>
                <p class="eyebrow">Vaniday</p>
                <h2>Your appointments stay organized.</h2>
                <p>Check upcoming visits, loyalty points, receipts, and wallet activity after signing in.</p>
            </div>
            <ul>
                <li><strong>QR check-in</strong><span>Open booking details faster.</span></li>
                <li><strong>Loyalty wallet</strong><span>Track earned and redeemed points.</span></li>
                <li><strong>Receipts</strong><span>View service and product history.</span></li>
            </ul>
        </aside>
    </div>
</section>

<%- include('partials/footer') %>
