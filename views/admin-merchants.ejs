<%- include('partials/header', { title }) %>

<%
    const safeMerchants = Array.isArray(merchants) ? merchants : [];
    const formatCurrency = (value) => Number(value || 0).toFixed(2);
    const currentMonthLabel = new Date().toLocaleDateString('en-SG', { month: 'long', year: 'numeric' });
    const pendingMerchants = safeMerchants.filter((merchant) => ['pending_review', 'changes_requested'].includes(merchant.approval_status || 'approved'));
    const monthlyFeaturedCandidates = safeMerchants
        .filter((merchant) => !merchant.is_featured && merchant.featuredRecommendation && Number(merchant.featuredRecommendation.recommendationRank || 0) > 0)
        .sort((left, right) => Number(left.featuredRecommendation.recommendationRank || 0) - Number(right.featuredRecommendation.recommendationRank || 0))
        .slice(0, 3);
%>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <header class="admin-dashboard-header admin-command-hero">
            <div><p class="eyebrow">Users</p><h1>Merchant Management</h1><p>Manage merchant accounts, onboarding readiness, commission, and marketplace status.</p></div>
            <div class="admin-topbar-utilities">
                <a class="button primary" href="/admin/merchants/new">Add merchant</a>
                <a class="button secondary" href="/admin/overview">Back to overview</a>
            </div>
        </header>

        <section class="admin-stat-grid">
            <article class="admin-stat-card accent-blue"><div class="admin-stat-card-top"><span class="admin-stat-icon">M</span></div><strong><%= safeMerchants.length %></strong><span>Total merchants</span><small>all marketplace accounts</small></article>
            <article class="admin-stat-card accent-purple"><div class="admin-stat-card-top"><span class="admin-stat-icon">R</span></div><strong><%= pendingMerchants.length %></strong><span>Pending review</span><small>approval queue</small></article>
            <article class="admin-stat-card accent-yellow"><div class="admin-stat-card-top"><span class="admin-stat-icon">S</span></div><strong><%= merchantReport.merchantsWithoutServices.length %></strong><span>Missing services</span><small>cannot receive bookings yet</small></article>
            <article class="admin-stat-card accent-red"><div class="admin-stat-card-top"><span class="admin-stat-icon">P</span></div><strong><%= merchantReport.merchantsMissingBusinessProfile.length %></strong><span>Incomplete profiles</span><small>missing business information</small></article>
            <article class="admin-stat-card accent-green"><div class="admin-stat-card-top"><span class="admin-stat-icon">T</span></div><strong><%= merchantReport.topMerchant?.salon_name || 'None' %></strong><span>Top merchant</span><small>current featured score leader</small></article>
        </section>

        <% if (monthlyFeaturedCandidates.length > 0) { %>
            <section class="admin-panel admin-featured-recommendations-panel">
                <div class="admin-panel-heading">
                    <div>
                        <p class="eyebrow">Recommendation</p>
                        <h2>Recommended To Be Featured In <%= currentMonthLabel %></h2>
                        <p class="muted">Top merchant candidates based on current marketplace readiness and performance score.</p>
                    </div>
                </div>
                <div class="admin-featured-recommendations-grid">
                    <% monthlyFeaturedCandidates.forEach((merchant) => { %>
                        <% const recommendation = merchant.featuredRecommendation || {}; %>
                        <article class="admin-featured-recommendation-card">
                            <span class="admin-featured-recommendation-rank">#<%= recommendation.recommendationRank || 0 %></span>
                            <h3><%= merchant.salon_name %></h3>
                            <p><%= recommendation.reason || 'Strong marketplace momentum.' %></p>
                            <div class="admin-featured-recommendation-metrics">
                                <span><strong><%= Number(merchant.featured_score || 0).toFixed(2) %></strong> score</span>
                                <span><strong><%= merchant.service_count || 0 %></strong> services</span>
                                <span><strong><%= recommendation.featuredType || 'trending' %></strong> type</span>
                            </div>
                            <form class="admin-featured-recommendation-form" action="/admin/merchants/<%= merchant.salon_id %>/feature" method="POST">
                                <input type="hidden" name="featuredType" value="<%= recommendation.featuredType || 'featured_month' %>">
                                <input type="hidden" name="featuredOrder" value="<%= recommendation.featuredOrder || 1 %>">
                                <input type="hidden" name="featuredStartDate" value="<%= recommendation.featuredStartDate || '' %>">
                                <input type="hidden" name="featuredEndDate" value="<%= recommendation.featuredEndDate || '' %>">
                                <button class="button secondary" type="submit">Feature for this month</button>
                            </form>
                        </article>
                    <% }) %>
                </div>
            </section>
        <% } %>

        <section class="admin-panel admin-merchant-directory-panel">
            <div class="admin-panel-heading">
                <div>
                    <p class="eyebrow">Directory</p>
                    <h2>Merchant accounts</h2>
                    <p class="muted">Review onboarding status, marketplace readiness, commission, and featuring controls.</p>
                </div>
                <span><%= safeMerchants.length %> account<%= safeMerchants.length === 1 ? '' : 's' %></span>
            </div>
            <div class="admin-merchant-grid">
                <% if (!safeMerchants.length) { %>
                    <div class="admin-empty-state admin-merchant-empty">
                        <span class="admin-empty-icon">M</span>
                        <strong>No merchants yet</strong>
                        <p class="muted">New merchant applications will appear here after registration.</p>
                    </div>
                <% } %>
                <% safeMerchants.forEach((merchant) => { %>
                    <% const recommendation = merchant.featuredRecommendation || {}; %>
                    <article class="admin-merchant-card admin-merchant-command-card">
                        <div class="admin-merchant-card-top">
                            <div>
                                <strong><%= merchant.salon_name %></strong>
                                <span><%= merchant.owner_name || merchant.owner_email || 'Owner not set' %></span>
                            </div>
                            <span class="merchant-approval-badge status-<%= merchant.approval_status || 'approved' %>"><%= (merchant.approval_status || 'approved').replace(/_/g, ' ') %></span>
                        </div>
                        <% if (merchant.review_reason) { %>
                            <p class="admin-merchant-review-note"><%= merchant.review_reason %></p>
                        <% } %>
                        <div class="admin-merchant-metrics admin-merchant-metrics-primary">
                            <p><span>Services</span><strong><%= merchant.service_count || 0 %></strong></p>
                            <p><span>Commission</span><strong><%= Number(merchant.commission_rate || 15).toFixed(1) %>%</strong></p>
                            <p><span>Featured</span><strong><%= merchant.is_featured ? 'Yes' : 'No' %></strong></p>
                            <p><span>Score</span><strong><%= Number(merchant.featured_score || 0).toFixed(2) %></strong></p>
                        </div>
                        <div class="admin-merchant-metrics">
                            <p><span>Category</span><strong><%= merchant.business_category || 'Not set' %></strong></p>
                            <p><span>Staff</span><strong><%= merchant.staff_count || 'Not set' %></strong></p>
                            <p><span>Owner phone</span><strong><%= merchant.owner_phone || 'Not set' %></strong></p>
                            <p><span>UEN</span><strong><%= merchant.uen || 'Not set' %></strong></p>
                            <p><span>Type</span><strong><%= merchant.featured_type || 'None' %></strong></p>
                        </div>
                        <div class="admin-merchant-action-stack">
                        <form class="admin-merchant-approval-form" action="/admin/merchants/<%= merchant.salon_id %>/approval" method="POST">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <textarea name="reason" rows="2" placeholder="Review remarks for merchant"><%= merchant.review_reason || '' %></textarea>
                            <div class="admin-merchant-approval-actions">
                                <button class="button secondary" type="submit" name="action" value="approve">Approve</button>
                                <button class="button secondary" type="submit" name="action" value="request_changes">Request changes</button>
                                <button class="button secondary" type="submit" name="action" value="reject">Reject</button>
                                <% if ((merchant.approval_status || 'approved') === 'suspended') { %>
                                    <button class="button primary" type="submit" name="action" value="reactivate">Reactivate</button>
                                <% } else { %>
                                    <button class="button secondary" type="submit" name="action" value="suspend">Suspend</button>
                                <% } %>
                            </div>
                        </form>
                        <form class="admin-merchant-commission-form" action="/admin/merchants/<%= merchant.salon_id %>/commission" method="POST">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <input type="number" name="commissionRate" min="0" max="80" step="0.1" value="<%= Number(merchant.commission_rate || 15).toFixed(1) %>">
                            <button class="button secondary" type="submit">Save</button>
                        </form>
                        <% if (merchant.is_featured) { %>
                            <form class="admin-merchant-commission-form" action="/admin/merchants/<%= merchant.salon_id %>/unfeature" method="POST">
                                <button class="button secondary" type="submit">Unfeature merchant</button>
                            </form>
                        <% } else { %>
                            <form class="admin-merchant-commission-form" action="/admin/merchants/<%= merchant.salon_id %>/feature" method="POST">
                                <div class="muted" style="font-size:.9rem;">
                                    Recommended: <strong><%= recommendation.featuredType || 'trending' %></strong>
                                    <% if (recommendation.reason) { %> · <%= recommendation.reason %><% } %>
                                </div>
                                <select data-readable-select name="featuredType">
                                    <option value="featured_month" <%= recommendation.featuredType === 'featured_month' ? 'selected' : '' %>>Featured Merchant of the Month</option>
                                    <option value="sponsored" <%= recommendation.featuredType === 'sponsored' ? 'selected' : '' %>>Sponsored</option>
                                    <option value="trending" <%= recommendation.featuredType === 'trending' ? 'selected' : '' %>>Trending</option>
                                    <option value="top_rated" <%= recommendation.featuredType === 'top_rated' ? 'selected' : '' %>>Top Rated</option>
                                </select>
                                <input type="number" name="featuredOrder" min="0" max="99" step="1" value="<%= recommendation.featuredOrder || Number(merchant.featured_order || 0) %>">
                                <input type="date" name="featuredStartDate" value="<%= recommendation.featuredStartDate || '' %>">
                                <input type="date" name="featuredEndDate" value="<%= recommendation.featuredEndDate || '' %>">
                                <button class="button secondary" type="submit">Feature merchant</button>
                            </form>
                        <% } %>
                        </div>
                    </article>
                <% }) %>
            </div>
        </section>
    </div>
</section>

<%- include('partials/footer') %>

