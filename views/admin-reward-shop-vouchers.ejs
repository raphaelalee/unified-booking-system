<%- include('partials/header', { title }) %>

<%
    const voucherList = Array.isArray(vouchers) ? vouchers : [];
    const dailyValues = Array.isArray(dailyRewardValues) ? dailyRewardValues : [];
    const formatGlints = (value) => Number(value || 0).toLocaleString('en-SG');
    const formatMoney = (value) => Number(value || 0).toLocaleString('en-SG', {
        minimumFractionDigits: Number(value || 0) % 1 === 0 ? 0 : 2,
        maximumFractionDigits: 2
    });
    const activeCount = voucherList.filter((voucher) => voucher.status === 'active').length;
    const totalDailyPoints = dailyValues.reduce((sum, value) => sum + Number(value || 0), 0);
    const highestVoucher = voucherList.reduce((max, voucher) => Math.max(max, Number(voucher.voucherValue || 0)), 0);
%>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <%- include('partials/admin-rewards-tabs') %>

        <header class="admin-dashboard-header marketplace-admin-header">
            <div>
                <p class="eyebrow">Admin Rewards</p>
                <h1>Reward shop</h1>
                <p>Manage daily VaniGlints and voucher tiers customers redeem from the reward shop.</p>
            </div>
            <div class="admin-topbar-utilities">
                <a class="button secondary" href="/reward-shop">Customer shop</a>
                <a class="button primary" href="/admin/reward-shop/new">Add voucher</a>
            </div>
        </header>

        <% if (success) { %><div class="notice success"><p><%= success %></p></div><% } %>
        <% if (error) { %><div class="notice error"><p><%= error %></p></div><% } %>
        <% if (!isDatabaseBacked) { %>
            <div class="notice">
                <p>Default voucher tiers are showing. Run <strong>database/20260506_create_reward_shop_vouchers.sql</strong> to enable admin create, edit, and delete.</p>
            </div>
        <% } %>

        <section class="marketplace-admin-panel rewards-admin-panel">
            <div class="marketplace-stat-grid">
                <article><span>Voucher Tiers</span><strong><%= voucherList.length %></strong></article>
                <article><span>Active</span><strong><%= activeCount %></strong></article>
                <article><span>7-Day Points</span><strong><%= formatGlints(totalDailyPoints) %></strong></article>
                <article><span>Top Value</span><strong>$<%= formatMoney(highestVoucher) %></strong></article>
            </div>

            <form class="rewards-daily-form marketplace-admin-form" action="/admin/reward-shop/daily-rewards" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="marketplace-admin-toolbar rewards-toolbar">
                    <div>
                        <p class="eyebrow">Daily Points</p>
                        <h2>7-day claim streak</h2>
                        <p class="muted">Customers can claim once per day. These values control the visible streak rewards.</p>
                    </div>
                    <button class="button primary" type="submit">Save daily points</button>
                </div>

                <div class="rewards-streak-editor">
                    <% dailyValues.forEach((points, index) => { %>
                        <label>
                            <span>Day <%= index + 1 %></span>
                            <input type="number" name="day<%= index + 1 %>" min="0" step="1" value="<%= points %>" required>
                        </label>
                    <% }) %>
                </div>
            </form>

            <div class="marketplace-admin-toolbar">
                <div>
                    <p class="eyebrow">Voucher Records</p>
                    <h2>Reward shop catalogue</h2>
                </div>
                <div class="marketplace-filter-row">
                    <label>
                        <span class="sr-only">Search vouchers</span>
                        <input class="js-rewards-search" type="search" placeholder="Search title or detail">
                    </label>
                    <label>
                        <span class="sr-only">Filter status</span>
                        <select class="js-rewards-status-filter">
                            <option value="">All statuses</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </label>
                </div>
            </div>

            <% if (voucherList.length === 0) { %>
                <div class="empty-state marketplace-empty-state">
                    <h2>No reward vouchers yet</h2>
                    <p class="muted">Create voucher tiers so customers can spend VaniGlints.</p>
                    <a class="button primary" href="/admin/reward-shop/new">Add voucher</a>
                </div>
            <% } else { %>
                <div class="admin-table-wrap marketplace-table-wrap">
                    <table class="admin-table marketplace-admin-table rewards-admin-table">
                        <thead>
                            <tr>
                                <th>Voucher</th>
                                <th>Cost</th>
                                <th>Value</th>
                                <th>Status</th>
                                <th>Sort</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% voucherList.forEach((voucher) => { %>
                                <tr class="js-rewards-row" data-status="<%= voucher.status %>" data-search="<%= `${voucher.title || ''} ${voucher.detail || ''}` %>">
                                    <td>
                                        <strong><%= voucher.title %></strong>
                                        <small><%= voucher.detail %></small>
                                    </td>
                                    <td><%= formatGlints(voucher.glintsCost) %> VaniGlints</td>
                                    <td>$<%= formatMoney(voucher.voucherValue) %></td>
                                    <td><span class="sync-pill"><%= voucher.status %></span></td>
                                    <td><%= voucher.sortOrder %></td>
                                    <td>
                                        <div class="marketplace-action-row">
                                            <% if (voucher.voucherId) { %>
                                                <a class="button secondary compact" href="/admin/reward-shop/<%= voucher.id %>/edit">Edit</a>
                                                <form action="/admin/reward-shop/<%= voucher.id %>/delete" method="POST">
                                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                    <button class="button secondary compact danger-button" type="submit">Delete</button>
                                                </form>
                                            <% } else { %>
                                                <span class="sync-pill">Default tier</span>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </div>
</section>

<script>
    (() => {
        const search = document.querySelector('.js-rewards-search');
        const status = document.querySelector('.js-rewards-status-filter');
        const rows = Array.from(document.querySelectorAll('.js-rewards-row'));

        const applyFilters = () => {
            const query = (search?.value || '').trim().toLowerCase();
            const selectedStatus = (status?.value || '').trim().toLowerCase();

            rows.forEach((row) => {
                const haystack = (row.dataset.search || '').toLowerCase();
                const rowStatus = (row.dataset.status || '').toLowerCase();
                row.hidden = Boolean(query && !haystack.includes(query)) || Boolean(selectedStatus && rowStatus !== selectedStatus);
            });
        };

        search?.addEventListener('input', applyFilters);
        status?.addEventListener('change', applyFilters);
    })();
</script>

<%- include('partials/footer') %>
