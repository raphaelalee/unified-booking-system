<%- include('partials/header', { title }) %>

<%
    const productImages = {
        'skin-serum': 'product-skin',
        'hair-mask': 'product-hair',
        'body-oil': 'product-body',
        'lip-tint': 'product-lip',
        'cream-cleanser': 'product-cleanser',
        'room-mist': 'product-fragrance'
    };
    const productImageClass = productImages[product.id] || 'product-skin';
    const productImageStyle = product.imageUrl ? `background-image: url('${product.imageUrl}')` : '';
    const productReviews = Array.isArray(reviews) ? reviews : [];
    const averageRating = Number.isFinite(reviewSummary?.averageRating) ? reviewSummary.averageRating : null;
    const reviewCount = Number(reviewSummary?.reviewCount || 0);
    const renderStars = (rating) => '&#9733;'.repeat(Number(rating || 0)) + '&#9734;'.repeat(Math.max(0, 5 - Number(rating || 0)));
%>

<section class="page-title">
    <p class="eyebrow"><%= product.category %></p>
    <h1><%= product.name %></h1>
    <p>$<%= Number(product.price || 0).toFixed(2) %> &middot; <%= product.description %></p>
</section>

<section class="section compact product-detail-page">
    <div class="product-detail-layout">
        <div class="product-detail-image product-image <%= productImageClass %>" style="<%= productImageStyle %>"></div>

        <article class="account-panel product-detail-card">
            <div class="account-panel-header">
                <div>
                    <p class="eyebrow">Product details</p>
                    <h2>Ingredients & how to use</h2>
                </div>
            </div>

            <div class="product-detail-block">
                <h3>Ingredients</h3>
                <p><%= product.ingredients %></p>
            </div>

            <div class="product-detail-block">
                <h3>How to use</h3>
                <p><%= product.howToUse %></p>
            </div>

            <div class="product-card-actions">
                <a class="button secondary full" href="/products">Back to products</a>
                <form action="/cart/product/<%= product.id %>" method="POST" class="product-add-form">
                    <button class="button primary full" type="submit">Add to cart</button>
                </form>
            </div>
        </article>
    </div>
</section>

<section class="section compact">
    <article class="account-panel product-detail-card">
        <div class="account-panel-header">
            <div>
                <p class="eyebrow">Product reviews</p>
                <h2>What buyers said</h2>
            </div>
            <div>
                <strong><%= averageRating ? averageRating.toFixed(1) : 'New' %></strong>
                <span class="muted"><%= reviewCount > 0 ? `${reviewCount} review${reviewCount === 1 ? '' : 's'}` : 'No reviews yet' %></span>
            </div>
        </div>

        <% if (!productReviews.length) { %>
            <p class="muted">Reviews appear here after customers receive or pick up this product and submit feedback from purchase history.</p>
        <% } else { %>
            <% productReviews.forEach((review) => { %>
                <article style="padding: 1rem 0; border-top: 1px solid rgba(15, 23, 42, 0.08);">
                    <div style="display: flex; justify-content: space-between; gap: 1rem; align-items: baseline;">
                        <strong><%= review.customerName || 'Customer' %></strong>
                        <span><%- renderStars(review.rating) %></span>
                    </div>
                    <% if (review.comment) { %>
                        <p><%= review.comment %></p>
                    <% } else { %>
                        <p class="muted">Customer left a rating without extra comments.</p>
                    <% } %>
                    <% if (review.imagePath || review.videoPath) { %>
                        <div class="merchant-review-media">
                            <% if (review.imagePath) { %>
                                <a href="<%= review.imagePath %>" target="_blank" rel="noopener">
                                    <img src="<%= review.imagePath %>" alt="Review photo for <%= product.name %>">
                                </a>
                            <% } %>
                            <% if (review.videoPath) { %>
                                <video controls preload="metadata">
                                    <source src="<%= review.videoPath %>">
                                </video>
                            <% } %>
                        </div>
                    <% } %>
                </article>
            <% }) %>
        <% } %>
    </article>
</section>

<%- include('partials/footer') %>
