<%- include('partials/header', { title }) %>

<%
    const appointments = typeof appointmentReport !== 'undefined' && appointmentReport ? appointmentReport : {};
    const todayBookings = appointments.todayBookings || [];
    const upcomingBookings = appointments.upcomingBookings || [];
    const pendingAppointments = appointments.pendingAppointments || [];
    const weekDays = appointments.weekDays || [];
    const monthView = appointments.monthView || { label: '', days: [] };
    const allCalendarBookings = appointments.allBookings || [];
    const rescheduleTools = typeof rescheduleAutomation !== 'undefined' && rescheduleAutomation ? rescheduleAutomation : {};
    const rescheduleSettings = rescheduleTools.settings || {
        autoApproveEnabled: 1,
        minimumNoticeHours: 24,
        maxReschedulesAllowed: 2,
        blockedTimes: '',
        peakHourRestrictions: 1,
        businessStart: '09:00',
        businessEnd: '20:00'
    };
    const autoApprovedReschedules = Array.isArray(rescheduleTools.autoApproved) ? rescheduleTools.autoApproved : [];
    const pendingRescheduleReviews = Array.isArray(rescheduleTools.pendingReviews) ? rescheduleTools.pendingReviews : [];
    const rescheduleRecommendations = Array.isArray(rescheduleTools.recommendations) ? rescheduleTools.recommendations : [];
    const storefrontQrImage = typeof qrImage !== 'undefined' && qrImage ? qrImage : (typeof qrCodeDataUrl !== 'undefined' ? qrCodeDataUrl : null);
    const serviceFilterOptions = [...new Set(allCalendarBookings.map((booking) => booking.serviceName).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const recentOrders = salesReport?.recentOrders || [];
    const lowStockProducts = salesReport?.lowStockProducts || [];
    const customerInsights = customerReport?.insights || {
        totalCustomers: 0,
        repeatCustomers: 0,
        repeatRate: 0,
        averageVisits: 0,
        averageCustomerValue: 0,
        topCustomers: [],
        suggestedFocus: 'Customer patterns will appear after more bookings.',
        topServiceName: 'No service',
        peakHour: 'No bookings',
        chartPayload: {
            ageLabels: ['Not set'],
            ageValues: [0],
            genderLabels: ['Not set'],
            genderValues: [0],
            serviceLabels: ['No service'],
            serviceValues: [0],
            hourLabels: ['No bookings'],
            hourValues: [0]
        }
    };
    const payoutSummary = salesReport?.payoutSummary || {
        grossOrderSales: 0,
        totalCommissionDeducted: 0,
        totalNetPayout: 0
    };
    const formatCurrency = (value) => Number(value || 0).toFixed(2);
    const totalBookings = Number(stats.bookingCount || 0);
    const checkedInBookings = (appointments.allBookings || []).filter((booking) => ['checked_in', 'completed'].includes(booking.status)).length;
    const pendingCheckIns = Math.max(0, totalBookings - checkedInBookings);
    const trendBase = Math.max(totalBookings, 1);
    const makeSparkline = (seed) => [18, 28, 22, 36, 30, 44, 38].map((value, index) => Math.min(100, value + (seed * 3) + index));
    const kpiCards = [
        { label: "Today's Bookings", value: todayBookings.length, icon: 'TB', trend: todayBookings.length > 0 ? 12 : 0, detail: 'scheduled today', accent: 'green', sparkline: makeSparkline(todayBookings.length) },
        { label: 'Monthly Revenue', value: '$' + formatCurrency(appointments.monthlyRevenue || 0), icon: '$', trend: Number(stats.growthPercent || 0).toFixed(1), detail: 'vs last 7 days', accent: 'orange', sparkline: makeSparkline(Math.round((appointments.monthlyRevenue || 0) / 50)) },
        { label: 'Pending Appointments', value: pendingAppointments.length, icon: 'PA', trend: pendingAppointments.length > 0 ? -3 : 0, detail: 'need confirmation', accent: pendingAppointments.length > 0 ? 'yellow' : 'green', sparkline: makeSparkline(pendingAppointments.length) },
        { label: 'Repeat Customers', value: appointments.repeatCustomers || 0, icon: 'RC', trend: appointments.repeatCustomers > 0 ? 9 : 0, detail: 'booked more than once', accent: 'blue', sparkline: makeSparkline(appointments.repeatCustomers || 0) },
        { label: 'QR Walk-ins', value: appointments.qrWalkIns || 0, icon: 'QR', trend: checkedInBookings > 0 ? 7 : 0, detail: 'checked in today', accent: 'blue', sparkline: makeSparkline(checkedInBookings) },
        { label: 'Promo Redemptions', value: appointments.loyaltyRedemptions || 0, icon: 'PR', trend: appointments.loyaltyRedemptions > 0 ? 5 : 0, detail: 'real promotion uses', accent: 'green', sparkline: makeSparkline(appointments.loyaltyRedemptions || 0) }
    ];
    const statusLabels = {
        pending: 'pending',
        confirmed: 'confirmed',
        paid: 'paid',
        checked_in: 'checked-in',
        completed: 'completed',
        cancelled: 'cancelled',
        no_show: 'no-show'
    };
    const merchantReviews = typeof reviews !== 'undefined' && Array.isArray(reviews) ? reviews : [];
    const merchantReviewSummary = typeof reviewSummary !== 'undefined' && reviewSummary
        ? reviewSummary
        : { reviewCount: 0, averageRating: null };
    const renderReviewStars = (rating) => '&#9733;'.repeat(Math.round(Number(rating || 0))) + '&#9734;'.repeat(Math.max(0, 5 - Math.round(Number(rating || 0))));
    const merchantTabAlerts = {
        dashboard: pendingCheckIns + (validationReport?.issues?.length || 0),
        calendar: pendingAppointments.length + pendingRescheduleReviews.length,
        insights: Math.max(0, Number(customerInsights.repeatCustomers || 0)),
        inventory: lowStockProducts.length,
        reviews: merchantReviews.length
    };
    const merchantChartPayload = {
        salesLabels: (salesReport?.dailySales || []).map((day) => day.label),
        salesRevenue: (salesReport?.dailySales || []).map((day) => Number(day.revenue || 0)),
        salesOrders: (salesReport?.dailySales || []).map((day) => Number(day.orders || 0)),
        ageLabels: customerInsights.chartPayload.ageLabels,
        ageValues: customerInsights.chartPayload.ageValues,
        genderLabels: customerInsights.chartPayload.genderLabels,
        genderValues: customerInsights.chartPayload.genderValues,
        serviceLabels: customerInsights.chartPayload.serviceLabels,
        serviceValues: customerInsights.chartPayload.serviceValues,
        hourLabels: customerInsights.chartPayload.hourLabels,
        hourValues: customerInsights.chartPayload.hourValues
    };
%>

<section class="section compact merchant-analytics-page merchant-appointment-dashboard">
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <div class="merchant-analytics-shell">
        <header class="merchant-dashboard-hero">
            <div>
                <p class="eyebrow">Merchant Dashboard</p>
                <h1><%= merchant.name %></h1>
                <span>Operational command center for bookings, revenue, customers, and alerts.</span>
            </div>
            <div class="merchant-hero-actions">
                <a class="button primary" href="/merchant/bookings">View appointments</a>
                <a class="button secondary" href="/merchant/services/new">Add service</a>
                <a class="button secondary" href="/merchant/promotions/new">Create promotion</a>
            </div>
        </header>

        <% if (databaseError) { %>
            <div class="notice error">
                <p>Some database records could not be loaded, so appointment reporting may be incomplete.</p>
            </div>
        <% } %>

        <section class="merchant-dashboard-panel is-active" id="merchant-overview">
            <section class="merchant-kpi-grid" aria-label="Merchant appointment summary">
                <% kpiCards.forEach((card) => { %>
                    <article class="merchant-kpi-card accent-<%= card.accent %>">
                        <div class="merchant-kpi-top">
                            <span class="merchant-kpi-icon"><%= card.icon %></span>
                            <span class="merchant-kpi-trend <%= Number(card.trend) >= 0 ? 'positive' : 'negative' %>">
                                <%= Number(card.trend) >= 0 ? '+' : '' %><%= card.trend %>%
                            </span>
                        </div>
                        <span><%= card.label %></span>
                        <strong><%= card.value %></strong>
                        <small><%= card.detail %></small>
                        <div class="merchant-kpi-sparkline" aria-hidden="true">
                            <% card.sparkline.forEach((point) => { %>
                                <i style="height:<%= Math.max(8, Math.min(point, 100)) %>%"></i>
                            <% }) %>
                        </div>
                    </article>
                <% }) %>
            </section>

            <section class="merchant-payout-summary-grid" aria-label="Merchant payout summary">
                <article class="merchant-payout-summary-card">
                    <span>Gross sales</span>
                    <strong>$<%= formatCurrency(payoutSummary.grossOrderSales) %></strong>
                    <small>Paid product orders before commission</small>
                </article>
                <article class="merchant-payout-summary-card">
                    <span>Commission deducted</span>
                    <strong>$<%= formatCurrency(payoutSummary.totalCommissionDeducted) %></strong>
                    <small>Platform fee based on your admin-set rate</small>
                </article>
                <article class="merchant-payout-summary-card">
                    <span>Net payout</span>
                    <strong>$<%= formatCurrency(payoutSummary.totalNetPayout) %></strong>
                    <small>Estimated amount remaining after commission</small>
                </article>
            </section>

            <section class="merchant-insight-grid" id="merchant-reschedules">
                <article class="merchant-chart-card span-8">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Reschedule Automation</p>
                            <h2>AI-assisted review queue</h2>
                        </div>
                        <span class="merchant-data-pill"><%= autoApprovedReschedules.length %> auto-approved</span>
                    </div>

                    <% if (!pendingRescheduleReviews.length) { %>
                        <p class="muted">No reschedule requests need manual review.</p>
                    <% } else { %>
                        <div class="merchant-appointment-list">
                            <% pendingRescheduleReviews.slice(0, 4).forEach((request) => { %>
                                <article>
                                    <span class="merchant-status-badge status-pending"><%= request.confidenceLevel %> confidence</span>
                                    <div>
                                        <strong><%= request.customerName %></strong>
                                        <small><%= request.serviceName %> - <%= String(request.oldBookingDate).slice(0, 10) %> <%= request.oldBookingTime || '' %> to <%= String(request.requestedBookingDate).slice(0, 10) %> at <%= request.requestedBookingTime %></small>
                                        <small><%= request.decisionReason || 'Merchant review recommended.' %></small>
                                    </div>
                                    <div class="merchant-booking-actions">
                                        <form action="/merchant/reschedule-requests/<%= request.id %>/review" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                            <input type="hidden" name="action" value="approve">
                                            <button class="button secondary" type="submit">Approve</button>
                                        </form>
                                        <form action="/merchant/reschedule-requests/<%= request.id %>/review" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                            <input type="hidden" name="action" value="reject">
                                            <button class="button secondary danger-button" type="submit">Reject</button>
                                        </form>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>
                </article>

                <article class="merchant-chart-card span-4">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Scheduling Signals</p>
                            <h2>Recommendations</h2>
                        </div>
                    </div>
                    <div class="merchant-alert-list">
                        <% rescheduleRecommendations.forEach((recommendation) => { %>
                            <p><%= recommendation %></p>
                        <% }) %>
                    </div>
                </article>
            </section>

            <section class="merchant-insight-grid" id="merchant-analytics">
                <article class="merchant-chart-card span-8">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Sales Analytics</p>
                            <h2>Revenue and orders</h2>
                        </div>
                        <span class="merchant-data-pill">7 days</span>
                    </div>
                    <div class="merchant-chart-box"><canvas id="merchantSalesChart"></canvas></div>
                </article>
                <article class="merchant-chart-card span-4">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Customer Signal</p>
                            <h2>Smart recommendation</h2>
                        </div>
                    </div>
                    <div class="merchant-insight-callout">
                        <strong><%= customerInsights.topServiceName %></strong>
                        <span>Peak demand: <%= customerInsights.peakHour %></span>
                        <p><%= customerInsights.suggestedFocus %></p>
                    </div>
                </article>
                <article class="merchant-chart-card span-6">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Customer Insights</p>
                            <h2>Age segments</h2>
                        </div>
                    </div>
                    <div class="merchant-chart-box small"><canvas id="merchantAgeChart"></canvas></div>
                </article>
                <article class="merchant-chart-card span-6">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Customer Insights</p>
                            <h2>Gender mix</h2>
                        </div>
                    </div>
                    <div class="merchant-chart-box small"><canvas id="merchantGenderChart"></canvas></div>
                </article>
                <article class="merchant-chart-card span-6">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Customer Demand</p>
                            <h2>Top services</h2>
                        </div>
                    </div>
                    <div class="merchant-chart-box small"><canvas id="merchantServiceChart"></canvas></div>
                </article>
                <article class="merchant-chart-card span-6">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Customer Timing</p>
                            <h2>Booking hours</h2>
                        </div>
                    </div>
                    <div class="merchant-chart-box small"><canvas id="merchantHourChart"></canvas></div>
                </article>
            </section>

            <div class="merchant-dashboard-lower-grid merchant-appointment-lower-grid">
                <section class="merchant-orders-card">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Upcoming</p>
                            <h2>Upcoming bookings</h2>
                        </div>
                        <span><%= upcomingBookings.length %> shown</span>
                    </div>

                    <% if (!upcomingBookings.length) { %>
                        <div class="merchant-empty-state">
                            <span>BK</span>
                            <strong>No upcoming bookings</strong>
                            <a class="text-button" href="/merchant/services">Review services</a>
                        </div>
                    <% } else { %>
                        <div class="merchant-appointment-list">
                            <% upcomingBookings.forEach((booking) => { %>
                                <article>
                                    <span class="merchant-status-badge status-<%= booking.status %>"><%= statusLabels[booking.status] || booking.status %></span>
                                    <div>
                                        <strong><%= booking.customerName %></strong>
                                        <small><%= booking.serviceName %> - <%= booking.bookingDate %> at <%= booking.bookingTime || 'Time TBC' %></small>
                                        <small>Age: <%= booking.customerAge || 'Not set' %> | Birthday: <%= booking.customerBirthday || 'Not set' %> | Gender: <%= booking.customerGender || 'Not set' %></small>
                                        <small><%= booking.customerPhone || booking.customerEmail || 'Contact not set' %></small>
                                    </div>
                                    <em><%= ['checked_in', 'completed'].includes(booking.status) ? 'QR checked' : 'QR pending' %></em>
                                    <div class="merchant-booking-actions">
                                        <% if (['pending', 'paid'].includes(booking.status)) { %>
                                            <form action="/merchant/bookings/<%= booking.id %>/status" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <input type="hidden" name="status" value="confirmed">
                                                <button class="button secondary" type="submit">Approve</button>
                                            </form>
                                        <% } %>
                                        <% if (['pending', 'confirmed', 'paid'].includes(booking.status)) { %>
                                            <form action="/merchant/bookings/<%= booking.id %>/status" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <input type="hidden" name="status" value="cancelled">
                                                <button class="button secondary danger-button" type="submit">Reject</button>
                                            </form>
                                        <% } %>
                                        <% if (['confirmed', 'paid', 'checked_in'].includes(booking.status)) { %>
                                            <form action="/merchant/bookings/<%= booking.id %>/status" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <input type="hidden" name="status" value="completed">
                                                <button class="button secondary" type="submit">Complete</button>
                                            </form>
                                        <% } %>
                                        <% if (!['cancelled', 'completed', 'checked_in'].includes(booking.status)) { %>
                                            <form action="/merchant/bookings/<%= booking.id %>/status" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <input type="hidden" name="status" value="no_show">
                                                <button class="button secondary" type="submit">No-show</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>
                </section>

                <section class="merchant-alert-card">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Scan to Book</p>
                            <h2>Storefront booking QR</h2>
                        </div>
                        <div class="merchant-inline-actions">
                            <form action="/merchant/generate-qr" method="POST">
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <button class="text-button" type="submit">Generate storefront QR</button>
                            </form>
                            <% if (qrBookingUrl) { %>
                                <a class="text-button" href="<%= qrBookingUrl %>">Open booking link</a>
                            <% } else if (merchant.id) { %>
                                <a class="text-button" href="/merchants/<%= merchant.id %>/qr">View QR page</a>
                            <% } %>
                        </div>
                    </div>
                    <div class="merchant-checkin-metrics">
                        <p><span>Storefront walk-ins</span><strong><%= appointments.qrWalkIns || 0 %></strong></p>
                        <p><span>Checked-in/completed</span><strong><%= checkedInBookings %></strong></p>
                        <p><span>Pending check-ins</span><strong><%= pendingCheckIns %></strong></p>
                    </div>
                    <p class="muted">Customers can scan this QR to book directly from your storefront.</p>
                    <% if (storefrontQrImage && qrBookingUrl) { %>
                        <a class="qr-code-link" href="<%= qrBookingUrl %>" aria-label="Open storefront booking page">
                            <img class="qr-code" src="<%= storefrontQrImage %>" alt="Merchant QR">
                        </a>
                        <p class="muted qr-link-wrap"><%= qrBookingUrl %></p>
                        <div class="merchant-inline-actions">
                            <a class="button secondary" href="<%= storefrontQrImage %>" download="vaniday-storefront-qr.png">Download QR</a>
                            <button class="button secondary" type="button" onclick="window.print()">Print QR</button>
                        </div>
                        <% if (qrDebug) { %>
                            <div class="qr-debug-panel">
                                <p class="eyebrow">QR Debug</p>
                                <p class="muted"><strong>System:</strong> <%= qrDebug.system %> / <%= qrDebug.label %></p>
                                <p class="muted"><strong>Token:</strong> <%= qrDebug.token %></p>
                                <p class="muted"><strong>Route target:</strong> <%= qrDebug.routeTarget %></p>
                            </div>
                        <% } %>
                    <% } else { %>
                        <p class="muted">Generate your permanent Scan to Book QR for walk-in customers and in-store booking displays.</p>
                    <% } %>
                </section>
            </div>

            <section class="merchant-alert-card <%= validationReport.issues.length > 0 ? 'needs-review' : '' %>">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Merchant Health</p>
                        <h2><%= validationReport.status %></h2>
                    </div>
                </div>
                <% if (!validationReport.issues.length) { %>
                    <p class="muted">Your merchant setup looks complete.</p>
                <% } else { %>
                    <div class="merchant-alert-list">
                        <% validationReport.issues.forEach((issue) => { %>
                            <p><%= issue %></p>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </section>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (() => {
        const chartPayload = <%- JSON.stringify(merchantChartPayload) %>;
        const chartPalette = {
            green: '#4f6847',
            blue: '#20899c',
            orange: '#df7c16',
            yellow: '#d4a017',
            red: '#a64032'
        };
        const merchantCharts = [];
        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 650 },
            plugins: { legend: { labels: { boxWidth: 10, usePointStyle: true } } },
            scales: {
                x: { grid: { display: false } },
                y: { beginAtZero: true, grid: { color: 'rgba(79, 104, 71, 0.12)' } }
            }
        };
        const makeChart = (id, config) => {
            const canvas = document.getElementById(id);
            if (!canvas || typeof Chart === 'undefined') return null;
            const chart = new Chart(canvas, config);
            merchantCharts.push(chart);
            return chart;
        };

        makeChart('merchantSalesChart', {
            type: 'line',
            data: {
                labels: chartPayload.salesLabels,
                datasets: [
                    { label: 'Revenue', data: chartPayload.salesRevenue, borderColor: chartPalette.green, backgroundColor: 'rgba(79, 104, 71, 0.12)', tension: 0.35, fill: true },
                    { label: 'Orders', data: chartPayload.salesOrders, borderColor: chartPalette.blue, backgroundColor: 'rgba(32, 137, 156, 0.1)', tension: 0.35, fill: true }
                ]
            },
            options: chartOptions
        });

        makeChart('merchantAgeChart', {
            type: 'bar',
            data: {
                labels: chartPayload.ageLabels,
                datasets: [
                    {
                        label: 'Customers',
                        data: chartPayload.ageValues,
                        borderColor: chartPalette.green,
                        backgroundColor: 'rgba(79, 104, 71, 0.32)',
                        borderWidth: 1
                    }
                ]
            },
            options: chartOptions
        });

        makeChart('merchantGenderChart', {
            type: 'doughnut',
            data: {
                labels: chartPayload.genderLabels,
                datasets: [
                    {
                        data: chartPayload.genderValues,
                        backgroundColor: [
                            chartPalette.green,
                            chartPalette.blue,
                            chartPalette.orange,
                            chartPalette.yellow,
                            chartPalette.red
                        ]
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 650 },
                plugins: chartOptions.plugins
            }
        });

        makeChart('merchantServiceChart', {
            type: 'bar',
            data: {
                labels: chartPayload.serviceLabels,
                datasets: [
                    {
                        label: 'Bookings',
                        data: chartPayload.serviceValues,
                        borderColor: chartPalette.blue,
                        backgroundColor: 'rgba(32, 137, 156, 0.28)',
                        borderWidth: 1
                    }
                ]
            },
            options: { ...chartOptions, indexAxis: 'y' }
        });

        makeChart('merchantHourChart', {
            type: 'line',
            data: {
                labels: chartPayload.hourLabels,
                datasets: [
                    {
                        label: 'Bookings',
                        data: chartPayload.hourValues,
                        borderColor: chartPalette.orange,
                        backgroundColor: 'rgba(223, 124, 22, 0.16)',
                        tension: 0.35,
                        fill: true
                    }
                ]
            },
            options: chartOptions
        });
    })();
</script>

<%- include('partials/footer') %>
