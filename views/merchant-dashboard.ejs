<%- include('partials/header', { title }) %>

<%
    const appointments = typeof appointmentReport !== 'undefined' && appointmentReport ? appointmentReport : {};
    const todayBookings = appointments.todayBookings || [];
    const upcomingBookings = appointments.upcomingBookings || [];
    const pendingAppointments = appointments.pendingAppointments || [];
    const weekDays = appointments.weekDays || [];
    const monthView = appointments.monthView || { label: '', days: [] };
    const allCalendarBookings = appointments.allBookings || [];
    const rescheduleTools = typeof rescheduleAutomation !== 'undefined' && rescheduleAutomation ? rescheduleAutomation : {};
    const rescheduleSettings = rescheduleTools.settings || {
        autoApproveEnabled: 1,
        autoApproveBookings: 1,
        minimumNoticeHours: 24,
        maxReschedulesAllowed: 2,
        blockedTimes: '',
        peakHourRestrictions: 1,
        businessStart: '09:00',
        businessEnd: '20:00'
    };
    const autoApprovedReschedules = Array.isArray(rescheduleTools.autoApproved) ? rescheduleTools.autoApproved : [];
    const pendingRescheduleReviews = Array.isArray(rescheduleTools.pendingReviews) ? rescheduleTools.pendingReviews : [];
    const rescheduleRecommendations = Array.isArray(rescheduleTools.recommendations) ? rescheduleTools.recommendations : [];
    const refunds = typeof refundStats !== 'undefined' && refundStats ? refundStats : {
        pendingCount: 0,
        approvedCount: 0,
        processingCount: 0,
        refundedCount: 0,
        rejectedCount: 0,
        failedCount: 0
    };
    const storefrontQrImage = typeof qrImage !== 'undefined' && qrImage ? qrImage : (typeof qrCodeDataUrl !== 'undefined' ? qrCodeDataUrl : null);
    const serviceFilterOptions = [...new Set(allCalendarBookings.map((booking) => booking.serviceName).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const recentOrders = salesReport?.recentOrders || [];
    const lowStockProducts = salesReport?.lowStockProducts || [];
    const customerInsights = customerReport?.insights || {
        totalCustomers: 0,
        repeatCustomers: 0,
        repeatRate: 0,
        averageVisits: 0,
        averageCustomerValue: 0,
        topCustomers: [],
        suggestedFocus: 'Customer patterns will appear after more bookings.',
        topServiceName: 'No service',
        peakHour: 'No bookings',
        chartPayload: {
            ageLabels: ['Not set'],
            ageValues: [0],
            genderLabels: ['Not set'],
            genderValues: [0],
            contactMethodLabels: ['Not set'],
            contactMethodValues: [0],
            postalDistrictLabels: ['Not set'],
            postalDistrictValues: [0],
            serviceLabels: ['No service'],
            serviceValues: [0],
            hourLabels: ['No bookings'],
            hourValues: [0]
        }
    };
    const payoutSummary = salesReport?.payoutSummary || {
        grossOrderSales: 0,
        totalCommissionDeducted: 0,
        totalNetPayout: 0
    };
    const formatCurrency = (value) => Number(value || 0).toFixed(2);
    const approvalStatus = merchant.approvalStatus || merchant.approval_status || 'approved';
    const approvalLabel = String(approvalStatus).replace(/_/g, ' ');
    const merchantInitials = String(merchant.name || merchant.salonName || merchant.salon_name || 'Vaniday')
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part[0])
        .join('')
        .toUpperCase() || 'VD';
    const merchantLogo = merchant.logo || merchant.logoUrl || merchant.logo_url || merchant.image || merchant.imageUrl || merchant.image_url || null;
    const totalBookings = Number(stats.bookingCount || 0);
    const checkedInBookings = (appointments.allBookings || []).filter((booking) => ['checked_in', 'completed'].includes(booking.status)).length;
    const pendingCheckIns = Math.max(0, totalBookings - checkedInBookings);
    const rewardRedemptions = appointments.rewardRedemptions || {};
    const trendBase = Math.max(totalBookings, 1);
    const makeSparkline = (seed) => [18, 28, 22, 36, 30, 44, 38].map((value, index) => Math.min(100, value + (seed * 3) + index));
    const activePromotions = Array.isArray(promotions)
        ? promotions.filter((promotion) => ['active', 'approved'].includes(String(promotion.status || 'active').toLowerCase())).length
        : Number(stats.promotionCount || 0);
    const kpiCards = [
        { label: "Today's Bookings", value: todayBookings.length, icon: 'B', trend: todayBookings.length > 0 ? 12 : 0, detail: 'scheduled today', accent: 'green', sparkline: makeSparkline(todayBookings.length) },
        { label: 'Monthly Revenue', value: '$' + formatCurrency(appointments.monthlyRevenue || 0), icon: '$', trend: Number(stats.growthPercent || 0).toFixed(1), detail: 'vs recent sales', accent: 'orange', sparkline: makeSparkline(Math.round((appointments.monthlyRevenue || 0) / 50)) },
        { label: 'Customers Served', value: stats.customerCount || 0, icon: 'C', trend: appointments.repeatCustomers > 0 ? 9 : 0, detail: `${appointments.repeatCustomers || 0} repeat customers`, accent: 'blue', sparkline: makeSparkline(appointments.repeatCustomers || 0) },
        { label: 'Active Promotions', value: activePromotions, icon: 'P', trend: activePromotions > 0 ? 5 : 0, detail: `${stats.promotionCount || 0} total campaigns`, accent: 'yellow', sparkline: makeSparkline(activePromotions) },
        { label: 'Pending Refunds', value: refunds.pendingCount || 0, icon: 'F', trend: (refunds.failedCount || 0) > 0 ? -5 : 0, detail: `${refunds.processingCount || 0} processing, ${refunds.failedCount || 0} failed`, accent: 'orange', sparkline: makeSparkline(refunds.pendingCount || 0) },
        { label: 'Products Sold', value: recentOrders.reduce((sum, order) => sum + Number(order.itemCount || 0), 0), icon: 'S', trend: recentOrders.length > 0 ? 7 : 0, detail: `${recentOrders.length} recent paid orders`, accent: 'blue', sparkline: makeSparkline(recentOrders.length) },
        { label: 'Reward Bookings', value: rewardRedemptions.rewardBookingCount || 0, icon: 'R', trend: rewardRedemptions.rewardBookingCount > 0 ? 5 : 0, detail: 'used loyalty or rewards', accent: 'green', sparkline: makeSparkline(rewardRedemptions.rewardBookingCount || 0) }
    ];
    const statusLabels = {
        pending: 'pending',
        confirmed: 'confirmed',
        paid: 'paid',
        checked_in: 'checked-in',
        completed: 'completed',
        cancelled: 'cancelled',
        no_show: 'no-show'
    };
    const deliveryStatusLabels = {
        processing: 'processing',
        pending_pickup: 'pending pickup',
        shipped: 'shipped',
        delivered: 'delivered',
        picked_up: 'picked up',
        cancelled: 'cancelled'
    };
    const formatOrderDate = (value) => {
        if (!value) return 'Date unavailable';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return String(value).slice(0, 10);
        return date.toLocaleDateString('en-SG', { day: '2-digit', month: 'short', year: 'numeric' });
    };
    const merchantReviews = typeof reviews !== 'undefined' && Array.isArray(reviews) ? reviews : [];
    const merchantReviewSummary = typeof reviewSummary !== 'undefined' && reviewSummary
        ? reviewSummary
        : { reviewCount: 0, averageRating: null };
    const renderReviewStars = (rating) => '&#9733;'.repeat(Math.round(Number(rating || 0))) + '&#9734;'.repeat(Math.max(0, 5 - Math.round(Number(rating || 0))));
    const merchantTabAlerts = {
        dashboard: pendingCheckIns + (validationReport?.issues?.length || 0),
        calendar: pendingAppointments.length + pendingRescheduleReviews.length,
        insights: Math.max(0, Number(customerInsights.repeatCustomers || 0)),
        inventory: lowStockProducts.length,
        reviews: merchantReviews.length
    };
    const merchantChartPayload = {
        salesLabels: (salesReport?.dailySales || []).map((day) => day.label),
        salesRevenue: (salesReport?.dailySales || []).map((day) => Number(day.revenue || 0)),
        salesOrders: (salesReport?.dailySales || []).map((day) => Number(day.orders || 0)),
        ageLabels: customerInsights.chartPayload.ageLabels,
        ageValues: customerInsights.chartPayload.ageValues,
        genderLabels: customerInsights.chartPayload.genderLabels,
        genderValues: customerInsights.chartPayload.genderValues,
        serviceLabels: customerInsights.chartPayload.serviceLabels,
        serviceValues: customerInsights.chartPayload.serviceValues,
        hourLabels: customerInsights.chartPayload.hourLabels,
        hourValues: customerInsights.chartPayload.hourValues
    };
%>

<section class="section compact merchant-analytics-page merchant-appointment-dashboard">
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <div class="merchant-analytics-shell">
        <header class="merchant-dashboard-hero merchant-command-hero">
            <div class="merchant-command-profile">
                <div class="merchant-command-logo" aria-hidden="true">
                    <% if (merchantLogo) { %>
                        <img src="<%= merchantLogo %>" alt="">
                    <% } else { %>
                        <span><%= merchantInitials %></span>
                    <% } %>
                </div>
                <div>
                    <p class="eyebrow">Merchant Dashboard</p>
                    <h1><%= merchant.name %></h1>
                    <span>Manage bookings, sales, promotions, and customer signals from one polished workspace.</span>
                    <div class="merchant-command-meta">
                        <span class="merchant-approval-badge status-<%= approvalStatus %>"><%= approvalLabel %></span>
                        <span><%= stats.serviceCount || 0 %> services</span>
                        <span><%= stats.productCount || 0 %> products</span>
                        <span><%= activePromotions %> active promotions</span>
                    </div>
                </div>
            </div>
            <div class="merchant-hero-actions">
                <a class="button primary" href="/merchant/bookings">View appointments</a>
                <a class="button secondary" href="/merchant/services/new">Add service</a>
                <a class="button secondary" href="/merchant/products/new">Add product</a>
                <a class="button secondary" href="/merchant/promotions/new">Create promotion</a>
            </div>
        </header>

        <% if (databaseError) { %>
            <div class="notice error">
                <p>Some database records could not be loaded, so appointment reporting may be incomplete.</p>
            </div>
        <% } %>

        <section class="merchant-dashboard-panel is-active" id="merchant-overview">
            <section class="merchant-kpi-grid" aria-label="Merchant appointment summary">
                <% kpiCards.forEach((card) => { %>
                    <article class="merchant-kpi-card accent-<%= card.accent %>">
                        <div class="merchant-kpi-top">
                            <span class="merchant-kpi-icon"><%= card.icon %></span>
                            <span class="merchant-kpi-trend <%= Number(card.trend) >= 0 ? 'positive' : 'negative' %>">
                                <%= Number(card.trend) >= 0 ? '+' : '' %><%= card.trend %>%
                            </span>
                        </div>
                        <span><%= card.label %></span>
                        <strong><%= card.value %></strong>
                        <small><%= card.detail %></small>
                        <div class="merchant-kpi-sparkline" aria-hidden="true">
                            <% card.sparkline.forEach((point) => { %>
                                <i style="height:<%= Math.max(8, Math.min(point, 100)) %>%"></i>
                            <% }) %>
                        </div>
                    </article>
                <% }) %>
            </section>

            <section class="merchant-payout-summary-grid merchant-executive-strip" aria-label="Merchant payout summary">
                <article class="merchant-payout-summary-card">
                    <span>Gross sales</span>
                    <strong>$<%= formatCurrency(payoutSummary.grossOrderSales) %></strong>
                    <small>Paid product orders before commission</small>
                </article>
                <article class="merchant-payout-summary-card">
                    <span>Commission deducted</span>
                    <strong>$<%= formatCurrency(payoutSummary.totalCommissionDeducted) %></strong>
                    <small>Platform fee based on your admin-set rate</small>
                </article>
                <article class="merchant-payout-summary-card">
                    <span>Net payout</span>
                    <strong>$<%= formatCurrency(payoutSummary.totalNetPayout) %></strong>
                    <small>Estimated amount remaining after commission</small>
                </article>
            </section>

            <section class="merchant-product-orders-panel">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Product Orders</p>
                        <h2>Recent paid orders</h2>
                    </div>
                    <a class="text-button" href="/merchant/orders"><%= recentOrders.length %> shown · manage all</a>
                </div>

                <% if (!recentOrders.length) { %>
                    <div class="merchant-empty-state">
                        <span>PO</span>
                        <strong>No product orders yet</strong>
                        <a class="text-button" href="/merchant/products">Review product catalogue</a>
                    </div>
                <% } else { %>
                    <div class="merchant-product-order-list">
                        <% recentOrders.forEach((order) => { %>
                            <article class="merchant-product-order-card">
                                <div class="merchant-product-order-main">
                                    <div>
                                        <span class="merchant-order-id">Order <%= order.order_number || order.orderNumber || ('#' + order.id) %></span>
                                        <strong><%= order.customerName || 'Customer' %></strong>
                                        <small><%= formatOrderDate(order.createdAt) %> · <%= order.paymentMethod || 'Payment' %></small>
                                    </div>
                                    <div class="merchant-product-order-amount">
                                        <strong>$<%= formatCurrency(order.grossAmount || order.totalAmount) %></strong>
                                        <small>Net $<%= formatCurrency(order.payoutAmount || order.totalAmount) %></small>
                                    </div>
                                    <span class="merchant-status-badge status-<%= String(order.deliveryStatus || 'processing').replace(/\s+/g, '_') %>">
                                        <%= deliveryStatusLabels[String(order.deliveryStatus || 'processing')] || order.deliveryStatus || 'processing' %>
                                    </span>
                                </div>
                                <div class="merchant-product-order-items">
                                    <% (order.items || []).forEach((item) => { %>
                                        <p>
                                            <span><%= item.name %></span>
                                            <strong>x<%= item.quantity %></strong>
                                            <em>$<%= formatCurrency(item.lineTotal) %></em>
                                        </p>
                                    <% }) %>
                                </div>
                                <div class="merchant-product-order-footer">
                                    <span><%= order.itemCount %> item<%= Number(order.itemCount || 0) === 1 ? '' : 's' %></span>
                                    <span>Commission $<%= formatCurrency(order.commissionAmount) %></span>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <section class="merchant-insight-grid">
                <article class="merchant-chart-card span-4">
                    <div class="merchant-card-heading"><div><p class="eyebrow">Bookings</p><h2>Needs attention</h2></div></div>
                    <div class="merchant-checkin-metrics">
                        <p><span>Pending approvals</span><strong><%= pendingAppointments.length %></strong></p>
                        <p><span>Reschedule reviews</span><strong><%= pendingRescheduleReviews.length %></strong></p>
                        <p><span>Auto-approved</span><strong><%= autoApprovedReschedules.length %></strong></p>
                    </div>
                    <a class="text-button" href="/merchant/bookings">Open booking operations</a>
                </article>
                <article class="merchant-chart-card span-4">
                    <div class="merchant-card-heading"><div><p class="eyebrow">Customers</p><h2>Current signal</h2></div></div>
                    <div class="merchant-insight-callout">
                        <strong><%= customerInsights.topServiceName %></strong>
                        <span>Peak demand: <%= customerInsights.peakHour %></span>
                        <p><%= customerInsights.suggestedFocus %></p>
                    </div>
                    <a class="text-button" href="/merchant/customers">Open customer insights</a>
                </article>
                <article class="merchant-chart-card span-4">
                    <div class="merchant-card-heading"><div><p class="eyebrow">Analytics</p><h2>Performance</h2></div></div>
                    <div class="merchant-checkin-metrics">
                        <p><span>Revenue growth</span><strong><%= Number(stats.growthPercent || 0).toFixed(1) %>%</strong></p>
                        <p><span>Reward bookings</span><strong><%= rewardRedemptions.rewardBookingCount || 0 %></strong></p>
                        <p><span>Redeemed value</span><strong>$<%= formatCurrency(rewardRedemptions.totalRedeemedValue || 0) %></strong></p>
                        <p><span>Average order</span><strong>$<%= formatCurrency(stats.averageOrderValue) %></strong></p>
                    </div>
                    <a class="text-button" href="/merchant/analytics">Open analytics</a>
                </article>
            </section>

            <div class="merchant-dashboard-lower-grid merchant-appointment-lower-grid">
                <section class="merchant-orders-card">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Upcoming</p>
                            <h2>Upcoming bookings</h2>
                        </div>
                        <span><%= upcomingBookings.length %> shown</span>
                    </div>

                    <% if (!upcomingBookings.length) { %>
                        <div class="merchant-empty-state">
                            <span>BK</span>
                            <strong>No upcoming bookings</strong>
                            <a class="text-button" href="/merchant/services">Review services</a>
                        </div>
                    <% } else { %>
                        <div class="merchant-appointment-list">
                            <% upcomingBookings.forEach((booking) => { %>
                                <article>
                                    <span class="merchant-status-badge status-<%= booking.status %>"><%= statusLabels[booking.status] || booking.status %></span>
                                    <div>
                                        <strong><%= booking.customerName %></strong>
                                        <small><%= booking.serviceName %> - <%= booking.bookingDate %> at <%= booking.bookingTime || 'Time TBC' %></small>
                                        <small>Age: <%= booking.customerAge || 'Not set' %> | Birthday: <%= booking.customerBirthday || 'Not set' %> | Gender: <%= booking.customerGender || 'Not set' %></small>
                                        <small><%= booking.customerPreferredContactMethod || 'Contact preference not set' %> | Postal: <%= booking.customerPostalCode || 'Not set' %></small>
                                        <small><%= booking.customerPhone || booking.customerEmail || 'Contact not set' %></small>
                                    </div>
                                    <em><%= ['checked_in', 'completed'].includes(booking.status) ? 'QR checked' : 'QR pending' %></em>
                                </article>
                            <% }) %>
                        </div>
                        <a class="text-button" href="/merchant/bookings">Manage appointments</a>
                    <% } %>
                </section>

                <section class="merchant-alert-card">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Scan to Book</p>
                            <h2>Storefront booking QR</h2>
                        </div>
                        <div class="merchant-inline-actions">
                            <a class="text-button" href="/merchant/profile">Manage QR tools</a>
                        </div>
                    </div>
                    <div class="merchant-checkin-metrics">
                        <p><span>Storefront walk-ins</span><strong><%= appointments.qrWalkIns || 0 %></strong></p>
                        <p><span>Checked-in/completed</span><strong><%= checkedInBookings %></strong></p>
                        <p><span>Pending check-ins</span><strong><%= pendingCheckIns %></strong></p>
                    </div>
                    <p class="muted">QR setup and downloads now live in Profile so this dashboard stays focused on daily performance.</p>
                </section>
            </div>

            <section class="merchant-alert-card <%= validationReport.issues.length > 0 ? 'needs-review' : '' %>">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Merchant Health</p>
                        <h2><%= validationReport.status %></h2>
                    </div>
                </div>
                <% if (!validationReport.issues.length) { %>
                    <p class="muted">Your merchant setup looks complete.</p>
                <% } else { %>
                    <div class="merchant-alert-list">
                        <% validationReport.issues.forEach((issue) => { %>
                            <p><%= issue %></p>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </section>
    </div>
</section>

<%- include('partials/footer') %>
