<%- include('partials/header', { title }) %>

<%
    const appointments = typeof appointmentReport !== 'undefined' && appointmentReport ? appointmentReport : {};
    const todayBookings = appointments.todayBookings || [];
    const upcomingBookings = appointments.upcomingBookings || [];
    const pendingAppointments = appointments.pendingAppointments || [];
    const weekDays = appointments.weekDays || [];
    const monthView = appointments.monthView || { label: '', days: [] };
    const allCalendarBookings = appointments.allBookings || [];
    const serviceFilterOptions = [...new Set(allCalendarBookings.map((booking) => booking.serviceName).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const recentOrders = salesReport?.recentOrders || [];
    const lowStockProducts = salesReport?.lowStockProducts || [];
    const formatCurrency = (value) => Number(value || 0).toFixed(2);
    const totalBookings = Number(stats.bookingCount || 0);
    const checkedInBookings = (appointments.allBookings || []).filter((booking) => ['checked_in', 'completed'].includes(booking.status)).length;
    const pendingCheckIns = Math.max(0, totalBookings - checkedInBookings);
    const trendBase = Math.max(totalBookings, 1);
    const makeSparkline = (seed) => [18, 28, 22, 36, 30, 44, 38].map((value, index) => Math.min(100, value + (seed * 3) + index));
    const kpiCards = [
        { label: "Today's Bookings", value: todayBookings.length, icon: 'TB', trend: todayBookings.length > 0 ? 12 : 0, detail: 'scheduled today', accent: 'green', sparkline: makeSparkline(todayBookings.length) },
        { label: 'Monthly Revenue', value: '$' + formatCurrency(appointments.monthlyRevenue || 0), icon: '$', trend: Number(stats.growthPercent || 0).toFixed(1), detail: 'vs last 7 days', accent: 'orange', sparkline: makeSparkline(Math.round((appointments.monthlyRevenue || 0) / 50)) },
        { label: 'Pending Appointments', value: pendingAppointments.length, icon: 'PA', trend: pendingAppointments.length > 0 ? -3 : 0, detail: 'need confirmation', accent: pendingAppointments.length > 0 ? 'yellow' : 'green', sparkline: makeSparkline(pendingAppointments.length) },
        { label: 'Repeat Customers', value: appointments.repeatCustomers || 0, icon: 'RC', trend: appointments.repeatCustomers > 0 ? 9 : 0, detail: 'booked more than once', accent: 'blue', sparkline: makeSparkline(appointments.repeatCustomers || 0) },
        { label: 'QR Walk-ins', value: appointments.qrWalkIns || 0, icon: 'QR', trend: checkedInBookings > 0 ? 7 : 0, detail: 'checked in today', accent: 'blue', sparkline: makeSparkline(checkedInBookings) },
        { label: 'Loyalty Redemptions', value: appointments.loyaltyRedemptions || 0, icon: 'LR', trend: appointments.loyaltyRedemptions > 0 ? 5 : 0, detail: 'estimated rewards usage', accent: 'green', sparkline: makeSparkline(appointments.loyaltyRedemptions || 0) }
    ];
    const statusLabels = {
        pending: 'pending',
        confirmed: 'confirmed',
        checked_in: 'checked-in',
        completed: 'completed',
        cancelled: 'cancelled',
        no_show: 'no-show'
    };
    const merchantTabAlerts = {
        dashboard: pendingCheckIns + (validationReport?.issues?.length || 0),
        calendar: pendingAppointments.length,
        inventory: lowStockProducts.length
    };
    const merchantBadgeKey = `merchant-tab-badges:${merchant.id || merchant.salon_id || merchant.name || 'default'}`;
%>

<section class="section compact merchant-analytics-page merchant-appointment-dashboard">
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <div class="merchant-analytics-shell">
        <header class="merchant-analytics-topbar">
            <a class="merchant-analytics-brand" href="/merchant"><%= merchant.name %></a>
            <nav aria-label="Merchant dashboard sections">
                <button type="button" class="merchant-topbar-tab active" data-merchant-tab="dashboard">Dashboard<% if (merchantTabAlerts.dashboard > 0) { %><span class="merchant-tab-badge" data-merchant-tab-badge><%= merchantTabAlerts.dashboard > 99 ? '99+' : merchantTabAlerts.dashboard %></span><% } %></button>
                <button type="button" class="merchant-topbar-tab" data-merchant-tab="calendar">Calendar<% if (merchantTabAlerts.calendar > 0) { %><span class="merchant-tab-badge" data-merchant-tab-badge><%= merchantTabAlerts.calendar > 99 ? '99+' : merchantTabAlerts.calendar %></span><% } %></button>
                <button type="button" class="merchant-topbar-tab" data-merchant-tab="inventory">Inventory<% if (merchantTabAlerts.inventory > 0) { %><span class="merchant-tab-badge" data-merchant-tab-badge><%= merchantTabAlerts.inventory > 99 ? '99+' : merchantTabAlerts.inventory %></span><% } %></button>
                <a href="/merchant/promotions">Promotions</a>
                <a href="/merchant/services">Services</a>
                <a href="/profile">Profile</a>
            </nav>
            <span>Welcome, <%= currentUser ? currentUser.name : 'Merchant' %></span>
        </header>

        <% if (databaseError) { %>
            <div class="notice error">
                <p>Some database records could not be loaded, so appointment reporting may be incomplete.</p>
            </div>
        <% } %>

        <section class="merchant-dashboard-panel is-active" id="merchant-overview" data-merchant-panel="dashboard">
            <section class="merchant-kpi-grid" aria-label="Merchant appointment summary">
                <% kpiCards.forEach((card) => { %>
                    <article class="merchant-kpi-card accent-<%= card.accent %>">
                        <div class="merchant-kpi-top">
                            <span class="merchant-kpi-icon"><%= card.icon %></span>
                            <span class="merchant-kpi-trend <%= Number(card.trend) >= 0 ? 'positive' : 'negative' %>">
                                <%= Number(card.trend) >= 0 ? '+' : '' %><%= card.trend %>%
                            </span>
                        </div>
                        <span><%= card.label %></span>
                        <strong><%= card.value %></strong>
                        <small><%= card.detail %></small>
                        <div class="merchant-kpi-sparkline" aria-hidden="true">
                            <% card.sparkline.forEach((point) => { %>
                                <i style="height:<%= Math.max(8, Math.min(point, 100)) %>%"></i>
                            <% }) %>
                        </div>
                    </article>
                <% }) %>
            </section>

            <div class="merchant-dashboard-lower-grid merchant-appointment-lower-grid">
                <section class="merchant-orders-card">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Upcoming</p>
                            <h2>Upcoming bookings</h2>
                        </div>
                        <span><%= upcomingBookings.length %> shown</span>
                    </div>

                    <% if (!upcomingBookings.length) { %>
                        <div class="merchant-empty-state">
                            <span>BK</span>
                            <strong>No upcoming bookings</strong>
                            <a class="text-button" href="/merchant/services">Review services</a>
                        </div>
                    <% } else { %>
                        <div class="merchant-appointment-list">
                            <% upcomingBookings.forEach((booking) => { %>
                                <article>
                                    <span class="merchant-status-badge status-<%= booking.status %>"><%= statusLabels[booking.status] || booking.status %></span>
                                    <div>
                                        <strong><%= booking.customerName %></strong>
                                        <small><%= booking.serviceName %> - <%= booking.bookingDate %> at <%= booking.bookingTime || 'Time TBC' %></small>
                                    </div>
                                    <em><%= ['checked_in', 'completed'].includes(booking.status) ? 'QR checked' : 'QR pending' %></em>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>
                </section>

                <section class="merchant-alert-card">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Check-in</p>
                            <h2>QR check-in status</h2>
                        </div>
                        <% if (qrBookingUrl) { %>
                            <a class="text-button" href="<%= qrBookingUrl %>">Open QR</a>
                        <% } %>
                    </div>
                    <div class="merchant-checkin-metrics">
                        <p><span>QR walk-ins</span><strong><%= appointments.qrWalkIns || 0 %></strong></p>
                        <p><span>Checked-in/completed</span><strong><%= checkedInBookings %></strong></p>
                        <p><span>Pending check-ins</span><strong><%= pendingCheckIns %></strong></p>
                    </div>
                    <% if (qrCodeDataUrl && qrBookingUrl) { %>
                        <a class="qr-code-link" href="<%= qrBookingUrl %>" aria-label="Open signed QR booking page">
                            <img class="qr-code" src="<%= qrCodeDataUrl %>" alt="QR code for <%= merchant.name %> booking page">
                        </a>
                    <% } %>
                </section>
            </div>

            <section class="merchant-alert-card <%= validationReport.issues.length > 0 ? 'needs-review' : '' %>">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Merchant Health</p>
                        <h2><%= validationReport.status %></h2>
                    </div>
                </div>
                <% if (!validationReport.issues.length) { %>
                    <p class="muted">Your merchant setup looks complete.</p>
                <% } else { %>
                    <div class="merchant-alert-list">
                        <% validationReport.issues.forEach((issue) => { %>
                            <p><%= issue %></p>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </section>

        <section class="merchant-dashboard-panel" id="merchant-calendar" data-merchant-panel="calendar" hidden>
            <section class="merchant-calendar-shell">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Appointment Calendar</p>
                        <h2 data-calendar-title>Weekly schedule</h2>
                    </div>
                    <div class="merchant-calendar-actions">
                        <div class="merchant-calendar-view-toggle" aria-label="Calendar view">
                            <button class="is-active" type="button" data-calendar-view-button="week">Week</button>
                            <button type="button" data-calendar-view-button="month">Month</button>
                        </div>
                    </div>
                </div>

                <div class="merchant-calendar-toolbar" data-calendar-filters>
                    <label>
                        Status
                        <select data-calendar-status-filter>
                            <option value="">All statuses</option>
                            <% Object.keys(statusLabels).forEach((status) => { %>
                                <option value="<%= status %>"><%= statusLabels[status] %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        Service
                        <select data-calendar-service-filter>
                            <option value="">All services</option>
                            <% serviceFilterOptions.forEach((serviceName) => { %>
                                <option value="<%= serviceName %>"><%= serviceName %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        Search
                        <input type="search" placeholder="Customer or service" data-calendar-search-filter>
                    </label>
                    <button class="button secondary" type="button" data-calendar-reset>Reset</button>
                </div>

                <div class="merchant-calendar-legend">
                    <% Object.keys(statusLabels).forEach((status) => { %>
                        <span class="merchant-status-dot status-<%= status %>"><%= statusLabels[status] %></span>
                    <% }) %>
                </div>

                <div class="merchant-calendar-grid" data-merchant-calendar data-calendar-view="week">
                    <% weekDays.forEach((day) => { %>
                        <section class="merchant-calendar-day" data-calendar-day="<%= day.key %>">
                            <header>
                                <span><%= day.label %></span>
                                <strong><%= day.day %></strong>
                            </header>
                            <div class="merchant-calendar-dropzone">
                                <% if (!day.appointments.length) { %>
                                    <p class="merchant-calendar-empty">No appointments</p>
                                <% } %>
                                <% day.appointments.forEach((booking) => { %>
                                    <article
                                        class="merchant-calendar-booking status-<%= booking.status %>"
                                        draggable="true"
                                        data-booking-id="<%= booking.id %>"
                                        data-status="<%= booking.status %>"
                                        data-service="<%= booking.serviceName %>"
                                        data-search="<%= `${booking.customerName} ${booking.serviceName} ${booking.bookingTime} ${booking.bookingDate}`.toLowerCase() %>">
                                        <div>
                                            <strong><%= booking.bookingTime || 'Time TBC' %></strong>
                                            <span><%= booking.serviceName %></span>
                                        </div>
                                        <small><%= booking.customerName %></small>
                                        <em><%= statusLabels[booking.status] || booking.status %></em>
                                        <% if (['checked_in', 'completed'].includes(booking.status)) { %>
                                            <b>QR</b>
                                        <% } %>
                                    </article>
                                <% }) %>
                            </div>
                        </section>
                    <% }) %>
                </div>

                <div class="merchant-calendar-month is-hidden" data-calendar-month data-calendar-view="month">
                    <div class="merchant-calendar-month-heading">
                        <strong><%= monthView.label %></strong>
                        <span><%= allCalendarBookings.length %> total bookings</span>
                    </div>
                    <div class="merchant-calendar-month-weekdays" aria-hidden="true">
                        <span>Sun</span>
                        <span>Mon</span>
                        <span>Tue</span>
                        <span>Wed</span>
                        <span>Thu</span>
                        <span>Fri</span>
                        <span>Sat</span>
                    </div>
                    <div class="merchant-calendar-month-grid">
                        <% monthView.days.forEach((day) => { %>
                            <% if (day.isPlaceholder) { %>
                                <div class="merchant-calendar-month-day is-placeholder"></div>
                            <% } else { %>
                                <section class="merchant-calendar-month-day" data-calendar-day="<%= day.key %>">
                                    <header>
                                        <span><%= day.label %></span>
                                        <strong><%= day.dayNumber %></strong>
                                    </header>
                                    <% if (!day.appointments.length) { %>
                                        <p class="merchant-calendar-empty compact">No bookings</p>
                                    <% } %>
                                    <% day.appointments.forEach((booking) => { %>
                                        <article
                                            class="merchant-calendar-booking merchant-calendar-booking-compact status-<%= booking.status %>"
                                            data-booking-id="<%= booking.id %>"
                                            data-status="<%= booking.status %>"
                                            data-service="<%= booking.serviceName %>"
                                            data-search="<%= `${booking.customerName} ${booking.serviceName} ${booking.bookingTime} ${booking.bookingDate}`.toLowerCase() %>">
                                            <strong><%= booking.bookingTime || 'Time TBC' %></strong>
                                            <span><%= booking.serviceName %></span>
                                            <small><%= booking.customerName %></small>
                                        </article>
                                    <% }) %>
                                </section>
                            <% } %>
                        <% }) %>
                    </div>
                </div>
            </section>
        </section>

        <section class="merchant-dashboard-panel" id="merchant-inventory" data-merchant-panel="inventory" hidden>
            <div class="merchant-dashboard-lower-grid">
                <section class="merchant-alert-card">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Inventory</p>
                            <h2>Low stock alerts</h2>
                        </div>
                        <a class="text-button" href="/merchant/products">Manage</a>
                    </div>

                    <% if (!lowStockProducts.length) { %>
                        <p class="muted">No low stock items.</p>
                    <% } else { %>
                        <div class="merchant-alert-list">
                            <% lowStockProducts.forEach((product) => { %>
                                <a href="/merchant/products/<%= product.id %>/edit">
                                    <span><%= product.name %></span>
                                    <strong><%= product.stockQuantity %> left</strong>
                                </a>
                            <% }) %>
                        </div>
                    <% } %>
                </section>

                <section class="merchant-actions-card">
                    <div class="merchant-card-heading">
                        <div>
                            <p class="eyebrow">Workspace</p>
                            <h2>Quick actions</h2>
                        </div>
                    </div>
                    <div class="merchant-quick-actions">
                        <a class="button primary" href="/merchant/schedule">Manage schedule</a>
                        <a class="button secondary" href="/merchant/products/new">Add product</a>
                        <a class="button secondary" href="/merchant/promotions">Promotions</a>
                        <form action="/merchant/generate-qr" method="POST">
                            <button class="button secondary" type="submit">Generate QR</button>
                        </form>
                    </div>
                </section>
            </div>
        </section>
    </div>
</section>

<script>
    (() => {
        const merchantTabButtons = Array.from(document.querySelectorAll('[data-merchant-tab]'));
        const merchantPanels = Array.from(document.querySelectorAll('[data-merchant-panel]'));
        const merchantHashMap = {
            '#merchant-overview': 'dashboard',
            '#merchant-calendar': 'calendar',
            '#merchant-inventory': 'inventory'
        };
        const merchantBadgeStorageKey = <%- JSON.stringify(merchantBadgeKey) %>;
        const getClearedMerchantTabs = () => {
            try {
                const stored = localStorage.getItem(merchantBadgeStorageKey);
                const parsed = stored ? JSON.parse(stored) : [];
                return Array.isArray(parsed) ? new Set(parsed) : new Set();
            } catch (error) {
                return new Set();
            }
        };
        const persistClearedMerchantTabs = (tabs) => {
            try {
                localStorage.setItem(merchantBadgeStorageKey, JSON.stringify(Array.from(tabs)));
            } catch (error) {
                return;
            }
        };
        const clearedMerchantTabs = getClearedMerchantTabs();
        const clearMerchantTabBadge = (tabName) => {
            const button = merchantTabButtons.find((item) => item.dataset.merchantTab === tabName);
            const badge = button?.querySelector('[data-merchant-tab-badge]');
            if (badge) {
                badge.remove();
            }
            if (!clearedMerchantTabs.has(tabName)) {
                clearedMerchantTabs.add(tabName);
                persistClearedMerchantTabs(clearedMerchantTabs);
            }
        };
        merchantTabButtons.forEach((button) => {
            if (clearedMerchantTabs.has(button.dataset.merchantTab)) {
                button.querySelector('[data-merchant-tab-badge]')?.remove();
            }
        });
        const setMerchantPanel = (panelName, syncHash = true) => {
            const activeButton = merchantTabButtons.find((button) => button.dataset.merchantTab === panelName) || merchantTabButtons[0];
            const nextPanel = activeButton?.dataset.merchantTab || 'dashboard';

            merchantTabButtons.forEach((button) => {
                const isActive = button.dataset.merchantTab === nextPanel;
                button.classList.toggle('active', isActive);
                if (isActive) {
                    button.setAttribute('aria-current', 'page');
                } else {
                    button.removeAttribute('aria-current');
                }
            });

            merchantPanels.forEach((panel) => {
                const isActive = panel.dataset.merchantPanel === nextPanel;
                panel.hidden = !isActive;
                panel.style.display = isActive ? 'block' : 'none';
            });

            if (syncHash) {
                const targetHash = nextPanel === 'dashboard' ? '#merchant-overview' : `#merchant-${nextPanel}`;
                if (window.location.hash !== targetHash) {
                    history.replaceState(null, '', targetHash);
                }
            }

            clearMerchantTabBadge(nextPanel);
        };

        merchantTabButtons.forEach((button) => {
            button.addEventListener('click', () => setMerchantPanel(button.dataset.merchantTab));
        });

        window.addEventListener('hashchange', () => {
            setMerchantPanel(merchantHashMap[window.location.hash] || 'dashboard', false);
        });

        const calendar = document.querySelector('[data-merchant-calendar]');
        const monthCalendar = document.querySelector('[data-calendar-month]');
        const title = document.querySelector('[data-calendar-title]');
        const viewButtons = Array.from(document.querySelectorAll('[data-calendar-view-button]'));
        const statusFilter = document.querySelector('[data-calendar-status-filter]');
        const serviceFilter = document.querySelector('[data-calendar-service-filter]');
        const searchFilter = document.querySelector('[data-calendar-search-filter]');
        const resetButton = document.querySelector('[data-calendar-reset]');
        setMerchantPanel(merchantHashMap[window.location.hash] || 'dashboard', false);
        if (!calendar) return;

        let draggedCard = null;

        const applyFilters = () => {
            const status = statusFilter?.value || '';
            const service = serviceFilter?.value || '';
            const search = (searchFilter?.value || '').trim().toLowerCase();

            document.querySelectorAll('.merchant-calendar-booking').forEach((card) => {
                const matchesStatus = !status || card.dataset.status === status;
                const matchesService = !service || card.dataset.service === service;
                const matchesSearch = !search || (card.dataset.search || '').includes(search);
                card.hidden = !(matchesStatus && matchesService && matchesSearch);
            });

            document.querySelectorAll('.merchant-calendar-day, .merchant-calendar-month-day:not(.is-placeholder)').forEach((day) => {
                const cards = Array.from(day.querySelectorAll('.merchant-calendar-booking'));
                const hasVisibleCard = cards.some((card) => !card.hidden);
                day.querySelector('.merchant-calendar-empty')?.classList.toggle('is-hidden', hasVisibleCard);
            });
        };

        viewButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const view = button.dataset.calendarViewButton;
                viewButtons.forEach((item) => item.classList.toggle('is-active', item === button));
                calendar.classList.toggle('is-hidden', view !== 'week');
                monthCalendar?.classList.toggle('is-hidden', view !== 'month');
                if (title) {
                    title.textContent = view === 'month' ? 'Monthly schedule' : 'Weekly schedule';
                }
                applyFilters();
            });
        });

        [statusFilter, serviceFilter, searchFilter].forEach((input) => {
            input?.addEventListener('input', applyFilters);
            input?.addEventListener('change', applyFilters);
        });

        resetButton?.addEventListener('click', () => {
            if (statusFilter) statusFilter.value = '';
            if (serviceFilter) serviceFilter.value = '';
            if (searchFilter) searchFilter.value = '';
            applyFilters();
        });

        calendar.querySelectorAll('.merchant-calendar-booking').forEach((card) => {
            card.addEventListener('dragstart', () => {
                draggedCard = card;
                card.classList.add('is-dragging');
            });
            card.addEventListener('dragend', () => {
                card.classList.remove('is-dragging');
                draggedCard = null;
            });
        });

        calendar.querySelectorAll('.merchant-calendar-day').forEach((day) => {
            day.addEventListener('dragover', (event) => {
                event.preventDefault();
                day.classList.add('is-drag-over');
            });
            day.addEventListener('dragleave', () => day.classList.remove('is-drag-over'));
            day.addEventListener('drop', () => {
                day.classList.remove('is-drag-over');
                if (!draggedCard) return;
                const dropzone = day.querySelector('.merchant-calendar-dropzone');
                dropzone.querySelector('.merchant-calendar-empty')?.remove();
                dropzone.appendChild(draggedCard);
                draggedCard.dataset.localDate = day.dataset.calendarDay;
                applyFilters();
            });
        });

        applyFilters();
    })();
</script>

<%- include('partials/footer') %>
