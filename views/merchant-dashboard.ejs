<%- include('partials/header', { title }) %>

<%
    const dailySales = salesReport?.dailySales || [];
    const maxRevenue = Math.max(...dailySales.map((day) => Number(day.revenue || 0)), 1);
    const maxOrders = Math.max(...dailySales.map((day) => Number(day.orders || 0)), 1);
    const recentOrders = salesReport?.recentOrders || [];
    const lowStockProducts = salesReport?.lowStockProducts || [];
%>

<section class="section compact merchant-analytics-page">
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <div class="merchant-analytics-shell">
        <header class="merchant-analytics-topbar">
            <a class="merchant-analytics-brand" href="/merchant"><%= merchant.name %></a>
            <nav aria-label="Merchant dashboard sections">
                <a href="/merchant">Dashboard</a>
                <a href="/merchant/products">Inventory</a>
                <a href="/merchant/promotions">Reports</a>
                <a href="/merchant/services">Services</a>
                <a href="/profile">Profile</a>
            </nav>
            <span>Welcome, <%= currentUser ? currentUser.name : 'Merchant' %></span>
        </header>

        <% if (databaseError) { %>
            <div class="notice error">
                <p>Some database records could not be loaded, so reporting may be incomplete.</p>
            </div>
        <% } %>

        <div class="merchant-analytics-kpis">
            <article>
                <span>Total Products</span>
                <strong><%= stats.productCount %></strong>
            </article>
            <article>
                <span>Total Revenue</span>
                <strong>$<%= stats.totalRevenue.toFixed(2) %></strong>
            </article>
            <article>
                <span>Total Orders</span>
                <strong><%= stats.totalOrders %></strong>
            </article>
            <article>
                <span>Avg Order Value</span>
                <strong>$<%= stats.averageOrderValue.toFixed(2) %></strong>
            </article>
            <article class="merchant-growth-card">
                <span>Growth vs last 7 days</span>
                <strong><%= stats.growthPercent.toFixed(1) %>%</strong>
                <small><%= stats.growthPercent >= 0 ? 'Up' : 'Down' %></small>
            </article>
        </div>

        <section class="merchant-sales-card">
            <div class="merchant-card-heading">
                <div>
                    <p class="eyebrow">Sales</p>
                    <h2>Daily sales (last 7 days)</h2>
                </div>
                <span>Updated <%= new Date().toLocaleString('en-SG', { dateStyle: 'short', timeStyle: 'short' }) %></span>
            </div>

            <div class="merchant-chart-legend">
                <span><i class="revenue"></i>Revenue ($)</span>
                <span><i class="orders"></i>Orders</span>
            </div>

            <div class="merchant-sales-chart" aria-label="Daily sales chart">
                <% dailySales.forEach((day) => { %>
                    <div class="merchant-chart-day">
                        <div class="merchant-chart-bars">
                            <span class="merchant-revenue-bar" style="height:<%= Math.max((day.revenue / maxRevenue) * 100, day.revenue > 0 ? 8 : 0) %>%"></span>
                            <span class="merchant-order-dot" style="bottom:<%= Math.max((day.orders / maxOrders) * 100, day.orders > 0 ? 10 : 0) %>%"></span>
                        </div>
                        <small><%= day.label %></small>
                    </div>
                <% }) %>
            </div>
        </section>

        <div class="merchant-dashboard-lower-grid">
            <section class="merchant-orders-card">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Orders</p>
                        <h2>Recent orders</h2>
                    </div>
                    <a class="text-button" href="/merchant/products">Inventory</a>
                </div>

                <% if (!recentOrders.length) { %>
                    <p class="muted">No paid product orders yet.</p>
                <% } else { %>
                    <div class="merchant-order-list">
                        <% recentOrders.forEach((order) => { %>
                            <article class="merchant-order-row">
                                <span>
                                    <strong>ORD-<%= order.id %></strong>
                                    <small><%= new Date(order.createdAt).toLocaleString('en-SG', { dateStyle: 'short', timeStyle: 'short' }) %> &middot; <%= order.itemCount %> item<%= order.itemCount === 1 ? '' : 's' %></small>
                                </span>
                                <span>
                                    <strong>$<%= order.totalAmount.toFixed(2) %></strong>
                                    <small><%= order.customerName %></small>
                                </span>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <section class="merchant-alert-card">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Inventory</p>
                        <h2>Low stock alerts</h2>
                    </div>
                    <a class="text-button" href="/merchant/products">Manage</a>
                </div>

                <% if (!lowStockProducts.length) { %>
                    <p class="muted">No low stock items.</p>
                <% } else { %>
                    <div class="merchant-alert-list">
                        <% lowStockProducts.forEach((product) => { %>
                            <a href="/merchant/products/<%= product.id %>/edit">
                                <span><%= product.name %></span>
                                <strong><%= product.stockQuantity %> left</strong>
                            </a>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </div>

        <div class="merchant-dashboard-lower-grid">
            <section class="merchant-alert-card <%= validationReport.issues.length > 0 ? 'needs-review' : '' %>">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Issues</p>
                        <h2><%= validationReport.status %></h2>
                    </div>
                </div>
                <% if (!validationReport.issues.length) { %>
                    <p class="muted">Your merchant setup looks complete.</p>
                <% } else { %>
                    <div class="merchant-alert-list">
                        <% validationReport.issues.forEach((issue) => { %>
                            <p><%= issue %></p>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <section class="merchant-actions-card">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Workspace</p>
                        <h2>Quick actions</h2>
                    </div>
                </div>
                <div class="merchant-quick-actions">
                    <a class="button primary" href="/merchant/products/new">Add product</a>
                    <a class="button secondary" href="/merchant/services">Services</a>
                    <a class="button secondary" href="/merchant/promotions">Promotions</a>
                    <form action="/merchant/generate-qr" method="POST">
                        <button class="button secondary" type="submit">Generate QR</button>
                    </form>
                </div>
                <% if (qrCodeDataUrl && qrBookingUrl) { %>
                    <a class="qr-code-link" href="<%= qrBookingUrl %>" aria-label="Open signed QR booking page">
                        <img class="qr-code" src="<%= qrCodeDataUrl %>" alt="QR code for <%= merchant.name %> booking page">
                    </a>
                <% } %>
            </section>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
