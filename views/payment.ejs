<%- include('partials/header', { title }) %>

<section class="page-title payment-title">
    <p class="eyebrow">Checkout</p>
    <h1>Secure checkout</h1>
    <p>Confirm your order and complete payment in under a minute.</p>
</section>

<section class="section compact payment-page">
    <div class="payment-layout">
        <%
            const paymentVoucherList = typeof availableVouchers !== 'undefined' && Array.isArray(availableVouchers) ? availableVouchers : [];
            const paymentVoucherMode = typeof voucherMode !== 'undefined' && voucherMode ? voucherMode : (cartCheckout ? 'product' : 'booking');
            const paymentSelectedVoucherId = String(typeof selectedVoucherId !== 'undefined' ? selectedVoucherId || '' : '');
            const voucherRecommendationView = typeof voucherRecommendation !== 'undefined' && voucherRecommendation ? voucherRecommendation : null;
            const smartVoucherMessageView = typeof smartVoucherMessage !== 'undefined' ? String(smartVoucherMessage || '').trim() : '';
            const paymentBirthdayPromotion = typeof birthdayPromotion !== 'undefined' ? birthdayPromotion : null;
            const paymentSelectedVoucher = paymentVoucherList.find((voucher) => String(voucher.id) === paymentSelectedVoucherId) || null;
            const isCartPayment = typeof cartCheckout !== 'undefined' && cartCheckout;
            const paymentItems = typeof items !== 'undefined' && Array.isArray(items) ? items : [];
            const paymentPickupOptions = typeof pickupMerchantOptions !== 'undefined' && Array.isArray(pickupMerchantOptions) ? pickupMerchantOptions : [];
            const checkoutHasProductItems = isCartPayment && paymentItems.some((item) => item.type === 'Product');
            const paymentDeliveryFee = Number(typeof deliveryFee !== 'undefined' ? deliveryFee || 0 : shippingFee || 0);
            const paymentAppliedVoucher = paymentSelectedVoucher
                || (!isCartPayment && paymentSelectedVoucherId !== 'none' ? voucherRecommendationView?.voucher : null)
                || null;
            const paymentCashbackBlockedByVoucher = Boolean(paymentAppliedVoucher);
            const paymentVoucherBaseAmount = paymentVoucherMode === 'product'
                ? Number(paymentAppliedVoucher?.eligibleSubtotal || itemSubtotal || 0)
                : Number(amount || 0);
            const paymentVoucherEstimate = paymentAppliedVoucher
                ? (
                    paymentAppliedVoucher.discountType === 'percentage'
                        ? (paymentVoucherBaseAmount * (Number(paymentAppliedVoucher.discountPercent || 0) / 100))
                        : Math.min(Number(paymentAppliedVoucher.remainingValue || paymentAppliedVoucher.voucherValue || 0), paymentVoucherBaseAmount)
                )
                : 0;
            const rewardRedemptionView = typeof rewardRedemption !== 'undefined' && rewardRedemption ? rewardRedemption : null;
            const rewardRules = rewardRedemptionView && rewardRedemptionView.rules ? rewardRedemptionView.rules : null;
            const rewardWallet = rewardRedemptionView && rewardRedemptionView.wallet ? rewardRedemptionView.wallet : null;
            const requestedRewardPoints = Number(redeemPointsRequested || 0);
            const rewardBaseAmount = Math.max(Number(amount || 0) - paymentVoucherEstimate, 0);
            const paymentPointEstimate = rewardRedemptionView && rewardRedemptionView.enabled && requestedRewardPoints > 0
                ? Math.min(
                    requestedRewardPoints * Number(rewardRules.pointsToCashRate || 0),
                    rewardBaseAmount * (Number(rewardRules.maxDiscountPercent || 0) / 100),
                    rewardBaseAmount
                )
                : 0;
            const paymentCashbackEstimate = typeof useCashback !== 'undefined' && useCashback && loyalty && !paymentCashbackBlockedByVoucher
                ? Math.min(Number(loyalty.wallet.cashbackBalance || 0), Math.max(Number(amount || 0) - paymentVoucherEstimate - paymentPointEstimate, 0))
                : 0;
            const campaignCashbackView = typeof campaignCashback !== 'undefined' && campaignCashback ? campaignCashback : { total: 0, breakdown: [] };
            const campaignCashbackTotal = Number(campaignCashbackView.total || 0);
            const paymentAmountDue = Math.max(Number(amount || 0) - paymentVoucherEstimate - paymentPointEstimate - paymentCashbackEstimate, 0);
            const eWalletView = typeof eWallet !== 'undefined' && eWallet ? eWallet : null;
            const eWalletBalance = Number(eWalletView && eWalletView.balance || 0);
            const walletCanPay = eWalletBalance >= paymentAmountDue;
            const initialPaymentMethod = walletCanPay
                ? 'wallet'
                : ((paypalEnabled && paypalClientId) ? 'paypal' : 'stripe');
            const fulfilmentLabel = fulfilment === 'delivery'
                ? 'Delivery'
                : fulfilment === 'pickup'
                    ? 'Pick up'
                    : '';
            const hasSavingsSection = Boolean(
                paymentBirthdayPromotion
                || (isCartPayment && paymentSelectedVoucher)
                || (!isCartPayment && (paymentVoucherList.length > 0 || (voucherRecommendationView && voucherRecommendationView.voucher) || smartVoucherMessageView))
                || (!(typeof cartCheckout !== 'undefined' && cartCheckout) && rewardRedemptionView)
                || (typeof cartCheckout !== 'undefined' && cartCheckout && typeof useCashback !== 'undefined' && useCashback)
                || (!(typeof cartCheckout !== 'undefined' && cartCheckout))
                || campaignCashbackTotal > 0
            );
        %>
        <form class="login-form payment-form" action="/payment" method="POST" data-base-amount="<%= Number(amount || 0).toFixed(2) %>" data-item-subtotal="<%= Number(itemSubtotal || amount || 0).toFixed(2) %>" data-delivery-fee="<%= paymentDeliveryFee.toFixed(2) %>" data-voucher-estimate="<%= paymentVoucherEstimate.toFixed(2) %>" data-cashback-balance="<%= typeof loyalty !== 'undefined' && loyalty ? Number(loyalty.wallet.cashbackBalance || 0).toFixed(2) : '0.00' %>" data-ewallet-balance="<%= eWalletBalance.toFixed(2) %>">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input id="payment-amount-input" type="hidden" name="amount" value="<%= amount %>">
            <input type="hidden" name="itemSubtotal" value="<%= Number(itemSubtotal || amount || 0).toFixed(2) %>">
            <input id="payment-shipping-input" type="hidden" name="shippingFee" value="<%= Number(shippingFee || 0).toFixed(2) %>">
            <input type="hidden" name="merchantName" value="<%= merchantName %>">
            <input type="hidden" name="serviceName" value="<%= serviceName %>">
            <input type="hidden" name="cartItemId" value="<%= cartItemId || '' %>">
            <input type="hidden" name="cartCheckout" value="<%= cartCheckout ? 'true' : 'false' %>">
            <input type="hidden" name="checkoutId" value="<%= typeof checkoutId !== 'undefined' ? checkoutId : '' %>">
            <input type="hidden" name="bookingId" value="<%= typeof bookingId !== 'undefined' ? bookingId : '' %>">
            <input type="hidden" name="selectedItemIds" value="<%= Array.isArray(selectedItemIds) ? selectedItemIds.join(',') : (selectedItemIds || '') %>">
            <input type="hidden" name="useCashback" value="<%= typeof useCashback !== 'undefined' && useCashback ? 'true' : 'false' %>">
            <% if (typeof useCashback !== 'undefined' && useCashback) { %>
                <input type="hidden" name="redeemCashback" value="on">
            <% } %>
            <% if (!checkoutHasProductItems) { %>
                <input type="hidden" name="fulfilment" value="<%= fulfilment || '' %>">
                <input type="hidden" name="pickupMerchantId" value="<%= pickupMerchantId || '' %>">
                <input type="hidden" name="deliveryAddress" value="<%= deliveryAddress || '' %>">
                <input type="hidden" name="deliveryUnit" value="<%= deliveryUnit || '' %>">
                <input type="hidden" name="deliveryPostal" value="<%= deliveryPostal || '' %>">
                <input type="hidden" name="deliveryPhone" value="<%= deliveryPhone || '' %>">
            <% } %>
            <% if (isCartPayment) { %>
                <input type="hidden" name="selectedVoucherId" value="<%= paymentSelectedVoucherId || 'none' %>">
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="notice error"><p><%= error %></p></div>
            <% } %>

            <div class="checkout-progress" aria-label="Checkout progress">
                <div class="checkout-progress-pill active">1. Details</div>
                <div class="checkout-progress-pill active">2. Rewards</div>
                <div class="checkout-progress-pill active">3. Payment</div>
            </div>

            <div class="payment-form-header">
                <p class="eyebrow">Secure payment</p>
                <h2 id="payment-live-total">$<%= paymentAmountDue.toFixed(2) %></h2>
                <p class="muted">Order: <%= serviceName %> &middot; <%= merchantName %></p>
                <% if (fulfilmentLabel) { %>
                    <p class="payment-fulfilment-pill"><%= fulfilmentLabel %></p>
                <% } %>
            </div>

            <% if (checkoutHasProductItems) { %>
                <section class="checkout-card payment-fulfilment-section">
                    <div class="checkout-card-header">
                        <h3>Fulfilment & details</h3>
                        <p>Choose pickup or delivery, then complete the required details.</p>
                    </div>
                    <div class="payment-fulfilment-combined">
                        <div class="fulfilment-options payment-fulfilment-options">
                            <label class="fulfilment-choice <%= fulfilment !== 'delivery' ? 'active' : '' %>">
                                <input type="radio" name="fulfilment" value="pickup" <%= fulfilment !== 'delivery' ? 'checked' : '' %>>
                                <span>
                                    Pick up
                                    <small>Collect from a merchant.</small>
                                </span>
                            </label>
                            <label class="fulfilment-choice <%= fulfilment === 'delivery' ? 'active' : '' %>">
                                <input type="radio" name="fulfilment" value="delivery" <%= fulfilment === 'delivery' ? 'checked' : '' %>>
                                <span>
                                    Delivery
                                    <small>Deliver to your address.</small>
                                </span>
                            </label>
                        </div>

                        <div class="payment-fulfilment-details">
                            <div id="payment-pickup-options" class="fulfilment-panel payment-pickup-panel">
                                <label class="pickup-field">
                                    Pickup merchant
                                    <select id="payment-pickup-merchant-select" name="pickupMerchantId">
                                        <option value="any" <%= !pickupMerchantId || pickupMerchantId === 'any' ? 'selected' : '' %>>Any merchant</option>
                                        <% paymentPickupOptions.forEach((merchant) => { %>
                                            <option value="<%= merchant.id %>" <%= String(pickupMerchantId || '') === String(merchant.id) ? 'selected' : '' %>><%= merchant.name %></option>
                                        <% }) %>
                                    </select>
                                </label>
                                <p class="muted">Choose where you want to collect your items.</p>
                            </div>

                            <div id="payment-delivery-options" class="fulfilment-panel payment-delivery-panel" style="display:none;">
                                <label class="delivery-field">
                                    Street address
                                    <input type="text" name="deliveryAddress" value="<%= deliveryAddress || '' %>" placeholder="123 Orchard Road" minlength="8" autocomplete="street-address" data-payment-delivery-required>
                                </label>
                                <label class="delivery-field">
                                    Unit number
                                    <input type="text" name="deliveryUnit" value="<%= deliveryUnit || '' %>" placeholder="#12-34" pattern="[A-Za-z0-9#\-/\s]+" autocomplete="address-line2" data-payment-delivery-required>
                                </label>
                                <label class="delivery-field">
                                    Postal code
                                    <input type="text" name="deliveryPostal" value="<%= deliveryPostal || '' %>" placeholder="123456" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="postal-code" data-payment-delivery-required>
                                </label>
                                <label class="delivery-field">
                                    Contact phone
                                    <input type="tel" name="deliveryPhone" value="<%= deliveryPhone || '' %>" placeholder="91234567" inputmode="tel" pattern="(\+65\s*)?[689][0-9]{7}" autocomplete="tel" data-payment-delivery-required>
                                </label>
                                <p class="muted">Delivery fee: $<%= paymentDeliveryFee.toFixed(2) %>. All fields are required.</p>
                            </div>
                        </div>
                    </div>
                </section>
            <% } %>

            <% if (hasSavingsSection) { %>
                <section class="checkout-card payment-rewards-card">
                    <div class="checkout-card-header payment-section-heading">
                        <h3>Rewards</h3>
                        <p>Quickly review cashback, vouchers, and points.</p>
                    </div>
                    <div class="payment-rewards-compact">
                        <% if (paymentBirthdayPromotion && paymentBirthdayPromotion.isBirthdayMonth) { %>
                            <div class="notice success payment-reward-item">
                                <p>
                                    Birthday perks are active for <strong><%= paymentBirthdayPromotion.monthName %></strong>.
                                    This payment can earn bonus points.
                                </p>
                            </div>
                        <% } %>

                        <% if (isCartPayment && paymentSelectedVoucher) { %>
                            <div class="loyalty-redemption-card payment-cashback-card payment-selected-voucher payment-reward-item">
                                <span>
                                    <strong><%= paymentSelectedVoucher.title %></strong>
                                    <small>
                                        Voucher ID: <%= paymentSelectedVoucher.id %> &middot; Code: <%= paymentSelectedVoucher.code %>
                                    </small>
                                </span>
                                <b>
                                    <%= paymentSelectedVoucher.discountType === 'percentage'
                                        ? `${Number(paymentSelectedVoucher.discountPercent || 0)}% OFF`
                                        : `$${Number(paymentSelectedVoucher.remainingValue || paymentSelectedVoucher.voucherValue || 0).toFixed(2)}` %>
                                </b>
                            </div>
                        <% } %>

                        <% if (!isCartPayment && (paymentVoucherList.length > 0 || (voucherRecommendationView && voucherRecommendationView.voucher) || smartVoucherMessageView)) { %>
                            <div class="loyalty-redemption-card payment-cashback-card payment-reward-item">
                    <% if (paymentVoucherList.length > 0) { %>
                        <div class="cart-voucher-picker">
                            <span>
                                <strong>Platform vouchers</strong>
                                <small>
                                    Choose your platform voucher here.
                                    <%= paymentVoucherMode === 'product'
                                        ? ' Product smart vouchers are still checked automatically.'
                                        : ' Service smart vouchers are still checked automatically.' %>
                                </small>
                            </span>
                            <button
                                class="button secondary compact cart-voucher-toggle"
                                type="button"
                                id="payment-voucher-toggle"
                                aria-expanded="false"
                                aria-controls="payment-voucher-panel">
                                Use vouchers
                            </button>
                            <div
                                class="cart-voucher-panel"
                                id="payment-voucher-panel"
                                hidden>
                                <div class="cart-voucher-options">
                                    <label class="cart-voucher-option">
                                        <input
                                            type="radio"
                                            name="selectedVoucherId"
                                            value="none"
                                            data-discount-type="none"
                                            <%= paymentSelectedVoucherId === 'none' ? 'checked' : '' %>>
                                        <span class="cart-voucher-option-copy">
                                            <strong>Do not use a voucher</strong>
                                            <small class="payment-voucher-meta">Continue without applying a platform voucher.</small>
                                        </span>
                                    </label>
                                    <% paymentVoucherList.forEach((voucher) => { %>
                                        <label class="cart-voucher-option">
                                            <input
                                                type="radio"
                                                name="selectedVoucherId"
                                                value="<%= voucher.id %>"
                                                data-discount-type="<%= voucher.discountType || 'fixed' %>"
                                                data-discount-percent="<%= Number(voucher.discountPercent || 0) %>"
                                                data-discount-value="<%= Number(voucher.remainingValue || voucher.voucherValue || 0).toFixed(2) %>"
                                                <%= String(voucher.id) === paymentSelectedVoucherId ? 'checked' : '' %>>
                                            <span class="cart-voucher-option-copy">
                                                <strong><%= voucher.title %></strong>
                                                <small class="payment-voucher-meta">
                                                    Voucher ID: <%= voucher.id %> &middot; Code: <%= voucher.code %>
                                                </small>
                                                <small class="payment-voucher-value">
                                                    <%= voucher.discountType === 'percentage'
                                                        ? `${Number(voucher.discountPercent || 0)}% OFF`
                                                        : `$${Number(voucher.remainingValue || voucher.voucherValue || 0).toFixed(2)}` %>
                                                </small>
                                                <small class="payment-voucher-meta">
                                                    <%= voucher.expiresAt
                                                        ? `Expires ${new Date(voucher.expiresAt).toLocaleDateString('en-SG', { dateStyle: 'medium' })}`
                                                        : voucher.minimumSpend
                                                            ? `Minimum spend $${Number(voucher.minimumSpend || 0).toFixed(2)}`
                                                            : 'Eligible items only' %>
                                                </small>
                                            </span>
                                        </label>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <span>
                            <strong>No platform vouchers to choose</strong>
                            <small>
                                <%= paymentVoucherMode === 'product'
                                    ? 'Product smart vouchers are still checked automatically for this checkout.'
                                    : 'Service smart vouchers are still checked automatically for this checkout.' %>
                            </small>
                        </span>
                    <% } %>
                    <% if (voucherRecommendationView && voucherRecommendationView.voucher) { %>
                        <div class="notice success payment-reward-item">
                            <p>
                                <strong>Smart voucher selected:</strong>
                                <%= voucherRecommendationView.voucher.title %> was selected automatically for this checkout.
                                You save <strong>$<%= Number(voucherRecommendationView.discount || 0).toFixed(2) %></strong><%= paymentVoucherMode === 'product' ? ' on eligible products' : '' %>.
                            </p>
                        </div>
                    <% } else if (smartVoucherMessageView) { %>
                        <div class="notice error payment-reward-item">
                            <p>
                                <strong>Smart voucher check:</strong>
                                <%= smartVoucherMessageView %>
                            </p>
                        </div>
                    <% } %>
                            </div>
                        <% } %>

                        <% if (!(typeof cartCheckout !== 'undefined' && cartCheckout) && rewardRedemptionView) { %>
                            <div class="loyalty-redemption-card payment-cashback-card payment-reward-item">
                    <% if (rewardRedemptionView.enabled) { %>
                        <label>
                            <span>
                                <strong>Redeem points</strong>
                                <small>
                                    Available <%= Number(rewardWallet.pointsBalance || 0) %> points.
                                    Redeemable amount $<%= Number(rewardRedemptionView.maxDiscountAmount || 0).toFixed(2) %>.
                                    Max usable <%= Number(rewardRedemptionView.maxPoints || 0) %> points.
                                    Minimum <%= rewardRules.minPointsToRedeem %>.
                                    Max reward discount <%= Number(rewardRules.maxDiscountPercent || 0) %>%.
                                    Final value is confirmed at payment capture.
                                </small>
                            </span>
                            <input
                                id="payment-redeem-points"
                                type="number"
                                name="redeemPoints"
                                min="0"
                                step="1"
                                max="<%= Number(rewardRedemptionView.maxPoints || rewardWallet.pointsBalance || 0) %>"
                                value="<%= requestedRewardPoints || 0 %>"
                                data-point-rate="<%= Number(rewardRules.pointsToCashRate || 0) %>"
                                data-max-discount="<%= Number(rewardRedemptionView.maxDiscountAmount || 0) %>"
                                data-base-amount="<%= rewardBaseAmount.toFixed(2) %>"
                                data-cashback-estimate="<%= paymentCashbackEstimate.toFixed(2) %>">
                        </label>
                    <% } else { %>
                        <span>
                            <strong>Points redemption unavailable</strong>
                            <small><%= rewardRedemptionView.reason || 'This merchant or service does not allow points redemption.' %></small>
                        </span>
                    <% } %>
                            </div>
                        <% } %>

                        <% if (typeof cartCheckout !== 'undefined' && cartCheckout && typeof useCashback !== 'undefined' && useCashback) { %>
                            <div class="loyalty-redemption-card payment-cashback-card payment-reward-item">
                    <span>
                        <strong><%= paymentCashbackBlockedByVoucher ? 'Cashback paused for this voucher' : 'Cashback selected from cart' %></strong>
                        <small>
                            Available $<%= loyalty ? Number(loyalty.wallet.cashbackBalance || 0).toFixed(2) : '0.00' %>.
                            <%= paymentCashbackBlockedByVoucher
                                ? 'Wallet cashback cannot be combined with a voucher in the same checkout.'
                                : `Estimated cashback applied: $${paymentCashbackEstimate.toFixed(2)}.` %>
                            Final value is confirmed at payment capture.
                        </small>
                    </span>
                            </div>
                        <% } else if (!(typeof cartCheckout !== 'undefined' && cartCheckout)) { %>
                            <div class="loyalty-redemption-card payment-cashback-card payment-reward-item">
                    <% if (typeof loyalty !== 'undefined' && loyalty && Number(loyalty.wallet.cashbackBalance || 0) > 0) { %>
                    <label>
                        <input type="checkbox" name="redeemCashback" value="on" <%= paymentCashbackBlockedByVoucher ? 'disabled' : '' %>>
                        <span>
                            <strong>Use cashback rewards</strong>
                            <small>
                                Available $<%= Number(loyalty.wallet.cashbackBalance || 0).toFixed(2) %>.
                                <%= paymentCashbackBlockedByVoucher
                                    ? 'Wallet cashback cannot be combined with the selected voucher.'
                                    : `Up to $${Math.min(Number(loyalty.wallet.cashbackBalance || 0), Number(amount || 0)).toFixed(2)} will be applied to this payment.` %>
                            </small>
                        </span>
                    </label>
                    <% } else { %>
                    <span>
                        <strong>No cashback available yet</strong>
                        <small>Complete this payment to earn rewards for your next checkout.</small>
                    </span>
                    <% } %>
                            </div>
                        <% } %>

                        <% if (campaignCashbackTotal > 0) { %>
                            <div class="notice success payment-reward-item">
                                <p>
                                    Estimated campaign cashback:
                                    <strong>$<%= campaignCashbackTotal.toFixed(2) %></strong>.
                                    Added to your wallet after successful payment.
                                </p>
                            </div>
                        <% } %>
                    </div>
                </section>
            <% } %>

            <section class="checkout-card payment-method-card-wrap">
                <div class="checkout-card-header payment-section-heading">
                    <h3>Payment method</h3>
                    <p>Select one method to continue.</p>
                </div>

                <fieldset class="payment-methods">
                    <legend class="eyebrow">Select payment method</legend>
                    <div class="payment-method-grid">
                    <label class="payment-method-card payment-method-card-wallet <%= initialPaymentMethod === 'wallet' ? 'is-selected' : '' %> <%= walletCanPay ? '' : 'is-disabled' %>" <%= walletCanPay ? '' : 'aria-disabled="true"' %>>
                        <input type="radio" name="paymentMethod" value="wallet" <%= initialPaymentMethod === 'wallet' ? 'checked' : '' %> <%= walletCanPay ? '' : 'disabled' %>>
                        <span class="payment-method-main">
                            <span class="payment-method-brand payment-brand-wallet" aria-hidden="true">Vaniday Wallet</span>
                            <span class="payment-method-copy">
                                <strong>E-wallet</strong>
                                <small>Use your wallet balance</small>
                                <small id="payment-ewallet-balance">Available: $<%= eWalletBalance.toFixed(2) %></small>
                                <small id="payment-ewallet-status"><%= walletCanPay ? 'Enough balance for this payment' : 'Insufficient balance. Choose another method.' %></small>
                                <small id="payment-ewallet-shortfall" style="<%= eWalletBalance >= paymentAmountDue ? 'display:none;' : '' %>">Top up needed: $<%= Math.max(paymentAmountDue - eWalletBalance, 0).toFixed(2) %></small>
                            </span>
                        </span>
                        <span class="payment-method-radio" aria-hidden="true"></span>
                    </label>
                    <label class="payment-method-card <%= initialPaymentMethod === 'paypal' ? 'is-selected' : '' %>">
                        <input type="radio" name="paymentMethod" value="paypal" <%= initialPaymentMethod === 'paypal' ? 'checked' : '' %>>
                        <span class="payment-method-main">
                            <span class="payment-method-brand payment-brand-paypal" aria-hidden="true">PayPal</span>
                            <span class="payment-method-copy"><strong>PayPal</strong><small>Fast checkout with your PayPal account</small></span>
                        </span>
                        <span class="payment-method-radio" aria-hidden="true"></span>
                    </label>
                    <label class="payment-method-card <%= initialPaymentMethod === 'stripe' ? 'is-selected' : '' %>">
                        <input type="radio" name="paymentMethod" value="stripe" <%= initialPaymentMethod === 'stripe' ? 'checked' : '' %>>
                        <span class="payment-method-main">
                            <span class="payment-method-brand payment-brand-stripe" aria-hidden="true">stripe</span>
                            <span class="payment-method-copy"><strong>Card (Stripe)</strong><small>Visa, Mastercard, and digital wallets</small></span>
                        </span>
                        <span class="payment-method-radio" aria-hidden="true"></span>
                    </label>
                    <label class="payment-method-card <%= initialPaymentMethod === 'nets' ? 'is-selected' : '' %>">
                        <input type="radio" name="paymentMethod" value="nets" <%= initialPaymentMethod === 'nets' ? 'checked' : '' %>>
                        <span class="payment-method-main">
                            <span class="payment-method-brand payment-brand-nets" aria-hidden="true">NETS</span>
                            <span class="payment-method-copy"><strong>NETS QR</strong><small>Scan the QR with your banking app</small></span>
                        </span>
                        <span class="payment-method-radio" aria-hidden="true"></span>
                    </label>
                    <label class="payment-method-card <%= initialPaymentMethod === 'paynow' ? 'is-selected' : '' %>">
                        <input type="radio" name="paymentMethod" value="paynow" <%= initialPaymentMethod === 'paynow' ? 'checked' : '' %>>
                        <span class="payment-method-main">
                            <span class="payment-method-brand payment-brand-paynow" aria-hidden="true">PayNow</span>
                            <span class="payment-method-copy"><strong>PayNow (HitPay)</strong><small>Secure transfer from your bank</small></span>
                        </span>
                        <span class="payment-method-radio" aria-hidden="true"></span>
                    </label>
                    </div>
                </fieldset>

                <div class="payment-method-notes">
                    <p id="nets-payment-note" class="muted payment-note" style="display:none;">
                        Continue to generate a NETS QR code for this payment.
                    </p>
                    <p id="paynow-payment-note" class="muted payment-note" style="display:none;">
                        Continue to secure HitPay checkout to complete this PayNow payment.
                    </p>
                    <p id="wallet-payment-note" class="muted payment-note">
                        Pay directly from your available e-wallet balance.
                    </p>
                    <p id="stripe-payment-note" class="muted payment-note" style="display:none;">
                        Continue to Stripe checkout.
                    </p>
                </div>
                <div id="paypal-message" class="notice error" style="display:none;"></div>
                <div id="paypal-button-container" style="display:none;"></div>
            </section>

            <div class="payment-submit-wrap">
                <button id="payment-submit-button" class="button primary full" type="submit">Pay with E-wallet</button>
                <p class="payment-submit-assurance">By continuing, you agree to complete this purchase securely via the selected payment provider.</p>
            </div>
        </form>

        <aside class="login-benefits payment-summary-card">
            <p class="eyebrow">Order summary</p>
            <h2><%= merchantName %></h2>
            <p class="muted"><%= serviceName %></p>
            <% if (fulfilmentLabel) { %>
                <div class="payment-detail-list">
                    <p><span>Fulfilment</span><strong id="payment-summary-fulfilment"><%= fulfilmentLabel %></strong></p>
                    <% if (checkoutHasProductItems) { %>
                        <p id="payment-summary-pickup-row"><span>Pickup merchant</span><strong id="payment-summary-pickup"><%= merchantName %></strong></p>
                        <p id="payment-summary-delivery-row" style="display:none;"><span>Delivery address</span><strong id="payment-summary-delivery">Not entered yet</strong></p>
                    <% } else { %>
                        <% if (fulfilment === 'pickup') { %>
                            <p><span>Pickup merchant</span><strong><%= merchantName %></strong></p>
                        <% } %>
                        <% if (fulfilment === 'delivery' && deliveryAddress) { %>
                            <p><span>Delivery address</span><strong><%= deliveryAddress %><% if (deliveryUnit) { %>, <%= deliveryUnit %><% } %></strong></p>
                        <% } %>
                    <% } %>
                </div>
            <% } %>
            <div class="cart-totals">
                <p><span>Subtotal</span><strong>$<%= Number(itemSubtotal || amount).toFixed(2) %></strong></p>
                <p id="payment-shipping-row" style="<%= Number(shippingFee || 0) > 0 ? '' : 'display:none;' %>"><span>Delivery fee</span><strong id="payment-shipping-value">$<%= Number(shippingFee || 0).toFixed(2) %></strong></p>
                <p id="payment-voucher-row" style="<%= paymentVoucherEstimate > 0 ? '' : 'display:none;' %>"><span>Voucher</span><strong id="payment-voucher-value">-$<%= paymentVoucherEstimate.toFixed(2) %></strong></p>
                <p id="payment-points-row" style="<%= paymentPointEstimate > 0 ? '' : 'display:none;' %>"><span>Points</span><strong id="payment-points-value">-$<%= paymentPointEstimate.toFixed(2) %></strong></p>
                <p id="payment-cashback-row" style="<%= paymentCashbackEstimate > 0 ? '' : 'display:none;' %>"><span>Wallet cashback used</span><strong id="payment-cashback-value">-$<%= paymentCashbackEstimate.toFixed(2) %></strong></p>
                <% if (campaignCashbackTotal > 0) { %>
                    <p><span>Campaign cashback earned</span><strong>+$<%= campaignCashbackTotal.toFixed(2) %></strong></p>
                <% } %>
                <p class="cart-total-line"><span>Total due</span><strong id="payment-summary-total">$<%= paymentAmountDue.toFixed(2) %></strong></p>
            </div>
            <p class="muted">Your final total updates automatically when options change.</p>
        </aside>
    </div>
</section>

<% if (paypalEnabled && paypalClientId) { %>
<script src="https://www.paypal.com/sdk/js?client-id=<%= encodeURIComponent(paypalClientId) %>&currency=SGD&intent=capture"></script>
<% } %>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
    const form = document.querySelector('.payment-form');
    const methodField = document.querySelector('[name="paymentMethod"]');
    const methodInputs = Array.from(document.querySelectorAll('input[name="paymentMethod"]'));
    const netsNote = document.getElementById('nets-payment-note');
    const paynowNote = document.getElementById('paynow-payment-note');
    const walletNote = document.getElementById('wallet-payment-note');
    const stripeNote = document.getElementById('stripe-payment-note');
    const submitButton = document.getElementById('payment-submit-button');
    const paypalButtonContainer = document.getElementById('paypal-button-container');
    const paypalMessage = document.getElementById('paypal-message');
    const redeemPointsInput = document.getElementById('payment-redeem-points');
    const pointsRow = document.getElementById('payment-points-row');
    const pointsValue = document.getElementById('payment-points-value');
    const voucherRow = document.getElementById('payment-voucher-row');
    const voucherValue = document.getElementById('payment-voucher-value');
    const shippingRow = document.getElementById('payment-shipping-row');
    const shippingValue = document.getElementById('payment-shipping-value');
    const cashbackRow = document.getElementById('payment-cashback-row');
    const cashbackValue = document.getElementById('payment-cashback-value');
    const summaryTotal = document.getElementById('payment-summary-total');
    const liveTotal = document.getElementById('payment-live-total');
    const amountInput = document.getElementById('payment-amount-input');
    const shippingInput = document.getElementById('payment-shipping-input');
    const voucherToggle = document.getElementById('payment-voucher-toggle');
    const voucherPanel = document.getElementById('payment-voucher-panel');
    const voucherInputs = Array.from(document.querySelectorAll('input[type="radio"][name="selectedVoucherId"]'));
    const fulfilmentChoices = Array.from(document.querySelectorAll('.payment-fulfilment-options .fulfilment-choice'));
    const fulfilmentRadios = Array.from(document.querySelectorAll('.payment-fulfilment-options input[name="fulfilment"]'));
    const pickupPanel = document.getElementById('payment-pickup-options');
    const deliveryPanel = document.getElementById('payment-delivery-options');
    const pickupSelect = document.getElementById('payment-pickup-merchant-select');
    const deliveryFields = Array.from(document.querySelectorAll('[data-payment-delivery-required]'));
    const fulfilmentPill = document.querySelector('.payment-fulfilment-pill');
    const summaryFulfilment = document.getElementById('payment-summary-fulfilment');
    const summaryPickupRow = document.getElementById('payment-summary-pickup-row');
    const summaryPickup = document.getElementById('payment-summary-pickup');
    const summaryDeliveryRow = document.getElementById('payment-summary-delivery-row');
    const summaryDelivery = document.getElementById('payment-summary-delivery');
    const ewalletBalanceCopy = document.getElementById('payment-ewallet-balance');
    const ewalletStatusCopy = document.getElementById('payment-ewallet-status');
    const ewalletShortfallCopy = document.getElementById('payment-ewallet-shortfall');
    const walletMethodInput = document.querySelector('input[name="paymentMethod"][value="wallet"]');
    const walletMethodCard = walletMethodInput ? walletMethodInput.closest('.payment-method-card') : null;
    const paypalEnabled = <%= paypalEnabled ? 'true' : 'false' %>;

    function setPayPalMessage(message) {
        if (!paypalMessage) return;
        paypalMessage.style.display = message ? '' : 'none';
        paypalMessage.innerHTML = message ? '<p>' + String(message) + '</p>' : '';
    }

    function collectPaymentPayload() {
        if (!form) return {};
        const formData = new FormData(form);
        const payload = {};

        formData.forEach((value, key) => {
            payload[key] = value;
        });

        payload.redeemCashback = formData.get('redeemCashback') ? 'on' : '';
        return payload;
    }

    async function postJson(url, payload) {
        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken,
                Accept: 'application/json'
            },
            body: JSON.stringify(payload)
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok || data.success === false) {
            throw new Error(data.message || 'Request failed.');
        }

        return data;
    }

    function formatMoney(value) {
        return '$' + Number(value || 0).toFixed(2);
    }

    function syncWalletAvailability(totalDue) {
        const walletBalance = Number(form?.dataset.ewalletBalance || 0);
        const shortfall = Math.max(Number(totalDue || 0) - walletBalance, 0);
        const walletAvailable = shortfall <= 0;

        if (ewalletBalanceCopy) {
            ewalletBalanceCopy.textContent = 'Available: ' + formatMoney(walletBalance);
        }

        if (ewalletStatusCopy) {
            ewalletStatusCopy.textContent = shortfall > 0
                ? 'Insufficient balance. Choose another method.'
                : 'Enough balance for this payment';
        }

        if (ewalletShortfallCopy) {
            ewalletShortfallCopy.style.display = shortfall > 0 ? '' : 'none';
            ewalletShortfallCopy.textContent = 'Top up needed: ' + formatMoney(shortfall);
        }

        if (walletMethodInput) {
            walletMethodInput.disabled = !walletAvailable;
            if (!walletAvailable && walletMethodInput.checked) {
                const fallbackInput = methodInputs.find((input) => !input.disabled && input.value !== 'wallet')
                    || methodInputs.find((input) => !input.disabled);
                if (fallbackInput) {
                    fallbackInput.checked = true;
                }
            }
        }

        if (walletMethodCard) {
            walletMethodCard.classList.toggle('is-disabled', !walletAvailable);
            walletMethodCard.setAttribute('aria-disabled', walletAvailable ? 'false' : 'true');
        }

        syncPaymentMethod();
    }

    function getVoucherDiscount(baseAmount) {
        const selectedVoucher = voucherInputs.find((input) => input.checked);
        if (!selectedVoucher || selectedVoucher.value === 'none') {
            return selectedVoucher && selectedVoucher.value === 'none'
                ? 0
                : Math.min(Number(form?.dataset.voucherEstimate || 0), baseAmount);
        }

        const discountType = selectedVoucher.dataset.discountType || 'fixed';
        const discountPercent = Number(selectedVoucher.dataset.discountPercent || 0);
        const discountValue = Number(selectedVoucher.dataset.discountValue || 0);

        if (discountType === 'percentage') {
            return Math.min(baseAmount * (discountPercent / 100), baseAmount);
        }

        return Math.min(discountValue, baseAmount);
    }

    function syncVoucherRedemption() {
        if (!form || !summaryTotal || !liveTotal) return;

        const baseAmount = Number(form.dataset.baseAmount || 0);
        const voucherDiscount = getVoucherDiscount(baseAmount);
        const voucherApplied = voucherDiscount > 0;
        const cashbackBalance = Number(form.dataset.cashbackBalance || 0);
        const cashbackCheckbox = form.querySelector('input[type="checkbox"][name="redeemCashback"]');
        const cashbackHidden = form.querySelector('input[type="hidden"][name="useCashback"][value="true"]');
        const cashbackRequestFields = Array.from(form.querySelectorAll('input[type="hidden"][name="redeemCashback"], input[type="hidden"][name="useCashback"]'));
        const useCashback = !voucherApplied && Boolean((cashbackCheckbox && cashbackCheckbox.checked) || cashbackHidden);
        const cashbackApplied = useCashback ? Math.min(cashbackBalance, Math.max(baseAmount - voucherDiscount, 0)) : 0;

        if (cashbackCheckbox) cashbackCheckbox.disabled = voucherApplied;
        cashbackRequestFields.forEach((field) => {
            field.disabled = voucherApplied;
        });
        if (voucherRow) voucherRow.style.display = voucherDiscount > 0 ? '' : 'none';
        if (voucherValue) voucherValue.textContent = '-' + formatMoney(voucherDiscount);
        if (cashbackRow) cashbackRow.style.display = cashbackApplied > 0 ? '' : 'none';
        if (cashbackValue) cashbackValue.textContent = '-' + formatMoney(cashbackApplied);

        if (redeemPointsInput) {
            redeemPointsInput.dataset.baseAmount = Math.max(baseAmount - voucherDiscount, 0).toFixed(2);
            redeemPointsInput.dataset.cashbackEstimate = cashbackApplied.toFixed(2);
            syncPointRedemption();
            return;
        }

        const totalDue = Math.max(baseAmount - voucherDiscount - cashbackApplied, 0);
        summaryTotal.textContent = formatMoney(totalDue);
        liveTotal.textContent = formatMoney(totalDue);
        syncWalletAvailability(totalDue);
    }

    function getFulfilmentValue() {
        return fulfilmentRadios.find((input) => input.checked)?.value || 'pickup';
    }

    function getDeliverySummary() {
        const values = {};
        deliveryFields.forEach((field) => {
            values[field.name] = String(field.value || '').trim();
        });

        if (!values.deliveryAddress) {
            return 'Not entered yet';
        }

        return [values.deliveryAddress, values.deliveryUnit, values.deliveryPostal].filter(Boolean).join(', ');
    }

    function syncCheckoutFulfilment() {
        if (!form || !fulfilmentRadios.length) return;

        const selected = getFulfilmentValue();
        const itemSubtotal = Number(form.dataset.itemSubtotal || form.dataset.baseAmount || 0);
        const deliveryFee = selected === 'delivery' ? Number(form.dataset.deliveryFee || 0) : 0;
        const baseAmount = Math.round((itemSubtotal + deliveryFee) * 100) / 100;

        fulfilmentChoices.forEach((choice) => {
            const input = choice.querySelector('input[name="fulfilment"]');
            choice.classList.toggle('active', input && input.checked);
        });
        if (pickupPanel) pickupPanel.style.display = selected === 'pickup' ? '' : 'none';
        if (deliveryPanel) deliveryPanel.style.display = selected === 'delivery' ? '' : 'none';
        if (pickupSelect) pickupSelect.disabled = selected !== 'pickup';
        deliveryFields.forEach((field) => {
            const isDelivery = selected === 'delivery';
            field.required = isDelivery;
            field.disabled = !isDelivery;
        });
        form.dataset.baseAmount = baseAmount.toFixed(2);
        if (amountInput) amountInput.value = baseAmount.toFixed(2);
        if (shippingInput) shippingInput.value = deliveryFee.toFixed(2);
        if (shippingRow) shippingRow.style.display = deliveryFee > 0 ? '' : 'none';
        if (shippingValue) shippingValue.textContent = formatMoney(deliveryFee);
        if (fulfilmentPill) fulfilmentPill.textContent = selected === 'delivery' ? 'Delivery' : 'Pick up';
        if (summaryFulfilment) summaryFulfilment.textContent = selected === 'delivery' ? 'Delivery' : 'Pick up';
        if (summaryPickupRow) summaryPickupRow.style.display = selected === 'pickup' ? '' : 'none';
        if (summaryDeliveryRow) summaryDeliveryRow.style.display = selected === 'delivery' ? '' : 'none';
        if (summaryPickup && pickupSelect) {
            summaryPickup.textContent = pickupSelect.options[pickupSelect.selectedIndex]?.text || 'Any merchant';
        }
        if (summaryDelivery) summaryDelivery.textContent = getDeliverySummary();
        syncVoucherRedemption();
    }

    function syncPointRedemption() {
        if (!redeemPointsInput || !summaryTotal || !liveTotal) return;

        const maxPoints = Number(redeemPointsInput.max || 0);
        const points = Math.max(0, Math.min(Math.floor(Number(redeemPointsInput.value || 0)), maxPoints));
        const rate = Number(redeemPointsInput.dataset.pointRate || 0);
        const maxDiscount = Number(redeemPointsInput.dataset.maxDiscount || 0);
        const baseAmount = Number(redeemPointsInput.dataset.baseAmount || 0);
        const cashbackEstimate = Number(redeemPointsInput.dataset.cashbackEstimate || 0);
        const pointsDiscount = Math.min(points * rate, maxDiscount, baseAmount);
        const totalDue = Math.max(baseAmount - pointsDiscount - cashbackEstimate, 0);

        redeemPointsInput.value = String(points);
        if (pointsRow) pointsRow.style.display = pointsDiscount > 0 ? '' : 'none';
        if (pointsValue) pointsValue.textContent = '-' + formatMoney(pointsDiscount);
        summaryTotal.textContent = formatMoney(totalDue);
        liveTotal.textContent = formatMoney(totalDue);
        syncWalletAvailability(totalDue);
    }

    function syncPaymentMethod() {
        let selectedInput = methodInputs.find((input) => input.checked);
        if (!selectedInput || selectedInput.disabled) {
            const fallbackInput = methodInputs.find((input) => !input.disabled);
            if (fallbackInput) {
                fallbackInput.checked = true;
                selectedInput = fallbackInput;
            }
        }

        const selected = selectedInput?.value || methodField?.value || 'wallet';

        document.querySelectorAll('.payment-method-card').forEach((card) => {
            const input = card.querySelector('input[name="paymentMethod"]');
            card.classList.toggle('is-selected', Boolean(input && input.checked && !input.disabled));
        });
        const isPaypal = selected === 'paypal';
        if (netsNote) netsNote.style.display = selected === 'nets' ? '' : 'none';
        if (paynowNote) paynowNote.style.display = selected === 'paynow' ? '' : 'none';
        if (stripeNote) stripeNote.style.display = selected === 'stripe' ? '' : 'none';
        if (walletNote) walletNote.style.display = selected === 'wallet' ? '' : 'none';
        if (paypalButtonContainer) paypalButtonContainer.style.display = isPaypal ? '' : 'none';
        if (submitButton) submitButton.style.display = isPaypal ? 'none' : '';
        if (submitButton) {
            const labels = {
                wallet: 'Pay with E-wallet',
                paypal: 'Continue with PayPal',
                stripe: 'Continue with Stripe',
                nets: 'Generate NETS QR',
                paynow: 'Continue with PayNow'
            };
            submitButton.textContent = labels[selected] || 'Continue payment';
        }

        if (!isPaypal) {
            setPayPalMessage('');
        } else if (!paypalEnabled) {
            setPayPalMessage('PayPal is not configured on this server yet.');
        }
    }

    if (paypalEnabled && window.paypal && paypalButtonContainer) {
        window.paypal.Buttons({
            style: {
                layout: 'vertical',
                shape: 'rect',
                label: 'paypal'
            },
            createOrder: async function () {
                setPayPalMessage('');
                if (form && !form.reportValidity()) {
                    throw new Error('Please complete the required checkout details.');
                }
                const payload = collectPaymentPayload();
                const result = await postJson('/api/paypal/create-order', payload);
                return result.orderId;
            },
            onApprove: async function (data) {
                setPayPalMessage('');
                const result = await postJson('/api/paypal/capture-order', { orderId: data.orderID });
                if (result.redirectUrl) {
                    window.location.assign(result.redirectUrl);
                }
            },
            onCancel: function () {
                setPayPalMessage('PayPal checkout was cancelled before payment was approved.');
            },
            onError: function (error) {
                console.error('PayPal checkout error:', error);
                setPayPalMessage(error?.message || 'PayPal checkout could not be completed.');
            }
        }).render('#paypal-button-container');
    }

    methodInputs.forEach((input) => input.addEventListener('change', syncPaymentMethod));
    methodField?.addEventListener('change', syncPaymentMethod);
    fulfilmentRadios.forEach((input) => input.addEventListener('change', syncCheckoutFulfilment));
    if (pickupSelect) pickupSelect.addEventListener('change', syncCheckoutFulfilment);
    deliveryFields.forEach((field) => {
        field.addEventListener('input', syncCheckoutFulfilment);
        field.addEventListener('change', syncCheckoutFulfilment);
    });
    if (voucherToggle && voucherPanel) {
        const selectedVoucherInput = voucherPanel.querySelector('input[name="selectedVoucherId"]:checked');
        if (selectedVoucherInput && selectedVoucherInput.value && selectedVoucherInput.value !== 'none') {
            voucherToggle.setAttribute('aria-expanded', 'true');
            voucherPanel.hidden = false;
        }

        voucherToggle.addEventListener('click', function () {
            const isOpen = voucherToggle.getAttribute('aria-expanded') === 'true';
            voucherToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
            voucherPanel.hidden = isOpen;
        });
    }
    voucherInputs.forEach((input) => {
        input.addEventListener('change', syncVoucherRedemption);
    });
    if (redeemPointsInput) {
        redeemPointsInput.addEventListener('input', syncPointRedemption);
        redeemPointsInput.addEventListener('change', syncPointRedemption);
    }
    if (voucherInputs.some((input) => input.checked) || Number(form?.dataset.voucherEstimate || 0) > 0) {
        syncVoucherRedemption();
    }
    syncCheckoutFulfilment();
    syncPaymentMethod();
});
</script>

<%- include('partials/footer') %>
