        const persistAiChat = () => {
            if (!aiChatHistory) return;
            const rows = Array.from(aiChatHistory.querySelectorAll('.vaniday-ai-message')).map((message) => ({
                role: message.dataset.role || 'assistant',
                text: message.querySelector('.vaniday-ai-message-text')?.textContent || ''
            })).filter((row) => row.text);
            sessionStorage.setItem(aiChatStorageKey, JSON.stringify(rows.slice(-20)));
        };
        const appendAiMessage = (role, text, children = []) => {
