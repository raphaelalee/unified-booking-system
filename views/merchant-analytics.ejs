<%- include('partials/header', { title }) %>

<%
    const appointments = typeof appointmentReport !== 'undefined' && appointmentReport ? appointmentReport : {};
    const rewardRedemptions = appointments.rewardRedemptions || {};
    const customerInsights = customerReport?.insights || {};
    const sales = salesReport || {};
    const safeStats = typeof stats !== 'undefined' && stats ? stats : {};
    const safeRefundStats = typeof refundStats !== 'undefined' && refundStats ? refundStats : {};
    const exportDatasets = [
        { id: 'salesRevenue', label: 'Sales or Revenue', description: 'Daily revenue, references, fees and net revenue.' },
        { id: 'bookings', label: 'Bookings', description: 'Service bookings, statuses, staff and payment details.' },
        { id: 'productOrders', label: 'Product Orders', description: 'Product order lines, fulfilment and payment status.' },
        { id: 'refunds', label: 'Refunds', description: 'Refund references, deductions and customer refund amounts.' },
        { id: 'customers', label: 'Customers', description: 'Customer spend, frequency and recent activity.' },
        { id: 'servicePerformance', label: 'Service Performance', description: 'Booking counts, completion and service revenue.' },
        { id: 'productPerformance', label: 'Product Performance', description: 'Units sold, discounts, refunds and net revenue.' },
        { id: 'payments', label: 'Payments', description: 'Transactions, methods, providers and refund status.' }
    ];
    const formatCurrency = (value) => Number(value || 0).toFixed(2);
    const formatPercent = (value) => Number(value || 0).toFixed(1);
    const normalizeStatus = (value) => String(value || 'pending').trim().toLowerCase().replace(/\s+/g, '_');
    const allBookings = Array.isArray(appointments.allBookings) ? appointments.allBookings : [];
    const allOrders = Array.isArray(sales.allOrders) ? sales.allOrders : [];
    const recentOrders = Array.isArray(sales.recentOrders) ? sales.recentOrders : allOrders.slice(0, 5);
    const uniqueBookings = Array.from(new Map(allBookings.map((booking, index) => {
        const key = booking.id || `${booking.customerEmail || booking.email || booking.customerName || 'customer'}-${booking.bookingDate || booking.booking_date || index}-${booking.bookingTime || booking.booking_time || ''}-${booking.serviceName || booking.service_name || ''}`;
        return [String(key), booking];
    })).values());
    const statusRows = Object.entries(uniqueBookings.reduce((counts, booking) => {
        const status = normalizeStatus(booking.status);
        counts[status] = (counts[status] || 0) + 1;
        return counts;
    }, {})).map(([status, count]) => ({ status, count }));
    const topCustomers = Array.isArray(customerInsights.topCustomers) ? customerInsights.topCustomers : [];
    const paymentRows = Object.values(allOrders.reduce((rows, order) => {
        const method = String(order.paymentMethod || order.payment_method || 'Not set').trim() || 'Not set';
        if (!rows[method]) rows[method] = { method, count: 0, amount: 0 };
        rows[method].count += 1;
        rows[method].amount += Number(order.totalAmount || order.paidAmount || order.amount || 0);
        return rows;
    }, {})).sort((left, right) => right.amount - left.amount);
    const refundTotal = Object.values(safeRefundStats).reduce((sum, value) => sum + Number(value || 0), 0);
    const hasSalesData = (sales.dailySales || []).some((day) => Number(day.revenue || 0) > 0 || Number(day.orders || 0) > 0);
    const hasBookingData = uniqueBookings.length > 0;
    const hasOrderData = allOrders.length > 0;
    const hasCustomerData = topCustomers.length > 0;
    const hasRefundData = refundTotal > 0;
    const chartPayload = {
        salesLabels: (sales.dailySales || []).map((day) => day.label),
        salesRevenue: (sales.dailySales || []).map((day) => Number(day.revenue || 0)),
        salesOrders: (sales.dailySales || []).map((day) => Number(day.orders || 0)),
        ageLabels: customerInsights.chartPayload?.ageLabels || ['Not set'],
        ageValues: customerInsights.chartPayload?.ageValues || [0],
        genderLabels: customerInsights.chartPayload?.genderLabels || ['Not set'],
        genderValues: customerInsights.chartPayload?.genderValues || [0],
        contactLabels: customerInsights.chartPayload?.contactMethodLabels || ['Not set'],
        contactValues: customerInsights.chartPayload?.contactMethodValues || [0],
        serviceLabels: customerInsights.chartPayload?.serviceLabels || ['No service'],
        serviceValues: customerInsights.chartPayload?.serviceValues || [0],
        hourLabels: customerInsights.chartPayload?.hourLabels || ['No bookings'],
        hourValues: customerInsights.chartPayload?.hourValues || [0],
        statusLabels: statusRows.length ? statusRows.map((row) => row.status.replace(/_/g, ' ')) : ['No bookings'],
        statusValues: statusRows.length ? statusRows.map((row) => row.count) : [0],
        paymentLabels: paymentRows.length ? paymentRows.map((row) => row.method.replace(/_/g, ' ')) : ['No payments'],
        paymentValues: paymentRows.length ? paymentRows.map((row) => row.amount) : [0]
    };
%>

<section class="section compact merchant-analytics-page merchant-analytics-redesign">
    <div class="merchant-analytics-shell">
        <header class="merchant-analytics-header">
            <div class="merchant-analytics-title-block">
                <p class="eyebrow">Merchant Analytics</p>
                <h1>Revenue, customers and demand</h1>
                <p>Track booking demand, product orders, customer patterns, refunds and report exports from one compact workspace.</p>
            </div>

            <div class="merchant-analytics-header-controls" data-export-scope="merchant">
                <label>
                    <span>Start date</span>
                    <input type="date" data-report-start-date>
                </label>
                <label>
                    <span>End date</span>
                    <input type="date" data-report-end-date>
                </label>
                <button class="button secondary" type="button" data-report-apply>Apply filter</button>
                <button class="button primary" type="button" data-export-open>Export report</button>
                <p class="merchant-analytics-control-message" data-report-message role="status" aria-live="polite"></p>
            </div>
        </header>

        <% if (typeof databaseError !== 'undefined' && databaseError) { %>
            <div class="merchant-analytics-alert" role="alert">
                Some analytics data could not be loaded. Available sections are still shown below.
            </div>
        <% } %>

        <section class="merchant-analytics-kpi-grid" aria-label="Merchant analytics summary">
            <article class="merchant-analytics-kpi-card">
                <span>Total revenue</span>
                <strong>$<%= formatCurrency(safeStats.totalRevenue || appointments.monthlyRevenue) %></strong>
                <small>Bookings and product orders</small>
            </article>
            <article class="merchant-analytics-kpi-card">
                <span>Total bookings</span>
                <strong><%= safeStats.bookingCount || uniqueBookings.length %></strong>
                <small><%= appointments.pendingAppointments?.length || 0 %> pending approvals</small>
            </article>
            <article class="merchant-analytics-kpi-card">
                <span>Product orders</span>
                <strong><%= safeStats.totalOrders || allOrders.length %></strong>
                <small><%= recentOrders.length %> recent order<%= recentOrders.length === 1 ? '' : 's' %></small>
            </article>
            <article class="merchant-analytics-kpi-card">
                <span>Customers</span>
                <strong><%= safeStats.customerCount || customerReport?.totalCustomers || 0 %></strong>
                <small><%= formatPercent(customerInsights.repeatRate) %>% repeat rate</small>
            </article>
            <article class="merchant-analytics-kpi-card">
                <span>Refunds</span>
                <strong><%= refundTotal %></strong>
                <small><%= safeRefundStats.pendingCount || 0 %> pending review</small>
            </article>
            <article class="merchant-analytics-kpi-card">
                <span>Average order value</span>
                <strong>$<%= formatCurrency(safeStats.averageOrderValue) %></strong>
                <small>Across supported sales data</small>
            </article>
        </section>

        <section class="merchant-analytics-chart-tabs" aria-label="Chart focus">
            <div>
                <p class="eyebrow">Interactive view</p>
                <h2 data-merchant-chart-title>Sales trend</h2>
            </div>
            <div class="analytics-segmented-control" role="group" aria-label="Merchant analytics chart view">
                <button type="button" class="active" data-merchant-chart-mode="sales">Sales</button>
                <button type="button" data-merchant-chart-mode="services">Services</button>
                <button type="button" data-merchant-chart-mode="hours">Hours</button>
                <button type="button" data-merchant-chart-mode="customers">Customers</button>
            </div>
        </section>

        <section class="merchant-analytics-grid">
            <article class="merchant-analytics-card merchant-analytics-card-wide">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Revenue trend</h3>
                        <p>Daily revenue and order count from current analytics data.</p>
                    </div>
                    <span class="merchant-analytics-status-pill"><%= hasSalesData ? 'Live data' : 'No sales yet' %></span>
                </div>
                <div class="merchant-chart-box merchant-analytics-chart-large">
                    <canvas id="merchantAnalyticsChart"></canvas>
                </div>
                <% if (!hasSalesData) { %>
                    <p class="merchant-analytics-empty">No analytics data is available for the selected period. Try a wider date range after orders are recorded.</p>
                <% } %>
            </article>

            <article class="merchant-analytics-card">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Booking status</h3>
                        <p>Current status mix across merchant bookings.</p>
                    </div>
                </div>
                <div class="merchant-chart-box merchant-analytics-chart-small">
                    <canvas id="merchantStatusChart"></canvas>
                </div>
                <% if (!hasBookingData) { %>
                    <p class="merchant-analytics-empty">No analytics data is available for the selected period.</p>
                <% } %>
            </article>

            <article class="merchant-analytics-card">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Product performance</h3>
                        <p>Recent product orders and value.</p>
                    </div>
                </div>
                <div class="merchant-analytics-table-list">
                    <% recentOrders.slice(0, 5).forEach((order) => { %>
                        <article>
                            <div>
                                <strong><%= order.orderNumber || order.order_number || order.receiptId || `Order #${order.id || ''}` %></strong>
                                <span><%= order.itemNames || order.item_names || 'Product order' %></span>
                            </div>
                            <b>$<%= formatCurrency(order.totalAmount || order.paidAmount || order.amount) %></b>
                        </article>
                    <% }) %>
                    <% if (!hasOrderData) { %>
                        <p class="merchant-analytics-empty">No analytics data is available for the selected period.</p>
                    <% } %>
                </div>
            </article>

            <article class="merchant-analytics-card">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Service performance</h3>
                        <p>Top services by booking volume.</p>
                    </div>
                </div>
                <div class="merchant-chart-box merchant-analytics-chart-small">
                    <canvas id="merchantServiceChart"></canvas>
                </div>
                <% if (!hasBookingData) { %>
                    <p class="merchant-analytics-empty">No analytics data is available for the selected period.</p>
                <% } %>
            </article>

            <article class="merchant-analytics-card">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Payment-method breakdown</h3>
                        <p>Order value grouped by stored payment method.</p>
                    </div>
                </div>
                <div class="merchant-chart-box merchant-analytics-chart-small">
                    <canvas id="merchantPaymentChart"></canvas>
                </div>
                <% if (!paymentRows.length) { %>
                    <p class="merchant-analytics-empty">No analytics data is available for the selected period.</p>
                <% } %>
            </article>

            <article class="merchant-analytics-card">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Customer insights</h3>
                        <p>Top customers by visits and spend.</p>
                    </div>
                </div>
                <div class="analytics-ranking-list merchant-analytics-ranking">
                    <% topCustomers.slice(0, 5).forEach((customer, index) => { %>
                        <article>
                            <span><%= index + 1 %></span>
                            <div>
                                <strong><%= customer.customerName || 'Customer' %></strong>
                                <small><%= customer.visits %> visits, last <%= customer.lastBookingDate || 'n/a' %></small>
                            </div>
                            <b>$<%= formatCurrency(customer.spend) %></b>
                        </article>
                    <% }) %>
                    <% if (!hasCustomerData) { %>
                        <p class="merchant-analytics-empty">No analytics data is available for the selected period.</p>
                    <% } %>
                </div>
            </article>

            <article class="merchant-analytics-card">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Refund summary</h3>
                        <p>Current refund queue and completed outcomes.</p>
                    </div>
                </div>
                <div class="merchant-analytics-metric-list">
                    <p><span>Pending</span><strong><%= safeRefundStats.pendingCount || 0 %></strong></p>
                    <p><span>Approved</span><strong><%= safeRefundStats.approvedCount || 0 %></strong></p>
                    <p><span>Processing</span><strong><%= safeRefundStats.processingCount || 0 %></strong></p>
                    <p><span>Refunded</span><strong><%= safeRefundStats.refundedCount || 0 %></strong></p>
                    <p><span>Rejected</span><strong><%= safeRefundStats.rejectedCount || 0 %></strong></p>
                    <p><span>Failed</span><strong><%= safeRefundStats.failedCount || 0 %></strong></p>
                </div>
                <% if (!hasRefundData) { %>
                    <p class="merchant-analytics-empty">No refund activity is available for the selected period.</p>
                <% } %>
            </article>

            <article class="merchant-analytics-card">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Loyalty impact</h3>
                        <p>Reward use and loyalty-driven revenue.</p>
                    </div>
                </div>
                <div class="merchant-analytics-metric-list">
                    <p><span>Reward bookings</span><strong><%= rewardRedemptions.rewardBookingCount || 0 %></strong></p>
                    <p><span>Redeemed value</span><strong>$<%= formatCurrency(rewardRedemptions.totalRedeemedValue) %></strong></p>
                    <p><span>Loyalty revenue</span><strong>$<%= formatCurrency(rewardRedemptions.loyaltyDrivenRevenue) %></strong></p>
                    <p><span>Repeat reward customers</span><strong><%= rewardRedemptions.repeatRewardCustomers || 0 %></strong></p>
                </div>
            </article>

            <article class="merchant-analytics-card">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Age segments</h3>
                        <p>Customer age mix where profile data is available.</p>
                    </div>
                </div>
                <div class="merchant-chart-box merchant-analytics-chart-small">
                    <canvas id="merchantAgeChart"></canvas>
                </div>
            </article>

            <article class="merchant-analytics-card">
                <div class="merchant-analytics-card-heading">
                    <div>
                        <h3>Gender mix</h3>
                        <p>Customer gender mix where profile data is available.</p>
                    </div>
                </div>
                <div class="merchant-chart-box merchant-analytics-chart-small">
                    <canvas id="merchantGenderChart"></canvas>
                </div>
            </article>
        </section>
    </div>
</section>

<div class="merchant-export-modal" data-export-modal hidden>
    <div class="merchant-export-dialog" role="dialog" aria-modal="true" aria-labelledby="merchantExportTitle" aria-describedby="merchantExportDescription">
        <header class="merchant-export-dialog-header">
            <div>
                <h2 id="merchantExportTitle">Export report</h2>
                <p id="merchantExportDescription">Choose one or more merchant analytics datasets and download a single XLSX workbook.</p>
            </div>
            <button class="merchant-export-close" type="button" data-export-close aria-label="Close export report">x</button>
        </header>
        <div class="merchant-export-dialog-body">
            <div class="merchant-export-date-grid">
                <label>
                    <span>Start date</span>
                    <input type="date" data-export-start-date>
                </label>
                <label>
                    <span>End date</span>
                    <input type="date" data-export-end-date>
                </label>
            </div>
            <div class="merchant-export-selection-bar">
                <label class="analytics-export-option select-all">
                    <input type="checkbox" data-export-select-all value="all">
                    <span>Select all</span>
                </label>
                <strong data-export-count>0 datasets selected</strong>
            </div>
            <div class="merchant-export-options" aria-label="Export datasets">
                <% exportDatasets.forEach((dataset) => { %>
                    <label class="analytics-export-option">
                        <input type="checkbox" data-export-dataset value="<%= dataset.id %>">
                        <span><strong><%= dataset.label %></strong><small><%= dataset.description %></small></span>
                    </label>
                <% }) %>
            </div>
            <p class="analytics-export-message" data-export-message role="status" aria-live="polite"></p>
        </div>
        <footer class="merchant-export-dialog-footer">
            <button class="button secondary" type="button" data-export-clear>Clear</button>
            <button class="button primary" type="button" data-export-button disabled>Download XLSX</button>
        </footer>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (() => {
        const chartPayload = <%- JSON.stringify(chartPayload) %>;
        const palette = { green: '#3f6b3a', blue: '#20899c', orange: '#df7c16', yellow: '#d4a017', red: '#a64032' };
        const mainCanvas = document.getElementById('merchantAnalyticsChart');
        const title = document.querySelector('[data-merchant-chart-title]');
        let mainChart;
        const baseOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } },
            scales: { x: { grid: { display: false } }, y: { beginAtZero: true } }
        };
        const chartConfigs = {
            sales: {
                title: 'Sales trend',
                type: 'line',
                labels: chartPayload.salesLabels,
                datasets: [
                    { label: 'Revenue', data: chartPayload.salesRevenue, borderColor: palette.green, backgroundColor: 'rgba(63,107,58,.12)', fill: true, tension: 0.35 },
                    { label: 'Orders', data: chartPayload.salesOrders, borderColor: palette.blue, backgroundColor: 'rgba(32,137,156,.12)', tension: 0.35 }
                ]
            },
            services: {
                title: 'Top services by bookings',
                type: 'bar',
                labels: chartPayload.serviceLabels,
                datasets: [{ label: 'Bookings', data: chartPayload.serviceValues, backgroundColor: 'rgba(63,107,58,.28)' }],
                options: { ...baseOptions, indexAxis: 'y' }
            },
            hours: {
                title: 'Peak booking hours',
                type: 'bar',
                labels: chartPayload.hourLabels,
                datasets: [{ label: 'Bookings', data: chartPayload.hourValues, backgroundColor: 'rgba(223,124,22,.28)' }]
            },
            customers: {
                title: 'Customer contact preference',
                type: 'doughnut',
                labels: chartPayload.contactLabels,
                datasets: [{ data: chartPayload.contactValues, backgroundColor: [palette.green, palette.blue, palette.orange, palette.yellow, palette.red] }]
            }
        };
        const renderMainChart = (mode) => {
            if (!mainCanvas || typeof Chart === 'undefined') return;
            const config = chartConfigs[mode] || chartConfigs.sales;
            if (mainChart) mainChart.destroy();
            if (title) title.textContent = config.title;
            mainChart = new Chart(mainCanvas, {
                type: config.type,
                data: { labels: config.labels, datasets: config.datasets },
                options: config.type === 'doughnut'
                    ? { responsive: true, maintainAspectRatio: false, plugins: baseOptions.plugins }
                    : (config.options || baseOptions)
            });
        };
        const makeChart = (id, config) => {
            const canvas = document.getElementById(id);
            if (canvas && typeof Chart !== 'undefined') new Chart(canvas, config);
        };

        document.querySelectorAll('[data-merchant-chart-mode]').forEach((button) => {
            button.addEventListener('click', () => {
                document.querySelectorAll('[data-merchant-chart-mode]').forEach((item) => item.classList.remove('active'));
                button.classList.add('active');
                renderMainChart(button.dataset.merchantChartMode);
            });
        });

        makeChart('merchantStatusChart', { type: 'doughnut', data: { labels: chartPayload.statusLabels, datasets: [{ data: chartPayload.statusValues, backgroundColor: [palette.green, palette.blue, palette.orange, palette.yellow, palette.red] }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } } });
        makeChart('merchantServiceChart', { type: 'bar', data: { labels: chartPayload.serviceLabels, datasets: [{ label: 'Bookings', data: chartPayload.serviceValues, backgroundColor: 'rgba(63,107,58,.28)' }] }, options: { ...baseOptions, indexAxis: 'y' } });
        makeChart('merchantPaymentChart', { type: 'doughnut', data: { labels: chartPayload.paymentLabels, datasets: [{ data: chartPayload.paymentValues, backgroundColor: [palette.green, palette.blue, palette.orange, palette.yellow, palette.red] }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } } });
        makeChart('merchantAgeChart', { type: 'bar', data: { labels: chartPayload.ageLabels, datasets: [{ label: 'Customers', data: chartPayload.ageValues, backgroundColor: 'rgba(32,137,156,.24)' }] }, options: baseOptions });
        makeChart('merchantGenderChart', { type: 'doughnut', data: { labels: chartPayload.genderLabels, datasets: [{ data: chartPayload.genderValues, backgroundColor: [palette.green, palette.blue, palette.orange, palette.yellow, palette.red] }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } } });

        const modal = document.querySelector('[data-export-modal]');
        const openButton = document.querySelector('[data-export-open]');
        const closeButton = document.querySelector('[data-export-close]');
        const selectAll = document.querySelector('[data-export-select-all]');
        const datasetInputs = Array.from(document.querySelectorAll('[data-export-dataset]'));
        const exportButton = document.querySelector('[data-export-button]');
        const clearButton = document.querySelector('[data-export-clear]');
        const countNode = document.querySelector('[data-export-count]');
        const messageNode = document.querySelector('[data-export-message]');
        const reportMessage = document.querySelector('[data-report-message]');
        const reportStartDate = document.querySelector('[data-report-start-date]');
        const reportEndDate = document.querySelector('[data-report-end-date]');
        const reportApply = document.querySelector('[data-report-apply]');
        const startDateInput = document.querySelector('[data-export-start-date]');
        const endDateInput = document.querySelector('[data-export-end-date]');
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
        let exportInProgress = false;
        let lastFocusedElement = null;

        const selectedDatasets = () => datasetInputs.filter((input) => input.checked).map((input) => input.value);
        const focusableSelector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
        const setExportMessage = (message, tone = '') => {
            if (!messageNode) return;
            messageNode.textContent = message || '';
            messageNode.dataset.tone = tone;
        };
        const syncExportState = () => {
            const selected = selectedDatasets();
            if (selectAll) {
                selectAll.checked = selected.length === datasetInputs.length && datasetInputs.length > 0;
                selectAll.indeterminate = selected.length > 0 && selected.length < datasetInputs.length;
            }
            if (countNode) {
                countNode.textContent = `${selected.length} dataset${selected.length === 1 ? '' : 's'} selected`;
            }
            if (exportButton) {
                exportButton.disabled = exportInProgress || selected.length === 0;
            }
        };
        const getFilename = (response) => {
            const disposition = response.headers.get('Content-Disposition') || '';
            const match = disposition.match(/filename="([^"]+)"/i) || disposition.match(/filename=([^;]+)/i);
            return match ? match[1].trim() : 'merchant-analytics.xlsx';
        };
        const syncDatesToModal = () => {
            if (startDateInput && reportStartDate) startDateInput.value = reportStartDate.value || '';
            if (endDateInput && reportEndDate) endDateInput.value = reportEndDate.value || '';
        };
        const openModal = () => {
            if (!modal) return;
            lastFocusedElement = document.activeElement;
            syncDatesToModal();
            modal.hidden = false;
            document.body.classList.add('modal-open');
            setExportMessage('');
            syncExportState();
            setTimeout(() => modal.querySelector(focusableSelector)?.focus(), 0);
        };
        const closeModal = () => {
            if (!modal) return;
            modal.hidden = true;
            document.body.classList.remove('modal-open');
            lastFocusedElement?.focus?.();
        };

        reportApply?.addEventListener('click', () => {
            syncDatesToModal();
            if (reportMessage) {
                reportMessage.textContent = 'Date range applied to the export report.';
                reportMessage.dataset.tone = 'success';
            }
        });
        openButton?.addEventListener('click', openModal);
        closeButton?.addEventListener('click', closeModal);
        modal?.addEventListener('click', (event) => {
            if (event.target === modal) closeModal();
        });
        modal?.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                event.preventDefault();
                closeModal();
                return;
            }
            if (event.key !== 'Tab') return;
            const focusable = Array.from(modal.querySelectorAll(focusableSelector)).filter((node) => !node.disabled && node.offsetParent !== null);
            if (!focusable.length) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        });

        selectAll?.addEventListener('change', () => {
            datasetInputs.forEach((input) => {
                input.checked = selectAll.checked;
            });
            setExportMessage('');
            syncExportState();
        });
        datasetInputs.forEach((input) => {
            input.addEventListener('change', () => {
                setExportMessage('');
                syncExportState();
            });
        });
        clearButton?.addEventListener('click', () => {
            datasetInputs.forEach((input) => {
                input.checked = false;
            });
            setExportMessage('Select at least one dataset to enable download.', 'warning');
            syncExportState();
        });
        exportButton?.addEventListener('click', async () => {
            const datasets = selectedDatasets();
            if (!datasets.length) {
                setExportMessage('Select at least one dataset to export.', 'error');
                syncExportState();
                return;
            }
            if (exportInProgress) return;

            exportInProgress = true;
            exportButton.textContent = 'Generating...';
            setExportMessage('Generating workbook...', 'loading');
            syncExportState();

            try {
                const response = await fetch('/merchant/analytics/export', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        datasets,
                        startDate: startDateInput?.value || '',
                        endDate: endDateInput?.value || ''
                    })
                });

                if (!response.ok) {
                    const errorPayload = await response.json().catch(() => ({}));
                    throw new Error(errorPayload.message || 'Analytics export failed.');
                }

                const blob = await response.blob();
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = getFilename(response);
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(link.href);
                setExportMessage('Download started.', 'success');
            } catch (error) {
                setExportMessage(error.message || 'Analytics export failed.', 'error');
            } finally {
                exportInProgress = false;
                exportButton.textContent = 'Download XLSX';
                syncExportState();
            }
        });

        renderMainChart('sales');
        syncExportState();
    })();
</script>

