        const renderInsightsToChat = (payload) => {
            const insights = payload.insights || payload.fallback || {};
            const rows = [
                ...(insights.keyFindings || []).map((row) => ({ title: row.title, detail: row.detail, meta: row.evidence })),
                ...(insights.recommendedActions || []).map((row) => ({ title: row.action, detail: row.reason, meta: row.priority ? `Priority: ${row.priority}` : '' })),
                ...(insights.risks || []).map((row) => ({ title: row.issue, detail: row.suggestedResponse, meta: row.severity ? `Severity: ${row.severity}` : '' }))
            ].slice(0, 8);
            appendAiMessage('assistant', insights.summary || 'Here is the current analytics summary.', rows.length ? [createAiDetailList(rows)] : []);
        };
        const renderAnswerToChat = (answer = {}) => {
            const rows = [
                ...(answer.supportingEvidence || []).map((item) => ({ title: 'Evidence', detail: item })),
                ...(answer.suggestedNextSteps || []).map((item) => ({ title: 'Next step', detail: item })),
                ...(answer.limitations || []).map((item) => ({ title: 'Limitation', detail: item }))
            ];
