                        const { response, payload } = await fetchAiJson(url, { reminderId: reminder.id });
                        if (!response.ok || !payload.success) throw new Error(payload.message || 'Reminder could not be updated.');
                        card.remove();
                        appendAiMessage('assistant', successMessage);
                    } catch (error) {
                        appendAiMessage('assistant', error.message || 'Reminder could not be updated.');
                    } finally {
                        aiChatInProgress = false;
                        syncAiButtons();
                    }
                };
                const done = document.createElement('button');
                done.type = 'button';
                done.className = 'button secondary';
                done.textContent = 'Mark Done';
                done.addEventListener('click', () => updateReminder('/api/ai/merchant/reminders/mark-done', 'Reminder marked done.'));
                const dismiss = document.createElement('button');
                dismiss.type = 'button';
