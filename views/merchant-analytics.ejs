            container.appendChild(row);
        };
        const renderActionProposal = (proposal) => {
            clearNode(aiActionProposal);
            if (!aiActionProposal || !proposal) return;
            const article = document.createElement('article');
            const body = document.createElement('div');
            const title = document.createElement('strong');
            const detail = document.createElement('span');
            const meta = document.createElement('span');
            title.textContent = proposal.title || 'AI action proposal';
            detail.textContent = proposal.reason || 'Review this proposal before taking action.';
            meta.textContent = `Type: ${proposal.actionType || 'proposal'} | Risk: ${proposal.riskLevel || 'review'}`;
            body.append(title, detail, meta);
            ['currentState', 'proposedState'].forEach((key) => {
                const state = proposal[key] || {};
                Object.keys(state).forEach((field) => renderKeyValue(body, field, state[field]));
            });
            (proposal.evidence || []).forEach((item) => renderKeyValue(body, 'Evidence', item));
            (proposal.warnings || []).forEach((item) => renderKeyValue(body, 'Warning', item));
            article.appendChild(body);
            const endpoint = actionConfirmEndpoint(proposal.actionType);
            if (endpoint && proposal.riskLevel !== 'recommend_only' && proposal.proposalId) {
                const confirmButton = document.createElement('button');
