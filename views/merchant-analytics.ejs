                list.appendChild(item);
            });
            return list;
        };
        const createProposalCard = (proposal) => {
            const card = document.createElement('div');
            card.className = 'vaniday-ai-action-card';
            const rows = [
                { title: proposal.title || 'AI action proposal', detail: proposal.reason || 'Review this proposal before taking action.', meta: proposal.riskLevel ? `Risk: ${proposal.riskLevel}` : '' },
                ...(proposal.evidence || []).map((item) => ({ title: 'Evidence', detail: item })),
                ...(proposal.warnings || []).map((item) => ({ title: 'Warning', detail: item }))
            ];
            card.appendChild(createAiDetailList(rows));
            const endpoint = actionConfirmEndpoint(proposal.actionType);
            if (endpoint && proposal.riskLevel !== 'recommend_only' && proposal.proposalId) {
                const confirmButton = document.createElement('button');
                confirmButton.type = 'button';
                confirmButton.className = 'button primary';
                confirmButton.textContent = proposal.actionType === 'create_promotion'
                    ? 'Create Promotion'
                    : proposal.actionType === 'create_reminder'
                        ? 'Create Reminder'
                        : 'Confirm Action';
                confirmButton.addEventListener('click', async () => {
                    if (aiChatInProgress) return;
                    aiChatInProgress = true;
                    syncAiButtons();
                    confirmButton.disabled = true;
