        };
        const merchantChatIntent = (prompt) => {
            const text = String(prompt || '').toLowerCase();
            if (/\b(reminder|remind)\b/.test(text)) return 'reminders';
            if (/\b(summarise|summarize|summary|performance|overview)\b/.test(text)) return 'insights';
            if (/\b(promotion|price|restock|inventory|schedule|action|prepare|refunds?\s+need|attention)\b/.test(text)) return 'proposal';
            return 'question';
        };
        const submitMerchantChat = async (prompt) => {
