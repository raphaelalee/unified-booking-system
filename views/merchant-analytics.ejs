                setStatus(aiMessage, 'AI response ready.', 'success');
            } catch (error) {
                typing?.remove();
                appendAiMessage('assistant', error.message || 'AI is temporarily unavailable.');
                setStatus(aiMessage, error.message || 'AI is temporarily unavailable.', 'error');
            } finally {
                aiChatInProgress = false;
                syncAiButtons();
            }
        };
        const restoreAiChat = () => {
            if (!aiChatHistory) return;
            let saved = [];
            try {
                saved = JSON.parse(sessionStorage.getItem(aiChatStorageKey) || '[]');
            } catch (error) {
                saved = [];
            }
            if (Array.isArray(saved) && saved.length) {
                saved.forEach((row) => appendAiMessage(row.role, row.text));
            } else {
                appendAiMessage('assistant', 'Hi, I can summarise analytics, answer questions, prepare safe actions, and show smart reminders.');
            }
        };

        aiChatSend?.addEventListener('click', () => submitMerchantChat(aiChatInput?.value));
        aiAssistantToggle?.addEventListener('click', () => {
            setAiAssistantOpen(!aiAssistantRoot?.classList.contains('is-open'));
        });
        aiAssistantClose?.addEventListener('click', () => setAiAssistantOpen(false));
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && aiAssistantRoot?.classList.contains('is-open')) {
                setAiAssistantOpen(false);
            }
        });
        aiChatInput?.addEventListener('input', syncAiButtons);
        aiChatInput?.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                submitMerchantChat(aiChatInput.value);
            }
        });
        aiChatPrompts.forEach((button) => {
            button.addEventListener('click', () => submitMerchantChat(button.dataset.aiChatPrompt));
        });

        aiGenerate?.addEventListener('click', async () => {
            if (aiInProgress) return;
            aiInProgress = true;
            aiGenerate.textContent = 'Generating...';
            setStatus(aiMessage, 'Generating AI insights...', 'loading');
            syncAiButtons();
            try {
                const { response, payload } = await fetchAiJson('/api/ai/merchant/business-insights', { period: aiPeriod?.value || 'last30' });
                if (!response.ok && !payload.fallback) throw new Error(payload.message || 'AI insights could not be generated.');
                renderMerchantInsights(payload);
                setStatus(aiMessage, payload.success ? 'AI insights generated.' : payload.message, payload.success ? 'success' : 'warning');
            } catch (error) {
                setStatus(aiMessage, error.message || 'AI insights are temporarily unavailable. Your analytics data is still available.', 'error');
            } finally {
                aiInProgress = false;
                aiGenerate.textContent = 'Generate Insights';
                syncAiButtons();
            }
        });

        aiAsk?.addEventListener('click', async () => {
            const question = String(aiQuestion?.value || '').trim();
            if (!question) {
                setStatus(aiQuestionMessage, 'Enter a question first.', 'error');
                return;
            }
            if (aiQuestionInProgress) return;
            aiQuestionInProgress = true;
            aiAsk.textContent = 'Asking...';
            setStatus(aiQuestionMessage, 'Asking AI...', 'loading');
            syncAiButtons();
            try {
                const { response, payload } = await fetchAiJson('/api/ai/merchant/ask-analytics', { period: aiPeriod?.value || 'last30', question });
                if (!response.ok && !payload.fallback) throw new Error(payload.message || 'AI answer could not be generated.');
                renderMerchantAnswer(payload.answer || payload.fallback || {});
                setStatus(aiQuestionMessage, payload.success ? 'Answer generated.' : payload.message, payload.success ? 'success' : 'warning');
            } catch (error) {
                setStatus(aiQuestionMessage, error.message || 'AI answer is temporarily unavailable.', 'error');
            } finally {
                aiQuestionInProgress = false;
                aiAsk.textContent = 'Ask AI';
                syncAiButtons();
            }
        });

        aiActionPrepare?.addEventListener('click', async () => {
            const prompt = String(aiActionPrompt?.value || '').trim();
            if (!prompt) {
                setStatus(aiActionMessage, 'Enter the action you want prepared.', 'error');
                return;
            }
            if (aiActionInProgress) return;
            aiActionInProgress = true;
            aiActionPrepare.textContent = 'Preparing...';
            setStatus(aiActionMessage, 'Preparing a safe proposal...', 'loading');
            syncAiButtons();
            try {
                const { response, payload } = await fetchAiJson('/api/ai/merchant/action-proposal', { period: aiPeriod?.value || 'last30', prompt });
                if (!response.ok || !payload.success) throw new Error(payload.message || 'Action proposal could not be prepared.');
                renderActionProposal(payload.proposal);
                setStatus(aiActionMessage, 'Proposal prepared for review.', 'success');
            } catch (error) {
                setStatus(aiActionMessage, error.message || 'Action proposal could not be prepared.', 'error');
            } finally {
                aiActionInProgress = false;
                aiActionPrepare.textContent = 'Prepare Action';
                syncAiButtons();
            }
        });

        aiScheduleRecommendations?.addEventListener('click', async () => {
            if (aiActionInProgress) return;
            aiActionInProgress = true;
            aiScheduleRecommendations.textContent = 'Loading...';
            setStatus(aiActionMessage, 'Reviewing booking patterns...', 'loading');
            syncAiButtons();
            try {
                const { response, payload } = await fetchAiJson('/api/ai/merchant/schedule-recommendations', { period: aiPeriod?.value || 'last30' });
                if (!response.ok || !payload.success) throw new Error(payload.message || 'Schedule recommendations could not be loaded.');
                renderActionProposal((payload.recommendations || [])[0]);
                setStatus(aiActionMessage, 'Schedule recommendation ready. Apply changes through schedule tools.', 'success');
            } catch (error) {
                setStatus(aiActionMessage, error.message || 'Schedule recommendations could not be loaded.', 'error');
            } finally {
                aiActionInProgress = false;
                aiScheduleRecommendations.textContent = 'Schedule Ideas';
                syncAiButtons();
            }
        });

        aiLoadReminders?.addEventListener('click', async () => {
            if (aiReminderInProgress) return;
            aiReminderInProgress = true;
            aiLoadReminders.textContent = 'Loading...';
            setStatus(aiReminderMessage, 'Loading smart reminders...', 'loading');
            syncAiButtons();
            try {
                const { response, payload } = await fetchAiJson('/api/ai/merchant/smart-reminders', { period: aiPeriod?.value || 'last30' });
                if (!response.ok || !payload.success) throw new Error(payload.message || 'Smart reminders could not be loaded.');
                renderReminders(payload.reminders || []);
                setStatus(aiReminderMessage, 'Smart reminders loaded.', 'success');
            } catch (error) {
                setStatus(aiReminderMessage, error.message || 'Smart reminders could not be loaded.', 'error');
            } finally {
                aiReminderInProgress = false;
                aiLoadReminders.textContent = 'Load Reminders';
                syncAiButtons();
            }
        });

        const selectedDatasets = () => datasetInputs.filter((input) => input.checked).map((input) => input.value);
        const focusableSelector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
        const setExportMessage = (message, tone = '') => {
            if (!messageNode) return;
            messageNode.textContent = message || '';
            messageNode.dataset.tone = tone;
        };
        const syncExportState = () => {
            const selected = selectedDatasets();
            if (selectAll) {
                selectAll.checked = selected.length === datasetInputs.length && datasetInputs.length > 0;
                selectAll.indeterminate = selected.length > 0 && selected.length < datasetInputs.length;
            }
            if (countNode) {
                countNode.textContent = `${selected.length} dataset${selected.length === 1 ? '' : 's'} selected`;
            }
            if (exportButton) {
                exportButton.disabled = exportInProgress || selected.length === 0;
            }
        };
        const getFilename = (response) => {
            const disposition = response.headers.get('Content-Disposition') || '';
            const match = disposition.match(/filename="([^"]+)"/i) || disposition.match(/filename=([^;]+)/i);
            return match ? match[1].trim() : 'merchant-analytics.xlsx';
        };
        const syncDatesToModal = () => {
            if (startDateInput && reportStartDate) startDateInput.value = reportStartDate.value || '';
            if (endDateInput && reportEndDate) endDateInput.value = reportEndDate.value || '';
        };
        const openModal = () => {
            if (!modal) return;
            lastFocusedElement = document.activeElement;
            syncDatesToModal();
            modal.hidden = false;
            document.body.classList.add('modal-open');
            setExportMessage('');
            syncExportState();
            setTimeout(() => modal.querySelector(focusableSelector)?.focus(), 0);
        };
        const closeModal = () => {
            if (!modal) return;
            modal.hidden = true;
            document.body.classList.remove('modal-open');
            lastFocusedElement?.focus?.();
        };

        reportApply?.addEventListener('click', () => {
            syncDatesToModal();
            if (reportMessage) {
                reportMessage.textContent = 'Date range applied to the export report.';
                reportMessage.dataset.tone = 'success';
            }
        });
        openButton?.addEventListener('click', openModal);
        closeButton?.addEventListener('click', closeModal);
        modal?.addEventListener('click', (event) => {
            if (event.target === modal) closeModal();
        });
        modal?.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                event.preventDefault();
                closeModal();
                return;
            }
            if (event.key !== 'Tab') return;
            const focusable = Array.from(modal.querySelectorAll(focusableSelector)).filter((node) => !node.disabled && node.offsetParent !== null);
            if (!focusable.length) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        });

        selectAll?.addEventListener('change', () => {
            datasetInputs.forEach((input) => {
                input.checked = selectAll.checked;
            });
            setExportMessage('');
            syncExportState();
        });
        datasetInputs.forEach((input) => {
            input.addEventListener('change', () => {
                setExportMessage('');
                syncExportState();
            });
        });
        clearButton?.addEventListener('click', () => {
            datasetInputs.forEach((input) => {
                input.checked = false;
            });
            setExportMessage('Select at least one dataset to enable download.', 'warning');
            syncExportState();
        });
        exportButton?.addEventListener('click', async () => {
            const datasets = selectedDatasets();
            if (!datasets.length) {
                setExportMessage('Select at least one dataset to export.', 'error');
                syncExportState();
                return;
            }
            if (exportInProgress) return;

            exportInProgress = true;
            exportButton.textContent = 'Generating...';
            setExportMessage('Generating workbook...', 'loading');
            syncExportState();

            try {
                const response = await fetch('/merchant/analytics/export', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({
                        datasets,
                        startDate: startDateInput?.value || '',
                        endDate: endDateInput?.value || ''
                    })
                });

                if (!response.ok) {
                    const errorPayload = await response.json().catch(() => ({}));
                    throw new Error(errorPayload.message || 'Analytics export failed.');
                }

                const blob = await response.blob();
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = getFilename(response);
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(link.href);
                setExportMessage('Download started.', 'success');
            } catch (error) {
                setExportMessage(error.message || 'Analytics export failed.', 'error');
            } finally {
                exportInProgress = false;
                exportButton.textContent = 'Download XLSX';
                syncExportState();
            }
        });

        setAiAssistantOpen(sessionStorage.getItem(aiPanelStateKey) === 'open');
        restoreAiChat();
        syncAiButtons();
        renderMainChart('sales');
        syncExportState();
    })();
</script>

<%- include('partials/footer') %>
