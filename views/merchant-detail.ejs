<%- include('partials/header', { title }) %>

<%
    const detailServices = Array.isArray(merchant.services) ? merchant.services : [];
    const merchantProducts = typeof products !== 'undefined' && Array.isArray(products) ? products : [];
    const merchantReviews = Array.isArray(reviews) ? reviews : [];
    const averageRating = Number.isFinite(reviewSummary?.averageRating) ? reviewSummary.averageRating : Number(merchant.rating || 0);
    const reviewCount = Number(reviewSummary?.reviewCount || 0);
    const priceValues = detailServices.map((service) => Number(service.price)).filter((price) => Number.isFinite(price));
    const startingPrice = priceValues.length > 0 ? Math.min(...priceValues) : 0;
    const slotCount = detailServices.reduce((total, service) => total + (Array.isArray(service.slots) ? service.slots.length : 0), 0);
    const categories = [...new Set(detailServices.map((service) => service.name).filter(Boolean))];
    const firstBookableService = detailServices[0] || null;
    const bookPath = (service) => {
        if (!service) return `/booking/${merchant.id}`;
        const params = new URLSearchParams({ serviceId: String(service.id) });
        if (service.flashDealDiscountPercent) {
            params.set('source', 'promotions');
            params.set('promoCampaign', 'Flash Deal');
            params.set('promoTitle', `${service.flashDealDiscountPercent}% off ${service.name}`);
            params.set('promoPrice', Number(service.price).toFixed(2));
            params.set('promoOriginalPrice', Number(service.originalPrice).toFixed(2));
            params.set('promoDiscountPercent', String(service.flashDealDiscountPercent));
        }
        return `/booking/${merchant.id}?${params.toString()}`;
    };
    const locationQuery = encodeURIComponent(`${merchant.name} ${merchant.location || 'Singapore'}`);
    const ratingCopy = averageRating ? averageRating.toFixed(1) : 'New';
    const statusCopy = 'Open today';
    const hoursCopy = '9:00 AM - 9:00 PM';
    const renderStars = (rating) => '&#9733;'.repeat(Math.round(Number(rating || 0))) + '&#9734;'.repeat(Math.max(0, 5 - Math.round(Number(rating || 0))));
    const highlightedServices = Array.isArray(featuredServices) ? featuredServices : [];
    const highlightedProducts = Array.isArray(featuredProducts) ? featuredProducts : [];
%>

<section class="merchant-storefront">
    <div class="merchant-storefront-back">
        <a class="text-link" href="<%= typeof backUrl !== 'undefined' ? backUrl : '/services' %>">
            &larr; <%= typeof backLabel !== 'undefined' ? backLabel : 'Back to services' %>
        </a>
    </div>

    <section class="merchant-storefront-hero">
        <div class="merchant-storefront-copy">
            <p class="eyebrow"><%= merchant.category || 'Beauty studio' %></p>
            <h1><%= merchant.name %></h1>
            <p><%= merchant.description %></p>
            <% if (merchant.isFeatured) { %>
                <div class="merchant-storefront-pills">
                    <span>
                        <%= merchant.featuredType === 'featured_month'
                            ? '🏆 Featured Merchant of the Month'
                            : merchant.featuredType === 'trending'
                                ? '🔥 Trending Merchant'
                                : merchant.featuredType === 'top_rated'
                                    ? '⭐ Top Rated Merchant'
                                    : '⭐ Featured Merchant' %>
                    </span>
                </div>
            <% } %>
            <div class="merchant-storefront-pills" aria-label="Merchant highlights">
                <span><strong><%= ratingCopy %></strong> rating<%= reviewCount > 0 ? ` / ${reviewCount} review${reviewCount === 1 ? '' : 's'}` : '' %></span>
                <span><%= merchant.location || 'Singapore' %></span>
                <span><%= statusCopy %></span>
                <span><%= hoursCopy %></span>
            </div>
            <div class="merchant-storefront-actions">
                <a class="button primary" href="<%= bookPath(firstBookableService) %>">Book appointment</a>
                <a class="button secondary" href="#storefront-services">View services</a>
            </div>
        </div>
        <div class="merchant-storefront-image merchant-thumb-<%= merchant.id %>" aria-label="<%= merchant.name %>"></div>
    </section>

    <nav class="storefront-tabs" aria-label="Storefront sections">
        <a class="active" href="#storefront-services">Services</a>
        <a href="#storefront-products">Products</a>
        <a href="#storefront-reviews">Reviews</a>
        <a href="#storefront-gallery">Gallery</a>
        <a href="#storefront-about">About</a>
    </nav>

    <div class="merchant-storefront-layout">
        <div class="merchant-storefront-main">
            <section class="storefront-section" id="storefront-services">
                <div class="storefront-section-heading">
                    <div>
                        <p class="eyebrow">Services</p>
                        <h2>Choose your treatment</h2>
                    </div>
                    <span><%= detailServices.length %> service<%= detailServices.length === 1 ? '' : 's' %></span>
                </div>

                <% if (highlightedServices.length > 0) { %>
                    <div class="storefront-product-strip">
                        <% highlightedServices.forEach((service) => { %>
                            <article>
                                <span class="tag">⭐ Featured Service</span>
                                <h3><%= service.name %></h3>
                                <p class="muted"><%= service.duration %> · $<%= Number(service.price || 0).toFixed(2) %></p>
                                <a class="button secondary" href="<%= bookPath(service) %>">Book featured</a>
                            </article>
                        <% }) %>
                    </div>
                <% } %>

                <% if (detailServices.length === 0) { %>
                    <div class="notice">
                        <p>This studio has not listed services yet.</p>
                    </div>
                <% } else { %>
                    <div class="storefront-service-grid">
                        <% detailServices.forEach((service) => { %>
                            <% const shortDescription = Array.isArray(service.options) && service.options.length > 0
                                ? service.options.map((option) => option.name).slice(0, 3).join(', ')
                                : `${merchant.category || 'Beauty'} appointment at ${merchant.name}`; %>
                            <article class="storefront-service-card <%= service.flashDealDiscountPercent ? 'is-flash-deal' : '' %>">
                                <div>
                                    <span class="tag"><%= service.flashDealDiscountPercent ? `Flash Deal · ${service.flashDealDiscountPercent}% OFF` : (merchant.category || 'Service') %></span>
                                    <h3><%= service.name %></h3>
                                    <p><%= shortDescription %></p>
                                </div>
                                <div class="storefront-service-meta">
                                    <span><%= service.duration || '60 mins' %></span>
                                    <strong>
                                        <% if (service.flashDealDiscountPercent) { %><del>$<%= Number(service.originalPrice || 0).toFixed(2) %></del> <% } %>
                                        $<%= Number(service.price || 0).toFixed(2) %>
                                    </strong>
                                </div>
                                <% if (Array.isArray(service.slots) && service.slots.length > 0) { %>
                                    <div class="availability-strip compact-slots">
                                        <% service.slots.slice(0, 4).forEach((slot) => { %>
                                            <span><%= slot %></span>
                                        <% }) %>
                                    </div>
                                <% } %>
                                <a class="button primary full" href="<%= bookPath(service) %>">Book now</a>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <section class="storefront-section storefront-products-section" id="storefront-products">
                <div class="storefront-section-heading">
                    <div>
                        <p class="eyebrow">Products</p>
                        <h2>Aftercare from this studio</h2>
                    </div>
                    <span><%= merchantProducts.length %> product<%= merchantProducts.length === 1 ? '' : 's' %></span>
                </div>

                <% if (highlightedProducts.length > 0) { %>
                    <div class="storefront-product-strip storefront-featured-products">
                        <% highlightedProducts.forEach((product) => { %>
                            <% const featuredImageUrl = product.imageUrl || product.fallbackImageUrl || ''; %>
                            <article class="storefront-product-card-clean is-featured">
                                <div class="storefront-product-card-media home-product-image"<% if (featuredImageUrl) { %> style="background-image: linear-gradient(180deg, rgba(255, 253, 247, 0.06), rgba(79, 104, 71, 0.2)), url('<%= featuredImageUrl %>');"<% } %>></div>
                                <div class="storefront-product-card-body">
                                    <span class="tag">Featured Product</span>
                                    <h3><%= product.name %></h3>
                                    <p class="muted"><%= product.description %></p>
                                </div>
                                <div class="storefront-product-card-footer">
                                    <strong>$<%= Number(product.price || 0).toFixed(2) %></strong>
                                    <a class="button secondary" href="/products/<%= product.id %>">View</a>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } %>

                <% if (merchantProducts.length === 0) { %>
                    <div class="notice">
                        <p>No products are listed for this studio yet.</p>
                    </div>
                <% } else { %>
                    <div class="storefront-product-strip storefront-products-grid">
                        <% merchantProducts.slice(0, 6).forEach((product) => { %>
                            <% const productImageUrl = product.imageUrl || product.fallbackImageUrl || ''; %>
                            <article class="storefront-product-card-clean">
                                <div class="storefront-product-card-media home-product-image"<% if (productImageUrl) { %> style="background-image: linear-gradient(180deg, rgba(255, 253, 247, 0.06), rgba(79, 104, 71, 0.2)), url('<%= productImageUrl %>');"<% } %>></div>
                                <div class="storefront-product-card-body">
                                    <span class="tag"><%= product.salonName || merchant.name %></span>
                                    <h3><%= product.name %></h3>
                                    <p class="muted"><%= product.description %></p>
                                </div>
                                <div class="storefront-product-card-footer">
                                    <strong>$<%= Number(product.price || 0).toFixed(2) %></strong>
                                    <a class="button secondary" href="/products/<%= product.id %>">View</a>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <section class="storefront-section" id="storefront-reviews">
                <div class="storefront-section-heading">
                    <div>
                        <p class="eyebrow">Reviews</p>
                        <h2>Verified customer feedback</h2>
                    </div>
                    <span><%= ratingCopy %> rating</span>
                </div>

                <div class="storefront-review-summary">
                    <strong><%= ratingCopy %></strong>
                    <div>
                        <span><%- renderStars(averageRating) %></span>
                        <p><%= reviewCount > 0 ? `${reviewCount} verified review${reviewCount === 1 ? '' : 's'}` : 'No verified reviews yet' %></p>
                    </div>
                </div>

                <% if (!merchantReviews.length) { %>
                    <p class="muted">Reviews appear here after customers complete a service and submit feedback.</p>
                <% } else { %>
                    <div class="merchant-review-list">
                        <% merchantReviews.forEach((review) => { %>
                            <article class="merchant-review-card">
                                <div class="merchant-review-card-top">
                                    <strong><%= review.customerName %></strong>
                                    <span><%- renderStars(review.rating) %></span>
                                </div>
                                <small><%= review.serviceName %></small>
                                <p><%= review.comment || 'Customer left a rating without additional comments.' %></p>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <section class="storefront-section" id="storefront-gallery">
                <div class="storefront-section-heading">
                    <div>
                        <p class="eyebrow">Gallery</p>
                        <h2>A look inside</h2>
                    </div>
                </div>
                <div class="storefront-gallery-grid">
                    <div class="merchant-thumb-<%= merchant.id %>"></div>
                    <div></div>
                    <div></div>
                </div>
            </section>

            <section class="storefront-section" id="storefront-about">
                <div class="storefront-section-heading">
                    <div>
                        <p class="eyebrow">About</p>
                        <h2>About the studio</h2>
                    </div>
                </div>
                <p><%= merchant.description %></p>
                <div class="merchant-storefront-pills">
                    <span><strong><%= categories.length %></strong> categories</span>
                    <span><strong><%= slotCount %></strong> available times</span>
                    <span>From <strong><%= startingPrice > 0 ? '$' + startingPrice : 'menu pricing' %></strong></span>
                </div>
            </section>
        </div>

        <aside class="storefront-side-card">
            <section>
                <p class="eyebrow">About the studio</p>
                <h2><%= merchant.name %></h2>
                <p><%= merchant.description %></p>
            </section>

            <div class="storefront-side-actions">
                <% if (typeof whatsappEnquiryUrl !== 'undefined' && whatsappEnquiryUrl) { %>
                    <a class="button primary full" href="<%= whatsappEnquiryUrl %>" target="_blank" rel="noopener">WhatsApp studio</a>
                <% } %>
                <a class="button secondary full" href="https://www.google.com/maps/search/?api=1&query=<%= locationQuery %>" target="_blank" rel="noopener">Share location</a>
            </div>

            <section>
                <h3>Store policies</h3>
                <p class="muted">Bookings are subject to live availability. Please arrive on time and contact the studio early for changes.</p>
            </section>

            <section>
                <h3>Opening hours</h3>
                <p><strong><%= statusCopy %></strong></p>
                <p class="muted"><%= hoursCopy %></p>
            </section>

            <section>
                <h3>Promotions / vouchers</h3>
                <p class="muted"><%= merchant.promotion || 'Ask the studio about current packages and vouchers.' %></p>
            </section>
        </aside>
    </div>
</section>

<%- include('partials/footer') %>
