<%- include('partials/header', { title }) %>

<%
    const platformBookings = Array.isArray(bookings) ? bookings : [];
    const formatCurrency = (value) => Number(value || 0).toFixed(2);
    const days = [];
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    for (let index = 6; index >= 0; index -= 1) {
        const date = new Date(today);
        date.setDate(today.getDate() - index);
        days.push({ key: date.toISOString().slice(0, 10), label: date.toLocaleDateString('en-SG', { month: 'short', day: 'numeric' }), bookings: 0, revenue: 0 });
    }
    const dayMap = days.reduce((map, day) => { map[day.key] = day; return map; }, {});
    platformBookings.forEach((booking) => {
        const key = booking.booking_date instanceof Date ? booking.booking_date.toISOString().slice(0, 10) : String(booking.booking_date || '').slice(0, 10);
        if (dayMap[key]) {
            dayMap[key].bookings += 1;
            dayMap[key].revenue += Number(booking.service_price || 0);
        }
    });
    const chartPayload = { labels: days.map((day) => day.label), bookings: days.map((day) => day.bookings), revenue: days.map((day) => Number(day.revenue.toFixed(2))) };
%>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <header class="admin-dashboard-header">
            <div><p class="eyebrow">Analytics</p><h1>Platform Analytics</h1><p>Revenue analytics, QR analytics, booking trends, and platform health signals.</p></div>
        </header>

        <section class="admin-stat-grid">
            <article class="admin-stat-card accent-green"><strong>$<%= formatCurrency(stats.bookingRevenue) %></strong><span>Total booking revenue</span></article>
            <article class="admin-stat-card accent-blue"><strong><%= stats.bookingCount %></strong><span>Total bookings</span></article>
            <article class="admin-stat-card accent-orange"><strong><%= loyaltySummary?.redemptionCount || 0 %></strong><span>Reward redemptions</span></article>
        </section>

        <section class="admin-grid">
            <article class="admin-panel admin-chart-panel span-8">
                <div class="admin-panel-heading"><div><p class="eyebrow">Revenue</p><h2>Revenue and bookings</h2></div></div>
                <div class="admin-chart-box"><canvas id="adminRevenueChart"></canvas></div>
            </article>
            <article class="admin-panel span-4">
                <div class="admin-panel-heading"><div><p class="eyebrow">Performance</p><h2>Promotion contribution</h2></div></div>
                <div class="admin-smart-widget"><strong><%= loyaltySummary?.redemptionCount || 0 %></strong><span>voucher redemptions</span><small>Reward shop and campaign activity</small></div>
            </article>
        </section>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (() => {
        const payload = <%- JSON.stringify(chartPayload) %>;
        const canvas = document.getElementById('adminRevenueChart');
        if (!canvas || typeof Chart === 'undefined') return;
        new Chart(canvas, {
            type: 'line',
            data: {
                labels: payload.labels,
                datasets: [
                    { label: 'Bookings', data: payload.bookings, borderColor: '#20899c', backgroundColor: 'rgba(32,137,156,.12)', fill: true },
                    { label: 'Revenue', data: payload.revenue, borderColor: '#4f6847', backgroundColor: 'rgba(79,104,71,.12)', fill: true }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } } }
        });
    })();
</script>

<%- include('partials/footer') %>
