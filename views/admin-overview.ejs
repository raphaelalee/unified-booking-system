<%- include('partials/header', { title }) %>

<%
    const platformBookings = Array.isArray(bookings) ? bookings : [];
    const safeMerchants = Array.isArray(merchants) ? merchants : [];
    const safeSupportSummary = supportSummary || { openCount: 0, pendingRefundCount: 0 };
    const formatCurrency = (value) => Number(value || 0).toFixed(2);
    const pendingMerchants = safeMerchants.filter((merchant) => {
        return Number(merchant.service_count || 0) === 0
            || !merchant.address
            || !merchant.description
            || !merchant.business_category
            || !merchant.uen
            || !merchant.owner_phone;
    });
    const pendingBookings = platformBookings.filter((booking) => String(booking.status || '').toLowerCase() === 'pending');
    const checkedInCount = platformBookings.filter((booking) => ['checked_in', 'completed'].includes(String(booking.status || '').toLowerCase())).length;
    const approvedMerchants = safeMerchants.filter((merchant) => String(merchant.approval_status || 'approved') === 'approved');
    const pendingReviewMerchants = safeMerchants.filter((merchant) => ['pending_review', 'changes_requested'].includes(String(merchant.approval_status || 'approved')));
    const activeCustomerCount = stats.uniqueBookedCustomers || customerReport.bookedCustomers || 0;
    const categoryEntries = Object.entries(merchantReport.merchantCategories || {}).sort((left, right) => right[1] - left[1]);
    const recentActivity = [
        ...platformBookings.slice(0, 4).map((booking) => ({
            title: `Booking #${booking.id} ${booking.status || 'pending'}`,
            meta: `${booking.merchant_name || 'Merchant'} - ${booking.customer_name || 'Customer'}`
        })),
        ...safeMerchants.slice(0, 3).map((merchant) => ({
            title: `${merchant.salon_name || 'Merchant'} profile checked`,
            meta: `${Number(merchant.service_count || 0)} services listed`
        }))
    ].slice(0, 6);
%>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <header class="admin-dashboard-header admin-command-hero">
            <div>
                <p class="eyebrow">Platform Command Center</p>
                <h1>Admin Overview</h1>
                <p>Monitor marketplace performance, approval work, customer activity, revenue, and system health.</p>
            </div>
            <div class="admin-topbar-utilities">
                <input type="search" placeholder="Search platform">
                <a class="button primary" href="/admin/merchants">Review merchants</a>
                <a class="button secondary" href="/admin/analytics">View analytics</a>
            </div>
        </header>

        <section class="admin-stat-grid">
            <article class="admin-stat-card accent-blue"><div class="admin-stat-card-top"><span class="admin-stat-icon">M</span><span class="admin-trend positive">Live</span></div><strong><%= stats.merchantCount %></strong><span>Total merchants</span><small><%= approvedMerchants.length %> approved, <%= stats.merchantUserCount %> merchant accounts</small></article>
            <article class="admin-stat-card accent-red"><div class="admin-stat-card-top"><span class="admin-stat-icon">A</span><span class="admin-trend <%= pendingReviewMerchants.length ? 'negative' : 'positive' %>"><%= pendingReviewMerchants.length ? 'Review' : 'Clear' %></span></div><strong><%= pendingReviewMerchants.length %></strong><span>Pending approvals</span><small>new or change-requested merchants</small></article>
            <article class="admin-stat-card accent-green"><div class="admin-stat-card-top"><span class="admin-stat-icon">C</span><span class="admin-trend positive">Users</span></div><strong><%= stats.customerCount %></strong><span>Total customers</span><small><%= activeCustomerCount %> customers with bookings</small></article>
            <article class="admin-stat-card accent-orange"><div class="admin-stat-card-top"><span class="admin-stat-icon">B</span><span class="admin-trend positive">Ops</span></div><strong><%= stats.bookingCount %></strong><span>Total bookings</span><small><%= checkedInCount %> checked in/completed</small></article>
            <article class="admin-stat-card accent-green"><div class="admin-stat-card-top"><span class="admin-stat-icon">$</span><span class="admin-trend positive">SGD</span></div><strong>$<%= formatCurrency(stats.bookingRevenue) %></strong><span>Revenue</span><small>booking revenue from live records</small></article>
            <article class="admin-stat-card accent-yellow"><div class="admin-stat-card-top"><span class="admin-stat-icon">S</span><span class="admin-trend <%= safeSupportSummary.openCount ? 'negative' : 'positive' %>">Support</span></div><strong><%= safeSupportSummary.openCount || 0 %></strong><span>Open support</span><small><%= safeSupportSummary.pendingRefundCount || 0 %> refund issues</small></article>
        </section>

        <section class="admin-overview-actions">
            <a href="/admin/merchants"><strong>Merchant approvals</strong><span><%= pendingReviewMerchants.length %> waiting for review</span></a>
            <a href="/admin/platform-health"><strong>Platform health</strong><span><%= validationReport.issues.length %> validation issue<%= validationReport.issues.length === 1 ? '' : 's' %></span></a>
            <a href="/admin/bookings"><strong>Booking operations</strong><span><%= pendingBookings.length %> pending booking<%= pendingBookings.length === 1 ? '' : 's' %></span></a>
            <a href="/admin/promotions"><strong>Campaign center</strong><span>Review marketplace promotions</span></a>
        </section>

        <section class="admin-grid">
            <article class="admin-panel span-8">
                <div class="admin-panel-heading"><div><p class="eyebrow">Recent Activity</p><h2>Marketplace activity</h2></div></div>
                <div class="admin-log-list">
                    <% recentActivity.forEach((item) => { %>
                        <article><strong><%= item.title %></strong><span><%= item.meta %></span></article>
                    <% }) %>
                </div>
            </article>
            <article class="admin-panel span-4">
                <div class="admin-panel-heading"><div><p class="eyebrow">Alerts</p><h2>Pending actions</h2></div></div>
                <div class="admin-health-list">
                    <a href="/admin/merchants"><span>Merchants missing setup</span><strong><%= pendingMerchants.length %></strong></a>
                    <a href="/admin/bookings"><span>Pending bookings</span><strong><%= pendingBookings.length %></strong></a>
                    <a href="/admin/platform-health"><span>Validation issues</span><strong><%= validationReport.issues.length %></strong></a>
                </div>
            </article>
            <article class="admin-panel span-4">
                <div class="admin-panel-heading"><div><p class="eyebrow">Merchant Information</p><h2>Business profile summary</h2></div></div>
                <div class="admin-health-list">
                    <a href="/admin/merchants"><span>Complete business profiles</span><strong><%= Math.max(0, merchantReport.totalMerchants - merchantReport.merchantsMissingBusinessProfile.length) %></strong></a>
                    <a href="/admin/merchants"><span>Need profile completion</span><strong><%= merchantReport.merchantsMissingBusinessProfile.length %></strong></a>
                    <a href="/admin/merchants"><span>Average staff count</span><strong><%= Number(merchantReport.averageStaffCount || 0).toFixed(1) %></strong></a>
                </div>
                <% if (categoryEntries.length) { %>
                    <div class="admin-log-list">
                        <% categoryEntries.slice(0, 4).forEach(([category, count]) => { %>
                            <article><strong><%= category %></strong><span><%= count %> merchant<%= count === 1 ? '' : 's' %></span></article>
                        <% }) %>
                    </div>
                <% } %>
            </article>
        </section>
    </div>
</section>

<%- include('partials/footer') %>
