<%- include('partials/header', { title }) %>

<%
    const services = Array.isArray(merchant.services) ? merchant.services : [];
    const rescheduleSettings = rescheduleAutomation?.settings || {};
    const storefrontQrImage = typeof qrImage !== 'undefined' && qrImage ? qrImage : (typeof qrCodeDataUrl !== 'undefined' ? qrCodeDataUrl : null);
%>

<section class="section compact merchant-analytics-page">
    <div class="merchant-analytics-shell">
        <header class="merchant-dashboard-hero">
            <div>
                <p class="eyebrow">Profile</p>
                <h1><%= merchant.name %></h1>
                <span>Business identity, operating rules, and storefront tools for this merchant account.</span>
            </div>
            <div class="merchant-hero-actions">
                <a class="button secondary" href="/profile">Account profile</a>
                <a class="button primary" href="/merchant/services">Manage services</a>
            </div>
        </header>

        <section class="merchant-dashboard-lower-grid">
            <article class="merchant-alert-card">
                <div class="merchant-card-heading"><div><p class="eyebrow">Business Info</p><h2>Merchant details</h2></div></div>
                <div class="merchant-checkin-metrics">
                    <p><span>Business name</span><strong><%= merchant.name %></strong></p>
                    <p><span>Location</span><strong><%= merchant.location || merchant.address || 'Not set' %></strong></p>
                    <p><span>Services</span><strong><%= services.length %></strong></p>
                </div>
            </article>
            <article class="merchant-alert-card">
                <div class="merchant-card-heading"><div><p class="eyebrow">Operating Hours</p><h2>Booking rules</h2></div></div>
                <div class="merchant-checkin-metrics">
                    <p><span>Business start</span><strong><%= rescheduleSettings.businessStart || '09:00' %></strong></p>
                    <p><span>Business end</span><strong><%= rescheduleSettings.businessEnd || '20:00' %></strong></p>
                    <p><span>Notice period</span><strong><%= Number(rescheduleSettings.minimumNoticeHours || 24) %>h</strong></p>
                </div>
            </article>
            <article class="merchant-alert-card">
                <div class="merchant-card-heading">
                    <div>
                        <p class="eyebrow">Scan to Book</p>
                        <h2>Storefront booking QR</h2>
                    </div>
                </div>
                <p class="muted">Customers can scan this QR to book directly from your storefront.</p>
                <div class="merchant-inline-actions">
                    <form action="/merchant/generate-qr" method="POST">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <input type="hidden" name="returnTo" value="profile">
                        <button class="button primary" type="submit">Generate storefront QR</button>
                    </form>
                    <% if (merchant.id) { %>
                        <a class="button secondary" href="/merchants/<%= merchant.id %>/qr">Open QR page</a>
                    <% } %>
                </div>
                <% if (storefrontQrImage && qrBookingUrl) { %>
                    <a class="qr-code-link" href="<%= qrBookingUrl %>" aria-label="Open signed QR booking page">
                        <img class="qr-code" src="<%= storefrontQrImage %>" alt="Merchant QR">
                    </a>
                    <p class="muted qr-link-wrap"><%= qrBookingUrl %></p>
                    <div class="merchant-inline-actions">
                        <a class="button secondary" href="<%= storefrontQrImage %>" download="vaniday-storefront-qr.png">Download QR</a>
                        <button class="button secondary" type="button" onclick="window.print()">Print QR</button>
                    </div>
                    <% if (qrDebug) { %>
                        <div class="qr-debug-panel">
                            <p class="eyebrow">QR Debug</p>
                            <p class="muted"><strong>System:</strong> <%= qrDebug.system %> / <%= qrDebug.label %></p>
                            <p class="muted"><strong>Token:</strong> <%= qrDebug.token %></p>
                            <p class="muted"><strong>Route target:</strong> <%= qrDebug.routeTarget %></p>
                        </div>
                    <% } %>
                <% } %>
            </article>
        </section>
    </div>
</section>

<%- include('partials/footer') %>
