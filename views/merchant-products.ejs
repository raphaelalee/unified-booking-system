<%- include('partials/header', { title }) %>

<%
    const totalStock = products.reduce((sum, product) => sum + Number(product.stockQuantity || 0), 0);
    const lowStockCount = products.filter((product) => Number(product.stockQuantity || 0) <= 5).length;
    const featuredCount = products.filter((product) => product.isFeatured).length;
    const recommendedProducts = products.filter((product) => !product.isFeatured && product.featuredRecommendation)
        .sort((left, right) => left.featuredRecommendation.rank - right.featuredRecommendation.rank)
        .slice(0, 3);
    const currentMonthLabel = new Date().toLocaleDateString('en-SG', { month: 'long', year: 'numeric' });
%>

<section class="section compact merchant-products-page">
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <header class="merchant-products-hero">
        <div class="merchant-products-hero-copy">
            <p class="eyebrow">Merchant Portal</p>
            <h1>Product inventory</h1>
            <p>Manage products for <%= merchant.name %>, update stock quickly, and keep the customer product page ready for shoppers.</p>
        </div>
        <div class="merchant-products-hero-actions">
            <a class="button primary" href="/merchant/products/new">Add product</a>
        </div>
    </header>

    <div class="merchant-products-summary" aria-label="Inventory summary">
        <article>
            <span>Listed products</span>
            <strong><%= products.length %></strong>
        </article>
        <article>
            <span>Total stock</span>
            <strong><%= totalStock %></strong>
        </article>
        <article>
            <span>Low stock</span>
            <strong><%= lowStockCount %></strong>
        </article>
        <article>
            <span>Featured</span>
            <strong><%= featuredCount %>/3</strong>
        </article>
    </div>

    <% if (recommendedProducts.length > 0) { %>
        <section class="merchant-sales-recommendations" aria-labelledby="product-recommendations-title">
            <p class="eyebrow">Recommendation</p>
            <h2 id="product-recommendations-title">Recommended Products To Be Featured In <%= currentMonthLabel %></h2>
            <p>Top product candidates based primarily on paid sales, with stock and listing readiness used as tie-breakers.</p>
            <div class="merchant-sales-recommendation-list">
                <% recommendedProducts.forEach((product) => { const recommendation = product.featuredRecommendation; %>
                    <article class="merchant-sales-recommendation-card">
                        <span class="merchant-sales-rank">#<%= recommendation.rank %></span>
                        <h3><%= product.name %></h3>
                        <p><%= recommendation.reason %></p>
                        <div class="merchant-sales-metrics">
                            <span><strong><%= Number(product.salesCount || 0) %></strong> paid units sold</span>
                            <span><strong><%= Number(product.stockQuantity || 0) %></strong> in stock</span>
                            <span><strong><%= Number(recommendation.score || 0).toFixed(0) %></strong> score</span>
                        </div>
                        <form action="/merchant/products/<%= product.id %>/feature" method="POST">
                            <input type="hidden" name="featuredOrder" value="<%= recommendation.featuredOrder %>">
                            <input type="hidden" name="featuredStartDate" value="<%= recommendation.featuredStartDate %>">
                            <input type="hidden" name="featuredEndDate" value="<%= recommendation.featuredEndDate %>">
                            <button class="button secondary" type="submit" <%= recommendation.canFeatureNow ? '' : 'disabled' %>><%= recommendation.canFeatureNow ? 'Feature for this month' : '3 featured products already selected' %></button>
                        </form>
                    </article>
                <% }) %>
            </div>
        </section>
    <% } %>

    <% if (products.length === 0) { %>
        <div class="merchant-products-empty">
            <p class="eyebrow">Products</p>
            <h2>No products listed yet</h2>
            <p>Add your first product when it is ready for customers.</p>
            <a class="button primary" href="/merchant/products/new">Add product</a>
        </div>
    <% } else { %>
        <div class="merchant-products-table-head" aria-hidden="true">
            <span>Product</span>
            <span>Price</span>
            <span>Stock</span>
            <span>Featured</span>
            <span>Restock</span>
            <span>Actions</span>
        </div>
        <div class="merchant-product-list">
            <% products.forEach((product) => { %>
                <%
                    const displayImageUrl = product.imageUrl || product.fallbackImageUrl || '';
                    const productImageClass = displayImageUrl ? '' : 'product-skin';
                    const productImageStyle = displayImageUrl ? `background-image: linear-gradient(180deg, rgba(255, 253, 247, 0.04), rgba(48, 68, 43, 0.16)), url('${displayImageUrl}')` : '';
                    const recommendation = product.featuredRecommendation || null;
                %>
                <article class="merchant-product-row compact">
                    <div class="merchant-product-thumb <%= productImageClass %>" style="<%= productImageStyle %>"></div>
                    <div class="merchant-product-main">
                        <h2><%= product.name %></h2>
                        <p class="muted"><%= product.salonName %></p>
                        <p class="merchant-product-sales"><strong><%= Number(product.salesCount || 0) %></strong> paid unit<%= Number(product.salesCount || 0) === 1 ? '' : 's' %> sold</p>
                        <% if ((product.routineGoalTags || []).length || (product.routineConcernTags || []).length || product.routineRecommendationNote) { %>
                            <p class="muted">
                                Routine Finder:
                                <strong><%= [...(product.routineGoalTags || []), ...(product.routineConcernTags || [])].slice(0, 4).join(', ') || 'Note added' %></strong>
                                <% if (product.routineRecommendationNote) { %>
                                    &middot; <%= product.routineRecommendationNote %>
                                <% } %>
                            </p>
                        <% } else { %>
                            <p class="muted">Routine Finder tags not set yet.</p>
                        <% } %>
                    </div>
                    <div class="merchant-product-meta">
                        <strong>$<%= product.price.toFixed(2) %></strong>
                    </div>
                    <div class="merchant-product-stock <%= Number(product.stockQuantity || 0) <= 5 ? 'is-low' : '' %>">
                        <strong><%= product.stockQuantity %></strong>
                        <span>in stock</span>
                    </div>
                    <div class="merchant-featured-cell <%= product.isFeatured ? 'is-featured' : 'is-idle' %>">
                        <span class="merchant-featured-pill <%= product.isFeatured ? 'is-featured' : 'is-idle' %>">
                            <%= product.isFeatured ? 'Featured' : 'Not featured' %>
                        </span>
                        <% if (product.isFeatured) { %>
                            <strong>Priority #<%= Number(product.featuredOrder || 0) %></strong>
                            <span><%= product.featuredStartDate || 'No start' %> to <%= product.featuredEndDate || 'No end' %></span>
                        <% } else if (recommendation) { %>
                            <strong>Recommended #<%= recommendation.rank %></strong>
                            <span>Sales score: <%= Number(recommendation.score || 0).toFixed(0) %></span>
                            <span><%= recommendation.reason %></span>
                            <span><%= recommendation.canFeatureNow ? `Suggested priority ${recommendation.featuredOrder}` : 'Replace one existing featured product to use this recommendation.' %></span>
                        <% } else { %>
                            <span>Use this to push the product into featured storefront slots.</span>
                        <% } %>
                    </div>
                    <form class="merchant-restock-form" action="/merchant/products/<%= product.id %>/restock" method="POST" aria-label="Restock <%= product.name %>">
                        <input type="number" name="quantity" min="1" max="999" step="1" value="1" aria-label="Restock quantity">
                        <button class="restock-icon-button" type="submit" title="Restock <%= product.name %>" aria-label="Restock <%= product.name %>">+</button>
                    </form>
                    <div class="merchant-product-actions">
                        <a class="button secondary" href="/merchant/products/<%= product.id %>/edit">Edit</a>
                        <details class="merchant-featured-editor">
                            <summary><%= product.isFeatured ? 'Edit featured' : 'Feature product' %></summary>
                            <form class="merchant-featured-form" action="/merchant/products/<%= product.id %>/feature" method="POST">
                                <label>
                                    <span>Priority</span>
                                    <input type="number" name="featuredOrder" min="0" max="99" value="<%= product.isFeatured ? Number(product.featuredOrder || 0) : Number(recommendation?.featuredOrder || 0) %>" placeholder="Order" aria-label="Featured order">
                                </label>
                                <label>
                                    <span>Start date</span>
                                    <input type="date" name="featuredStartDate" value="<%= product.isFeatured ? (product.featuredStartDate || '') : (recommendation?.featuredStartDate || '') %>" aria-label="Featured start date">
                                </label>
                                <label>
                                    <span>End date</span>
                                    <input type="date" name="featuredEndDate" value="<%= product.isFeatured ? (product.featuredEndDate || '') : (recommendation?.featuredEndDate || '') %>" aria-label="Featured end date">
                                </label>
                                <% if (!product.isFeatured && recommendation) { %>
                                    <p class="muted">Recommended: <%= recommendation.reason %></p>
                                <% } %>
                                <button class="button secondary" type="submit"><%= product.isFeatured ? 'Save featured settings' : 'Mark as Featured' %></button>
                            </form>
                        </details>
                        <% if (product.isFeatured) { %>
                            <form action="/merchant/products/<%= product.id %>/unfeature" method="POST">
                                <button class="button secondary" type="submit">Remove Featured</button>
                            </form>
                        <% } %>
                        <form action="/merchant/products/<%= product.id %>/delete" method="POST">
                            <button class="button secondary danger-button" type="submit">Delete</button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
</section>

<%- include('partials/footer') %>
