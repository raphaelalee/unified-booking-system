<%- include('partials/header', { title }) %>

<%
    const totalStock = products.reduce((sum, product) => sum + Number(product.stockQuantity || 0), 0);
    const lowStockCount = products.filter((product) => Number(product.stockQuantity || 0) <= 5).length;
    const featuredCount = products.filter((product) => product.isFeatured).length;
%>

<section class="section compact merchant-products-page">
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <header class="merchant-products-hero">
        <div class="merchant-products-hero-copy">
            <p class="eyebrow">Merchant Portal</p>
            <h1>Product inventory</h1>
            <p>Manage products for <%= merchant.name %>, update stock quickly, and keep the customer product page ready for shoppers.</p>
        </div>
        <div class="merchant-products-hero-actions">
            <a class="button primary" href="/merchant/products/new">Add product</a>
        </div>
    </header>

    <div class="merchant-products-summary" aria-label="Inventory summary">
        <article>
            <span>Listed products</span>
            <strong><%= products.length %></strong>
        </article>
        <article>
            <span>Total stock</span>
            <strong><%= totalStock %></strong>
        </article>
        <article>
            <span>Low stock</span>
            <strong><%= lowStockCount %></strong>
        </article>
        <article>
            <span>Featured</span>
            <strong><%= featuredCount %>/3</strong>
        </article>
    </div>

    <% if (products.length === 0) { %>
        <div class="merchant-products-empty">
            <p class="eyebrow">Products</p>
            <h2>No products listed yet</h2>
            <p>Add your first product when it is ready for customers.</p>
            <a class="button primary" href="/merchant/products/new">Add product</a>
        </div>
    <% } else { %>
        <div class="merchant-products-table-head" aria-hidden="true">
            <span>Product</span>
            <span>Price</span>
            <span>Stock</span>
            <span>Featured</span>
            <span>Restock</span>
            <span>Actions</span>
        </div>
        <div class="merchant-product-list">
            <% products.forEach((product) => { %>
                <%
                    const displayImageUrl = product.imageUrl || product.fallbackImageUrl || '';
                    const productImageClass = displayImageUrl ? '' : 'product-skin';
                    const productImageStyle = displayImageUrl ? `background-image: linear-gradient(180deg, rgba(255, 253, 247, 0.04), rgba(48, 68, 43, 0.16)), url('${displayImageUrl}')` : '';
                %>
                <article class="merchant-product-row compact">
                    <div class="merchant-product-thumb <%= productImageClass %>" style="<%= productImageStyle %>"></div>
                    <div class="merchant-product-main">
                        <h2><%= product.name %></h2>
                        <p class="muted"><%= product.salonName %></p>
                    </div>
                    <div class="merchant-product-meta">
                        <strong>$<%= product.price.toFixed(2) %></strong>
                    </div>
                    <div class="merchant-product-stock <%= Number(product.stockQuantity || 0) <= 5 ? 'is-low' : '' %>">
                        <strong><%= product.stockQuantity %></strong>
                        <span>in stock</span>
                    </div>
                    <div class="merchant-featured-cell <%= product.isFeatured ? 'is-featured' : 'is-idle' %>">
                        <span class="merchant-featured-pill <%= product.isFeatured ? 'is-featured' : 'is-idle' %>">
                            <%= product.isFeatured ? 'Featured' : 'Not featured' %>
                        </span>
                        <% if (product.isFeatured) { %>
                            <strong>Priority #<%= Number(product.featuredOrder || 0) %></strong>
                            <span><%= product.featuredStartDate || 'No start' %> to <%= product.featuredEndDate || 'No end' %></span>
                        <% } else { %>
                            <span>Use this to push the product into featured storefront slots.</span>
                        <% } %>
                    </div>
                    <form class="merchant-restock-form" action="/merchant/products/<%= product.id %>/restock" method="POST" aria-label="Restock <%= product.name %>">
                        <input type="number" name="quantity" min="1" max="999" step="1" value="1" aria-label="Restock quantity">
                        <button class="restock-icon-button" type="submit" title="Restock <%= product.name %>" aria-label="Restock <%= product.name %>">+</button>
                    </form>
                    <div class="merchant-product-actions">
                        <a class="button secondary" href="/merchant/products/<%= product.id %>/edit">Edit</a>
                        <details class="merchant-featured-editor">
                            <summary><%= product.isFeatured ? 'Edit featured' : 'Feature product' %></summary>
                            <form class="merchant-featured-form" action="/merchant/products/<%= product.id %>/feature" method="POST">
                                <label>
                                    <span>Priority</span>
                                    <input type="number" name="featuredOrder" min="0" max="99" value="<%= Number(product.featuredOrder || 0) %>" placeholder="Order" aria-label="Featured order">
                                </label>
                                <label>
                                    <span>Start date</span>
                                    <input type="date" name="featuredStartDate" value="<%= product.featuredStartDate || '' %>" aria-label="Featured start date">
                                </label>
                                <label>
                                    <span>End date</span>
                                    <input type="date" name="featuredEndDate" value="<%= product.featuredEndDate || '' %>" aria-label="Featured end date">
                                </label>
                                <button class="button secondary" type="submit"><%= product.isFeatured ? 'Save featured settings' : 'Mark as Featured' %></button>
                            </form>
                        </details>
                        <% if (product.isFeatured) { %>
                            <form action="/merchant/products/<%= product.id %>/unfeature" method="POST">
                                <button class="button secondary" type="submit">Remove Featured</button>
                            </form>
                        <% } %>
                        <form action="/merchant/products/<%= product.id %>/delete" method="POST">
                            <button class="button secondary danger-button" type="submit">Delete</button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
</section>

<%- include('partials/footer') %>
