<%- include('partials/header', { title }) %>

<section class="page-title">
    <p class="eyebrow">Merchant Portal</p>
    <h1>My products.</h1>
    <p>List and manage products for <%= merchant.name %>. Customers can shop these products from the Vaniday product page.</p>
</section>

<section class="section compact">
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <div class="merchant-products-toolbar compact">
        <div>
            <p class="eyebrow">Products</p>
            <h2><%= products.length %> listed product<%= products.length === 1 ? '' : 's' %></h2>
        </div>
        <div class="admin-action-row">
            <a class="button secondary" href="/merchant">Back to dashboard</a>
            <a class="button primary" href="/merchant/products/new">Add product</a>
        </div>
    </div>

    <% if (products.length === 0) { %>
        <div class="notice">
            <p>No products listed yet. Add your first product when it is ready for customers.</p>
        </div>
    <% } else { %>
        <div class="merchant-product-list">
            <% products.forEach((product) => { %>
                <article class="merchant-product-row compact">
                    <div class="merchant-product-thumb product-skin" style="<%= product.imageUrl ? `background-image: url('${product.imageUrl}')` : '' %>"></div>
                    <div class="merchant-product-main">
                        <h2><%= product.name %></h2>
                        <p class="muted"><%= product.salonName %></p>
                    </div>
                    <div class="merchant-product-meta">
                        <strong>$<%= product.price.toFixed(2) %></strong>
                        <span><%= product.stockQuantity %> in stock</span>
                    </div>
                    <form class="merchant-restock-form" action="/merchant/products/<%= product.id %>/restock" method="POST" aria-label="Restock <%= product.name %>">
                        <input type="number" name="quantity" min="1" max="999" step="1" value="1" aria-label="Restock quantity">
                        <button class="restock-icon-button" type="submit" title="Restock <%= product.name %>" aria-label="Restock <%= product.name %>">+</button>
                    </form>
                    <div class="merchant-product-actions">
                        <a class="button secondary" href="/merchant/products/<%= product.id %>/edit">Edit</a>
                        <form action="/merchant/products/<%= product.id %>/delete" method="POST">
                            <button class="button secondary danger-button" type="submit">Delete</button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
</section>

<%- include('partials/footer') %>
