<%- include('partials/header', { title }) %>

<section class="otp-auth-shell">
    <div class="otp-auth-card">
        <div class="otp-card-copy">
            <p class="eyebrow"><%= pending.method === 'sms' ? 'SMS verification' : 'Email verification' %></p>
            <h1>Enter your code</h1>
            <p>We sent a one-time code to <strong><%= pending.destination %></strong>.</p>
        </div>

        <% if (success) { %>
            <div class="notice success"><p><%= success %></p></div>
        <% } %>

        <% if (error) { %>
            <div class="notice error"><p><%= error %></p></div>
        <% } %>

        <form class="otp-form" action="/login/verify-otp" method="POST" data-otp-form>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="code" value="" data-otp-code>

            <div class="otp-input-row" aria-label="One-time verification code">
                <% for (let index = 0; index < 6; index += 1) { %>
                    <input
                        class="otp-digit"
                        type="text"
                        inputmode="numeric"
                        pattern="[0-9]*"
                        maxlength="1"
                        autocomplete="<%= index === 0 ? 'one-time-code' : 'off' %>"
                        aria-label="Digit <%= index + 1 %>"
                        data-otp-digit
                        <%= index === 0 ? 'autofocus' : '' %>>
                <% } %>
            </div>

            <button class="otp-primary-button" type="submit">Verify Code</button>
        </form>

        <div class="otp-secondary-actions">
            <form action="/login/otp-method" method="POST" data-resend-email-form>
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="method" value="email">
                <% if (pending.secondsUntilResend > 0) { %>
                    <button class="otp-text-button" type="submit" disabled data-resend-email data-resend-seconds="<%= pending.secondsUntilResend %>">
                        Resend code in <%= pending.secondsUntilResend %>s
                    </button>
                <% } else { %>
                    <button class="otp-text-button" type="submit" <%= !pending.canUseEmail ? 'disabled' : '' %> data-resend-email data-resend-seconds="0">
                        Resend via Email
                    </button>
                <% } %>
            </form>

            <form action="/login/otp-method" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="method" value="sms">
                <button class="otp-text-button otp-sms-link" type="submit" <%= !pending.canUseSms ? 'disabled' : '' %>>
                    Send via SMS instead
                </button>
            </form>

            <a class="otp-back-link" href="/login">Back to login</a>
        </div>
    </div>
</section>

<script>
    (() => {
        const form = document.querySelector('[data-otp-form]');
        const digits = Array.from(document.querySelectorAll('[data-otp-digit]'));
        const codeInput = document.querySelector('[data-otp-code]');
        const resendButton = document.querySelector('[data-resend-email]');

        const syncCode = () => {
            if (codeInput) {
                codeInput.value = digits.map((input) => input.value).join('');
            }
        };

        digits.forEach((input, index) => {
            input.addEventListener('input', () => {
                input.value = input.value.replace(/\D/g, '').slice(0, 1);
                syncCode();

                if (input.value && digits[index + 1]) {
                    digits[index + 1].focus();
                }
            });

            input.addEventListener('keydown', (event) => {
                if (event.key === 'Backspace' && !input.value && digits[index - 1]) {
                    digits[index - 1].focus();
                }
            });

            input.addEventListener('paste', (event) => {
                const pastedCode = event.clipboardData.getData('text').replace(/\D/g, '').slice(0, digits.length);

                if (!pastedCode) {
                    return;
                }

                event.preventDefault();
                digits.forEach((digitInput, digitIndex) => {
                    digitInput.value = pastedCode[digitIndex] || '';
                });
                syncCode();
                const nextIndex = Math.min(pastedCode.length, digits.length) - 1;
                digits[Math.max(nextIndex, 0)].focus();
            });
        });

        form?.addEventListener('submit', (event) => {
            syncCode();

            if (!/^\d{6}$/.test(codeInput?.value || '')) {
                event.preventDefault();
                digits.find((input) => !input.value)?.focus();
            }
        });

        if (resendButton) {
            let secondsLeft = Number(resendButton.dataset.resendSeconds || 0);

            if (secondsLeft > 0) {
                const tick = () => {
                    secondsLeft -= 1;

                    if (secondsLeft <= 0) {
                        resendButton.disabled = false;
                        resendButton.textContent = 'Resend via Email';
                        return;
                    }

                    resendButton.textContent = `Resend code in ${secondsLeft}s`;
                    window.setTimeout(tick, 1000);
                };

                window.setTimeout(tick, 1000);
            }
        }
    })();
</script>

<%- include('partials/footer') %>
