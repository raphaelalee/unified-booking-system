<%- include('partials/header', { title }) %>

<% const showClaimPop = Boolean(success && success.startsWith('Claimed ')); %>

<section class="section compact reward-shop-page">
    <%
        const platformOffers = (offers || []).filter((offer) => (offer.voucherSource || 'platform') !== 'merchant');
        const merchantOffers = (offers || []).filter((offer) => (offer.voucherSource || '') === 'merchant');
    %>
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <section class="reward-shop-daily-card <%= showClaimPop ? 'has-claim-pop' : '' %>">
        <p class="reward-shop-kicker reward-shop-kicker-light">VaniGlints Rewards Page</p>

        <div class="reward-shop-daily-balance">
            <span class="reward-shop-coin" aria-hidden="true">V</span>
            <strong><%= glintsBalance %></strong>
            <span class="reward-shop-daily-arrow" aria-hidden="true">&#8250;</span>
        </div>

        <% if (showClaimPop) { %>
            <span class="reward-shop-claim-pop" aria-hidden="true">V</span>
        <% } %>

        <div class="reward-shop-daily-panel">
            <div class="reward-shop-streak-grid">
                <% dailyRewards.forEach((reward, index) => { %>
                    <article class="reward-shop-streak-day <%= reward.isCurrent ? 'is-today' : '' %> <%= reward.isClaimed ? 'is-claimed' : '' %> <%= index === 6 ? 'is-highlight' : '' %>">
                        <span class="reward-shop-streak-points">+<%= reward.points %></span>
                        <span class="reward-shop-coin reward-shop-coin-small" aria-hidden="true">V</span>
                        <strong><%= reward.label %></strong>
                    </article>
                <% }) %>
            </div>

            <div class="reward-shop-daily-cta-wrap">
                <% if (rewardWallet && rewardWallet.hasClaimedToday) { %>
                    <button class="reward-shop-daily-cta is-claimed" type="button" disabled>Next claim is tomorrow</button>
                <% } else { %>
                    <form action="/reward-shop/claim" method="POST">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <button class="reward-shop-daily-cta" type="submit">
                            Claim now (+<%= rewardWallet ? rewardWallet.nextRewardValue : 10 %>)
                        </button>
                    </form>
                <% } %>
            </div>
        </div>
    </section>

    <div class="reward-shop-shell">
        <section class="reward-shop-hero">
            <p class="reward-shop-kicker">Reward Shop</p>
            <h1>Turn VaniGlints into booking vouchers.</h1>
            <p class="reward-shop-copy">
                Redeem your saved points for cash-offset vouchers. The higher your balance, the more value you can unlock for your next booking.
            </p>

            <div class="reward-shop-balance">
                <span class="reward-shop-balance-icon" aria-hidden="true">V</span>
                <div>
                    <strong><%= glintsBalance %></strong>
                    <span>Available VaniGlints</span>
                </div>
            </div>

            <div class="reward-shop-rate">
                <span>Conversion rate</span>
                <strong>1,000 Glints = $1 SGD</strong>
            </div>
        </section>

        <section class="reward-shop-panel">
            <div class="reward-shop-panel-header">
                <div>
                    <p class="eyebrow">Redeemable tiers</p>
                    <h2>Choose your voucher value</h2>
                </div>
                <a class="button secondary" href="/profile#vouchers">My vouchers<% if (typeof ownedVoucherCount !== 'undefined') { %> (<%= ownedVoucherCount %>)<% } %></a>
            </div>

            <div class="profile-voucher-tabs" data-reward-shop-tabs>
                <button class="profile-voucher-tab is-active" type="button" data-reward-shop-tab="vaniday">
                    Vani vouchers (<%= platformOffers.length %>)
                </button>
                <button class="profile-voucher-tab" type="button" data-reward-shop-tab="merchant">
                    Merchant vouchers (<%= merchantOffers.length %>)
                </button>
            </div>

            <% const renderOfferGrid = (offerList = []) => { %>
                <div class="reward-shop-grid">
                    <% offerList.forEach((offer) => { %>
                        <article class="reward-voucher-card <%= offer.canRedeem ? 'is-available' : 'is-locked' %>">
                            <div class="reward-voucher-topline">
                                <span class="reward-voucher-cost"><%= offer.glintsCost.toLocaleString('en-SG') %> Glints</span>
                                <span class="reward-voucher-value">
                                    <%= offer.discountType === 'percentage'
                                        ? `${Number(offer.discountValue || 0)}%`
                                        : `$${Number(offer.voucherValue || offer.discountValue || 0).toFixed(0)}` %>
                                </span>
                            </div>

                            <% if (offer.merchantName) { %>
                                <p class="tag"><%= offer.merchantName %></p>
                            <% } %>
                            <h3><%= offer.title %></h3>
                            <p><%= offer.detail %></p>

                            <div class="reward-voucher-meta">
                                <% if (offer.canRedeem) { %>
                                    <span class="reward-status reward-status-ready">Ready to redeem</span>
                                    <form action="/reward-shop/vouchers/<%= encodeURIComponent(offer.voucherId || offer.id) %>/redeem" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <button class="button primary full" type="submit">Redeem now</button>
                                    </form>
                                <% } else { %>
                                    <span class="reward-status reward-status-locked">
                                        Need <%= offer.remaining.toLocaleString('en-SG') %> more Glints
                                    </span>
                                    <button class="button secondary full" type="button" disabled>Locked</button>
                                <% } %>
                            </div>
                        </article>
                    <% }) %>
                    <% if (offerList.length === 0) { %>
                        <div class="notice">
                            No vouchers in this tab right now.
                        </div>
                    <% } %>
                </div>
            <% }; %>

            <div class="profile-voucher-tab-panel is-active" data-reward-shop-panel="vaniday">
                <% renderOfferGrid(platformOffers); %>
            </div>

            <div class="profile-voucher-tab-panel" data-reward-shop-panel="merchant" hidden>
                <% renderOfferGrid(merchantOffers); %>
            </div>

            <div class="reward-shop-note">
                <p>
                    Redeemed vouchers are added to your profile rewards section and can be used on eligible booking payments.
                </p>
            </div>
        </section>
    </div>
</section>

<script>
    (() => {
        const tabGroups = document.querySelectorAll('[data-reward-shop-tabs]');

        tabGroups.forEach((group) => {
            const tabs = Array.from(group.querySelectorAll('[data-reward-shop-tab]'));
            const panels = Array.from(group.parentElement.querySelectorAll('[data-reward-shop-panel]'));

            const activateTab = (target) => {
                tabs.forEach((tab) => {
                    const isActive = tab.dataset.rewardShopTab === target;
                    tab.classList.toggle('is-active', isActive);
                });

                panels.forEach((panel) => {
                    const isActive = panel.dataset.rewardShopPanel === target;
                    panel.classList.toggle('is-active', isActive);
                    panel.hidden = !isActive;
                });
            };

            tabs.forEach((tab) => {
                tab.addEventListener('click', () => activateTab(tab.dataset.rewardShopTab));
            });
        });
    })();
</script>

<%- include('partials/footer') %>
