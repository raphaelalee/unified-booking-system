<%- include('partials/header', { title }) %>

<% if (allowSalonChoice) { %>
    <section class="admin-dashboard-v2">
        <%- include('partials/admin-sidebar') %>
        <div class="admin-main-panel">
            <%- include('partials/admin-rewards-tabs') %>

            <header class="admin-dashboard-header marketplace-admin-header">
                <div>
                    <p class="eyebrow">Admin Rewards</p>
                    <h1><%= title %></h1>
                    <p>Create platform rewards or attach rewards to a merchant.</p>
                </div>
                <a class="button secondary" href="<%= cancelPath %>">Back to game rewards</a>
            </header>

            <% if (errors && errors.length > 0) { %>
                <div class="notice error">
                    <% errors.forEach((message) => { %>
                        <p><%= message %></p>
                    <% }) %>
                </div>
            <% } %>

            <section class="admin-panel marketplace-crud-panel">
                <%- include('partials/game-prize-fields', { actionPath, form, allowSalonChoice, salons, merchant: null, prizeTypes, statuses, cancelPath, prize }) %>
            </section>
        </div>
    </section>
<% } else { %>
    <section class="page-title">
        <p class="eyebrow">Merchant Portal</p>
        <h1><%= title %>.</h1>
        <p>Create a reward customers can win from your merchant.</p>
    </section>

    <section class="section compact">
        <% if (errors && errors.length > 0) { %>
            <div class="notice error">
                <% errors.forEach((message) => { %>
                    <p><%= message %></p>
                <% }) %>
            </div>
        <% } %>

        <%- include('partials/game-prize-fields', { actionPath, form, allowSalonChoice, salons: [], merchant, prizeTypes, statuses, cancelPath, prize }) %>
    </section>
<% } %>

<%- include('partials/footer') %>
