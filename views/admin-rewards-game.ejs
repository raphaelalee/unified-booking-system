<%- include('partials/header', { title }) %>

<%
    const prizeList = Array.isArray(prizes) ? prizes : [];
    const activePrizes = prizeList.filter((prize) => prize.status === 'active');
    const merchantPrizeCount = prizeList.filter((prize) => prize.salonId).length;
    const platformPrizeCount = prizeList.length - merchantPrizeCount;
    const totalWeight = prizeList.reduce((sum, prize) => sum + Number(prize.weight || 0), 0);
    const prizeTypeLabel = (type) => String(type || '').replace(/_/g, ' ');
    const typeOptions = [...new Set(prizeList.map((prize) => prize.prizeType).filter(Boolean))];
%>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <%- include('partials/admin-rewards-tabs') %>

        <header class="admin-dashboard-header marketplace-admin-header">
            <div>
                <p class="eyebrow">Admin Rewards</p>
                <h1>Game rewards</h1>
                <p>Control play rules and manage the weighted prize pool customers can win from the rewards game.</p>
            </div>
            <div class="admin-topbar-utilities">
                <a class="button secondary" href="/rewards-game">Customer game</a>
                <a class="button primary" href="/admin/rewards-game/prizes/new">Add prize</a>
            </div>
        </header>

        <% if (success) { %><div class="notice success"><p><%= success %></p></div><% } %>
        <% if (error) { %><div class="notice error"><p><%= error %></p></div><% } %>

        <section class="marketplace-admin-panel rewards-admin-panel">
            <div class="marketplace-stat-grid">
                <article><span>Status</span><strong><%= settings.isEnabled ? 'Active' : 'Paused' %></strong></article>
                <article><span>Weekly Plays</span><strong><%= settings.weeklyFreePlays %></strong></article>
                <article><span>Active Prizes</span><strong><%= activePrizes.length %></strong></article>
                <article><span>Draw Weight</span><strong><%= totalWeight %></strong></article>
            </div>

            <form class="rewards-game-rules marketplace-admin-form" action="/admin/rewards-game/settings" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="marketplace-admin-toolbar rewards-toolbar">
                    <div>
                        <p class="eyebrow">Game Rules</p>
                        <h2>Customer play criteria</h2>
                        <p class="muted">Weekly grants and spend bonus rules apply across the whole platform.</p>
                    </div>
                    <button class="button primary" type="submit">Save game rules</button>
                </div>

                <div class="marketplace-form-grid">
                    <label>
                        <span>Weekly free plays</span>
                        <input type="number" name="weeklyFreePlays" min="0" step="1" value="<%= settings.weeklyFreePlays %>" required>
                    </label>
                    <label>
                        <span>Spend amount for bonus play</span>
                        <input type="number" name="spendPerBonusPlay" min="1" step="0.01" value="<%= settings.spendPerBonusPlay %>" required>
                    </label>
                    <label>
                        <span>Bonus plays per spend tier</span>
                        <input type="number" name="bonusPlaysPerThreshold" min="0" step="1" value="<%= settings.bonusPlaysPerThreshold %>" required>
                    </label>
                    <label class="rewards-toggle-field">
                        <input type="checkbox" name="isEnabled" <%= settings.isEnabled ? 'checked' : '' %>>
                        <span>Allow customers to play</span>
                    </label>
                </div>
            </form>

            <div class="rewards-scope-grid">
                <article>
                    <span>Platform prizes</span>
                    <strong><%= platformPrizeCount %></strong>
                    <p>Created by admin and available across the platform.</p>
                </article>
                <article>
                    <span>Merchant prizes</span>
                    <strong><%= merchantPrizeCount %></strong>
                    <p>Attached to a merchant and still visible in the shared prize pool.</p>
                </article>
                <article>
                    <span>Weight logic</span>
                    <strong><%= totalWeight %></strong>
                    <p>Higher weight means a higher chance of being selected.</p>
                </article>
            </div>

            <div class="marketplace-admin-toolbar">
                <div>
                    <p class="eyebrow">Prize Records</p>
                    <h2>Weighted prize pool</h2>
                </div>
                <div class="marketplace-filter-row">
                    <label>
                        <span class="sr-only">Search prizes</span>
                        <input class="js-rewards-search" type="search" placeholder="Search prize or owner">
                    </label>
                    <label>
                        <span class="sr-only">Filter type</span>
                        <select class="js-rewards-type-filter">
                            <option value="">All types</option>
                            <% typeOptions.forEach((type) => { %>
                                <option value="<%= type %>"><%= prizeTypeLabel(type) %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        <span class="sr-only">Filter status</span>
                        <select class="js-rewards-status-filter">
                            <option value="">All statuses</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </label>
                </div>
            </div>

            <% if (prizeList.length === 0) { %>
                <div class="empty-state marketplace-empty-state">
                    <h2>No game prizes yet</h2>
                    <p class="muted">Add a platform prize or a merchant-linked prize to activate the rewards pool.</p>
                    <a class="button primary" href="/admin/rewards-game/prizes/new">Add prize</a>
                </div>
            <% } else { %>
                <div class="admin-table-wrap marketplace-table-wrap">
                    <table class="admin-table marketplace-admin-table rewards-admin-table">
                        <thead>
                            <tr>
                                <th>Prize</th>
                                <th>Owner</th>
                                <th>Type</th>
                                <th>Value</th>
                                <th>Weight</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% prizeList.forEach((prize) => { %>
                                <tr class="js-rewards-row" data-type="<%= prize.prizeType %>" data-status="<%= prize.status %>" data-search="<%= `${prize.title || ''} ${prize.description || ''} ${prize.salonName || ''}` %>">
                                    <td>
                                        <strong><%= prize.title %></strong>
                                        <small><%= prize.description || 'No description set.' %></small>
                                    </td>
                                    <td>
                                        <strong><%= prize.salonId ? prize.salonName : 'Platform' %></strong>
                                        <small><%= prize.salonId ? 'Merchant reward' : 'Admin reward' %></small>
                                    </td>
                                    <td><span class="sync-pill"><%= prizeTypeLabel(prize.prizeType) %></span></td>
                                    <td><%= prize.rewardValue === null ? '-' : prize.rewardValue %></td>
                                    <td><%= prize.weight %></td>
                                    <td><span class="sync-pill"><%= prize.status %></span></td>
                                    <td>
                                        <div class="marketplace-action-row">
                                            <a class="button secondary compact" href="/admin/rewards-game/prizes/<%= prize.id %>/edit">Edit</a>
                                            <form action="/admin/rewards-game/prizes/<%= prize.id %>/delete" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button class="button secondary compact danger-button" type="submit">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </div>
</section>

<script>
    (() => {
        const search = document.querySelector('.js-rewards-search');
        const type = document.querySelector('.js-rewards-type-filter');
        const status = document.querySelector('.js-rewards-status-filter');
        const rows = Array.from(document.querySelectorAll('.js-rewards-row'));

        const applyFilters = () => {
            const query = (search?.value || '').trim().toLowerCase();
            const selectedType = (type?.value || '').trim().toLowerCase();
            const selectedStatus = (status?.value || '').trim().toLowerCase();

            rows.forEach((row) => {
                const haystack = (row.dataset.search || '').toLowerCase();
                const rowType = (row.dataset.type || '').toLowerCase();
                const rowStatus = (row.dataset.status || '').toLowerCase();
                row.hidden = Boolean(query && !haystack.includes(query))
                    || Boolean(selectedType && rowType !== selectedType)
                    || Boolean(selectedStatus && rowStatus !== selectedStatus);
            });
        };

        search?.addEventListener('input', applyFilters);
        type?.addEventListener('change', applyFilters);
        status?.addEventListener('change', applyFilters);
    })();
</script>

<%- include('partials/footer') %>
