<%- include('partials/header', { title }) %>

<section class="page-title auth-page-title">
    <p class="eyebrow">Sign Up</p>
    <h1>Create your Vaniday account.</h1>
    <p>Sign up to save merchants, manage your profile, track cashback, and keep services in your cart.</p>
</section>

<section class="section compact">
    <div class="login-layout">
        <form class="login-form" action="/signup" method="POST" data-signup-form>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div>
                <p class="eyebrow">Customer Account</p>
                <h2>Sign up</h2>
            </div>

            <% if (error) { %>
                <div class="notice error"><p><%= error %></p></div>
            <% } %>

            <label>
                Full name
                <input type="text" name="name" value="<%= form.name || '' %>" placeholder="Enter your name" required>
            </label>

            <label>
                Email
                <input type="email" name="email" value="<%= form.email || '' %>" placeholder="name@example.com" required>
            </label>

            <label>
                Handphone number
                <input type="tel" name="phone" value="<%= form.phone || '' %>" placeholder="81234567" maxlength="8" required>
            </label>

            <label>
                Age
                <input type="number" name="age" value="<%= form.age || '' %>" placeholder="21" min="1" max="120" required>
            </label>

            <label>
                Birthday
                <input type="date" name="birthday" value="<%= form.birthday || '' %>" max="<%= new Date().toISOString().slice(0, 10) %>" required>
            </label>

            <label>
                Gender
                <select name="gender" required>
                    <option value="">Select gender</option>
                    <option value="female" <%= form.gender === 'female' ? 'selected' : '' %>>Female</option>
                    <option value="male" <%= form.gender === 'male' ? 'selected' : '' %>>Male</option>
                    <option value="non_binary" <%= form.gender === 'non_binary' ? 'selected' : '' %>>Non-binary</option>
                    <option value="prefer_not_to_say" <%= form.gender === 'prefer_not_to_say' ? 'selected' : '' %>>Prefer not to say</option>
                    <option value="other" <%= form.gender === 'other' ? 'selected' : '' %>>Other</option>
                </select>
            </label>

            <label>
                Postal code
                <input type="text" name="postalCode" value="<%= form.postalCode || '' %>" placeholder="123456" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" required>
            </label>

            <label>
                Preferred contact method
                <select name="preferredContactMethod" required>
                    <option value="">Select contact method</option>
                    <option value="email" <%= form.preferredContactMethod === 'email' ? 'selected' : '' %>>Email</option>
                    <option value="phone" <%= form.preferredContactMethod === 'phone' ? 'selected' : '' %>>Phone call</option>
                    <option value="whatsapp" <%= form.preferredContactMethod === 'whatsapp' ? 'selected' : '' %>>WhatsApp</option>
                </select>
            </label>

            <label>
                Password
                <input type="password" name="password" placeholder="At least 8 characters" required>
            </label>

            <label>
                Confirm password
                <input type="password" name="confirmPassword" placeholder="Re-enter password" required>
            </label>

            <label>
                Referral code <span class="muted">(optional)</span>
                <input type="text" name="referralCode" value="<%= form.referralCode || '' %>" placeholder="VANI0001" autocomplete="off">
            </label>

            <label class="terms-check">
                <input type="checkbox" name="termsAccepted" value="on" required data-terms-checkbox <%= form.termsAccepted ? 'checked' : '' %>>
                <span>I agree to the <a class="text-link" href="/terms" target="_blank" rel="noopener">Terms of Service</a> and <a class="text-link" href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span>
            </label>

            <button class="button primary full" type="submit" data-create-account disabled>Create account</button>
            <p class="auth-switch">Already have an account? <a class="text-link" href="/login">Log in</a></p>
        </form>

        <aside class="login-benefits">
            <p class="eyebrow">Why sign up?</p>
            <h2>Your beauty booking companion.</h2>
            <ul>
                <li>Save favourite salons and wellness merchants</li>
                <li>Manage personal details in your profile</li>
                <li>View cashback and reward points</li>
                <li>Access your cart faster before booking</li>
            </ul>
        </aside>
    </div>
</section>

<%- include('partials/footer') %>
