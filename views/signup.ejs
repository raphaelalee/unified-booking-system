<%- include('partials/header', { title }) %>

<section class="section compact signup-page">
    <div class="signup-shell">
        <form class="login-form signup-card" action="/signup" method="POST" data-signup-form novalidate>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <header class="signup-card-header">
                <p class="eyebrow">Customer Account</p>
                <h1>Create your account</h1>
                <p>Book services, check in with QR, and keep rewards in one profile.</p>
            </header>

            <% if (error) { %>
                <div class="notice error"><p><%= error %></p></div>
            <% } %>

            <div class="signup-validation-summary" data-signup-summary hidden></div>

            <div class="signup-section">
                <div class="signup-section-heading">
                    <span>1</span>
                    <div>
                        <h2>Contact</h2>
                        <p>Used for booking updates and QR check-in receipts.</p>
                    </div>
                </div>

                <div class="signup-field-grid">
                    <label class="signup-field span-2">
                        <span>Full name</span>
                        <input type="text" name="name" value="<%= form.name || '' %>" placeholder="Mary Tan" autocomplete="name" data-validate="name" required>
                        <small data-field-message></small>
                    </label>

                    <label class="signup-field">
                        <span>Email</span>
                        <input type="email" name="email" value="<%= form.email || '' %>" placeholder="mary@example.com" autocomplete="email" data-validate="email" required>
                        <small data-field-message></small>
                    </label>

                    <label class="signup-field">
                        <span>Handphone</span>
                        <input type="tel" name="phone" value="<%= form.phone || '' %>" placeholder="81234567" maxlength="8" inputmode="numeric" autocomplete="tel" data-validate="phone" required>
                        <small data-field-message></small>
                    </label>
                </div>
            </div>

            <div class="signup-section">
                <div class="signup-section-heading">
                    <span>2</span>
                    <div>
                        <h2>Profile</h2>
                        <p>Helps merchants prepare for the right customer details.</p>
                    </div>
                </div>

                <div class="signup-field-grid">
                    <label class="signup-field">
                        <span>Birthday</span>
                        <input type="date" name="birthday" value="<%= form.birthday || '' %>" max="<%= new Date().toISOString().slice(0, 10) %>" data-validate="birthday" required>
                        <small data-field-message></small>
                    </label>

                    <label class="signup-field">
                        <span>Age</span>
                        <input type="number" name="age" value="<%= form.age || '' %>" placeholder="Auto" min="1" max="120" inputmode="numeric" data-validate="age" required>
                        <small data-field-message></small>
                    </label>

                    <label class="signup-field">
                        <span>Gender</span>
                        <select data-readable-select name="gender" data-validate="gender" required>
                            <option value="">Select</option>
                            <option value="female" <%= form.gender === 'female' ? 'selected' : '' %>>Female</option>
                            <option value="male" <%= form.gender === 'male' ? 'selected' : '' %>>Male</option>
                            <option value="non_binary" <%= form.gender === 'non_binary' ? 'selected' : '' %>>Non-binary</option>
                            <option value="prefer_not_to_say" <%= form.gender === 'prefer_not_to_say' ? 'selected' : '' %>>Prefer not to say</option>
                            <option value="other" <%= form.gender === 'other' ? 'selected' : '' %>>Other</option>
                        </select>
                        <small data-field-message></small>
                    </label>

                    <label class="signup-field">
                        <span>Postal code</span>
                        <input type="text" name="postalCode" value="<%= form.postalCode || '' %>" placeholder="123456" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" data-validate="postalCode" required>
                        <small data-field-message></small>
                    </label>

                    <label class="signup-field span-2">
                        <span>Preferred contact</span>
                        <select data-readable-select name="preferredContactMethod" data-validate="preferredContactMethod" required>
                            <option value="">Select contact method</option>
                            <option value="email" <%= form.preferredContactMethod === 'email' ? 'selected' : '' %>>Email</option>
                            <option value="phone" <%= form.preferredContactMethod === 'phone' ? 'selected' : '' %>>Phone call</option>
                            <option value="whatsapp" <%= form.preferredContactMethod === 'whatsapp' ? 'selected' : '' %>>WhatsApp</option>
                        </select>
                        <small data-field-message></small>
                    </label>
                </div>
            </div>

            <div class="signup-section">
                <div class="signup-section-heading">
                    <span>3</span>
                    <div>
                        <h2>Security</h2>
                        <p>Choose a password and add a referral code if you have one.</p>
                    </div>
                </div>

                <div class="signup-field-grid">
                    <label class="signup-field">
                        <span>Password</span>
                        <input type="password" name="password" placeholder="At least 8 characters" autocomplete="new-password" data-validate="password" required>
                        <small data-field-message></small>
                    </label>

                    <label class="signup-field">
                        <span>Confirm password</span>
                        <input type="password" name="confirmPassword" placeholder="Re-enter password" autocomplete="new-password" data-validate="confirmPassword" required>
                        <small data-field-message></small>
                    </label>

                    <label class="signup-field span-2">
                        <span>Referral code <em>optional</em></span>
                        <input type="text" name="referralCode" value="<%= form.referralCode || '' %>" placeholder="VANI0001" autocomplete="off" data-validate="referralCode">
                        <small data-field-message></small>
                    </label>
                </div>

                <div class="signup-password-rules" data-password-rules>
                    <span data-rule="length">8+ characters</span>
                    <span data-rule="letter">Letter</span>
                    <span data-rule="number">Number</span>
                </div>
            </div>

            <label class="terms-check signup-terms-card">
                <input type="checkbox" name="termsAccepted" value="on" required data-terms-checkbox <%= form.termsAccepted ? 'checked' : '' %>>
                <span class="terms-checkmark" aria-hidden="true"></span>
                <span class="terms-copy">I agree to the <a class="text-link" href="/terms" target="_blank" rel="noopener">Terms of Service</a> and <a class="text-link" href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span>
            </label>

            <button class="button primary full" type="submit" data-create-account disabled>Create account</button>
            <div class="auth-switch-card">
                <span>Already have an account?</span>
                <a class="button secondary auth-switch-action" href="/login">Log in</a>
            </div>
        </form>

        <aside class="signup-aside">
            <div>
                <p class="eyebrow">Vaniday Rewards</p>
                <h2>Book now, earn later.</h2>
                <p>You earn points after QR check-in and appointment completion. Redeemed points are refunded when eligible cancellations happen.</p>
            </div>
            <ul>
                <li><strong>QR check-in</strong><span>Skip account checks at the counter.</span></li>
                <li><strong>Wallet history</strong><span>See earned, redeemed, and refunded points.</span></li>
                <li><strong>Faster booking</strong><span>Your contact details stay ready for the next appointment.</span></li>
            </ul>
        </aside>
    </div>
</section>

<%- include('partials/footer') %>

