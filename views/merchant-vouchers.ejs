<%- include('partials/header', { title }) %>

<%
    const aiVoucherPayload = JSON.stringify({
        customerBookingFrequency: '',
        customerTotalSpend: '',
        favouriteMerchant: merchant.name || merchant.salonName || '',
        favouriteService: (merchant.services || [])[0]?.name || '',
        merchantSales: '',
        lowBookingDays: [],
        existingVouchers: vouchers.map((voucher) => voucher.title).filter(Boolean),
        voucherRedemptionPerformance: vouchers.map((voucher) => `${voucher.title}: ${Number(voucher.redemptionCount || 0)} redemptions`),
        availableServices: (merchant.services || []).map((service) => service.name).filter(Boolean),
        availableProducts: vouchers.filter((voucher) => voucher.linkedItemType === 'product').map((voucher) => voucher.linkedItemName).filter(Boolean)
    }).replace(/</g, '\\u003c');
    const formatVoucherDate = (value) => {
        const date = value instanceof Date ? value : new Date(value);

        if (!value || Number.isNaN(date.getTime())) {
            return 'Not set';
        }

        return date.toLocaleString('en-SG', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: 'numeric',
            minute: '2-digit'
        });
    };
%>

<section class="section compact merchant-analytics-page">
    <div class="merchant-analytics-shell">
        <header class="merchant-dashboard-hero">
            <div>
                <p class="eyebrow">Vouchers</p>
                <h1>Merchant vouchers</h1>
                <span>Create reward-shop vouchers only from services or products already listed under <%= merchant.name %>.</span>
            </div>
            <div class="merchant-hero-actions">
                <a class="button primary" href="/merchant/vouchers/new">Add voucher</a>
            </div>
        </header>
        <% if (success) { %>
            <div class="notice success"><p><%= success %></p></div>
        <% } %>
        <% if (error) { %>
            <div class="notice error"><p><%= error %></p></div>
        <% } %>

        <div class="section-cta">
            <div>
                <h2>Reward shop vouchers</h2>
                <p class="muted"><%= vouchers.length %> vouchers currently linked to this merchant.</p>
            </div>
        </div>

        <section class="service-catalog-card unified-service-card" data-ai-voucher-panel>
            <div class="portal-card-header">
                <div>
                    <span class="tag">AI assistant</span>
                    <h3>Voucher recommendations</h3>
                </div>
                <button class="button primary" type="button" data-generate-ai-vouchers>Generate voucher recommendations</button>
            </div>
            <p class="muted">
                Suggests reward-shop voucher ideas from your listed services, existing vouchers, and customer-retention patterns.
            </p>
            <div class="notice" data-ai-voucher-status hidden></div>
            <div class="service-catalog-grid unified-service-grid" data-ai-voucher-results hidden></div>
        </section>

        <% if (vouchers.length === 0) { %>
            <div class="notice">
                No vouchers have been created yet. Add one and link it to an existing listed service or product.
            </div>
        <% } else { %>
            <div class="service-catalog-grid unified-service-grid">
                <% vouchers.forEach((voucher) => { %>
                    <article class="service-catalog-card unified-service-card">
                        <div class="portal-card-header">
                            <span class="tag"><%= voucher.linkedItemType || 'merchant' %></span>
                            <span class="service-price slim"><%= voucher.status %></span>
                        </div>
                        <div>
                            <h3><%= voucher.title %></h3>
                            <p class="muted">
                                <%= voucher.linkedItemName || 'Linked item unavailable' %> &middot;
                                <%= voucher.discountType === 'percentage'
                                    ? `${Number(voucher.discountValue || 0)}% OFF`
                                    : `$${Number(voucher.discountValue || 0).toFixed(2)} OFF` %>
                            </p>
                            <p class="muted">
                                Redeem cost <strong><%= Number(voucher.pointsRequired || voucher.glintsCost || 0) %> VaniGlints</strong>
                                &middot; Min spend $<%= Number(voucher.minimumSpend || 0).toFixed(2) %>
                            </p>
                            <p class="muted">
                                Per-user limit <%= voucher.usageLimitPerUser === null ? 'No limit' : voucher.usageLimitPerUser %>
                                &middot; Total limit <%= voucher.usageLimitTotal === null ? 'No limit' : voucher.usageLimitTotal %>
                            </p>
                            <% if (voucher.detail) { %>
                                <p><%= voucher.detail %></p>
                            <% } %>
                        </div>
                        <div class="availability-strip">
                            <span>Starts <%= formatVoucherDate(voucher.startDate) %></span>
                            <span>Ends <%= formatVoucherDate(voucher.expiryDate) %></span>
                        </div>
                        <div class="service-card-actions">
                            <a class="button secondary full" href="/merchant/vouchers/<%= voucher.id %>/edit">Edit</a>
                            <form action="/merchant/vouchers/<%= voucher.id %>/delete" method="POST">
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <button class="button secondary full danger-button" type="submit">Delete</button>
                            </form>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </div>
</section>

<script>
    (() => {
        const aiVoucherData = <%- aiVoucherPayload %>;
        const button = document.querySelector('[data-generate-ai-vouchers]');
        const status = document.querySelector('[data-ai-voucher-status]');
        const results = document.querySelector('[data-ai-voucher-results]');
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

        const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;'
        }[char]));

        const setStatus = (message, isError = false) => {
            if (!status) return;
            status.hidden = !message;
            status.classList.toggle('error', Boolean(isError));
            status.textContent = message || '';
        };

        const buildCreateUrl = (recommendation = {}) => {
            const params = new URLSearchParams({
                fromAi: '1',
                aiTitle: recommendation.voucherTitle || '',
                aiItem: recommendation.serviceOrProduct || recommendation.targetCustomerGroup || '',
                aiDiscountType: recommendation.discountType || '',
                aiDiscountValue: recommendation.discountValue || '',
                aiMinimumSpend: formatMinimumSpend(recommendation.minimumSpend),
                aiPointsRequired: formatPoints(recommendation.pointsRequired),
                aiReason: recommendation.reason || '',
                aiBenefit: recommendation.expectedBenefit || ''
            });

            return `/merchant/vouchers/new?${params.toString()}`;
        };

        const formatPoints = (value) => {
            const points = Number(value || 0);
            return points > 0 ? String(Math.round(points)) : '500';
        };

        const formatMinimumSpend = (value) => {
            const text = String(value ?? '').trim();
            if (!text) return '$0.00';
            if (text.startsWith('$')) return text;
            const amount = Number(text.replace(/[^\d.]/g, ''));
            return Number.isFinite(amount) ? `$${amount.toFixed(2)}` : text;
        };

        const render = (payload = {}) => {
            const recommendations = Array.isArray(payload.recommendations) ? payload.recommendations : [];

            if (!results) return;

            if (!recommendations.length) {
                results.hidden = true;
                setStatus(payload.summary || 'No voucher recommendations could be generated.');
                return;
            }

            results.hidden = false;
            results.innerHTML = recommendations.map((recommendation) => `
                <article class="service-catalog-card unified-service-card">
                    <div class="portal-card-header">
                        <span class="tag">${escapeHtml(recommendation.voucherType || 'Voucher')}</span>
                        <span class="service-price slim">${escapeHtml(recommendation.discountValue || recommendation.discountType || '')}</span>
                    </div>
                    <div>
                        <h3>${escapeHtml(recommendation.voucherTitle || 'Recommended voucher')}</h3>
                        <p class="muted">${escapeHtml(recommendation.targetCustomerGroup || 'Relevant customers')}</p>
                        <p>${escapeHtml(recommendation.reason || '')}</p>
                    </div>
                    <dl class="profile-booking-meta">
                        <div><dt>Minimum spend</dt><dd>${escapeHtml(formatMinimumSpend(recommendation.minimumSpend))}</dd></div>
                        <div><dt>Points</dt><dd>${escapeHtml(formatPoints(recommendation.pointsRequired))}</dd></div>
                        <div><dt>Validity</dt><dd>${escapeHtml(recommendation.validityPeriod || 'Next campaign period')}</dd></div>
                        <div><dt>Expected benefit</dt><dd>${escapeHtml(recommendation.expectedBenefit || '')}</dd></div>
                    </dl>
                    <div class="service-card-actions ai-recommendation-actions">
                        <a class="button primary" href="${escapeHtml(buildCreateUrl(recommendation))}">Create voucher</a>
                    </div>
                </article>
            `).join('');

            setStatus(payload.summary || 'Voucher recommendations generated.');
        };

        button?.addEventListener('click', async () => {
            button.disabled = true;
            button.textContent = 'Generating...';
            if (results) {
                results.hidden = true;
                results.innerHTML = '';
            }
            setStatus('Generating voucher recommendations...');

            try {
                const response = await fetch('/api/ai/vouchers', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-csrf-token': csrfToken
                    },
                    body: JSON.stringify(aiVoucherData)
                });
                const payload = await response.json();

                if (!response.ok) {
                    throw new Error(payload.message || 'Voucher recommendations could not be generated.');
                }

                render(payload);
            } catch (error) {
                setStatus(error.message || 'Voucher recommendations could not be generated.', true);
            } finally {
                button.disabled = false;
                button.textContent = 'Generate voucher recommendations';
            }
        });
    })();
</script>

<%- include('partials/footer') %>
