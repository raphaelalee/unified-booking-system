<%- include('partials/header', { title }) %>

<section class="section compact merchant-products-page">
    <%
        const safeCsrfToken = typeof csrfToken !== 'undefined' ? csrfToken : '';
        const productFormActionBase = product ? `/merchant/products/${product.id}` : '/merchant/products';
        const productFormAction = `${productFormActionBase}?_csrf=${encodeURIComponent(safeCsrfToken)}`;
    %>
    <header class="merchant-products-hero">
        <div class="merchant-products-hero-copy">
            <p class="eyebrow">Products</p>
            <h1><%= product ? 'Edit product' : 'Add product' %></h1>
            <p>Maintain product details, copy, pricing, and stock for <%= merchant.name %>.</p>
        </div>
        <div class="merchant-products-hero-actions">
            <a class="button secondary" href="/merchant/products">Back to inventory</a>
        </div>
    </header>

    <form class="merchant-product-editor" action="<%= productFormAction %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= safeCsrfToken %>">
        <% if (errors.length > 0) { %>
            <div class="notice error">
                <% errors.forEach((error) => { %>
                    <p><%= error %></p>
                <% }) %>
            </div>
        <% } %>

        <div class="merchant-product-editor-grid">
            <div class="merchant-product-editor-main">
                <label>
                    Product name
                    <input type="text" name="name" value="<%= form.name %>" placeholder="Hydrating Glow Serum" required data-product-name-input>
                </label>

                <div class="ai-product-helper">
                    <div>
                        <p class="eyebrow">AI helper</p>
                        <p class="muted">Generate product copy from the product name.</p>
                    </div>
                    <button class="button secondary" type="button" data-generate-product-copy>Generate with AI</button>
                </div>

                <label>
                    Description
                    <textarea name="description" rows="4" placeholder="Short customer-facing product description" data-product-description><%= form.description %></textarea>
                </label>

                <div class="merchant-product-copy-grid">
                    <label>
                        Ingredients
                        <textarea name="ingredients" rows="4" placeholder="Key ingredients, separated by commas" data-product-ingredients><%= form.ingredients %></textarea>
                    </label>

                    <label>
                        How to use
                        <textarea name="howToUse" rows="4" placeholder="How customers should use this product" data-product-how-to-use><%= form.howToUse %></textarea>
                    </label>
                </div>
            </div>

            <aside class="merchant-product-editor-side">
                <label>
                    Price
                    <input type="number" name="price" value="<%= form.price %>" placeholder="38.00" min="0" step="0.01" required>
                </label>

                <label>
                    Category
                    <select name="categoryId">
                        <option value="" <%= String(form.categoryId) === '' ? 'selected' : '' %>>Uncategorised</option>
                        <% categories.forEach((category) => { %>
                            <option value="<%= category.category_id %>" <%= String(form.categoryId) === String(category.category_id) ? 'selected' : '' %>><%= category.category_name %></option>
                        <% }) %>
                    </select>
                </label>

                <label>
                    Stock quantity
                    <input type="number" name="stockQuantity" value="<%= form.stockQuantity %>" placeholder="25" min="0" step="1" required>
                </label>

                <label>
                    Product photo
                    <% if (form.imageUrl) { %>
                        <span class="merchant-product-image-preview" style="background-image: url('<%= form.imageUrl %>')" aria-label="Current product photo"></span>
                    <% } %>
                    <input type="hidden" name="currentImageUrl" value="<%= form.imageUrl %>">
                    <input type="file" name="productImage" accept="image/*">
                    <span class="form-hint"><%= product ? 'Choose a new photo to replace the current one.' : 'Upload a JPG, PNG, or phone photo up to 8 MB.' %></span>
                </label>
            </aside>
        </div>

        <div class="form-actions">
            <button class="button primary" type="submit"><%= product ? 'Save product' : 'Create product' %></button>
            <a class="button secondary" href="/merchant/products">Cancel</a>
        </div>
    </form>
</section>

<script>
    (() => {
        const button = document.querySelector('[data-generate-product-copy]');
        const nameInput = document.querySelector('[data-product-name-input]');
        const descriptionInput = document.querySelector('[data-product-description]');
        const ingredientsInput = document.querySelector('[data-product-ingredients]');
        const howToUseInput = document.querySelector('[data-product-how-to-use]');

        if (!button || !nameInput || !descriptionInput || !ingredientsInput || !howToUseInput) {
            return;
        }

        button.addEventListener('click', async () => {
            const productName = nameInput.value.trim();

            if (!productName) {
                nameInput.focus();
                return;
            }

            const originalText = button.textContent;
            button.disabled = true;
            button.textContent = 'Generating...';

            try {
                const response = await fetch('/api/ai/product-copy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productName })
                });
                const responseText = await response.text();
                let data;

                try {
                    data = JSON.parse(responseText);
                } catch (parseError) {
                    throw new Error('AI helper returned a page instead of JSON. Restart the server and try again.');
                }

                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'AI generation failed.');
                }

                descriptionInput.value = data.description || descriptionInput.value;
                ingredientsInput.value = data.ingredients || ingredientsInput.value;
                howToUseInput.value = data.howToUse || howToUseInput.value;
            } catch (error) {
                window.alert(error.message || 'AI could not generate product details right now.');
            } finally {
                button.disabled = false;
                button.textContent = originalText;
            }
        });
    })();
</script>

<%- include('partials/footer') %>
