<%- include('partials/header', { title }) %>

<section class="section compact merchant-products-page">
    <%
        const safeCsrfToken = typeof csrfToken !== 'undefined' ? csrfToken : '';
        const productFormActionBase = product ? `/merchant/products/${product.id}` : '/merchant/products';
        const productFormAction = `${productFormActionBase}?_csrf=${encodeURIComponent(safeCsrfToken)}`;
        const selectedRoutineGoals = Array.isArray(form.routineGoalTags) ? form.routineGoalTags : [];
        const selectedRoutineConcerns = Array.isArray(form.routineConcernTags) ? form.routineConcernTags : [];
        const checkedTag = (collection, value) => collection.includes(value) ? 'checked' : '';
        const hasRoutineSettings = Boolean(
            String(form.routineRecommendationNote || '').trim()
            || String(form.routineBudgetMin || '').trim()
            || String(form.routineBudgetMax || '').trim()
            || selectedRoutineGoals.length
            || selectedRoutineConcerns.length
        );
    %>
    <header class="merchant-products-hero">
        <div class="merchant-products-hero-copy">
            <p class="eyebrow">Products</p>
            <h1><%= product ? 'Edit product' : 'Add product' %></h1>
            <p>Maintain product details, copy, pricing, and stock for <%= merchant.name %>.</p>
        </div>
        <div class="merchant-products-hero-actions">
            <a class="button secondary" href="/merchant/products">Back to inventory</a>
        </div>
    </header>

    <form class="merchant-product-editor" action="<%= productFormAction %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= safeCsrfToken %>">
        <% if (errors.length > 0) { %>
            <div class="notice error">
                <% errors.forEach((error) => { %>
                    <p><%= error %></p>
                <% }) %>
            </div>
        <% } %>

        <div class="merchant-product-editor-grid">
            <div class="merchant-product-editor-main">
                <div class="merchant-product-section-heading">
                    <p class="eyebrow">Product details</p>
                    <h2>Customer-facing copy</h2>
                </div>

                <label>
                    Product name
                    <input type="text" name="name" value="<%= form.name %>" placeholder="Hydrating Glow Serum" required data-product-name-input>
                </label>

                <div class="ai-product-helper">
                    <div>
                        <p class="eyebrow">AI helper</p>
                        <p class="muted">Generate product copy from the product name.</p>
                    </div>
                    <button class="button secondary" type="button" data-generate-product-copy>Generate with AI</button>
                </div>

                <label>
                    Description
                    <textarea name="description" rows="4" placeholder="Short customer-facing product description" data-product-description><%= form.description %></textarea>
                </label>

                <div class="merchant-product-copy-grid">
                    <label>
                        Ingredients
                        <textarea name="ingredients" rows="4" placeholder="Key ingredients, separated by commas" data-product-ingredients><%= form.ingredients %></textarea>
                    </label>

                    <label>
                        How to use
                        <textarea name="howToUse" rows="4" placeholder="How customers should use this product" data-product-how-to-use><%= form.howToUse %></textarea>
                    </label>
                </div>
            </div>

            <aside class="merchant-product-editor-side">
                <section class="merchant-product-side-panel" aria-label="Pricing and inventory">
                    <div class="merchant-product-section-heading">
                        <p class="eyebrow">Inventory</p>
                        <h2>Pricing and stock</h2>
                    </div>
                    <label>
                        Price
                        <input type="number" name="price" value="<%= form.price %>" placeholder="38.00" min="0" step="0.01" required>
                    </label>

                    <label>
                        Category
                        <select data-readable-select name="categoryId">
                            <option value="" <%= String(form.categoryId) === '' ? 'selected' : '' %>>Uncategorised</option>
                            <%
                                const selectedCategoryId = String(form.categoryId || '');
                                const selectedCategoryIdExists = categories.some((category) => String(category.category_id) === selectedCategoryId);
                                categories.forEach((category) => {
                                const isSelectedCategory = String(form.categoryId) === String(category.category_id)
                                    || (!selectedCategoryIdExists && product && String(product.category || '') === String(category.category_name || ''));
                            %>
                                <option value="<%= category.category_id %>" <%= isSelectedCategory ? 'selected' : '' %>><%= category.category_name %></option>
                            <% }) %>
                        </select>
                    </label>

                    <label>
                        Stock quantity
                        <input type="number" name="stockQuantity" value="<%= form.stockQuantity %>" placeholder="25" min="0" step="1" required>
                    </label>
                </section>

                <details class="merchant-product-routine-panel merchant-product-collapsible" <%= hasRoutineSettings ? 'open' : '' %>>
                    <summary>
                        <span>
                            <p class="eyebrow">Routine Finder</p>
                            <h2>Recommendation tags</h2>
                        </span>
                        <small>Optional</small>
                    </summary>
                    <div class="merchant-product-collapsible-body">
                        <p class="muted">Help customers discover this product as aftercare for their goals and concerns.</p>
                        <label>
                            Recommendation note
                            <input type="text" name="routineRecommendationNote" maxlength="255" value="<%= form.routineRecommendationNote || '' %>" placeholder="Best after hydrating facial">
                        </label>
                        <div class="merchant-service-editor-pair">
                            <label>
                                Budget minimum
                                <input type="number" name="routineBudgetMin" value="<%= form.routineBudgetMin || '' %>" min="0" step="0.01" placeholder="20">
                            </label>
                            <label>
                                Budget maximum
                                <input type="number" name="routineBudgetMax" value="<%= form.routineBudgetMax || '' %>" min="0" step="0.01" placeholder="80">
                            </label>
                        </div>
                        <div class="routine-merchant-tag-panel">
                            <span>Goal tags</span>
                            <div>
                                <% (routineTagOptions || []).slice(0, 8).forEach((tag) => { %>
                                    <label>
                                        <input type="checkbox" name="routineGoalTags" value="<%= tag.value %>" <%= checkedTag(selectedRoutineGoals, tag.value) %>>
                                        <span><%= tag.label %></span>
                                    </label>
                                <% }) %>
                            </div>
                        </div>
                        <div class="routine-merchant-tag-panel">
                            <span>Concern tags</span>
                            <div>
                                <% (routineTagOptions || []).slice(6).forEach((tag) => { %>
                                    <label>
                                        <input type="checkbox" name="routineConcernTags" value="<%= tag.value %>" <%= checkedTag(selectedRoutineConcerns, tag.value) %>>
                                        <span><%= tag.label %></span>
                                    </label>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                </details>

                <section class="merchant-product-side-panel" aria-label="Product photo">
                    <label>
                        Product photo
                        <% if (form.imageUrl) { %>
                            <span class="merchant-product-image-preview" style="background-image: url('<%= form.imageUrl %>')" aria-label="Current product photo"></span>
                        <% } %>
                        <input type="hidden" name="currentImageUrl" value="<%= form.imageUrl %>">
                        <input type="file" name="productImage" accept="image/*">
                        <span class="form-hint"><%= product ? 'Choose a new photo to replace the current one.' : 'Upload a JPG, PNG, or phone photo up to 8 MB.' %></span>
                    </label>
                </section>
            </aside>
        </div>

        <div class="form-actions">
            <button class="button primary" type="submit"><%= product ? 'Save product' : 'Create product' %></button>
            <a class="button secondary" href="/merchant/products">Cancel</a>
        </div>
    </form>
</section>

<script>
    (() => {
        const button = document.querySelector('[data-generate-product-copy]');
        const nameInput = document.querySelector('[data-product-name-input]');
        const descriptionInput = document.querySelector('[data-product-description]');
        const ingredientsInput = document.querySelector('[data-product-ingredients]');
        const howToUseInput = document.querySelector('[data-product-how-to-use]');

        if (!button || !nameInput || !descriptionInput || !ingredientsInput || !howToUseInput) {
            return;
        }

        button.addEventListener('click', async () => {
            const productName = nameInput.value.trim();

            if (!productName) {
                nameInput.focus();
                return;
            }

            const originalText = button.textContent;
            button.disabled = true;
            button.textContent = 'Generating...';

            try {
                const response = await fetch('/api/ai/product-copy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productName })
                });
                const responseText = await response.text();
                let data;

                try {
                    data = JSON.parse(responseText);
                } catch (parseError) {
                    throw new Error('AI helper returned a page instead of JSON. Restart the server and try again.');
                }

                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'AI generation failed.');
                }

                descriptionInput.value = data.description || descriptionInput.value;
                ingredientsInput.value = data.ingredients || ingredientsInput.value;
                howToUseInput.value = data.howToUse || howToUseInput.value;
            } catch (error) {
                window.VanidayAlerts?.error(error.message || 'AI could not generate product details right now.');
            } finally {
                button.disabled = false;
                button.textContent = originalText;
            }
        });
    })();
</script>

<%- include('partials/footer') %>

