                        <option value="<%= merchant.salon_name %>"><%= merchant.salon_name %></option>
                    <% }) %>
                </select>
            </div>

            <% if (!platformBookings.length) { %>
                <%- include('partials/admin-empty-state', { icon: 'BK', message: 'No bookings have been recorded yet', actionUrl: '/services', actionLabel: 'View services' }) %>
            <% } else { %>
                <div class="admin-table-wrap admin-responsive-table">
                    <table class="admin-table admin-booking-table">
                        <thead>
                            <tr>
                                <th>Booking</th>
                                <th>Customer</th>
                                <th>Merchant</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>QR</th>
                                <th>Payment</th>
                                <th>Check-in</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% platformBookings.forEach((booking) => { %>
                                <% const status = normalizeStatus(booking.status); %>
                                <tr data-status="<%= status %>" data-date="<%= getBookingDate(booking) %>" data-merchant="<%= getMerchantName(booking) %>">
                                    <td><strong>#<%= booking.id %></strong><br><span><%= getServiceName(booking) %></span></td>
                                    <td><strong><%= getCustomerName(booking) %></strong><br><span><%= booking.email || 'No email' %></span></td>
                                    <td><%= getMerchantName(booking) %></td>
                                    <td><%= getBookingDate(booking) %><br><span><%= getBookingTime(booking) %></span></td>
                                    <td><span class="status-badge status-<%= status %>"><%= status.replace('_', '-') %></span></td>
                                    <td><span class="status-badge status-<%= status === 'cancelled' ? 'cancelled' : 'confirmed' %>"><%= status === 'cancelled' ? 'failed' : 'valid' %></span></td>
                                    <td><span class="status-badge status-<%= getBookingAmount(booking) > 0 ? 'confirmed' : 'pending' %>"><%= getBookingAmount(booking) > 0 ? 'paid' : 'pending' %></span></td>
                                    <td><span class="status-badge status-<%= checkedInCount > 0 && (status === 'checked_in' || status === 'completed') ? 'completed' : 'pending' %>"><%= status === 'checked_in' || status === 'completed' ? 'checked-in' : 'waiting' %></span></td>
                                    <td>
                                        <div class="admin-row-actions">
                                            <a class="text-button" href="/receipt/<%= booking.id %>">View</a>
                                            <button type="button" disabled>Refund</button>
                                            <button type="button" disabled>Cancel</button>
                                            <button type="button" disabled>Complete</button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
