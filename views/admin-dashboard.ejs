                    <% ['all', 'pending', 'confirmed', 'completed', 'cancelled', 'checked_in'].forEach((status) => { %>
                        <button type="button" class="<%= status === 'all' ? 'active' : '' %>" data-booking-status="<%= status %>"><%= status.replace('_', '-') %></button>
                    <% }) %>
                </div>
                <input type="search" data-booking-search placeholder="Search booking, customer, merchant">
                <input type="date" data-booking-date>
                <select data-booking-merchant>
                    <option value="">All merchants</option>
