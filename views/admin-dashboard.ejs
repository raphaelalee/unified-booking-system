<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (() => {
        const payload = <%- JSON.stringify(chartPayload) %>;
        const palette = {
            green: '#4f6847',
            blue: '#20899c',
            orange: '#df7c16',
            yellow: '#d4a017',
            red: '#a64032',
            pale: 'rgba(79, 104, 71, 0.12)'
        };
        const baseOptions = {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 700 },
            plugins: { legend: { labels: { boxWidth: 10, usePointStyle: true } } },
            scales: {
                x: { grid: { display: false } },
                y: { beginAtZero: true, grid: { color: 'rgba(79, 104, 71, 0.12)' } }
            }
        };
        const chartInstances = [];
        const makeChart = (id, config) => {
            const canvas = document.getElementById(id);
            if (!canvas || typeof Chart === 'undefined') return;
            const chart = new Chart(canvas, config);
            chartInstances.push(chart);
            return chart;
        };

        makeChart('bookingRevenueChart', {
            type: 'line',
            data: {
                labels: payload.labels,
                datasets: [
                    { label: 'Bookings', data: payload.bookings, borderColor: palette.blue, backgroundColor: 'rgba(32, 137, 156, 0.12)', tension: 0.35, fill: true },
                    { label: 'Revenue', data: payload.revenue, borderColor: palette.green, backgroundColor: 'rgba(79, 104, 71, 0.12)', tension: 0.35, fill: true }
                ]
            },
            options: baseOptions
        });
        makeChart('qrScansChart', {
            type: 'bar',
            data: { labels: payload.labels, datasets: [{ label: 'QR scans', data: payload.qrScans, backgroundColor: 'rgba(32, 137, 156, 0.38)', borderColor: palette.blue, borderWidth: 2 }] },
            options: baseOptions
        });
        makeChart('bookingStatusChart', {
            type: 'doughnut',
            data: { labels: payload.statusLabels, datasets: [{ data: payload.statusValues, backgroundColor: [palette.yellow, palette.blue, palette.green, palette.red, palette.orange] }] },
            options: { responsive: true, maintainAspectRatio: false, animation: { duration: 700 }, plugins: { legend: { position: 'bottom' } } }
        });
        makeChart('topMerchantsChart', {
            type: 'bar',
            data: { labels: payload.topMerchantLabels, datasets: [{ label: 'Bookings', data: payload.topMerchantValues, backgroundColor: 'rgba(79, 104, 71, 0.35)', borderColor: palette.green, borderWidth: 2 }] },
            options: { ...baseOptions, indexAxis: 'y' }
        });
        makeChart('topServicesChart', {
            type: 'bar',
            data: { labels: payload.topServiceLabels, datasets: [{ label: 'Bookings', data: payload.topServiceValues, backgroundColor: 'rgba(32, 137, 156, 0.3)', borderColor: palette.blue, borderWidth: 2 }] },
            options: { ...baseOptions, indexAxis: 'y' }
        });
        makeChart('peakHoursChart', {
            type: 'bar',
            data: { labels: payload.peakHourLabels, datasets: [{ label: 'Bookings', data: payload.peakHourValues, backgroundColor: 'rgba(223, 124, 22, 0.35)', borderColor: palette.orange, borderWidth: 2 }] },
            options: baseOptions
        });
        makeChart('customerAgeChart', {
            type: 'bar',
            data: { labels: payload.ageBandLabels, datasets: [{ label: 'Customers', data: payload.ageBandValues, backgroundColor: 'rgba(32, 137, 156, 0.3)', borderColor: palette.blue, borderWidth: 2 }] },
            options: baseOptions
        });
        makeChart('customerGenderChart', {
            type: 'doughnut',
            data: { labels: payload.genderLabels, datasets: [{ data: payload.genderValues, backgroundColor: [palette.green, palette.blue, palette.orange, palette.yellow, palette.red] }] },
            options: { responsive: true, maintainAspectRatio: false, animation: { duration: 700 }, plugins: { legend: { position: 'bottom' } } }
        });

        const rows = Array.from(document.querySelectorAll('.admin-booking-table tbody tr'));
        const statusButtons = Array.from(document.querySelectorAll('[data-booking-status]'));
        const searchInput = document.querySelector('[data-booking-search]');
        const dateInput = document.querySelector('[data-booking-date]');
        const merchantSelect = document.querySelector('[data-booking-merchant]');
        let activeStatus = 'all';

        const applyFilters = () => {
            const query = String(searchInput?.value || '').toLowerCase();
            const date = dateInput?.value || '';
            const merchant = merchantSelect?.value || '';

            rows.forEach((row) => {
                const matchesStatus = activeStatus === 'all' || row.dataset.status === activeStatus;
                const matchesSearch = !query || row.textContent.toLowerCase().includes(query);
                const matchesDate = !date || row.dataset.date === date;
                const matchesMerchant = !merchant || row.dataset.merchant === merchant;
                row.hidden = !(matchesStatus && matchesSearch && matchesDate && matchesMerchant);
            });
        };

        statusButtons.forEach((button) => {
            button.addEventListener('click', () => {
                activeStatus = button.dataset.bookingStatus;
                statusButtons.forEach((item) => item.classList.toggle('active', item === button));
                applyFilters();
            });
        });
        [searchInput, dateInput, merchantSelect].forEach((control) => control?.addEventListener('input', applyFilters));

        document.querySelector('[data-export-csv]')?.addEventListener('click', () => {
            const visibleRows = rows.filter((row) => !row.hidden);
            const csv = ['Booking,Customer,Merchant,Date,Status']
                .concat(visibleRows.map((row) => {
                    const cells = Array.from(row.cells).slice(0, 5).map((cell) => `"${cell.textContent.trim().replace(/"/g, '""')}"`);
                    return cells.join(',');
                }))
                .join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = 'vaniday-bookings.csv';
            link.click();
            URL.revokeObjectURL(url);
        });

        document.querySelector('[data-export-pdf]')?.addEventListener('click', () => window.print());

        const panelButtons = Array.from(document.querySelectorAll('[data-dashboard-tab]'));
        const panels = Array.from(document.querySelectorAll('[data-dashboard-panel]'));
        const titleNode = document.querySelector('[data-dashboard-title]');
        const descriptionNode = document.querySelector('[data-dashboard-description]');
        const hashToPanel = {
            '#admin-overview': 'overview',
            '#admin-health': 'health',
            '#admin-qr': 'qr',
            '#admin-bookings': 'bookings',
            '#admin-merchants': 'merchants',
            '#admin-reviews': 'reviews',
            '#admin-audit': 'audit'
        };
        const adminBadgeStorageKey = <%- JSON.stringify(adminBadgeKey) %>;
        const getClearedAdminTabs = () => {
            try {
                const stored = localStorage.getItem(adminBadgeStorageKey);
                const parsed = stored ? JSON.parse(stored) : [];
                return Array.isArray(parsed) ? new Set(parsed) : new Set();
            } catch (error) {
                return new Set();
            }
        };
        const persistClearedAdminTabs = (tabs) => {
            try {
                localStorage.setItem(adminBadgeStorageKey, JSON.stringify(Array.from(tabs)));
            } catch (error) {
                return;
            }
        };
        const clearedAdminTabs = getClearedAdminTabs();
        const clearAdminTabBadge = (tabName) => {
            const button = panelButtons.find((item) => item.dataset.dashboardTab === tabName);
            const badge = button?.querySelector('[data-admin-tab-badge]');
            if (badge) {
                badge.remove();
            }
            if (!clearedAdminTabs.has(tabName)) {
                clearedAdminTabs.add(tabName);
                persistClearedAdminTabs(clearedAdminTabs);
            }
        };

        panelButtons.forEach((button) => {
            if (clearedAdminTabs.has(button.dataset.dashboardTab)) {
                button.querySelector('[data-admin-tab-badge]')?.remove();
            }
        });

        const setActivePanel = (panelName, syncHash = true) => {
            const activeButton = panelButtons.find((button) => button.dataset.dashboardTab === panelName) || panelButtons[0];
            const nextPanel = activeButton?.dataset.dashboardTab || 'overview';

            panelButtons.forEach((button) => {
                const isActive = button.dataset.dashboardTab === nextPanel;
                button.classList.toggle('active', isActive);
                if (isActive) {
                    button.setAttribute('aria-current', 'page');
                } else {
                    button.removeAttribute('aria-current');
                }
            });

            panels.forEach((panel) => {
                const isActive = panel.dataset.dashboardPanel === nextPanel;
                panel.hidden = !isActive;
                panel.classList.toggle('is-active', isActive);
                panel.style.display = isActive ? 'block' : 'none';
            });

            if (titleNode) titleNode.textContent = activeButton?.dataset.panelTitle || 'Vaniday Admin Overview';
            if (descriptionNode) descriptionNode.textContent = activeButton?.dataset.panelDescription || '';

            if (syncHash) {
                const targetHash = nextPanel === 'overview' ? '#admin-overview' : `#admin-${nextPanel}`;
                if (window.location.hash !== targetHash) {
                    history.replaceState(null, '', targetHash);
                }
            }

            clearAdminTabBadge(nextPanel);

            requestAnimationFrame(() => {
                chartInstances.forEach((chart) => chart.resize());
            });
        };

        panelButtons.forEach((button) => {
            button.addEventListener('click', () => setActivePanel(button.dataset.dashboardTab));
        });

        document.querySelectorAll('a[href^="#admin-"]').forEach((link) => {
            link.addEventListener('click', (event) => {
                const panelName = hashToPanel[link.getAttribute('href')];
                if (!panelName) return;
                event.preventDefault();
                setActivePanel(panelName);
            });
        });

        window.addEventListener('hashchange', () => {
            setActivePanel(hashToPanel[window.location.hash] || 'overview', false);
        });

        setActivePanel(hashToPanel[window.location.hash] || 'overview', false);
    })();
</script>

