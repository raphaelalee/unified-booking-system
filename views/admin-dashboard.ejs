        <section class="admin-dashboard-panel" id="admin-bookings" data-dashboard-panel="bookings" hidden>
            <section class="admin-panel">
            <div class="admin-panel-heading">
                <div>
                    <p class="eyebrow">Booking Management</p>
                    <h2>Platform booking records</h2>
                </div>
