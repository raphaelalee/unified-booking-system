<%- include('partials/header', { title }) %>

<%
    const allBookingServices = typeof scopedServices !== 'undefined' && Array.isArray(scopedServices) && scopedServices.length > 0
        ? scopedServices
        : Array.isArray(merchant.services) && merchant.services.length > 0
            ? merchant.services
        : [{ id: 9001, name: 'QR Test Booking Service', duration: '30 mins', price: 20, slots: ['9:00 AM', '12:30 PM', '6:30 PM'] }];
    const requestedServiceId = String((form && form.serviceId) || (typeof selectedServiceId !== 'undefined' && selectedServiceId ? selectedServiceId : ''));
    const requestedOptionId = String((form && form.serviceOptionId) || '');
    const selectedBookingService = requestedServiceId
        ? allBookingServices.find((service) => String(service.id) === requestedServiceId)
        : null;
    const selectedBookingOption = selectedBookingService && requestedOptionId && Array.isArray(selectedBookingService.options)
        ? selectedBookingService.options.find((option) => String(option.id) === requestedOptionId)
        : null;
    const requestedPurchaseType = String((form && form.purchaseType) || (typeof packageSelected !== 'undefined' && packageSelected ? 'package' : 'single'));
    const bookingServices = selectedBookingService ? [selectedBookingService] : allBookingServices;
    const promoDisplayPrice = selectedPromotion && typeof selectedPromotion.price === 'number'
        ? selectedPromotion.price
        : null;
    const promoOriginalPrice = selectedPromotion && typeof selectedPromotion.originalPrice === 'number'
        ? selectedPromotion.originalPrice
        : null;
    const lockPromotionOption = Boolean(selectedPromotion && requestedOptionId);
    const bookingMaxDate = typeof maxBookingDate !== 'undefined' && maxBookingDate ? maxBookingDate : '';

    const normalizeText = (text) => String(text || '').toLowerCase();
    const hasPattern = (text, patterns = []) =>
        patterns.some((pattern) => normalizeText(text).includes(pattern));

    const bookingCategories = [
        {
            id: 'hair-cut',
            title: 'Hair Cut',
            patterns: ['cut', 'haircut', 'fade', 'fringe', 'trim']
        },
        {
            id: 'hair-colour',
            title: 'Hair Colour / Hair Dye',
            patterns: ['colour', 'color', 'dye', 'highlight', 'balayage', 'root']
        },
        {
            id: 'perms',
            title: 'Perms',
            patterns: ['perm']
        },
        {
            id: 'wash-blow',
            title: 'Wash and Blow / Styling',
            patterns: ['wash', 'blow', 'style', 'styling']
        },
        {
            id: 'treatment',
            title: 'Treatment',
            patterns: ['treatment', 'scalp', 'repair']
        },
        {
            id: 'other',
            title: 'Other Services',
            patterns: []
        }
    ];

    const categorizedServices = bookingCategories.map((category) => ({
        ...category,
        services: []
    }));

    const getServiceDisplayName = (service) => String(service.name || '');
    const getServiceGenderLabel = (service) => {
        const normalizedName = normalizeText(service.name);

        if (hasPattern(normalizedName, ['male', 'men', 'him', 'barber'])) {
            return 'Male';
        }

        if (hasPattern(normalizedName, ['female', 'women', 'her', 'ladies'])) {
            return 'Female';
        }

        const genderTarget = String(service.genderTarget || '').toLowerCase();
        if (genderTarget === 'male') {
            return 'Male';
        }
        if (genderTarget === 'female') {
            return 'Female';
        }

        return 'Unisex';
    };

    const getServicePriceText = (service) => {
        const price = Number(service.price || 0);
        const packagePrice = Number(service.packagePrice || 0);

        if (service.packageEnabled && packagePrice > 0 && packagePrice !== price) {
            const minPrice = Math.min(price, packagePrice);
            const maxPrice = Math.max(price, packagePrice);
            return minPrice === maxPrice
                ? `$${minPrice.toFixed(2)}`
                : `$${minPrice.toFixed(2)} - $${maxPrice.toFixed(2)}`;
        }

        return `$${price.toFixed(2)}`;
    };

    bookingServices.forEach((service) => {
        const matchedCategory = categorizedServices.find((category) =>
            category.patterns.length > 0 && hasPattern(service.name, category.patterns)
        );

        const targetCategory = matchedCategory || categorizedServices.find((category) => category.id === 'other');
        targetCategory.services.push(service);
    });

    const visibleServiceGroups = categorizedServices.filter((group) => group.services.length > 0);
%>

<section class="booking-hero">
    <p class="eyebrow">Appointment booking</p>
    <h1>Book <%= merchant.name %></h1>
    <p><%= merchant.description %></p>
    <div class="booking-meta">
        <span><%= merchant.location %></span>
        <span>Rating <%= merchant.rating %></span>
        <span><%= bookingServices.length %> service<%= bookingServices.length === 1 ? '' : 's' %></span>
    </div>
    <% if (selectedPromotion) { %>
        <div class="notice">
            <p>
                Booking with promotion:
                <strong><%= selectedPromotion.campaignLabel || 'Promotion' %></strong>
                <% if (selectedPromotion.title) { %>
                    for <strong><%= selectedPromotion.title %></strong>
                <% } %>
            </p>
            <p>
                <% if (selectedPromotion.originalPrice) { %>
                    Original price: $<%= selectedPromotion.originalPrice %>.
                <% } %>
                <% if (selectedPromotion.price) { %>
                    Promo price: $<%= selectedPromotion.price %>.
                <% } %>
                <% if (selectedPromotion.discountPercent) { %>
                    Savings: <%= selectedPromotion.discountPercent %>% off.
                <% } %>
            </p>
        </div>
    <% } %>
</section>

<section class="section booking-section">
    <% if (errors.length > 0) { %>
        <div class="notice error booking-error-notice">
            <% errors.forEach((error) => { %>
                <p><%= error %></p>
            <% }) %>
        </div>
    <% } %>

    <form action="<%= bookingPath %>" method="POST" class="booking-layout booking-form js-immediate-booking-form" data-booking-action="<%= bookingPath %>" data-availability-url="/booking/<%= merchant.id %>/available-slots">
        <input type="hidden" name="merchantId" value="<%= merchant.id %>">
        <% if (typeof qrDebug !== 'undefined' && qrDebug && qrDebug.token) { %>
            <input type="hidden" name="bookingSource" value="<%= qrDebug.system || 'qr' %>">
            <input type="hidden" name="qrToken" value="<%= qrDebug.token %>">
        <% } %>
        <% if (requestedOptionId) { %>
            <input type="hidden" name="serviceOptionId" value="<%= requestedOptionId %>">
        <% } %>
        <input type="hidden" name="purchaseType" value="<%= requestedPurchaseType === 'package' ? 'package' : 'single' %>" data-purchase-type-field>
        <input type="hidden" name="professionalName" value="Any Available" data-professional-field>

        <div class="booking-native-fields" aria-hidden="true">
            <label>
                Service
                <select name="serviceId" class="js-service-select" tabindex="-1">
                    <option value="">Select a service</option>
                    <% bookingServices.forEach((service) => { %>
                        <option
                            value="<%= service.id %>"
                            data-purchase-type="single"
                            data-service-name="<%= service.name %>"
                            data-service-duration="<%= service.duration || '' %>"
                            data-service-price="<%= Number(service.price || 0).toFixed(2) %>"
                            <%= requestedServiceId === String(service.id) && requestedPurchaseType !== 'package' ? 'selected' : '' %>>
                            <%= service.name %> - single session $<%= Number(service.price).toFixed(2) %>
                        </option>
                        <% if (service.packageEnabled) { %>
                            <option
                                value="<%= service.id %>"
                                data-purchase-type="package"
                                data-service-name="<%= service.name %> package"
                                data-service-duration="<%= service.duration || '' %>"
                                data-service-price="<%= Number(service.packagePrice || service.price || 0).toFixed(2) %>"
                                <%= requestedServiceId === String(service.id) && requestedPurchaseType === 'package' ? 'selected' : '' %>>
                                <%= service.name %> package - <%= service.packageSessions %> sessions $<%= Number(service.packagePrice).toFixed(2) %>
                            </option>
                        <% } %>
                    <% }) %>
                </select>
            </label>
            <label>
                Date
                <input type="date" name="bookingDate" value="<%= form.bookingDate || todayDate %>" min="<%= todayDate %>" <% if (bookingMaxDate) { %>max="<%= bookingMaxDate %>"<% } %> tabindex="-1">
            </label>
            <label>
                Time slot
                <select name="bookingTime" class="js-time-select" data-selected-time="<%= form.bookingTime || '' %>" tabindex="-1">
                    <option value="">Checking availability...</option>
                </select>
            </label>
        </div>

        <div class="booking-services-panel">
            <div class="section-heading">
                <p class="eyebrow">Services</p>
                <h2>Choose an appointment</h2>
            </div>

            <div class="service-list booking-service-options booking-service-groups">
                <% visibleServiceGroups.forEach((group, groupIndex) => { %>
                    <section class="category-group <%= groupIndex === 0 ? 'is-open' : '' %>" data-category-group>
                        <button
                            class="category-group-header"
                            type="button"
                            aria-expanded="<%= groupIndex === 0 ? 'true' : 'false' %>"
                            data-category-toggle>
                            <span><%= group.title %></span>
                            <span class="toggle-icon" aria-hidden="true">&#9660;</span>
                        </button>

                        <div class="category-group-body">
                            <% group.services.forEach((service) => { %>
                                <% const activeOption = selectedBookingOption && String(selectedBookingService?.id) === String(service.id) ? selectedBookingOption : null; %>
                                <% const bookableItem = activeOption || service; %>
                                <% const packageIsSelected = requestedPurchaseType === 'package' && service.packageEnabled; %>
                                <% const displayPrice = packageIsSelected ? service.packagePrice : (promoDisplayPrice !== null ? promoDisplayPrice : bookableItem.price); %>
                                <% const isSelectedServiceCard = requestedServiceId === String(service.id); %>
                                <% const serviceInfo = service.shortDescription || service.description || ''; %>
                                <% const displayName = getServiceDisplayName(service); %>
                                <% const genderLabel = getServiceGenderLabel(service); %>
                                <% const serviceDescription = service.shortDescription || service.description || ''; %>
                                <% const priceText = getServicePriceText(service); %>
                                <% const durationText = bookableItem.duration || service.duration || ''; %>
                                <% const labelName = activeOption ? `${displayName} - ${activeOption.name}` : displayName; %>
                                <button
                                    class="booking-service-card booking-service-row booking-service-option <%= isSelectedServiceCard ? 'is-selected' : '' %>"
                                    type="button"
                                    data-service-card
                                    data-service-id="<%= service.id %>"
                                    data-purchase-type="<%= packageIsSelected ? 'package' : 'single' %>"
                                    data-service-name="<%= labelName %>"
                                    data-service-duration="<%= durationText %>"
                                    data-service-price="<%= Number(displayPrice || 0).toFixed(2) %>">
                                    <span class="service-row-left">
                                        <span class="service-row-checkbox" aria-hidden="true"></span>
                                        <span class="service-row-main">
                                            <span class="service-row-title">
                                                <strong><%= labelName %></strong>
                                                <span class="service-row-gender"><%= genderLabel %></span>
                                            </span>
                                            <% if (serviceDescription) { %>
                                                <span class="service-row-description"><%= serviceDescription %></span>
                                            <% } %>
                                            <span class="service-row-meta"><%= durationText %> &middot; <%= priceText %><% if (packageIsSelected) { %> &middot; <%= service.packageSessions %> sessions<% } %></span>
                                        </span>
                                    </span>
                                    <span class="service-row-right">
                                        <% if (serviceInfo) { %>
                                            <span class="service-row-info" title="<%= serviceInfo %>">i</span>
                                        <% } %>
                                    </span>
                                </button>
                            <% }) %>
                        </div>
                    </section>
                <% }) %>
            </div>

            <div class="booking-picker-stack">
                <header class="booking-date-time-heading">
                    <h2>Select Date &amp; Time</h2>
                    <p>Choose when you'd like to visit <%= merchant.name %>.</p>
                </header>

                <section class="booking-picker-card">
                    <div class="booking-picker-heading">
                        <span class="booking-picker-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false"><path d="M8 2v4M16 2v4M3 10h18M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/></svg>
                        </span>
                        <h3>Select Date</h3>
                    </div>
                    <p class="muted booking-date-helper">You can book up to 2 months in advance.</p>
                    <div class="booking-date-strip js-date-card-list" aria-label="Select booking date"></div>
                    <span class="muted js-public-holiday-message" hidden></span>
                </section>

                <section class="booking-picker-card">
                    <div class="booking-picker-heading">
                        <span class="booking-picker-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false"><path d="M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                        </span>
                        <h3>Available Times</h3>
                    </div>
                    <div class="booking-time-grid js-time-slot-list" aria-label="Select available time">
                        <button class="time-slot-pill is-disabled" type="button" disabled>Checking availability...</button>
                    </div>
                    <p class="muted booking-slot-note">Booked and past slots are removed automatically.</p>
                </section>

                <section class="booking-picker-card">
                    <div class="booking-picker-heading">
                        <span class="booking-picker-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"/></svg>
                        </span>
                        <h3>Select Professional <span>(Optional)</span></h3>
                    </div>
                    <div class="booking-professional-list js-professional-list" aria-label="Select professional">
                        <button class="professional-pill is-selected" type="button" data-professional="Any Available">Any Available</button>
                        <button class="professional-pill" type="button" data-professional="Sarah">Sarah</button>
                        <button class="professional-pill" type="button" data-professional="Jessica">Jessica</button>
                        <button class="professional-pill" type="button" data-professional="Emily">Emily</button>
                    </div>
                </section>
            </div>
        </div>

        <aside class="booking-form-panel">
        <div>
            <p class="eyebrow">Your details</p>
            <h2>Confirm booking</h2>
            <p class="muted">Select a service, date, and time. We will save your booking request.</p>
        </div>

            <div class="form-row">
                <label>
                    Full name
                    <input type="text" name="customerName" value="<%= form.customerName || '' %>" placeholder="Enter your name">
                </label>
                <label>
                    Phone number
                    <input type="tel" name="phone" value="<%= form.phone || '' %>" placeholder="81234567" maxlength="8">
                </label>
            </div>

            <label>
                Email address
                <input type="email" name="email" value="<%= form.email || '' %>" placeholder="name@example.com">
            </label>

            <div class="booking-summary-card" aria-live="polite">
                <div class="booking-summary-heading">
                    <p class="eyebrow">Summary</p>
                    <strong class="js-summary-price">$0.00</strong>
                </div>
                <dl>
                    <div>
                        <dt>Service</dt>
                        <dd class="js-summary-service">Select a service</dd>
                    </div>
                    <div>
                        <dt>Date</dt>
                        <dd class="js-summary-date">Choose a date</dd>
                    </div>
                    <div>
                        <dt>Time</dt>
                        <dd class="js-summary-time">Choose a time</dd>
                    </div>
                    <div>
                        <dt>Professional</dt>
                        <dd class="js-summary-professional">Any Available</dd>
                    </div>
                </dl>
            </div>

            <button class="button primary full js-confirm-booking" type="submit" disabled>Confirm booking</button>

        <% if (typeof whatsappEnquiryUrl !== 'undefined' && whatsappEnquiryUrl) { %>
            <div class="whatsapp-booking-panel">
                <p class="eyebrow">WhatsApp booking</p>
                <h3>Need help choosing a slot?</h3>
                <p class="muted">Start a guided WhatsApp enquiry with the selected merchant.</p>
                <a class="button whatsapp-button full" href="<%= whatsappEnquiryUrl %>" target="_blank" rel="noopener">Continue on WhatsApp</a>
            </div>
        <% } %>
        <% if (showQrDebug && typeof qrDebug !== 'undefined' && qrDebug) { %>
            <div class="whatsapp-booking-panel qr-debug-panel">
                <p class="eyebrow">QR Debug</p>
                <p class="muted"><strong>System:</strong> <%= qrDebug.system %> / <%= qrDebug.label %></p>
                <p class="muted"><strong>URL:</strong> <%= qrDebug.url %></p>
                <p class="muted"><strong>Token:</strong> <%= qrDebug.token %></p>
                <p class="muted"><strong>Route target:</strong> <%= qrDebug.routeTarget %></p>
            </div>
        <% } %>
        </aside>
    </form>
</section>

<script>
    (() => {
        const bookingForm = document.querySelector('.booking-form');
        const dateField = bookingForm?.querySelector('input[name="bookingDate"]');
        const holidayMessage = bookingForm?.querySelector('.js-public-holiday-message');
        const selectedPromotion = <%- JSON.stringify(selectedPromotion || null) %>;
        const publicHolidays = <%- JSON.stringify(typeof publicHolidays !== 'undefined' ? publicHolidays : {}) %>;

        if (!bookingForm || !dateField) {
            return;
        }

        const validateBookingDate = () => {
            const setMessage = (message = '') => {
                if (!holidayMessage) {
                    return;
                }

                holidayMessage.textContent = message;
                holidayMessage.hidden = !message;
            };

            if (!dateField.value) {
                dateField.setCustomValidity('');
                setMessage();
                return;
            }

            const holidayName = publicHolidays[dateField.value];

            if (holidayName) {
                const message = `Closed on ${holidayName}. Please choose another date.`;
                dateField.setCustomValidity(message);
                setMessage(message);
                return;
            }

            if (!selectedPromotion || selectedPromotion.campaignLabel !== 'Happy Hour') {
                dateField.setCustomValidity('');
                setMessage();
                return;
            }

            const selectedDate = new Date(`${dateField.value}T00:00:00`);

            if (Number.isNaN(selectedDate.getTime())) {
                dateField.setCustomValidity('');
                setMessage();
                return;
            }

            const day = selectedDate.getDay();
            const isWeekday = day >= 1 && day <= 5;

            const message = isWeekday ? '' : 'Happy Hour promotions can only be booked on weekdays.';
            dateField.setCustomValidity(message);
            setMessage(message);
        };

        dateField.addEventListener('input', validateBookingDate);
        dateField.addEventListener('change', validateBookingDate);
        validateBookingDate();
    })();

    (() => {
        const bookingForm = document.querySelector('.js-immediate-booking-form');
        const serviceSelect = bookingForm?.querySelector('.js-service-select');
        const purchaseTypeField = bookingForm?.querySelector('[data-purchase-type-field]');

        if (!bookingForm || !serviceSelect) {
            return;
        }

        const baseAction = bookingForm.dataset.bookingAction || bookingForm.action;

        const syncBookingAction = () => {
            bookingForm.action = baseAction;
            if (purchaseTypeField) {
                purchaseTypeField.value = serviceSelect.selectedOptions[0]?.dataset.purchaseType || 'single';
            }
        };

        serviceSelect.addEventListener('change', syncBookingAction);
        syncBookingAction();
    })();

    (() => {
        document.querySelectorAll('[data-category-toggle]').forEach((toggleButton) => {
            toggleButton.addEventListener('click', () => {
                const category = toggleButton.closest('[data-category-group]');
                if (!category) {
                    return;
                }

                const expanded = category.classList.toggle('is-open');
                toggleButton.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            });
        });
    })();
</script>

<%- include('partials/footer') %>
