<%- include('partials/header', { title }) %>

<%
    const categoryOptions = [...new Set(promotions.map((promotion) => promotion.type).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const aiPromotionPayload = JSON.stringify(typeof aiPromotionData !== 'undefined' && aiPromotionData ? aiPromotionData : {}).replace(/</g, '\\u003c');
    const formatPromotionDate = (value) => {
        const date = value instanceof Date ? value : new Date(value);

        if (Number.isNaN(date.getTime())) {
            return '';
        }

        return date.toLocaleString('en-SG', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: 'numeric',
            minute: '2-digit'
        });
    };
%>

<section class="section compact merchant-analytics-page">
    <div class="merchant-analytics-shell">
        <header class="merchant-dashboard-hero">
            <div>
                <p class="eyebrow">Promotions</p>
                <h1>Campaigns</h1>
                <span>Create and manage customer-facing offers for <%= merchant.name %>.</span>
            </div>
            <div class="merchant-hero-actions">
                <a class="button primary" href="/merchant/promotions/new">Add promotion</a>
            </div>
        </header>
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <div class="section-cta">
        <div>
            <h2>Promotion campaigns</h2>
            <p class="muted"><%= promotions.length %> promotions currently linked to this merchant.</p>
        </div>
        <div class="inline-button-group">
            <label>
                <span class="sr-only">Filter by category</span>
                <select class="js-merchant-promotion-category-filter">
                    <option value="">All categories</option>
                    <% categoryOptions.forEach((category) => { %>
                        <option value="<%= category %>"><%= category.replace(/_/g, ' ') %></option>
                    <% }) %>
                </select>
            </label>
        </div>
    </div>

    <section class="service-catalog-card unified-service-card" data-ai-promotion-panel>
        <div class="portal-card-header">
            <div>
                <span class="tag">AI assistant</span>
                <h3>Promotion recommendations</h3>
            </div>
            <button class="button primary" type="button" data-generate-ai-promotions>Generate recommendations</button>
        </div>
        <p class="muted">
            Uses your merchant services, products, booking activity, and current promotions to suggest up to three campaign ideas.
        </p>
        <div class="notice" data-ai-promotion-status hidden></div>
        <div class="service-catalog-grid unified-service-grid" data-ai-promotion-results hidden></div>
    </section>

    <% if (promotions.length === 0) { %>
        <div class="notice">
            No promotions have been created yet. Add one to start running first-trial, happy hour, 1-for-1, or featured campaigns.
        </div>
    <% } else { %>
        <div class="service-catalog-grid unified-service-grid">
            <% promotions.forEach((promotion) => { %>
                <article class="service-catalog-card unified-service-card js-merchant-promotion-card" data-category="<%= promotion.type %>">
                    <div class="portal-card-header">
                        <span class="tag"><%= promotion.type.replace(/_/g, ' ') %></span>
                        <span class="service-price slim"><%= promotion.status %></span>
                    </div>
                    <div>
                        <h3><%= promotion.title %></h3>
                        <p class="muted">
                            <%= promotion.serviceName || promotion.productName || 'All merchant listings' %> &middot;
                            <%= promotion.discountType.replace(/_/g, ' ') %>
                            <% if (promotion.discountValue !== null) { %>
                                &middot; <%= promotion.discountValue %>
                            <% } %>
                        </p>
                        <p class="muted">
                            Spin & Discover:
                            <strong><%= promotion.spinEligible ? 'eligible' : 'not eligible' %></strong>
                            <% if (promotion.spinEligible && promotion.spinRewardType) { %>
                                &middot; <%= promotion.spinRewardType.replace(/_/g, ' ') %>
                            <% } %>
                        </p>
                        <p class="muted">
                            Redeemed <%= promotion.redemptionCount %> time<%= promotion.redemptionCount === 1 ? '' : 's' %>
                            <% if (promotion.totalRedemptions !== promotion.redemptionCount) { %>
                                &middot; <%= promotion.totalRedemptions %> total record<%= promotion.totalRedemptions === 1 ? '' : 's' %>
                            <% } %>
                        </p>
                        <p class="muted">
                            Wheel wins <%= promotion.spinWinCount || 0 %>
                            &middot; Claims <%= promotion.spinClaimCount || 0 %>
                            <% if (promotion.spinClaimLimit !== null) { %>
                                &middot; Limit <%= promotion.spinClaimLimit %>
                            <% } %>
                            <% if (promotion.spinInventoryRemaining !== null) { %>
                                &middot; Remaining <%= promotion.spinInventoryRemaining %>
                            <% } %>
                        </p>
                        <% if (promotion.description) { %>
                            <p><%= promotion.description %></p>
                        <% } %>
                        <% if (promotion.terms) { %>
                            <p class="muted"><%= promotion.terms %></p>
                        <% } %>
                    </div>
                    <div class="availability-strip">
                        <span>Starts <%= formatPromotionDate(promotion.startDate) %></span>
                        <span>Ends <%= formatPromotionDate(promotion.endDate) %></span>
                    </div>
                    <div class="service-card-actions">
                        <a class="button secondary full" href="/merchant/promotions/<%= promotion.id %>/edit">Edit</a>
                        <form action="/merchant/promotions/<%= promotion.id %>/delete" method="POST">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button class="button secondary full danger-button" type="submit">Delete</button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
    </div>
</section>

<script>
    (() => {
        const aiPromotionData = <%- aiPromotionPayload %>;
        const aiButton = document.querySelector('[data-generate-ai-promotions]');
        const aiStatus = document.querySelector('[data-ai-promotion-status]');
        const aiResults = document.querySelector('[data-ai-promotion-results]');
        const categoryFilter = document.querySelector('.js-merchant-promotion-category-filter');
        const promotionCards = Array.from(document.querySelectorAll('.js-merchant-promotion-card'));
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

        const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;'
        }[char]));

        const setAiStatus = (message, isError = false) => {
            if (!aiStatus) return;
            aiStatus.hidden = !message;
            aiStatus.classList.toggle('error', Boolean(isError));
            aiStatus.textContent = message || '';
        };

        const buildCreatePromotionUrl = (recommendation = {}) => {
            const params = new URLSearchParams({
                fromAi: '1',
                aiTitle: recommendation.promotionTitle || '',
                aiType: recommendation.promotionType || '',
                aiItem: recommendation.serviceOrProduct || '',
                aiDiscount: recommendation.discountOrReward || '',
                aiMinimumSpend: recommendation.minimumSpend || '',
                aiPeriod: recommendation.recommendedPeriod || '',
                aiTarget: recommendation.targetCustomers || '',
                aiReason: recommendation.reason || ''
            });

            return `/merchant/promotions/new?${params.toString()}`;
        };

        const renderRecommendations = (payload = {}) => {
            const recommendations = Array.isArray(payload.recommendations) ? payload.recommendations : [];

            if (!aiResults) return;

            if (!recommendations.length) {
                aiResults.hidden = true;
                setAiStatus(payload.summary || 'No recommendation could be generated from the available merchant data.', false);
                return;
            }

            aiResults.hidden = false;
            aiResults.innerHTML = recommendations.map((recommendation) => `
                <article class="service-catalog-card unified-service-card">
                    <div class="portal-card-header">
                        <span class="tag">${escapeHtml(recommendation.promotionType || 'Promotion')}</span>
                        <span class="service-price slim">${escapeHtml(recommendation.discountOrReward || 'Reward')}</span>
                    </div>
                    <div>
                        <h3>${escapeHtml(recommendation.promotionTitle || 'Recommended promotion')}</h3>
                        <p class="muted">${escapeHtml(recommendation.serviceOrProduct || 'Service or product TBC')}</p>
                        <p>${escapeHtml(recommendation.reason || '')}</p>
                    </div>
                    <dl class="profile-booking-meta">
                        <div><dt>Minimum spend</dt><dd>${escapeHtml(recommendation.minimumSpend || 'None')}</dd></div>
                        <div><dt>Period</dt><dd>${escapeHtml(recommendation.recommendedPeriod || 'Next campaign period')}</dd></div>
                        <div><dt>Target customers</dt><dd>${escapeHtml(recommendation.targetCustomers || 'Relevant customers')}</dd></div>
                        <div><dt>Expected benefit</dt><dd>${escapeHtml(recommendation.expectedBenefit || '')}</dd></div>
                    </dl>
                    <div class="service-card-actions ai-recommendation-actions">
                        <a class="button primary" href="${escapeHtml(buildCreatePromotionUrl(recommendation))}">Create promotion</a>
                    </div>
                </article>
            `).join('');

            setAiStatus(payload.summary || 'Recommendations generated.', false);
        };

        aiButton?.addEventListener('click', async () => {
            aiButton.disabled = true;
            aiButton.textContent = 'Generating...';
            if (aiResults) {
                aiResults.hidden = true;
                aiResults.innerHTML = '';
            }
            setAiStatus('Generating AI promotion recommendations...', false);

            try {
                const requestVariant = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
                const response = await fetch('/api/ai/promotions', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-csrf-token': csrfToken
                    },
                    body: JSON.stringify({
                        ...aiPromotionData,
                        requestVariant
                    })
                });
                const payload = await response.json();

                if (!response.ok) {
                    throw new Error(payload.message || 'Promotion recommendations could not be generated.');
                }

                renderRecommendations(payload);
            } catch (error) {
                setAiStatus(error.message || 'Promotion recommendations could not be generated.', true);
            } finally {
                aiButton.disabled = false;
                aiButton.textContent = 'Generate recommendations';
            }
        });

        if (!categoryFilter || promotionCards.length === 0) {
            return;
        }

        categoryFilter.addEventListener('change', () => {
            const selectedCategory = categoryFilter.value.trim().toLowerCase();

            promotionCards.forEach((card) => {
                const category = (card.dataset.category || '').trim().toLowerCase();
                const isVisible = !selectedCategory || category === selectedCategory;
                card.style.display = isVisible ? '' : 'none';
            });
        });
    })();
</script>

<%- include('partials/footer') %>
