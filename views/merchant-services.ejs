<%- include('partials/header', { title }) %>

<%
    const services = Array.isArray(merchant.services) ? merchant.services : [];
    const categoryOptions = [...new Set(services.map((service) => service.category || merchant.category).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const slotCount = services.reduce((total, service) => total + (Array.isArray(service.slots) ? service.slots.length : 0), 0);
    const packageCount = services.filter((service) => service.packageEnabled).length;
    const featuredCount = services.filter((service) => service.isFeatured).length;
    const averagePrice = services.length > 0
        ? services.reduce((total, service) => total + Number(service.price || 0), 0) / services.length
        : 0;
%>

<section class="section compact merchant-service-manager-page">
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <header class="merchant-dashboard-hero merchant-portal-hero">
        <div>
            <p class="eyebrow">Merchant Portal</p>
            <h1>Service menu</h1>
            <span>Manage services, prices, duration, and bookable times for <%= merchant.name %>.</span>
        </div>
        <div class="merchant-hero-actions">
            <a class="button primary" href="/merchant/services/new">Add service</a>
        </div>
    </header>

    <div class="merchant-service-summary">
        <article>
            <span>Listed services</span>
            <strong><%= services.length %></strong>
            <small><%= categoryOptions.length %> categories</small>
        </article>
        <article>
            <span>Available slots</span>
            <strong><%= slotCount %></strong>
            <small>across all services</small>
        </article>
        <article>
            <span>Packages</span>
            <strong><%= packageCount %></strong>
            <small><%= averagePrice > 0 ? `$${averagePrice.toFixed(2)} avg single session` : 'none listed yet' %></small>
        </article>
        <article>
            <span>Featured</span>
            <strong><%= featuredCount %>/3</strong>
            <small>homepage and marketplace priority</small>
        </article>
    </div>

    <div class="merchant-service-toolbar">
        <div>
            <p class="eyebrow">Service manager</p>
            <h2>Menu and availability</h2>
            <p class="muted">Filter by category, review each service, and edit its booking slots.</p>
        </div>
        <div class="inline-button-group">
            <label>
                <span class="sr-only">Search services</span>
                <input class="js-merchant-service-search" type="search" placeholder="Search service">
            </label>
            <% if (categoryOptions.length > 1) { %>
                <label>
                    <span class="sr-only">Filter by category</span>
                    <select class="js-merchant-service-category-filter">
                        <option value="">All categories</option>
                        <% categoryOptions.forEach((category) => { %>
                            <option value="<%= category %>"><%= category %></option>
                        <% }) %>
                    </select>
                </label>
            <% } %>
        </div>
    </div>

    <% if (services.length === 0) { %>
        <div class="merchant-products-empty">
            <p class="eyebrow">Services</p>
            <h2>No services listed yet</h2>
            <p>Add your first service so customers can start booking.</p>
            <a class="button primary" href="/merchant/services/new">Add service</a>
        </div>
    <% } else { %>
        <div class="merchant-service-table-head" aria-hidden="true">
            <span>Service</span>
            <span>Category</span>
            <span>Duration</span>
            <span>Price</span>
            <span>Package</span>
            <span>Featured</span>
            <span>Slots</span>
            <span>Actions</span>
        </div>
        <div class="merchant-service-list">
            <% services.forEach((service) => { %>
                <% const recommendation = service.featuredRecommendation || null; %>
                <article class="merchant-service-row js-merchant-service-card" data-category="<%= service.category || merchant.category %>">
                    <div class="merchant-service-main">
                        <h3><%= service.name %></h3>
                        <% if (service.description) { %>
                            <p><%= service.description %></p>
                        <% } %>
                        <% if ((service.routineGoalTags || []).length || (service.routineConcernTags || []).length || service.routineRecommendationNote) { %>
                            <p class="muted">
                                Routine Finder:
                                <strong><%= [...(service.routineGoalTags || []), ...(service.routineConcernTags || [])].slice(0, 4).join(', ') || 'Note added' %></strong>
                                <% if (service.routineRecommendationNote) { %>
                                    &middot; <%= service.routineRecommendationNote %>
                                <% } %>
                            </p>
                        <% } else { %>
                            <p class="muted">Routine Finder tags not set yet.</p>
                        <% } %>
                        <% if (service.inventoryProductId) { %>
                            <p class="muted">
                                Linked inventory: <strong><%= service.inventoryProductName || 'Tracked product' %></strong>
                                (<%= Number(service.inventoryStockQuantity || 0) %> in stock, requires <%= Number(service.inventoryQuantityRequired || 1) %>)
                                <% if (service.inventoryBlocked) { %>
                                    <span>• Booking hidden until restocked</span>
                                <% } %>
                            </p>
                        <% } %>
                    </div>
                    <span class="merchant-service-category"><%= service.category || merchant.category %></span>
                    <span class="merchant-service-duration"><%= service.duration %></span>
                    <strong class="merchant-service-price">$<%= Number(service.price).toFixed(2) %></strong>
                    <div class="merchant-service-package">
                        <% if (service.packageEnabled) { %>
                            <strong>$<%= Number(service.packagePrice).toFixed(2) %></strong>
                            <span><%= service.packageSessions %> sessions</span>
                        <% } else { %>
                            <span>No package</span>
                        <% } %>
                    </div>
                    <div class="merchant-featured-cell <%= service.isFeatured ? 'is-featured' : 'is-idle' %>">
                        <span class="merchant-featured-pill <%= service.isFeatured ? 'is-featured' : 'is-idle' %>">
                            <%= service.isFeatured ? 'Featured' : 'Not featured' %>
                        </span>
                        <% if (service.isFeatured) { %>
                            <strong>Priority #<%= Number(service.featuredOrder || 0) %></strong>
                            <span><%= service.featuredStartDate || 'No start' %> to <%= service.featuredEndDate || 'No end' %></span>
                        <% } else if (recommendation) { %>
                            <strong>Recommended #<%= recommendation.rank %></strong>
                            <span><%= recommendation.reason %></span>
                            <span><%= recommendation.canFeatureNow ? `Suggested priority ${recommendation.featuredOrder}` : 'Replace one existing featured service to use this recommendation.' %></span>
                        <% } else { %>
                            <span>Use this to highlight the service on booking and marketplace surfaces.</span>
                        <% } %>
                    </div>
                    <% if (Array.isArray(service.slots) && service.slots.length > 0) { %>
                        <div class="merchant-service-slots">
                            <% service.slots.forEach((slot) => { %>
                                <span><%= slot %></span>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="muted merchant-service-slots">No slots configured yet.</p>
                    <% } %>
                    <div class="merchant-service-actions">
                        <a class="button secondary" href="/merchant/services/<%= service.id %>/edit">Edit</a>
                        <details class="merchant-featured-editor">
                            <summary><%= service.isFeatured ? 'Edit featured' : 'Feature service' %></summary>
                            <form class="merchant-featured-form" action="/merchant/services/<%= service.id %>/feature" method="POST">
                                <label>
                                    <span>Priority</span>
                                    <input type="number" name="featuredOrder" min="0" max="99" value="<%= service.isFeatured ? Number(service.featuredOrder || 0) : Number(recommendation?.featuredOrder || 0) %>" placeholder="Order" aria-label="Featured order">
                                </label>
                                <label>
                                    <span>Start date</span>
                                    <input type="date" name="featuredStartDate" value="<%= service.isFeatured ? (service.featuredStartDate || '') : (recommendation?.featuredStartDate || '') %>" aria-label="Featured start date">
                                </label>
                                <label>
                                    <span>End date</span>
                                    <input type="date" name="featuredEndDate" value="<%= service.isFeatured ? (service.featuredEndDate || '') : (recommendation?.featuredEndDate || '') %>" aria-label="Featured end date">
                                </label>
                                <% if (!service.isFeatured && recommendation) { %>
                                    <p class="muted">Recommended: <%= recommendation.reason %></p>
                                <% } %>
                                <button class="button secondary" type="submit"><%= service.isFeatured ? 'Save featured settings' : 'Mark as Featured' %></button>
                            </form>
                        </details>
                        <% if (service.isFeatured) { %>
                            <form action="/merchant/services/<%= service.id %>/unfeature" method="POST">
                                <button class="button secondary" type="submit">Remove Featured</button>
                            </form>
                        <% } %>
                        <form action="/merchant/services/<%= service.id %>/delete" method="POST">
                            <button class="button secondary danger-button" type="submit">Delete</button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
</section>

<script>
    (() => {
        const categoryFilter = document.querySelector('.js-merchant-service-category-filter');
        const searchInput = document.querySelector('.js-merchant-service-search');
        const serviceCards = Array.from(document.querySelectorAll('.js-merchant-service-card'));

        if (serviceCards.length === 0) {
            return;
        }

        const applyFilters = () => {
            const selectedCategory = (categoryFilter?.value || '').trim().toLowerCase();
            const query = (searchInput?.value || '').trim().toLowerCase();

            serviceCards.forEach((card) => {
                const category = (card.dataset.category || '').trim().toLowerCase();
                const text = card.textContent.trim().toLowerCase();
                card.style.display = (!selectedCategory || category === selectedCategory) && (!query || text.includes(query)) ? '' : 'none';
            });
        };

        categoryFilter?.addEventListener('change', applyFilters);
        searchInput?.addEventListener('input', applyFilters);
    })();
</script>

<%- include('partials/footer') %>
