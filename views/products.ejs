<%- include('partials/header', { title }) %>

<%
    const productList = Array.isArray(products)
        ? products
        : [
            { id: 'skin-serum', name: 'Hydrating Glow Serum', category: 'Skincare', price: 38, description: 'Best after facial treatments' },
            { id: 'hair-mask', name: 'Repair Hair Mask', category: 'Haircare', price: 32, description: 'For coloured or dry hair' },
            { id: 'body-oil', name: 'Calming Body Oil', category: 'Bodycare', price: 28, description: 'Spa-inspired daily care' },
            { id: 'lip-tint', name: 'Soft Rose Lip Tint', category: 'Makeup', price: 18, description: 'Lightweight everyday colour' },
            { id: 'cream-cleanser', name: 'Gentle Cream Cleanser', category: 'Skincare', price: 24, description: 'For daily cleansing after facials' },
            { id: 'room-mist', name: 'Botanical Room Mist', category: 'Wellness', price: 22, description: 'Calm spa scent for home' }
        ];
    const productImages = {
        'skin-serum': 'product-skin',
        'hair-mask': 'product-hair',
        'body-oil': 'product-body',
        'lip-tint': 'product-lip',
        'cream-cleanser': 'product-cleanser',
        'room-mist': 'product-fragrance'
    };
    const categoryList = [...new Set(productList.map((product) => product.category || 'Uncategorised'))].sort();
    const maxPrice = productList.reduce((max, product) => Math.max(max, Number(product.price || 0)), 0);
    const formatStock = (product) => {
        if (typeof product.stockQuantity === 'undefined') return 'Available';
        const stock = Number(product.stockQuantity || 0);
        if (stock <= 0) return 'Out of stock';
        if (stock <= 5) return `${stock} left`;
        return 'In stock';
    };
%>

<section class="marketplace-hero">
    <div class="marketplace-hero-copy">
        <p class="eyebrow">Product marketplace</p>
        <h1><%= typeof categoryName !== 'undefined' && categoryName ? `${categoryName} products` : 'Salon favourites for better aftercare.' %></h1>
        <p><%= typeof categoryName !== 'undefined' && categoryName ? `Shop ${categoryName.toLowerCase()} products recommended for post-treatment routines, daily care, and at-home maintenance.` : 'Shop beauty and wellness products recommended for post-treatment routines, daily care, and at-home maintenance.' %></p>
        <div class="marketplace-hero-actions">
            <a class="button primary" href="#product-catalog">Shop now</a>
            <a class="button secondary" href="/cart">View cart (<span data-cart-count><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>)</a>
        </div>
    </div>
    <div class="marketplace-hero-image" aria-label="Facial aftercare products"></div>
</section>

<section class="section compact products-marketplace-page" id="product-catalog">
    <div class="marketplace-heading-row">
        <div>
            <p class="eyebrow">Product catalog</p>
            <h2>Shop aftercare essentials</h2>
        </div>
        <p><span data-product-count><%= productList.length %></span> product<%= productList.length === 1 ? '' : 's' %> available</p>
    </div>

    <div class="marketplace-controls" data-marketplace-controls>
        <label class="marketplace-search">
            <span>Search products</span>
            <input type="search" data-product-search placeholder="Search cleanser, serum, salon...">
        </label>

        <label>
            <span>Category</span>
            <select data-readable-select data-product-category>
                <option value="">All categories</option>
                <% categoryList.forEach((category) => { %>
                    <option value="<%= category %>"><%= category %></option>
                <% }) %>
            </select>
        </label>

        <label>
            <span>Sort</span>
            <select data-readable-select data-product-sort>
                <option value="featured">Featured</option>
                <option value="price-asc">Price: low to high</option>
                <option value="price-desc">Price: high to low</option>
                <option value="name-asc">Name: A to Z</option>
            </select>
        </label>

        <label class="marketplace-price-filter">
            <span>Max price <strong data-price-output>$<%= Number(maxPrice || 0).toFixed(0) %></strong></span>
            <input type="range" min="0" max="<%= Math.ceil(maxPrice || 100) %>" value="<%= Math.ceil(maxPrice || 100) %>" data-product-price>
        </label>

    </div>

    <% if (productList.length === 0) { %>
        <div class="marketplace-empty-state" data-product-empty>
            <p class="eyebrow">No products</p>
            <h2>No aftercare products are listed yet.</h2>
            <p class="muted">Check back after merchants add retail products.</p>
        </div>
    <% } else { %>
        <div class="products-marketplace-grid" data-products-grid>
            <% productList.forEach((product, index) => { %>
                <%
                    const displayImageUrl = product.imageUrl || product.fallbackImageUrl || '';
                    const productImageClass = displayImageUrl ? '' : (productImages[product.id] || 'product-skin');
                    const productImageStyle = displayImageUrl ? `background-image: linear-gradient(180deg, rgba(255, 253, 247, 0.04), rgba(48, 68, 43, 0.16)), url('${displayImageUrl}')` : '';
                    const category = product.category || 'Uncategorised';
                    const merchantName = product.salonName || (product.category && !categoryList.includes(product.category) ? product.category : 'Vaniday Beauty Studio');
                    const stockLabel = formatStock(product);
                    const isOutOfStock = stockLabel === 'Out of stock';
                    const campaignCashbackTotal = Number(product.campaignCashback?.total || 0);
                %>
                <article
                    class="marketplace-product-card"
                    data-product-card
                    data-name="<%= product.name %>"
                    data-description="<%= product.description || '' %>"
                    data-merchant="<%= merchantName %>"
                    data-category="<%= category %>"
                    data-price="<%= Number(product.price || 0).toFixed(2) %>"
                    data-index="<%= index %>"
                    data-featured="<%= product.isFeatured ? '1' : '0' %>"
                    data-featured-order="<%= Number(product.featuredOrder || 0) %>">
                    <a class="marketplace-product-image product-image <%= productImageClass %>" href="/products/<%= product.id %>" style="<%= productImageStyle %>" aria-label="View <%= product.name %>">
                        <span class="product-image-badge"><%= category %></span>
                        <% if (product.isFeatured) { %>
                            <span class="product-stock-badge">⭐ Featured Product</span>
                        <% } %>
                        <span class="product-stock-badge <%= isOutOfStock ? 'is-empty' : '' %>"><%= stockLabel %></span>
                        <% if (campaignCashbackTotal > 0) { %>
                            <span class="product-stock-badge">+$<%= campaignCashbackTotal.toFixed(2) %> cashback</span>
                        <% } %>
                    </a>

                    <div class="marketplace-product-body">
                        <div class="marketplace-product-meta">
                            <span><%= merchantName %></span>
                            <span>New</span>
                        </div>
                        <h3><%= product.name %></h3>
                        <p><%= product.description %></p>
                        <% if (campaignCashbackTotal > 0) { %>
                            <p class="muted">Eligible for merchant campaign cashback after payment.</p>
                        <% } %>
                    </div>

                    <div class="marketplace-product-footer">
                        <strong>$<%= Number(product.price || 0).toFixed(2) %></strong>
                        <div class="marketplace-product-actions">
                            <a class="button secondary" href="/products/<%= product.id %>">View product</a>
                            <form action="/cart/product/<%= product.id %>" method="POST" class="product-add-form">
                                <input type="hidden" name="productId" value="<%= product.id %>">
                                <button class="button primary" type="submit" <%= isOutOfStock ? 'disabled' : '' %>>Add to cart</button>
                            </form>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>

        <div class="marketplace-empty-state" data-product-empty hidden>
            <p class="eyebrow">No matches</p>
            <h2>No products match your filters.</h2>
            <p class="muted">Try a broader search, another category, or a higher price limit.</p>
        </div>
    <% } %>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const cards = Array.from(document.querySelectorAll('[data-product-card]'));
    const grid = document.querySelector('[data-products-grid]');
    const search = document.querySelector('[data-product-search]');
    const category = document.querySelector('[data-product-category]');
    const sort = document.querySelector('[data-product-sort]');
    const price = document.querySelector('[data-product-price]');
    const priceOutput = document.querySelector('[data-price-output]');
    const count = document.querySelector('[data-product-count]');
    const empty = document.querySelector('[data-product-empty]');

    function normalize(value) {
        return String(value || '').trim().toLowerCase();
    }

    function debounce(callback, delay = 240) {
        let timer = null;

        return (...args) => {
            window.clearTimeout(timer);
            timer = window.setTimeout(() => callback(...args), delay);
        };
    }

    function applyFilters() {
        const query = normalize(search ? search.value : '');
        const selectedCategory = category ? category.value : '';
        const maxPrice = price ? Number(price.value || price.max || 0) : Infinity;
        let visibleCards = cards.filter((card) => {
            const haystack = normalize(`${card.dataset.name} ${card.dataset.description} ${card.dataset.merchant} ${card.dataset.category}`);
            const matchesSearch = !query || haystack.includes(query);
            const matchesCategory = !selectedCategory || card.dataset.category === selectedCategory;
            const matchesPrice = Number(card.dataset.price || 0) <= maxPrice;
            return matchesSearch && matchesCategory && matchesPrice;
        });

        if (sort && grid) {
            const mode = sort.value;
            visibleCards = visibleCards.slice().sort((a, b) => {
                if (mode === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
                if (mode === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
                if (mode === 'name-asc') return String(a.dataset.name).localeCompare(String(b.dataset.name));
                if (Number(b.dataset.featured || 0) !== Number(a.dataset.featured || 0)) {
                    return Number(b.dataset.featured || 0) - Number(a.dataset.featured || 0);
                }
                if (Number(a.dataset.featuredOrder || 0) !== Number(b.dataset.featuredOrder || 0)) {
                    return Number(a.dataset.featuredOrder || 0) - Number(b.dataset.featuredOrder || 0);
                }
                return Number(a.dataset.index) - Number(b.dataset.index);
            });
            visibleCards.forEach((card) => grid.appendChild(card));
        }

        cards.forEach((card) => {
            card.hidden = !visibleCards.includes(card);
        });

        if (priceOutput && price) {
            priceOutput.textContent = '$' + Number(price.value || 0).toFixed(0);
        }

        if (count) {
            count.textContent = String(visibleCards.length);
        }

        if (empty) {
            empty.hidden = visibleCards.length > 0;
        }
    }

    const debouncedApplyFilters = debounce(applyFilters);

    [search, category, sort, price].filter(Boolean).forEach((control) => {
        control.addEventListener('input', debouncedApplyFilters);
        control.addEventListener('change', applyFilters);
    });

    applyFilters();
});
</script>

<%- include('partials/footer') %>

