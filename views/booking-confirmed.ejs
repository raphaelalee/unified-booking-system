<%- include('partials/header', { title }) %>

<section class="page-title receipt-title">
    <p class="eyebrow">Booking confirmed</p>
    <h1>Your booking is confirmed.</h1>
    <p>
        <strong><%= booking.service_name %></strong>
        at <strong><%= booking.merchant_name %></strong>
        has been successfully completed.
    </p>
    <div class="hero-actions">
        <a class="button primary" href="/receipt/<%= booking.id %>">View booking</a>
        <a class="button secondary" href="/services">Browse services</a>
    </div>
</section>

<section class="section compact receipt-section">
    <div class="receipt-layout">
        <article class="receipt-card">
            <div class="receipt-meta-grid">
                <p><span>Booking ID</span><strong><%= booking.displayReference || ('#' + booking.id) %></strong></p>
                <p><span>Status</span><strong><%= String(booking.status || 'completed').replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase()) %></strong></p>
                <p><span>Service</span><strong><%= booking.service_name %></strong></p>
                <p><span>Merchant</span><strong><%= booking.merchant_name %></strong></p>
                <p><span>Date</span><strong><%= String(booking.booking_date).slice(0, 10) %></strong></p>
                <p><span>Time</span><strong><%= booking.booking_time %></strong></p>
                <p><span>Price</span><strong>$<%= Number(booking.service_price || 0).toFixed(2) %></strong></p>
                <p><span>Payment</span><strong><%= String(booking.payment_status || 'paid').replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase()) %></strong></p>
            </div>

            <div class="notice success">
                <p>Your appointment has been recorded and completed in the system. You can access the booking receipt or review your upcoming services.</p>
            </div>

            <div class="receipt-total">
                <span>Next step</span>
                <strong>Keep your receipt for reference. Visit your profile to manage bookings or get help.</strong>
            </div>
        </article>

        <aside class="receipt-qr-panel">
            <p class="eyebrow">Need support?</p>
            <p class="muted">If you have questions about this service or want to follow up with the merchant, use your booking receipt or profile booking history.</p>
            <a class="button secondary" href="/profile#bookings">View my bookings</a>
            <a class="button secondary" href="/help-center">Contact support</a>
        </aside>
    </div>
</section>

<%- include('partials/footer') %>
