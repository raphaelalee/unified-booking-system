<%- include('partials/header', { title }) %>

<section class="page-title split">
    <div>
        <p class="eyebrow">Scan to Check In</p>
        <h1><%= booking.merchant_name %></h1>
        <p>
            Verify your attendance for <strong><%= booking.service_name %></strong>
            on <strong><%= String(booking.booking_date).slice(0, 10) %></strong>
            at <strong><%= booking.booking_time %></strong>.
        </p>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="notice success"><p><%= success %></p></div>
        <% } %>
    </div>

    <div class="promo-panel qr-panel">
        <p class="eyebrow">Attendance QR</p>
        <h2>Booking #<%= booking.id %></h2>
        <p class="muted">Current status: <strong><%= booking.status %></strong></p>
        <% if (String(booking.status || '').toLowerCase() === 'checked_in') { %>
            <p class="muted">This appointment is already checked in.</p>
        <% } else { %>
            <form action="<%= qrDebug.routeTarget %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button class="button primary full" type="submit">Confirm check-in</button>
            </form>
        <% } %>
    </div>
</section>

<section class="section compact">
    <article class="account-panel qr-debug-panel">
        <p class="eyebrow">QR Debug</p>
        <p><strong>System:</strong> <%= qrDebug.system %> / <%= qrDebug.label %></p>
        <p><strong>Generated QR URL:</strong> <span class="qr-link-wrap"><%= qrDebug.url %></span></p>
        <p><strong>Token:</strong> <span class="qr-link-wrap"><%= qrDebug.token %></span></p>
        <p><strong>Route target:</strong> <%= qrDebug.routeTarget %></p>
    </article>
</section>

<%- include('partials/footer') %>
