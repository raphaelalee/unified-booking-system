<%- include('partials/header', { title }) %>

<%
    const safeBookingStatus = String(typeof bookingStatus !== 'undefined' ? bookingStatus : 'confirmed').toLowerCase();
    const isPendingBooking = safeBookingStatus === 'pending';
    const statusLabel = isPendingBooking ? 'Pending approval' : 'Confirmed';
    const displayBookingReference = typeof bookingReference !== 'undefined'
        ? bookingReference
        : (typeof bookingReceipt !== 'undefined' && bookingReceipt && bookingReceipt.displayReference ? bookingReceipt.displayReference : '');
    const bookingDirections = (typeof bookingReceipt !== 'undefined' && bookingReceipt && bookingReceipt.directions)
        ? bookingReceipt.directions
        : (typeof directions !== 'undefined' ? directions : null);
%>

<section class="page-title receipt-title">
    <p class="eyebrow"><%= isPendingBooking ? 'Booking pending' : 'Booking confirmed' %></p>
    <h1><%= isPendingBooking ? 'Your booking is under review.' : 'Your booking has been confirmed.' %></h1>
    <p>
        <strong><%= service.name %></strong> at <strong><%= merchant.name %></strong>
        on <strong><%= bookingDate %></strong> at <strong><%= bookingTime %></strong>.
    </p>
    <p class="muted">
        <%= isPendingBooking
            ? 'The merchant will review this appointment request and notify you once it is approved.'
            : 'A confirmation email has been sent with your booking details and check-in QR code.' %>
    </p>
    <div class="hero-actions">
        <% if (currentUser) { %>
            <a class="button primary" href="/profile#bookings">View my bookings</a>
        <% } %>
        <% if (typeof bookingId !== 'undefined' && bookingId) { %>
            <% const receiptBasePath = bookingReceipt && bookingReceipt.receiptPath ? bookingReceipt.receiptPath : `/receipt/${encodeURIComponent(bookingId)}`; %>
            <a class="button secondary" href="<%= receiptBasePath %>">View receipt</a>
            <a class="button secondary" href="<%= receiptBasePath.replace(`/receipt/${encodeURIComponent(bookingId)}`, `/receipt/${encodeURIComponent(bookingId)}/google-calendar`) %>" target="_blank" rel="noopener">Add to calendar</a>
            <a class="button secondary" href="<%= receiptBasePath.replace(`/receipt/${encodeURIComponent(bookingId)}`, `/receipt/${encodeURIComponent(bookingId)}/pdf`) %>">Download receipt</a>
        <% } %>
        <a class="button secondary" href="<%= typeof anotherBookingPath !== 'undefined' ? anotherBookingPath : '/merchant/' + merchant.id %>">Book again</a>
    </div>
</section>

<% if (typeof bookingReceipt !== 'undefined' && bookingReceipt && bookingReceipt.qrCodeDataUrl) { %>
    <section class="section compact receipt-section">
        <div class="receipt-layout">
            <article class="receipt-card">
                <div class="receipt-meta-grid">
                    <p><span>Booking ID</span><strong><%= displayBookingReference || ('#' + bookingReceipt.id) %></strong></p>
                    <p><span>Status</span><strong><%= statusLabel %></strong></p>
                    <p><span>Service</span><strong><%= bookingReceipt.serviceName %></strong></p>
                    <p><span>Merchant</span><strong><%= bookingReceipt.merchantName %></strong></p>
                    <p><span>Date & time</span><strong><%= bookingReceipt.appointmentLabel %></strong></p>
                    <p><span>Original service price</span><strong>$<%= Number(bookingReceipt.servicePrice || 0).toFixed(2) %></strong></p>
                    <% if (Number(bookingReceipt.pointsDiscount || 0) > 0) { %>
                        <p><span>Points discount</span><strong>-$<%= Number(bookingReceipt.pointsDiscount || 0).toFixed(2) %></strong></p>
                        <p><span>Points redeemed</span><strong><%= Number(bookingReceipt.pointsRedeemed || 0) %> pts</strong></p>
                    <% } %>
                    <p><span>Amount payable at merchant</span><strong>$<%= Number((bookingReceipt.amountPayableAtMerchant ?? bookingReceipt.servicePrice) || 0).toFixed(2) %></strong></p>
                </div>
                <div class="notice success" style="margin: 0;">
                    <p>
                        <%= isPendingBooking
                            ? 'This appointment request is waiting for merchant approval. You will receive an update shortly.'
                            : 'Bring this QR code to the merchant counter to complete check-in. You will pay the remaining amount during your appointment.' %>
                    </p>
                </div>
            </article>

            <aside class="receipt-qr-panel receipt-action-panel">
                <% if (bookingDirections && bookingDirections.directionsUrl) { %>
                    <div class="receipt-directions-card">
                        <div class="receipt-directions-header">
                            <span class="receipt-map-mark" aria-hidden="true">G</span>
                            <div>
                                <p class="eyebrow">How to get there</p>
                                <h2><%= bookingDirections.destinationLabel || bookingReceipt.merchantName %></h2>
                            </div>
                        </div>
                        <p class="receipt-address-line"><%= bookingDirections.destinationAddress %></p>
                        <div class="receipt-transit-note">
                            <strong>Transit route</strong>
                            <span>Google Maps will show nearby bus stops, MRT options, walking time, and live route choices.</span>
                        </div>
                        <a class="button primary" href="<%= bookingDirections.directionsUrl %>" target="_blank" rel="noopener">Open transit directions</a>
                        <div class="receipt-map-mode-row">
                            <a href="<%= bookingDirections.walkingDirectionsUrl %>" target="_blank" rel="noopener">Walk</a>
                            <a href="<%= bookingDirections.drivingDirectionsUrl %>" target="_blank" rel="noopener">Drive</a>
                        </div>
                    </div>
                <% } %>
                <div class="receipt-verification-card">
                <p class="eyebrow">Check-in QR code</p>
                <img class="qr-code" src="<%= bookingReceipt.qrCodeDataUrl %>" alt="Check-in QR code for booking <%= bookingReceipt.id %>">
                <p class="muted">Show this QR code when you arrive at the merchant.</p>
                </div>
            </aside>
        </div>
    </section>
<% } %>

<%- include('partials/footer') %>
