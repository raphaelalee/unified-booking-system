<%- include('partials/header', { title }) %>

<%
    const safeBookingStatus = String(typeof bookingStatus !== 'undefined' ? bookingStatus : 'confirmed').toLowerCase();
    const isPendingBooking = safeBookingStatus === 'pending';
%>

<section class="page-title">
    <p class="eyebrow"><%= isPendingBooking ? 'Booking pending' : 'Booking confirmed' %></p>
    <h1><%= isPendingBooking ? 'Your booking is waiting for merchant review.' : 'Your booking has been confirmed.' %></h1>
    <p>
        <strong><%= service.name %></strong> at <strong><%= merchant.name %></strong>
        on <strong><%= bookingDate %></strong> at <strong><%= bookingTime %></strong>.
        <%= isPendingBooking ? 'The merchant will review this appointment request.' : 'Please refer to your email for the confirmation details and check-in QR code.' %>
    </p>
    <div class="hero-actions">
        <a class="button primary" href="/profile#bookings">View my bookings</a>
        <% if (typeof bookingId !== 'undefined' && bookingId) { %>
            <a class="button secondary" href="/receipt/<%= encodeURIComponent(bookingId) %>/google-calendar" target="_blank" rel="noopener">Add to Google Calendar</a>
            <a class="button secondary" href="/receipt/<%= encodeURIComponent(bookingId) %>/pdf">Download Receipt</a>
        <% } %>
        <a class="button secondary" href="<%= typeof anotherBookingPath !== 'undefined' ? anotherBookingPath : '/merchant/' + merchant.id %>">Create another booking</a>
    </div>
</section>

<%- include('partials/footer') %>
