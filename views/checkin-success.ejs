<%- include('partials/header', { title }) %>

<section class="page-title">
    <p class="eyebrow"><%= receiptType === 'product pickup' ? 'Verified pickup' : 'Verified receipt' %></p>
    <h1><%= receiptType === 'product pickup' ? 'Pickup verified' : 'Check-in successful' %></h1>
    <p>
        <% if (receiptType === 'product pickup') { %>
            Receipt <strong>#<%= receiptId %></strong> is valid for item collection.
        <% } else { %>
            Receipt <strong>#<%= receiptId %></strong> has a valid signed token.
        <% } %>
    </p>
    <div class="hero-actions">
        <a class="button primary" href="/">Back to home</a>
    </div>
</section>

<%- include('partials/footer') %>
