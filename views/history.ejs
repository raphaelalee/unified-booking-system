<%- include('partials/header', { title }) %>

<section class="page-title">
    <p class="eyebrow">Profile</p>
    <h1>Purchase history</h1>
    <p>View your bookings and orders at a glance.</p>
</section>

<section class="section compact">
    <%
        const formatStatusLabel = (value) => String(value || '').replace(/_/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
        const formatFulfilmentLabel = (value) => String(value || '').toLowerCase() === 'delivery' ? 'Delivery' : 'Pickup';
        const formatBookingReference = (entry) => {
            if (entry.displayReference) {
                return entry.displayReference;
            }

            const bookingId = String(entry.id || entry.receiptId || '').replace(/\D/g, '');
            const bookingDate = new Date(entry.createdAt || 0);
            const datePart = Number.isNaN(bookingDate.getTime())
                ? '00000000'
                : [
                    bookingDate.getFullYear(),
                    String(bookingDate.getMonth() + 1).padStart(2, '0'),
                    String(bookingDate.getDate()).padStart(2, '0')
                ].join('');

            return `BKG-${datePart}-${bookingId.padStart(6, '0')}`;
        };
    %>
    <% if (success) { %>
        <div class="notice success"><%= success %></div>
    <% } %>

    <% if (error) { %>
        <div class="notice error"><%= error %></div>
    <% } %>

    <div class="history-filter-tabs">
        <a class="button <%= activeFilter === 'all' ? 'primary' : 'secondary' %>" href="/profile/history">All (<%= counts.all %>)</a>
        <a class="button <%= activeFilter === 'bookings' ? 'primary' : 'secondary' %>" href="/profile/history?type=bookings">Bookings (<%= counts.bookings %>)</a>
        <a class="button <%= activeFilter === 'products' ? 'primary' : 'secondary' %>" href="/profile/history?type=products">Products (<%= counts.products %>)</a>
    </div>

    <% if (!history.length) { %>
        <div class="notice">
            No purchases yet
        </div>
    <% } else { %>
        <div class="history-card-list">
            <% history.forEach((entry) => { %>
                <article class="history-card">
                    <div class="history-card-top">
                        <div class="history-card-title-group">
                            <span class="sync-pill"><%= entry.type %></span>
                            <strong class="history-card-id">
                                <%= entry.type === 'booking' ? 'Booking' : 'Order' %>
                                <%= entry.type === 'booking'
                                    ? formatBookingReference(entry)
                                    : (entry.order_number || entry.orderNumber || ('#' + entry.id)) %>
                            </strong>
                        </div>
                        <a class="button secondary" href="/receipt/<%= encodeURIComponent(entry.receiptId) %>">Receipt</a>
                    </div>

                    <div class="history-card-grid">
                        <div class="history-card-block history-card-items">
                            <span class="history-card-label">Items</span>
                            <% if (entry.type === 'product' && Array.isArray(entry.items) && entry.items.length) { %>
                                <% entry.items.forEach((item) => { %>
                                    <div class="history-item-block">
                                            <div class="history-item-row">
                                                <img
                                                    class="history-item-image"
                                                    src="<%= item.imageUrl || '/images/product-room-mist.svg' %>"
                                                    alt="<%= item.name %>"
                                                    onerror="this.onerror=null;this.src='/images/product-room-mist.svg';"
                                                >
                                                <div class="history-item-content">
                                                    <div class="history-item-title">
                                                        <strong><%= item.name %></strong>
                                                        <% if (Number(item.quantity || 1) > 1) { %>
                                                            <span class="history-quantity">x<%= Number(item.quantity || 1) %></span>
                                                        <% } %>
                                                    </div>
                                                    <% if (item.review) { %>
                                                        <div class="muted">Reviewed <%= item.review.rating %>/5</div>
                                                    <% } else if (entry.reviewable && item.productId) { %>
                                                        <details class="history-review-panel">
                                                            <summary class="button secondary history-review-trigger">Review product</summary>
                                                            <form action="/profile/orders/<%= encodeURIComponent(entry.receiptId) %>/products/<%= item.productId %>/review?_csrf=<%= encodeURIComponent(typeof csrfToken !== 'undefined' ? csrfToken : '') %>" method="POST" enctype="multipart/form-data" class="history-review-form">
                                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                                <label>
                                                                    Rating
                                                                    <select name="rating" required>
                                                                        <option value="">Select</option>
                                                                        <option value="5">5 stars</option>
                                                                        <option value="4">4 stars</option>
                                                                        <option value="3">3 stars</option>
                                                                        <option value="2">2 stars</option>
                                                                        <option value="1">1 star</option>
                                                                    </select>
                                                                </label>
                                                                <label>
                                                                    Comment
                                                                    <textarea class="review-comment-input" name="comment" rows="3" maxlength="800" placeholder="Share what you liked about this product."></textarea>
                                                                </label>
                                                                <label>
                                                                    Photo
                                                                    <input type="file" name="reviewImage" accept="image/*">
                                                                </label>
                                                                <label>
                                                                    Video
                                                                    <input type="file" name="reviewVideo" accept="video/*">
                                                                </label>
                                                                <button class="button primary" type="submit">Submit review</button>
                                                            </form>
                                                        </details>
                                                    <% } %>
                                                </div>
                                            </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="history-item-block">
                                    <div class="history-item-title"><strong><%= entry.itemNames %></strong></div>
                                </div>
                            <% } %>
                        </div>

                        <div class="history-card-block">
                            <span class="history-card-label">Summary</span>
                            <div class="history-card-value">$<%= Number(entry.totalAmount || 0).toFixed(2) %></div>
                            <div class="muted"><%= entry.paymentMethodLabel || entry.paymentMethod %></div>
                            <% if (Number(entry.refundedAmount || 0) > 0) { %>
                                <div class="muted">Refunded $<%= Number(entry.refundedAmount || 0).toFixed(2) %></div>
                            <% } %>
                        </div>

                        <div class="history-card-block">
                            <span class="history-card-label">Status</span>
                            <div class="history-card-value"><%= entry.paymentStatusLabel || entry.paymentStatus %></div>
                            <% if (entry.type === 'product' && entry.deliveryStatus) { %>
                                <div class="muted history-status-meta">
                                    <%= formatFulfilmentLabel(entry.fulfilmentType || entry.fulfilment) %> •
                                    <%= formatStatusLabel((String(entry.fulfilmentType || entry.fulfilment).toLowerCase() === 'pickup' && entry.pickupStatus) ? entry.pickupStatus : entry.deliveryStatus) %>
                                </div>
                            <% } %>
                            <% if ((entry.refundStatusLabel || entry.refundStatus) && String(entry.refundStatusLabel || entry.refundStatus).toLowerCase() !== 'none') { %>
                                <div class="muted history-status-meta">Refund: <%= entry.refundStatusLabel || entry.refundStatus %></div>
                            <% } %>
                        </div>

                        <div class="history-card-block">
                            <span class="history-card-label">Date</span>
                            <div class="history-card-value history-card-date"><%= entry.createdAtLabel %></div>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
</section>

<% if (typeof reviewModerationPopup !== 'undefined' && reviewModerationPopup) { %>
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            alert(<%- JSON.stringify(`Review blocked: ${reviewModerationPopup}`) %>);
        });
    </script>
<% } %>

<%- include('partials/footer') %>
