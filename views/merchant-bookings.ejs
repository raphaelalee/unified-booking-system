<%- include('partials/header', { title }) %>

<%
    const appointments = typeof appointmentReport !== 'undefined' && appointmentReport ? appointmentReport : {};
    const weekDays = appointments.weekDays || [];
    const monthView = appointments.monthView || { label: '', days: [] };
    const allCalendarBookings = appointments.allBookings || [];
    const upcomingBookings = appointments.upcomingBookings || [];
    const pendingAppointments = appointments.pendingAppointments || [];
    const rescheduleTools = typeof rescheduleAutomation !== 'undefined' && rescheduleAutomation ? rescheduleAutomation : {};
    const rescheduleSettings = rescheduleTools.settings || {
        autoApproveEnabled: 1,
        autoApproveBookings: 1,
        minimumNoticeHours: 24,
        maxReschedulesAllowed: 2,
        blockedTimes: '',
        peakHourRestrictions: 1,
        businessStart: '09:00',
        businessEnd: '20:00'
    };
    const pendingRescheduleReviews = Array.isArray(rescheduleTools.pendingReviews) ? rescheduleTools.pendingReviews : [];
    const autoApprovedReschedules = Array.isArray(rescheduleTools.autoApproved) ? rescheduleTools.autoApproved : [];
    const serviceFilterOptions = [...new Set(allCalendarBookings.map((booking) => booking.serviceName).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const timeOptions = [];
    for (let hour = 0; hour < 24; hour += 1) {
        [0, 30].forEach((minute) => {
            const value = `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
            const displayHour = hour % 12 || 12;
            const period = hour < 12 ? 'AM' : 'PM';
            timeOptions.push({ value, label: `${String(displayHour).padStart(2, '0')}:${String(minute).padStart(2, '0')} ${period}` });
        });
    }
    const selectedBusinessStart = String(rescheduleSettings.businessStart || '09:00').slice(0, 5);
    const selectedBusinessEnd = String(rescheduleSettings.businessEnd || '20:00').slice(0, 5);
    const selectedBlockedTimes = new Set(String(rescheduleSettings.blockedTimes || '').split(',').map((time) => time.trim().slice(0, 5)).filter(Boolean));
    const selectedBlockedLabels = timeOptions
        .filter((option) => selectedBlockedTimes.has(option.value))
        .map((option) => option.label);
    const statusLabels = {
        pending: 'pending',
        confirmed: 'confirmed',
        paid: 'paid',
        checked_in: 'checked-in',
        completed: 'completed',
        cancelled: 'cancelled',
        no_show: 'no-show'
    };
%>

<section class="section compact merchant-analytics-page merchant-appointment-dashboard">
    <% if (success) { %><div class="notice success"><p><%= success %></p></div><% } %>
    <% if (error) { %><div class="notice error"><p><%= error %></p></div><% } %>

    <div class="merchant-analytics-shell">
        <header class="merchant-dashboard-hero">
            <div>
                <p class="eyebrow">Bookings</p>
                <h1>Appointment operations</h1>
                <span>Service bookings confirm automatically. Review reschedule requests and manage booking rules for <%= merchant.name %>.</span>
            </div>
            <div class="merchant-hero-actions">
                <a class="button secondary" href="/merchant/schedule">Open calendar</a>
            </div>
        </header>

        <section class="merchant-kpi-grid" aria-label="Booking summary">
            <article class="merchant-kpi-card accent-green"><span>Upcoming</span><strong><%= upcomingBookings.length %></strong><small>next appointments</small></article>
            <article class="merchant-kpi-card accent-yellow"><span>Booking mode</span><strong>Auto</strong><small>available slots confirm</small></article>
            <article class="merchant-kpi-card accent-orange"><span>Reschedule reviews</span><strong><%= pendingRescheduleReviews.length %></strong><small>manual review queue</small></article>
            <article class="merchant-kpi-card accent-blue"><span>Auto-approved</span><strong><%= autoApprovedReschedules.length %></strong><small>handled by rules</small></article>
        </section>

        <section class="merchant-dashboard-lower-grid" id="reschedule-requests">
            <% if (pendingRescheduleReviews.length) { %>
            <article class="merchant-alert-card">
                <div class="merchant-card-heading">
                    <div><p class="eyebrow">Reschedules</p><h2>Pending manual reviews</h2></div>
                </div>
                <div class="merchant-appointment-list">
                    <% pendingRescheduleReviews.forEach((request) => { %>
                        <article>
                            <span class="merchant-status-badge status-pending"><%= request.confidenceLevel %> confidence</span>
                            <div>
                                <strong><%= request.customerName %></strong>
                                <small><%= request.serviceName %> - <%= String(request.oldBookingDate).slice(0, 10) %> <%= request.oldBookingTime || '' %> to <%= String(request.requestedBookingDate).slice(0, 10) %> at <%= request.requestedBookingTime %></small>
                                <small><%= request.decisionReason || 'Merchant review recommended.' %></small>
                            </div>
                            <div class="merchant-booking-actions">
                                <form action="/merchant/reschedule-requests/<%= request.id %>/review" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <input type="hidden" name="action" value="approve">
                                    <button class="button secondary" type="submit">Approve</button>
                                </form>
                                <form action="/merchant/reschedule-requests/<%= request.id %>/review" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <input type="hidden" name="action" value="reject">
                                    <button class="button secondary danger-button" type="submit">Reject</button>
                                </form>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </article>
            <% } %>

            <article class="merchant-alert-card">
                <div class="merchant-card-heading">
                    <div><p class="eyebrow">Reschedule Rules</p><h2>Booking and reschedule settings</h2></div>
                </div>
                <form class="merchant-quick-actions merchant-reschedule-settings" action="/merchant/reschedule-settings" method="POST">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="autoApproveBookings" value="1">
                    <label class="merchant-toggle-row merchant-settings-wide">
                        <input type="checkbox" name="autoApproveEnabled" value="1" <%= Number(rescheduleSettings.autoApproveEnabled) ? 'checked' : '' %>>
                        <span><strong>Auto approve simple requests</strong><small>Approve low-risk reschedules when rules pass.</small></span>
                    </label>
                    <label class="merchant-settings-field">Notice hours <input type="number" name="minimumNoticeHours" min="0" max="720" value="<%= Number(rescheduleSettings.minimumNoticeHours || 24) %>"></label>
                    <label class="merchant-settings-field">Max reschedules <input type="number" name="maxReschedulesAllowed" min="0" max="20" value="<%= Number(rescheduleSettings.maxReschedulesAllowed || 2) %>"></label>
                    <label class="merchant-settings-field">
                        <span>Business start</span>
                        <select data-readable-select name="businessStart" required>
                            <% timeOptions.forEach((option) => { %>
                                <option value="<%= option.value %>" <%= option.value === selectedBusinessStart ? 'selected' : '' %>><%= option.label %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label class="merchant-settings-field">
                        <span>Business end</span>
                        <select data-readable-select name="businessEnd" required>
                            <% timeOptions.forEach((option) => { %>
                                <option value="<%= option.value %>" <%= option.value === selectedBusinessEnd ? 'selected' : '' %>><%= option.label %></option>
                            <% }) %>
                        </select>
                    </label>
                    <div class="merchant-settings-wide merchant-settings-field">
                        <span>Blocked times</span>
                        <details class="merchant-time-picker">
                            <summary>
                                <span><%= selectedBlockedLabels.length ? selectedBlockedLabels.join(', ') : 'No blocked times selected' %></span>
                            </summary>
                            <div class="merchant-time-chip-grid">
                                <% timeOptions.forEach((option) => { %>
                                    <label class="merchant-time-chip">
                                        <input type="checkbox" name="blockedTimes" value="<%= option.value %>" <%= selectedBlockedTimes.has(option.value) ? 'checked' : '' %>>
                                        <span><%= option.label %></span>
                                    </label>
                                <% }) %>
                            </div>
                        </details>
                        <small id="blocked-times-help" class="muted">Pick unavailable appointment start times. Leave all unselected if none are blocked.</small>
                    </div>
                    <label class="merchant-toggle-row merchant-settings-wide">
                        <input type="checkbox" name="peakHourRestrictions" value="1" <%= Number(rescheduleSettings.peakHourRestrictions) ? 'checked' : '' %>>
                        <span><strong>Send peak-hour moves to review</strong><small>Keep high-demand time changes in the manual queue.</small></span>
                    </label>
                    <button class="button primary merchant-settings-submit" type="submit">Save rules</button>
                </form>
            </article>
        </section>

        <section class="merchant-orders-card">
            <div class="merchant-card-heading">
                <div><p class="eyebrow">Automation</p><h2>Booking approvals</h2></div>
            </div>
            <p class="muted">Available service bookings are confirmed automatically. Customers pay the remaining amount during the appointment.</p>
        </section>
    </div>
</section>

<%- include('partials/footer') %>

