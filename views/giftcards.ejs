<%- include('partials/header', { title }) %>

<section class="page-title">
    <p class="eyebrow">Gift Cards</p>
    <h1>Give someone their next self-care moment.</h1>
    <p>Vaniday gift cards can be used for beauty, salon, spa, and grooming appointments.</p>
</section>

<section class="section compact giftcard-page">
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="notice success"><%= success %></div>
    <% } %>

    <div class="giftcard-grid">
        <aside class="giftcard-preview-panel">
            <div class="giftcard-card">
                <div class="giftcard-decor" aria-hidden="true"></div>
                <div class="giftcard-brand">Vaniday</div>
                <div class="giftcard-subtitle">Beauty Gift Card</div>
                <div class="giftcard-value" id="giftcard-preview-amount">$50</div>

                <div class="giftcard-detail-row">
                    <span class="giftcard-detail-label">Recipient</span>
                    <span class="giftcard-detail-value" id="giftcard-preview-recipient">Recipient Name</span>
                </div>

                <p class="giftcard-message-preview" id="giftcard-preview-message">Write a short personalised message to make this gift extra special.</p>

                <div class="giftcard-footer-row">
                    <span class="giftcard-footer-tag">Voucher code</span>
                    <span class="giftcard-footer-value" id="giftcard-preview-code">VANI-XXXXXX</span>
                </div>

                <div class="giftcard-meta">Valid for 12 months from purchase date</div>
            </div>
        </aside>

        <main class="giftcard-purchase-panel">
            <section class="giftcard-purchase-card">
                <h2>Purchase a gift voucher</h2>
                <p class="muted">Complete the personalised gift voucher details below before adding it to your cart.</p>

                <form id="giftcard-purchase-form" action="/giftcards/add" method="POST">
                    <div class="form-group">
                        <label class="field-label">Gift card amount</label>
                        <div class="giftcard-amount-options" role="radiogroup" aria-label="Gift card amount">
                            <% [20, 50, 80, 100].forEach((amount) => { %>
                                <label class="giftcard-amount-choice">
                                    <input type="radio" name="amount" value="<%= amount %>" <%= amount === 50 ? 'checked' : '' %>>
                                    <span>$<%= amount %></span>
                                </label>
                            <% }) %>
                        </div>
                        <div class="custom-amount-field">
                            <label for="custom-amount">Custom amount</label>
                            <input id="custom-amount" name="customAmount" type="number" min="10" max="500" step="1" placeholder="Enter amount" autocomplete="off">
                        </div>
                        <p class="field-note">Minimum $10, maximum $500.</p>
                    </div>

                    <div class="form-group">
                        <label class="field-label">Delivery option</label>
                        <div class="radio-grid">
                            <label class="radio-choice">
                                <input type="radio" name="deliveryOption" value="self" checked>
                                <span>Send to my email</span>
                            </label>
                            <label class="radio-choice">
                                <input type="radio" name="deliveryOption" value="recipient">
                                <span>Send to recipient’s email</span>
                            </label>
                        </div>
                    </div>

                    <div class="form-group hidden" id="recipient-email-group">
                        <label for="recipient-email" class="field-label">Recipient email</label>
                        <input id="recipient-email" name="recipientEmail" type="email" placeholder="recipient@example.com">
                    </div>

                    <div class="form-group">
                        <label for="recipient-name" class="field-label">Recipient name</label>
                        <input id="recipient-name" name="recipientName" type="text" placeholder="Recipient name">
                    </div>

                    <div class="form-group">
                        <label for="sender-name" class="field-label">Sender name</label>
                        <input id="sender-name" name="senderName" type="text" placeholder="Your name">
                    </div>

                    <div class="form-group">
                        <label for="message" class="field-label">Personalised message</label>
                        <textarea id="message" name="message" rows="4" placeholder="Add a note to make the gift special"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="field-label">Delivery date</label>
                        <div class="radio-grid">
                            <label class="radio-choice">
                                <input type="radio" name="deliveryDateOption" value="now" checked>
                                <span>Send now</span>
                            </label>
                            <label class="radio-choice">
                                <input type="radio" name="deliveryDateOption" value="schedule">
                                <span>Send on selected date</span>
                            </label>
                        </div>
                        <div class="scheduled-date-field hidden" id="scheduled-date-group">
                            <label for="scheduled-date">Send on date</label>
                            <input id="scheduled-date" name="scheduledDate" type="date" min="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                    </div>

                    <div class="order-summary-card">
                        <h3>Order summary</h3>
                        <div class="summary-row">
                            <span>Gift card amount</span>
                            <span id="summary-amount">$50</span>
                        </div>
                        <div class="summary-row">
                            <span>Delivery method</span>
                            <span id="summary-delivery">Send to my email</span>
                        </div>
                        <div class="summary-row">
                            <span>Recipient</span>
                            <span id="summary-recipient">Not set</span>
                        </div>
                        <div class="summary-row total-row">
                            <span>Total</span>
                            <strong id="summary-total">$50</strong>
                        </div>
                        <p class="summary-note">Valid for 12 months from purchase date.</p>
                    </div>

                    <div class="form-actions">
                        <button class="button primary full" type="submit" id="giftcard-submit-button" disabled>Add gift card to cart</button>
                        <p class="form-error hidden" id="giftcard-form-error" role="alert"></p>
                    </div>
                </form>
            </section>

            <article class="giftcard-terms-card">
                <h2>Terms and conditions</h2>
                <ul class="giftcard-terms">
                    <li>Gift cards are redeemable for Vaniday beauty, salon, spa, and grooming appointments.</li>
                    <li>Gift cards are valid for 12 months from the purchase date.</li>
                    <li>Gift cards cannot be exchanged for cash or refunded after purchase.</li>
                    <li>Gift card value can be used across multiple appointments until the balance is fully redeemed.</li>
                    <li>Lost, stolen, or expired gift cards cannot be replaced.</li>
                    <li>Gift cards cannot be used with other vouchers unless stated by Vaniday.</li>
                </ul>
            </article>
        </main>
    </div>
</section>

<style>
.giftcard-page .giftcard-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 2rem;
}

.giftcard-preview-panel,
.giftcard-purchase-panel {
    width: 100%;
}

.giftcard-card {
    position: relative;
    min-height: 420px;
    padding: 2rem;
    border-radius: 28px;
    background: linear-gradient(135deg, #1f4d35 0%, #3a7d5c 100%);
    color: #f5f5ef;
    overflow: hidden;
    box-shadow: 0 28px 70px rgba(22, 39, 31, 0.25);
}

.giftcard-decor {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left, rgba(255,255,255,0.18), transparent 30%), radial-gradient(circle at bottom right, rgba(255,255,255,0.1), transparent 18%);
    pointer-events: none;
}

.giftcard-brand {
    font-size: 1.1rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 1rem;
}

.giftcard-subtitle {
    font-size: 1.25rem;
    margin-bottom: 1.4rem;
    color: #d9e7d9;
}

.giftcard-value {
    display: inline-flex;
    align-items: baseline;
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: 1.8rem;
}

.giftcard-detail-row,
.giftcard-footer-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: 0.9rem;
    font-size: 0.95rem;
}

.giftcard-detail-label,
.giftcard-footer-tag {
    color: rgba(245,245,239,0.75);
}

.giftcard-detail-value,
.giftcard-footer-value {
    font-weight: 600;
}

.giftcard-message-preview {
    margin: 0 0 1.8rem;
    line-height: 1.7;
    color: rgba(245,245,239,0.92);
    min-height: 56px;
}

.giftcard-meta {
    margin-top: auto;
    padding-top: 1rem;
    color: rgba(245,245,239,0.75);
    font-size: 0.95rem;
    letter-spacing: 0.01em;
}

.giftcard-purchase-card {
    padding: 2rem;
    border-radius: 24px;
    background: #ffffff;
    border: 1px solid #e2e7e1;
    box-shadow: 0 18px 30px rgba(47, 62, 54, 0.08);
}

.giftcard-purchase-card h2 {
    margin-top: 0;
}

.giftcard-purchase-card .muted {
    margin: 0.5rem 0 1.75rem;
    color: #6c766d;
}

.form-group {
    margin-bottom: 1.25rem;
}

.field-label {
    display: block;
    margin-bottom: 0.65rem;
    font-weight: 700;
    color: #1f332c;
}

.giftcard-amount-options,
.radio-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
}

.giftcard-amount-choice,
.radio-choice {
    display: block;
    border: 1px solid #d9e5dc;
    border-radius: 14px;
    padding: 0.95rem 1rem;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
    background: #fafcf9;
}

.giftcard-amount-choice input,
.radio-choice input {
    display: none;
}

.giftcard-amount-choice span,
.radio-choice span {
    display: block;
    font-weight: 700;
    color: #1f332c;
}

.giftcard-amount-choice input:checked + span,
.radio-choice input:checked + span {
    color: #0f3525;
}

.giftcard-amount-choice input:checked,
.radio-choice input:checked {
    outline: none;
}

.giftcard-amount-choice:hover,
.radio-choice:hover {
    border-color: #82ad8d;
}

.giftcard-amount-choice input:checked ~ span,
.radio-choice input:checked ~ span {
    color: #0f3525;
}

.custom-amount-field,
.scheduled-date-field {
    margin-top: 0.75rem;
}

.custom-amount-field input,
.form-group input,
.form-group textarea {
    width: 100%;
    padding: 0.95rem 1rem;
    border: 1px solid #d9e5dc;
    border-radius: 14px;
    font-size: 1rem;
    background: #fbfcfb;
    color: #1f332c;
}

.form-group textarea {
    min-height: 110px;
    resize: vertical;
}

.field-note {
    margin: 0.7rem 0 0;
    color: #6c766d;
    font-size: 0.92rem;
}

.order-summary-card {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: 18px;
    background: #fbfef9;
    border: 1px solid #dbe5dd;
}

.order-summary-card h3 {
    margin-top: 0;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid #e6ece4;
    font-size: 0.98rem;
}

.summary-row:last-of-type {
    border-bottom: none;
}

.total-row {
    margin-top: 0.5rem;
    font-weight: 700;
    color: #1f332c;
}

.summary-note {
    margin: 1rem 0 0;
    color: #6c766d;
    font-size: 0.92rem;
}

.form-actions {
    margin-top: 1.5rem;
}

.button.full {
    width: 100%;
}

.form-error {
    margin-top: 0.85rem;
    color: #9d2c2c;
    font-size: 0.95rem;
}

.hidden {
    display: none !important;
}

.giftcard-terms-card {
    margin-top: 1.75rem;
    padding: 1.5rem;
    border-radius: 18px;
    background: #ffffff;
    border: 1px solid #e6ece4;
    color: #4f5d52;
}

.giftcard-terms-card h2 {
    margin-top: 0;
}

.giftcard-terms {
    margin: 1rem 0 0;
    padding-left: 1.2rem;
    list-style: disc;
    color: #4f5d52;
    font-size: 0.95rem;
    line-height: 1.8;
}

.giftcard-terms li {
    margin-bottom: 0.65rem;
}

@media (max-width: 980px) {
    .giftcard-grid {
        grid-template-columns: 1fr;
    }

    .giftcard-purchase-panel {
        order: 2;
    }
}

@media (max-width: 680px) {
    .giftcard-card {
        padding: 1.6rem;
        min-height: auto;
    }

    .giftcard-purchase-card,
    .giftcard-terms-card {
        padding: 1.5rem;
    }

    .giftcard-amount-options,
    .radio-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<script>
(function () {
    const amountRadios = Array.from(document.querySelectorAll('input[name="amount"]'));
    const customAmountInput = document.getElementById('custom-amount');
    const recipientEmailGroup = document.getElementById('recipient-email-group');
    const recipientEmailInput = document.getElementById('recipient-email');
    const recipientNameInput = document.getElementById('recipient-name');
    const senderNameInput = document.getElementById('sender-name');
    const messageInput = document.getElementById('message');
    const deliveryOptionInputs = Array.from(document.querySelectorAll('input[name="deliveryOption"]'));
    const deliveryDateInputs = Array.from(document.querySelectorAll('input[name="deliveryDateOption"]'));
    const scheduledDateGroup = document.getElementById('scheduled-date-group');
    const scheduledDateInput = document.getElementById('scheduled-date');
    const previewAmount = document.getElementById('giftcard-preview-amount');
    const previewRecipient = document.getElementById('giftcard-preview-recipient');
    const previewMessage = document.getElementById('giftcard-preview-message');
    const summaryAmount = document.getElementById('summary-amount');
    const summaryDelivery = document.getElementById('summary-delivery');
    const summaryRecipient = document.getElementById('summary-recipient');
    const summaryTotal = document.getElementById('summary-total');
    const submitButton = document.getElementById('giftcard-submit-button');
    const errorMessage = document.getElementById('giftcard-form-error');
    const previewCode = document.getElementById('giftcard-preview-code');

    const formatCurrency = (value) => `$${Number(value || 0).toFixed(0)}`;

    function getSelectedAmount() {
        const customValue = Number(customAmountInput.value || '0');
        if (customAmountInput.value.trim() !== '') {
            return customValue;
        }

        const selected = amountRadios.find((input) => input.checked);
        return selected ? Number(selected.value) : 0;
    }

    function getDeliveryOption() {
        return deliveryOptionInputs.find((input) => input.checked)?.value || 'self';
    }

    function getDeliveryDateOption() {
        return deliveryDateInputs.find((input) => input.checked)?.value || 'now';
    }

    function updatePreview() {
        const amount = getSelectedAmount();
        previewAmount.textContent = formatCurrency(amount || 50);
        previewRecipient.textContent = recipientNameInput.value.trim() || 'Recipient Name';
        previewMessage.textContent = messageInput.value.trim() || 'Write a short personalised message to make this gift extra special.';
        previewCode.textContent = 'VANI-XXXXXX';
    }

    function updateSummary() {
        const amount = getSelectedAmount();
        const deliveryOption = getDeliveryOption();
        const recipientName = recipientNameInput.value.trim();
        const recipientEmail = recipientEmailInput.value.trim();

        summaryAmount.textContent = formatCurrency(amount || 50);
        summaryTotal.textContent = formatCurrency(amount || 50);
        summaryDelivery.textContent = deliveryOption === 'recipient' ? 'Send to recipient’s email' : 'Send to my email';
        summaryRecipient.textContent = recipientName || recipientEmail || 'Not set';
    }

    function setVisibility() {
        recipientEmailGroup.classList.toggle('hidden', getDeliveryOption() !== 'recipient');
        scheduledDateGroup.classList.toggle('hidden', getDeliveryDateOption() !== 'schedule');
        scheduledDateInput.disabled = getDeliveryDateOption() !== 'schedule';
    }

    function validateAmount() {
        const amount = getSelectedAmount();
        if (customAmountInput.value.trim() !== '') {
            if (!Number.isFinite(amount)) {
                return false;
            }
        }
        return amount >= 10 && amount <= 500;
    }

    function validateForm() {
        const amountValid = validateAmount();
        const deliveryOption = getDeliveryOption();
        const scheduledOption = getDeliveryDateOption();
        const scheduledDate = scheduledDateInput.value.trim();
        let valid = amountValid;

        if (deliveryOption === 'recipient') {
            valid = valid && recipientEmailInput.value.trim() !== '' && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(recipientEmailInput.value.trim());
        }

        if (scheduledOption === 'schedule') {
            valid = valid && scheduledDate !== '';
        }

        return valid;
    }

    function updateButtonState() {
        const valid = validateForm();
        submitButton.disabled = !valid;

        if (!valid) {
            submitButton.textContent = 'Add gift card to cart';
            errorMessage.classList.add('hidden');
            return;
        }

        submitButton.textContent = 'Add gift card to cart';
        errorMessage.classList.add('hidden');
    }

    function attachInputHandlers() {
        amountRadios.forEach((input) => {
            input.addEventListener('change', () => {
                if (customAmountInput.value.trim() !== '') {
                    customAmountInput.value = '';
                }
                updateAll();
            });
        });

        customAmountInput.addEventListener('input', updateAll);
        recipientNameInput.addEventListener('input', updateAll);
        senderNameInput.addEventListener('input', updateAll);
        messageInput.addEventListener('input', updateAll);
        recipientEmailInput.addEventListener('input', updateAll);
        deliveryOptionInputs.forEach((input) => input.addEventListener('change', () => {
            setVisibility();
            updateAll();
        }));
        deliveryDateInputs.forEach((input) => input.addEventListener('change', () => {
            setVisibility();
            updateAll();
        }));
    }

    function updateAll() {
        updatePreview();
        updateSummary();
        updateButtonState();
    }

    document.getElementById('giftcard-purchase-form').addEventListener('submit', function (event) {
        if (!validateForm()) {
            event.preventDefault();
            errorMessage.textContent = 'Please complete the form with a valid amount and recipient details.';
            errorMessage.classList.remove('hidden');
            return;
        }
    });

    setVisibility();
    attachInputHandlers();
    updateAll();
})();
</script>

<%- include('partials/footer') %>
