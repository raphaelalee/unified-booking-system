<%- include('partials/header', { title }) %>

<%
    const config = typeof giftCardConfig !== 'undefined' && giftCardConfig ? giftCardConfig : {};
    const giftAmounts = Array.isArray(config.amounts) ? config.amounts : [];
    const minGiftAmount = Number(config.minAmount || 0);
    const maxGiftAmount = Number(config.maxAmount || 0);
    const validityMonths = Number(config.validityMonths || 0);
    const giftTerms = Array.isArray(config.terms) ? config.terms : [];
    const defaultAmount = Number(giftAmounts[0] || minGiftAmount || 0);
%>

<section class="page-title giftcard-title">
    <p class="eyebrow">Gift Cards</p>
    <h1>Give someone their next self-care moment.</h1>
    <p>Vaniday gift cards can be used for beauty, salon, spa, and grooming appointments.</p>
</section>

<section class="section compact giftcard-page">
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="notice success"><%= success %></div>
    <% } %>

    <form id="giftcard-purchase-form" class="giftcard-checkout" action="/giftcards/add" method="POST">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <main class="giftcard-form-column">
            <section class="giftcard-step">
                <div class="giftcard-step-heading">
                    <span>01</span>
                    <div>
                        <strong>Gift value</strong>
                        <small>Pick one amount or enter a custom value.</small>
                    </div>
                </div>

                <div class="giftcard-step-content">
                    <% if (giftAmounts.length) { %>
                        <div class="giftcard-amount-options" role="radiogroup" aria-label="Gift card amount">
                            <% giftAmounts.forEach((amount) => { %>
                                <label class="giftcard-amount-choice">
                                    <input type="radio" name="amount" value="<%= Number(amount) %>" <%= Number(amount) === defaultAmount ? 'checked' : '' %>>
                                    <span>$<%= Number(amount).toFixed(0) %></span>
                                </label>
                            <% }) %>
                        </div>
                    <% } %>

                    <label class="giftcard-field custom-amount-field" for="custom-amount">
                        <span>Custom amount</span>
                        <input id="custom-amount" name="customAmount" type="number" min="<%= minGiftAmount %>" max="<%= maxGiftAmount %>" step="1" placeholder="$<%= minGiftAmount %> - $<%= maxGiftAmount %>" autocomplete="off">
                    </label>
                    <p class="giftcard-note">Minimum $<%= minGiftAmount %>, maximum $<%= maxGiftAmount %>.</p>
                </div>
            </section>

            <section class="giftcard-step">
                <div class="giftcard-step-heading">
                    <span>02</span>
                    <div>
                        <strong>Delivery</strong>
                        <small>Send to your email or directly to the recipient.</small>
                    </div>
                </div>

                <div class="giftcard-step-content">
                    <div class="giftcard-delivery-options">
                        <label class="giftcard-delivery-choice">
                            <input type="radio" name="deliveryOption" value="self" checked>
                            <span>
                                <strong>Send to my email</strong>
                                <small>Receive the gift card after payment.</small>
                            </span>
                        </label>
                        <label class="giftcard-delivery-choice">
                            <input type="radio" name="deliveryOption" value="recipient">
                            <span>
                                <strong>Send to recipient email</strong>
                                <small>Deliver it straight to them.</small>
                            </span>
                        </label>
                    </div>

                    <label class="giftcard-field hidden" id="recipient-email-group" for="recipient-email">
                        <span>Recipient email</span>
                        <input id="recipient-email" name="recipientEmail" type="email" placeholder="recipient@example.com">
                    </label>
                </div>
            </section>

            <section class="giftcard-step">
                <div class="giftcard-step-heading">
                    <span>03</span>
                    <div>
                        <strong>Personal details</strong>
                        <small>Add the names and message shown in the gift email.</small>
                    </div>
                </div>

                <div class="giftcard-step-content giftcard-detail-grid">
                    <label class="giftcard-field" for="recipient-name">
                        <span>Recipient name</span>
                        <input id="recipient-name" name="recipientName" type="text" placeholder="Recipient name">
                    </label>
                    <label class="giftcard-field" for="sender-name">
                        <span>Sender name</span>
                        <input id="sender-name" name="senderName" type="text" placeholder="Your name">
                    </label>
                    <label class="giftcard-field giftcard-message-field" for="message">
                        <span>Personalised message</span>
                        <textarea id="message" name="message" rows="4" placeholder="Add a note to make the gift special"></textarea>
                    </label>
                </div>
            </section>

            <p class="form-error hidden" id="giftcard-form-error" role="alert"></p>
            <span id="summary-amount" class="hidden">$<%= defaultAmount %></span>
        </main>

        <aside class="giftcard-summary-column">
            <div class="giftcard-preview-card">
                <div class="giftcard-preview-top">
                    <span class="giftcard-brand">Vaniday</span>
                    <span>Beauty Gift Card</span>
                </div>
                <strong class="giftcard-preview-amount" id="giftcard-preview-amount">$<%= defaultAmount %></strong>
                <p id="giftcard-preview-message">Write a short personalised message to make this gift extra special.</p>
                <div class="giftcard-preview-meta">
                    <span>
                        <small>Recipient</small>
                        <b id="giftcard-preview-recipient">Recipient Name</b>
                    </span>
                    <span>
                        <small>Voucher code</small>
                        <b id="giftcard-preview-code">VANI-XXXXXX</b>
                    </span>
                    <span>
                        <small>Validity</small>
                        <b><%= validityMonths %> months</b>
                    </span>
                </div>
            </div>

            <section class="giftcard-order-panel">
                <div class="giftcard-order-row">
                    <span>Total</span>
                    <strong id="summary-total">$<%= defaultAmount %></strong>
                </div>
                <div class="giftcard-order-row">
                    <span>Delivery</span>
                    <strong id="summary-delivery">Send to my email</strong>
                </div>
                <div class="giftcard-order-row">
                    <span>Recipient</span>
                    <strong id="summary-recipient">Not set</strong>
                </div>
                <button class="button primary full" type="submit" id="giftcard-submit-button" disabled>Add gift card to cart</button>
            </section>

            <section class="giftcard-terms-panel">
                <button class="giftcard-terms-toggle" type="button" aria-expanded="true" aria-controls="giftcard-terms-list">
                    Terms and conditions
                </button>
                <ul class="giftcard-terms" id="giftcard-terms-list">
                    <% giftTerms.forEach((term) => { %>
                        <li><%= term %></li>
                    <% }) %>
                </ul>
            </section>
        </aside>
    </form>
</section>

<style>
.giftcard-title {
    min-height: 170px !important;
}

.giftcard-page {
    width: min(1320px, calc(100% - 40px)) !important;
    max-width: none !important;
    padding: 34px 0 64px !important;
}

.giftcard-checkout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 44px;
    align-items: start;
}

.giftcard-form-column,
.giftcard-summary-column {
    min-width: 0;
}

.giftcard-form-column {
    display: grid;
    gap: 0;
}

.giftcard-step {
    padding: 26px 0;
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 34px;
    border-bottom: 1px solid rgba(39, 53, 35, 0.14);
}

.giftcard-step:first-child {
    padding-top: 0;
}

.giftcard-step-heading {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 12px;
    align-content: start;
}

.giftcard-step-heading > span {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(39, 53, 35, 0.22);
    color: #536e49;
    font-size: 0.76rem;
    font-weight: 900;
}

.giftcard-step-heading strong,
.giftcard-field span,
.giftcard-order-row strong,
.giftcard-preview-meta b {
    color: var(--sand-ink);
}

.giftcard-step-heading small,
.giftcard-note,
.giftcard-delivery-choice small,
.giftcard-order-row span,
.giftcard-preview-meta small,
.giftcard-terms {
    color: var(--sand-muted);
}

.giftcard-step-heading small {
    display: block;
    margin-top: 4px;
    font-size: 0.8rem;
    line-height: 1.45;
}

.giftcard-step-content {
    display: grid;
    gap: 16px;
}

.giftcard-amount-options {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid rgba(39, 53, 35, 0.15);
    border-width: 1px 0;
}

.giftcard-amount-choice {
    min-height: 64px;
    display: grid;
    place-items: center;
    cursor: pointer;
}

.giftcard-amount-choice + .giftcard-amount-choice {
    border-left: 1px solid rgba(39, 53, 35, 0.13);
}

.giftcard-amount-choice input,
.giftcard-delivery-choice input {
    position: absolute;
    opacity: 0;
}

.giftcard-amount-choice span {
    color: var(--sand-ink);
    font-size: 1rem;
    font-weight: 900;
}

.giftcard-amount-choice:has(input:checked),
.giftcard-delivery-choice:has(input:checked) {
    background: #f0f5ec;
    box-shadow: inset 0 -3px 0 #536e49;
}

.giftcard-field {
    display: grid;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 900;
}

.giftcard-field input,
.giftcard-field textarea {
    width: 100%;
    min-height: 44px;
    padding: 9px 0;
    border: 1px solid rgba(39, 53, 35, 0.24);
    border-width: 0 0 1px;
    border-radius: 0;
    background: transparent;
    color: var(--sand-ink);
}

.giftcard-field textarea {
    min-height: 104px;
    resize: vertical;
}

.giftcard-note {
    margin: -4px 0 0;
    font-size: 0.78rem;
}

.giftcard-delivery-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid rgba(39, 53, 35, 0.15);
    border-width: 1px 0;
}

.giftcard-delivery-choice {
    min-height: 78px;
    padding: 14px 0;
    display: grid;
    align-items: center;
    cursor: pointer;
}

.giftcard-delivery-choice + .giftcard-delivery-choice {
    padding-left: 18px;
    border-left: 1px solid rgba(39, 53, 35, 0.13);
}

.giftcard-delivery-choice span {
    display: grid;
    gap: 3px;
}

.giftcard-delivery-choice strong {
    color: var(--sand-ink);
}

.giftcard-delivery-choice small {
    font-size: 0.78rem;
}

.giftcard-detail-grid {
    grid-template-columns: 1fr 1fr;
}

.giftcard-message-field {
    grid-column: 1 / -1;
}

.giftcard-summary-column {
    position: sticky;
    top: 92px;
    display: grid;
    gap: 18px;
}

.giftcard-preview-card {
    min-height: 290px;
    padding: 24px;
    display: grid;
    align-content: space-between;
    gap: 22px;
    background: #314c36;
    color: #fffef8;
}

.giftcard-preview-top,
.giftcard-preview-meta {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: start;
}

.giftcard-brand {
    font-family: Georgia, serif;
    font-size: 1.28rem;
}

.giftcard-preview-top span:last-child,
.giftcard-preview-meta small {
    color: rgba(255, 254, 248, 0.72);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
}

.giftcard-preview-amount {
    color: #fffef8;
    font-size: 3.25rem;
    line-height: 1;
}

.giftcard-preview-card p {
    margin: 0;
    color: rgba(255, 254, 248, 0.86);
    line-height: 1.55;
}

.giftcard-preview-meta span {
    display: grid;
    gap: 4px;
}

.giftcard-preview-meta b {
    color: #fffef8;
    font-size: 0.84rem;
}

.giftcard-order-panel,
.giftcard-terms-panel {
    padding-top: 18px;
    border-top: 1px solid rgba(39, 53, 35, 0.16);
}

.giftcard-order-panel {
    display: grid;
    gap: 12px;
}

.giftcard-order-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
}

.giftcard-order-row span {
    font-size: 0.76rem;
    font-weight: 900;
    text-transform: uppercase;
}

.giftcard-order-row strong {
    text-align: right;
}

.giftcard-order-panel .button {
    margin-top: 6px;
}

.giftcard-terms-toggle {
    width: 100%;
    padding: 0 0 12px;
    border: 0;
    background: transparent;
    color: var(--sand-ink);
    font-weight: 900;
    text-align: left;
}

.giftcard-terms {
    margin: 0;
    padding-left: 18px;
    line-height: 1.65;
    font-size: 0.86rem;
}

.form-error {
    margin: 16px 0 0;
    color: #9d2c2c;
    font-size: 0.92rem;
}

.hidden {
    display: none !important;
}

@media (max-width: 1040px) {
    .giftcard-checkout {
        grid-template-columns: 1fr;
    }

    .giftcard-summary-column {
        position: static;
        grid-row: 1;
    }
}

@media (max-width: 720px) {
    .giftcard-page {
        width: min(100% - 28px, 1320px) !important;
    }

    .giftcard-step,
    .giftcard-detail-grid,
    .giftcard-delivery-options {
        grid-template-columns: 1fr;
    }

    .giftcard-step {
        gap: 18px;
    }

    .giftcard-amount-options {
        grid-template-columns: 1fr 1fr;
    }

    .giftcard-amount-choice + .giftcard-amount-choice,
    .giftcard-delivery-choice + .giftcard-delivery-choice {
        padding-left: 0;
        border-left: 0;
        border-top: 1px solid rgba(39, 53, 35, 0.13);
    }

    .giftcard-preview-top,
    .giftcard-preview-meta {
        display: grid;
    }
}
</style>

<script>
(function () {
    const amountRadios = Array.from(document.querySelectorAll('input[name="amount"]'));
    const customAmountInput = document.getElementById('custom-amount');
    const recipientEmailGroup = document.getElementById('recipient-email-group');
    const recipientEmailInput = document.getElementById('recipient-email');
    const recipientNameInput = document.getElementById('recipient-name');
    const senderNameInput = document.getElementById('sender-name');
    const messageInput = document.getElementById('message');
    const deliveryOptionInputs = Array.from(document.querySelectorAll('input[name="deliveryOption"]'));
    const previewAmount = document.getElementById('giftcard-preview-amount');
    const previewRecipient = document.getElementById('giftcard-preview-recipient');
    const previewMessage = document.getElementById('giftcard-preview-message');
    const summaryAmount = document.getElementById('summary-amount');
    const summaryDelivery = document.getElementById('summary-delivery');
    const summaryRecipient = document.getElementById('summary-recipient');
    const summaryTotal = document.getElementById('summary-total');
    const submitButton = document.getElementById('giftcard-submit-button');
    const errorMessage = document.getElementById('giftcard-form-error');
    const previewCode = document.getElementById('giftcard-preview-code');
    const termsToggle = document.querySelector('.giftcard-terms-toggle');
    const termsList = document.getElementById('giftcard-terms-list');
    const minAmount = Number(customAmountInput.min || 10);
    const maxAmount = Number(customAmountInput.max || 500);

    const formatCurrency = (value) => '$' + Number(value || 0).toFixed(0);

    function getSelectedAmount() {
        const customValue = Number(customAmountInput.value || '0');
        if (customAmountInput.value.trim() !== '') {
            return customValue;
        }

        const selected = amountRadios.find((input) => input.checked);
        return selected ? Number(selected.value) : 0;
    }

    function getDeliveryOption() {
        return deliveryOptionInputs.find((input) => input.checked)?.value || 'self';
    }

    function updatePreview() {
        const amount = getSelectedAmount();
        previewAmount.textContent = formatCurrency(amount || <%= defaultAmount %>);
        previewRecipient.textContent = recipientNameInput.value.trim() || 'Recipient Name';
        previewMessage.textContent = messageInput.value.trim() || 'Write a short personalised message to make this gift extra special.';
        previewCode.textContent = 'VANI-XXXXXX';
    }

    function updateSummary() {
        const amount = getSelectedAmount();
        const deliveryOption = getDeliveryOption();
        const recipientName = recipientNameInput.value.trim();
        const recipientEmail = recipientEmailInput.value.trim();

        summaryAmount.textContent = formatCurrency(amount || <%= defaultAmount %>);
        summaryTotal.textContent = formatCurrency(amount || <%= defaultAmount %>);
        summaryDelivery.textContent = deliveryOption === 'recipient' ? 'Send to recipient email' : 'Send to my email';
        summaryRecipient.textContent = recipientName || recipientEmail || 'Not set';
    }

    function setVisibility() {
        const recipientDelivery = getDeliveryOption() === 'recipient';
        recipientEmailGroup.classList.toggle('hidden', !recipientDelivery);
        recipientEmailInput.disabled = !recipientDelivery;
    }

    function validateAmount() {
        const amount = getSelectedAmount();
        return Number.isFinite(amount) && amount >= minAmount && amount <= maxAmount;
    }

    function validateForm() {
        const deliveryOption = getDeliveryOption();
        let valid = validateAmount();

        if (deliveryOption === 'recipient') {
            valid = valid && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(recipientEmailInput.value.trim());
        }

        return valid;
    }

    function updateButtonState() {
        submitButton.disabled = !validateForm();
        errorMessage.classList.add('hidden');
    }

    function updateAll() {
        setVisibility();
        updatePreview();
        updateSummary();
        updateButtonState();
    }

    amountRadios.forEach((input) => {
        input.addEventListener('change', () => {
            if (customAmountInput.value.trim() !== '') {
                customAmountInput.value = '';
            }
            updateAll();
        });
    });
    [
        customAmountInput,
        recipientEmailInput,
        recipientNameInput,
        senderNameInput,
        messageInput,
        ...deliveryOptionInputs
    ].forEach((input) => input.addEventListener('input', updateAll));
    deliveryOptionInputs.forEach((input) => input.addEventListener('change', updateAll));

    if (termsToggle && termsList) {
        termsToggle.addEventListener('click', function () {
            const expanded = termsToggle.getAttribute('aria-expanded') === 'true';
            termsToggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
            termsList.hidden = expanded;
        });
    }

    document.getElementById('giftcard-purchase-form').addEventListener('submit', function (event) {
        if (!validateForm()) {
            event.preventDefault();
            errorMessage.textContent = 'Please complete the form with a valid amount and recipient details.';
            errorMessage.classList.remove('hidden');
        }
    });

    updateAll();
})();
</script>

<%- include('partials/footer') %>
