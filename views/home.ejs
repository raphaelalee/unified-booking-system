<%- include('partials/header', { title }) %>

<%
    const serviceSearch = typeof search !== 'undefined' ? search : '';
    const serviceMerchants = Array.isArray(merchants) && merchants.length > 0
        ? merchants
        : [
            {
                id: 1,
                name: 'Vaniday Beauty Studio',
                category: 'Beauty & Wellness',
                location: 'Orchard',
                rating: '4.8',
                promotion: '20% off first booking',
                description: 'Facials, hair styling, and beauty treatments with simple digital booking.'
            },
            {
                id: 2,
                name: 'FreshGlow Spa',
                category: 'Spa',
                location: 'Tampines',
                rating: '4.6',
                promotion: 'Free add-on massage above $80',
                description: 'Relaxing spa and massage sessions with clear appointment slots.'
            },
            {
                id: 3,
                name: 'Urban Groom Barbers',
                category: 'Grooming',
                location: 'Woodlands',
                rating: '4.7',
                promotion: '$5 student discount',
                description: 'Fast grooming services with QR booking and digital receipts.'
            }
        ];
    const stats = typeof portalStats !== 'undefined' ? portalStats : {
        merchantCount: serviceMerchants.length,
        serviceCount: 0,
        promotionCount: 0,
        slotCount: 0,
        startingPrice: 0
    };
    const allServices = Array.isArray(serviceCatalog) && serviceCatalog.length > 0
        ? serviceCatalog
        : serviceMerchants.flatMap((merchant) => {
            const fallbackServices = Array.isArray(merchant.services) && merchant.services.length > 0
                ? merchant.services
                : [{ id: `${merchant.id}-featured`, name: merchant.category || 'Beauty Service', duration: '45 mins', price: 35 }];

            return fallbackServices.map((service) => ({
                ...service,
                merchantId: merchant.id,
                merchantName: merchant.name,
                merchantLocation: merchant.location,
                merchantCategory: merchant.category,
                merchantRating: merchant.rating,
                merchantPromotion: merchant.promotion,
                serviceBookingPath: `/merchants/${merchant.id}`
            }));
        });
    const filteredServices = serviceSearch
        ? allServices.filter((service) => {
            const text = [
                service.name,
                service.duration,
                service.price,
                service.merchantName,
                service.merchantLocation,
                service.merchantCategory,
                service.merchantPromotion
            ].join(' ').toLowerCase();

            return text.includes(serviceSearch.toLowerCase());
        })
        : allServices;
    const formatPrice = (value) => `$${Number(value || 0).toFixed(0)}`;
    const getBookingHref = (service) => service.serviceBookingPath || `/merchants/${service.merchantId || ''}`;
    const popularServices = [
        {
            title: 'Facial Treatment',
            category: 'Facial',
            copy: 'Hydration, cleansing, glow care, and skin recovery sessions.',
            imageClass: 'home-service-facial',
            href: '/services?search=facial'
        },
        {
            title: 'Hair Salon',
            category: 'Hair',
            copy: 'Cuts, colouring, blowouts, scalp care, and styling appointments.',
            imageClass: 'home-service-hair',
            href: '/services?search=hair'
        },
        {
            title: 'Spa & Massage',
            category: 'Spa',
            copy: 'Body care, aromatherapy massage, scrubs, wraps, and wellness time.',
            imageClass: 'home-service-spa',
            href: '/services?search=spa'
        },
        {
            title: 'Nails',
            category: 'Nails',
            copy: 'Manicures, pedicures, gel polish, and hand care treatments.',
            imageClass: 'home-service-nails',
            href: '/services?search=nails'
        },
        {
            title: 'Grooming',
            category: 'Grooming',
            copy: 'Haircuts, shaves, beard trims, and quick grooming sessions.',
            imageClass: 'home-service-grooming',
            href: '/services?search=grooming'
        }
    ];
    const benefitCards = [
        ['All merchants in one platform', 'Compare salons, spas, grooming, and wellness merchants without switching apps.'],
        ['Easy booking without calling', 'Choose services, dates, and times online instead of waiting for replies.'],
        ['Rewards, cashback, and promotions', 'Use offers, collect points, and keep your beauty spending visible.'],
        ['QR check-in and digital receipts', 'Receive confirmation, QR access, and receipts after booking or checkout.']
    ];
    const promotionCards = serviceMerchants
        .filter((merchant) => merchant.promotion)
        .slice(0, 3)
        .map((merchant) => ({
            title: merchant.promotion,
            merchantName: merchant.name,
            discount: merchant.promotion.match(/\d+%|\$\d+/)?.[0] || 'Special offer',
            expiry: 'Limited availability',
            href: `/merchants/${merchant.id}?from=home-promo`
        }));
    const safePromotions = promotionCards.length > 0
        ? promotionCards
        : [
            { title: 'First Trial Glow', merchantName: 'Vaniday partners', discount: '20%', expiry: 'This month', href: '/promotions' },
            { title: 'Happy Hour Wellness', merchantName: 'Selected spas', discount: '15%', expiry: 'Weekdays', href: '/promotions' },
            { title: 'Beauty Rewards Boost', merchantName: 'Vaniday', discount: '2x points', expiry: 'Ongoing', href: '/reward-shop' }
        ];
    const recommendedMerchants = (Array.isArray(featuredMerchants) && featuredMerchants.length > 0 ? featuredMerchants : serviceMerchants).slice(0, 6);
    const featuredServiceItems = (Array.isArray(featuredServices) && featuredServices.length > 0 ? featuredServices : filteredServices.slice(0, 5));
    const featuredProductItems = Array.isArray(featuredProducts) ? featuredProducts : [];
    const featuredMonthMerchant = typeof featuredMerchantOfMonth !== 'undefined' ? featuredMerchantOfMonth : null;
    const trendingMerchantItems = Array.isArray(trendingMerchants) ? trendingMerchants : [];
    const heroSlides = [
        {
            kicker: 'Hair salon',
            title: 'Fresh cuts, colour, and styling',
            copy: 'Compare salon services and reserve your next appointment without calling.',
            imageClass: 'home-hero-slide-hair',
            meta: 'From $35'
        },
        {
            kicker: 'Spa retreat',
            title: 'Body care for slower days',
            copy: 'Find massages, scrubs, aromatherapy sessions, and wellness offers nearby.',
            imageClass: 'home-hero-slide-spa',
            meta: `${stats.promotionCount || safePromotions.length} live offers`
        },
        {
            kicker: 'Facial studio',
            title: 'Glow treatments with rewards',
            copy: 'Book facials, earn points, and keep receipts neatly in one Vaniday account.',
            imageClass: 'home-hero-slide-facial',
            meta: `${stats.slotCount} open slots`
        }
    ];
    const carouselCards = [
        ...recommendedMerchants.slice(0, 3).map((merchant, index) => ({
            type: 'Merchant',
            title: merchant.name,
            copy: merchant.description || `${merchant.category || 'Beauty'} merchant in ${merchant.location || 'Singapore'}.`,
            meta: `${merchant.location || 'Singapore'} - Rating ${merchant.rating || 'New'}`,
            href: `/merchants/${merchant.id}?from=home-carousel`,
            cta: 'View',
            imageClass: `home-merchant-${(index % 3) + 1}`
        })),
        ...featuredServiceItems.slice(0, 2).map((service, index) => ({
            type: 'Service',
            title: service.name,
            copy: `${service.merchantName || 'Vaniday merchant'} - ${service.duration || 'Flexible timing'}`,
            meta: `From ${formatPrice(service.price)}`,
            href: getBookingHref(service),
            cta: 'Book',
            imageClass: index === 0 ? 'home-service-facial' : 'home-service-spa'
        }))
    ].slice(0, 5);
%>

<section class="hero vaniday-home-hero">
    <div class="hero-content vaniday-home-hero-copy">
        <p class="eyebrow">Beauty, wellness, and rewards</p>
        <h1>Vaniday</h1>
        <p class="home-hero-tagline">Book salons, spas, grooming services, promotions and rewards in one place.</p>
        <p class="hero-text">
            Find merchants, compare services, book appointments, earn rewards, and receive QR check-in with digital receipts.
        </p>
        <div class="hero-actions">
            <a class="button primary" href="/services">Explore Services</a>
            <a class="button secondary" href="/merchants">View Merchants</a>
            <a class="button secondary" href="/services#service-catalog">Book Now</a>
        </div>
        <div class="home-hero-stats" aria-label="Vaniday platform summary">
            <span><strong><%= stats.merchantCount %></strong> merchants</span>
            <span><strong><%= stats.serviceCount || filteredServices.length %></strong> services</span>
            <span><strong><%= stats.slotCount %></strong> open slots</span>
        </div>
    </div>
    <div class="hero-visual vaniday-home-visual" data-home-hero-carousel aria-label="Salon and wellness highlights">
        <div class="home-hero-carousel-track">
            <% heroSlides.forEach((slide, index) => { %>
                <article class="home-hero-slide <%= slide.imageClass %> <%= index === 0 ? 'is-active' : '' %>" data-home-hero-slide>
                    <div class="home-hero-slide-copy" aria-hidden="true">
                        <span><%= slide.kicker %></span>
                        <h2><%= slide.title %></h2>
                        <p><%= slide.copy %></p>
                    </div>
                </article>
            <% }) %>
        </div>
        <div class="home-hero-carousel-controls">
            <button type="button" data-home-hero-prev aria-label="Previous salon highlight">&lsaquo;</button>
            <div class="home-hero-carousel-dots" aria-label="Salon highlight position">
                <% heroSlides.forEach((slide, index) => { %>
                    <button type="button" class="<%= index === 0 ? 'is-active' : '' %>" data-home-hero-dot="<%= index %>" aria-label="Go to salon highlight <%= index + 1 %>"></button>
                <% }) %>
            </div>
            <button type="button" data-home-hero-next aria-label="Next salon highlight">&rsaquo;</button>
        </div>
    </div>
</section>

<% if (success) { %>
    <section class="notice success home-notice">
        <%= success %>
    </section>
<% } %>

<section class="home-search-band" aria-label="Search Vaniday">
    <div>
        <p class="eyebrow">Find your appointment</p>
        <h2>Search services, merchants, location, or price.</h2>
    </div>
    <form class="home-search-form" action="/services" method="GET">
        <label>
            <span>Service or merchant</span>
            <input type="search" name="search" value="<%= serviceSearch %>" placeholder="Facial, spa, Orchard...">
        </label>
        <label>
            <span>Category</span>
            <select name="category">
                <option value="">Any category</option>
                <option value="facial">Facial</option>
                <option value="hair">Hair</option>
                <option value="spa">Spa</option>
                <option value="nails">Nails</option>
                <option value="grooming">Grooming</option>
            </select>
        </label>
        <label>
            <span>Max price</span>
            <select name="maxPrice">
                <option value="">Any price</option>
                <option value="50">Under $50</option>
                <option value="80">Under $80</option>
                <option value="120">Under $120</option>
            </select>
        </label>
        <button class="button primary" type="submit">Search</button>
    </form>
</section>

<section class="home-section home-featured-section" aria-label="Featured carousel">
    <div class="home-section-heading">
        <div>
            <p class="eyebrow">Featured now</p>
            <h2>Recommended picks for your next visit.</h2>
        </div>
        <div class="home-carousel-controls">
            <button type="button" data-home-carousel-prev aria-label="Previous featured item">&lsaquo;</button>
            <button type="button" data-home-carousel-next aria-label="Next featured item">&rsaquo;</button>
        </div>
    </div>

    <div class="home-carousel" data-home-carousel>
        <div class="home-carousel-track" data-home-carousel-track>
            <% carouselCards.forEach((card) => { %>
                <article class="home-carousel-card">
                    <div class="home-card-image <%= card.imageClass %>" aria-hidden="true"></div>
                    <div class="home-card-body">
                        <span class="home-card-kicker"><%= card.type %></span>
                        <h3><%= card.title %></h3>
                        <p><%= card.copy %></p>
                        <div class="home-card-footer">
                            <strong><%= card.meta %></strong>
                            <a class="button secondary" href="<%= card.href %>"><%= card.cta %></a>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>
        <div class="home-carousel-dots" data-home-carousel-dots aria-label="Featured carousel position">
            <% carouselCards.forEach((card, index) => { %>
                <button type="button" class="<%= index === 0 ? 'is-active' : '' %>" data-home-carousel-dot="<%= index %>" aria-label="Go to featured item <%= index + 1 %>"></button>
            <% }) %>
        </div>
    </div>
</section>

<% if (featuredMonthMerchant) { %>
    <section class="home-section">
        <div class="home-section-heading">
            <div>
                <p class="eyebrow">Featured Salon of the Month</p>
                <h2>🏆 <%= featuredMonthMerchant.name %></h2>
            </div>
            <a class="button secondary" href="/merchants/<%= featuredMonthMerchant.id %>?from=home">View merchant</a>
        </div>
        <p><%= featuredMonthMerchant.description || `${featuredMonthMerchant.category || 'Beauty'} merchant in ${featuredMonthMerchant.location || 'Singapore'}.` %></p>
    </section>
<% } %>

<% if (featuredServiceItems.length > 0) { %>
    <section class="home-section">
        <div class="home-section-heading">
            <div>
                <p class="eyebrow">Featured Services</p>
                <h2>Services getting extra marketplace visibility.</h2>
            </div>
            <a class="button secondary" href="/services">View all services</a>
        </div>
        <div class="storefront-product-strip">
            <% featuredServiceItems.slice(0, 4).forEach((service) => { %>
                <article>
                    <span class="tag">⭐ Featured Service</span>
                    <h3><%= service.name %></h3>
                    <p class="muted"><%= service.merchantName %> · <%= service.duration %></p>
                    <a class="button secondary" href="<%= getBookingHref(service) %>">Book</a>
                </article>
            <% }) %>
        </div>
    </section>
<% } %>

<% if (featuredProductItems.length > 0) { %>
    <section class="home-section">
        <div class="home-section-heading">
            <div>
                <p class="eyebrow">Featured Products</p>
                <h2>Merchant aftercare picks.</h2>
            </div>
            <a class="button secondary" href="/products">Shop products</a>
        </div>
        <div class="storefront-product-strip">
            <% featuredProductItems.slice(0, 4).forEach((product) => { %>
                <article>
                    <span class="tag">⭐ Featured Product</span>
                    <h3><%= product.name %></h3>
                    <p class="muted"><%= product.salonName || 'Vaniday merchant' %></p>
                    <div>
                        <strong>$<%= Number(product.price || 0).toFixed(2) %></strong>
                        <a class="button secondary" href="/products/<%= product.id %>">View</a>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>
<% } %>

<% if (trendingMerchantItems.length > 0) { %>
    <section class="home-section">
        <div class="home-section-heading">
            <div>
                <p class="eyebrow">Trending Merchants</p>
                <h2>🔥 Merchants with current featured momentum.</h2>
            </div>
            <a class="button secondary" href="/merchants">View merchants</a>
        </div>
        <div class="storefront-product-strip">
            <% trendingMerchantItems.slice(0, 4).forEach((merchant) => { %>
                <article>
                    <span class="tag">🔥 Trending Merchant</span>
                    <h3><%= merchant.name %></h3>
                    <p class="muted"><%= merchant.location || 'Singapore' %></p>
                    <a class="button secondary" href="/merchants/<%= merchant.id %>?from=home">View</a>
                </article>
            <% }) %>
        </div>
    </section>
<% } %>

<section class="home-section">
    <div class="home-section-heading">
        <div>
            <p class="eyebrow">Popular services</p>
            <h2>Browse by care type.</h2>
        </div>
        <a class="button secondary" href="/services">View All Services</a>
    </div>

    <div class="home-service-grid">
        <% popularServices.forEach((service) => { %>
            <article class="home-service-card">
                <div class="home-card-image <%= service.imageClass %>" aria-hidden="true"></div>
                <div class="home-card-body">
                    <span class="home-card-kicker"><%= service.category %></span>
                    <h3><%= service.title %></h3>
                    <p><%= service.copy %></p>
                    <a class="button secondary" href="<%= service.href %>">Explore</a>
                </div>
            </article>
        <% }) %>
    </div>
</section>

<section class="home-section home-benefits-section">
    <div class="home-section-heading">
        <div>
            <p class="eyebrow">Why choose Vaniday</p>
            <h2>Everything around the appointment, handled neatly.</h2>
        </div>
    </div>
    <div class="home-benefit-grid">
        <% benefitCards.forEach((benefit, index) => { %>
            <article class="home-benefit-card">
                <span><%= index + 1 %></span>
                <h3><%= benefit[0] %></h3>
                <p><%= benefit[1] %></p>
            </article>
        <% }) %>
    </div>
</section>

<section class="home-section">
    <div class="home-section-heading">
        <div>
            <p class="eyebrow">Promotions</p>
            <h2>Offers worth checking before you book.</h2>
        </div>
        <a class="button secondary" href="/promotions">All Promotions</a>
    </div>

    <div class="home-promo-grid">
        <% safePromotions.forEach((promo) => { %>
            <article class="home-promo-card">
                <span class="home-card-kicker"><%= promo.merchantName %></span>
                <h3><%= promo.title %></h3>
                <strong><%= promo.discount %></strong>
                <p><%= promo.expiry %></p>
                <a class="button primary" href="<%= promo.href %>">Use Promo</a>
            </article>
        <% }) %>
    </div>
</section>

<section class="home-section home-how-section">
    <div class="home-section-heading">
        <div>
            <p class="eyebrow">How it works</p>
            <h2>Book in three simple steps.</h2>
        </div>
    </div>
    <div class="home-step-grid">
        <article>
            <span>1</span>
            <h3>Search services or merchants</h3>
            <p>Compare care types, location, promotions, ratings, and starting prices.</p>
        </article>
        <article>
            <span>2</span>
            <h3>Choose date and time</h3>
            <p>Pick an available appointment slot from the service booking page.</p>
        </article>
        <article>
            <span>3</span>
            <h3>Book and receive confirmation</h3>
            <p>Get your booking confirmation, QR receipt, and appointment details.</p>
        </article>
    </div>
</section>

<section class="home-section">
    <div class="home-section-heading">
        <div>
            <p class="eyebrow">Recommended merchants</p>
            <h2>Trusted places to start with.</h2>
        </div>
        <a class="button secondary" href="/merchants">View Merchant Directory</a>
    </div>

    <div class="home-merchant-grid">
        <% recommendedMerchants.forEach((merchant, index) => { %>
            <article class="home-merchant-card">
                <div class="home-card-image home-merchant-<%= (index % 3) + 1 %>" aria-hidden="true"></div>
                <div class="home-card-body">
                    <span class="home-card-kicker"><%= merchant.category || 'Beauty & Wellness' %></span>
                    <h3><%= merchant.name %></h3>
                    <p><%= merchant.location || 'Singapore' %> - Rating <%= merchant.rating || 'New' %></p>
                    <p><%= merchant.description || 'Book beauty and wellness services through Vaniday.' %></p>
                    <a class="button secondary" href="/merchants/<%= merchant.id %>?from=home-recommended">View Merchant</a>
                </div>
            </article>
        <% }) %>
    </div>
</section>

<script>
    (() => {
        const heroCarousel = document.querySelector('[data-home-hero-carousel]');
        const heroSlides = Array.from(document.querySelectorAll('[data-home-hero-slide]'));
        const heroDots = Array.from(document.querySelectorAll('[data-home-hero-dot]'));
        const heroPrevious = document.querySelector('[data-home-hero-prev]');
        const heroNext = document.querySelector('[data-home-hero-next]');
        let heroActiveIndex = 0;
        let heroTimer;

        const setHeroActive = (index) => {
            if (!heroCarousel || heroSlides.length === 0 || heroDots.length === 0) {
                return;
            }

            heroActiveIndex = (index + heroSlides.length) % heroSlides.length;
            heroSlides.forEach((slide, slideIndex) => {
                slide.classList.toggle('is-active', slideIndex === heroActiveIndex);
            });
            heroDots.forEach((dot, dotIndex) => {
                dot.classList.toggle('is-active', dotIndex === heroActiveIndex);
            });
        };

        const restartHeroTimer = () => {
            window.clearInterval(heroTimer);
            heroTimer = window.setInterval(() => setHeroActive(heroActiveIndex + 1), 5200);
        };

        if (heroCarousel && heroSlides.length > 1) {
            heroPrevious?.addEventListener('click', () => {
                setHeroActive(heroActiveIndex - 1);
                restartHeroTimer();
            });
            heroNext?.addEventListener('click', () => {
                setHeroActive(heroActiveIndex + 1);
                restartHeroTimer();
            });
            heroDots.forEach((dot, index) => {
                dot.addEventListener('click', () => {
                    setHeroActive(index);
                    restartHeroTimer();
                });
            });
            restartHeroTimer();
        }

        const carousel = document.querySelector('[data-home-carousel]');
        const track = document.querySelector('[data-home-carousel-track]');
        const dots = Array.from(document.querySelectorAll('[data-home-carousel-dot]'));
        const previous = document.querySelector('[data-home-carousel-prev]');
        const next = document.querySelector('[data-home-carousel-next]');

        if (!carousel || !track || dots.length === 0) {
            return;
        }

        let activeIndex = 0;

        const setActive = (index) => {
            activeIndex = (index + dots.length) % dots.length;
            const firstCard = track.querySelector('.home-carousel-card');
            const gap = 16;
            const cardWidth = firstCard ? firstCard.getBoundingClientRect().width + gap : 0;
            track.scrollTo({ left: cardWidth * activeIndex, behavior: 'smooth' });
            dots.forEach((dot, dotIndex) => {
                dot.classList.toggle('is-active', dotIndex === activeIndex);
            });
        };

        previous?.addEventListener('click', () => setActive(activeIndex - 1));
        next?.addEventListener('click', () => setActive(activeIndex + 1));
        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => setActive(index));
        });
    })();
</script>

<%- include('partials/footer') %>
