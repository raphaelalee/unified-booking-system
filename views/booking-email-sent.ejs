<%- include('partials/header', { title }) %>

<section class="page-title">
    <p class="eyebrow">Booking confirmed</p>
    <h1><%= emailSkipped ? 'Booking created.' : 'Confirmation sent.' %></h1>
    <% if (emailSkipped) { %>
        <p>Your booking was created. Use the check-in QR code shown below for your appointment.</p>
    <% } else { %>
        <p>
            We have sent your booking confirmation to <strong><%= booking.email %></strong>.
            Your check-in QR code is in the email.
        </p>
    <% } %>
    <% if (emailSkipped) { %>
        <div class="notice">
            <p>Email sending is not configured or Gmail rejected the SMTP login. Your booking was still created.</p>
        </div>
    <% } %>
    <div class="hero-actions">
        <% const receiptPath = booking.receiptPath || `/receipt/${encodeURIComponent(booking.id)}`; %>
        <% if (currentUser) { %>
            <a class="button primary" href="/profile">View my bookings</a>
        <% } %>
        <a class="button secondary" href="<%= receiptPath %>">View Receipt</a>
        <a class="button secondary" href="<%= receiptPath.replace(`/receipt/${encodeURIComponent(booking.id)}`, `/receipt/${encodeURIComponent(booking.id)}/google-calendar`) %>" target="_blank" rel="noopener">Add to Google Calendar</a>
        <a class="button secondary" href="<%= receiptPath.replace(`/receipt/${encodeURIComponent(booking.id)}`, `/receipt/${encodeURIComponent(booking.id)}/pdf`) %>">Download Receipt</a>
        <a class="button secondary" href="/services">Book another service</a>
    </div>
</section>

<section class="section compact receipt-section">
    <div class="receipt-layout">
        <article class="receipt-card">
            <div class="receipt-meta-grid">
                <p><span>Booking ID</span><strong><%= booking.displayReference || ('#' + booking.id) %></strong></p>
                <p><span>Service</span><strong><%= booking.serviceName %></strong></p>
                <% if (booking.purchaseType === 'package') { %>
                    <p><span>Package price</span><strong>$<%= Number(booking.servicePrice || 0).toFixed(2) %></strong></p>
                <% } %>
                <p><span>Merchant</span><strong><%= booking.merchantName %></strong></p>
                <p>
                    <span>Date/time</span>
                    <strong><%= booking.appointmentLabel || booking.bookingDate %></strong>
                </p>
            </div>
            <p class="muted">
                <% if (currentUser) { %>
                    This receipt is also available from your profile.
                <% } else { %>
                    Save this page or keep the confirmation email. Guest bookings are not attached to an account.
                <% } %>
            </p>
            <div class="hero-actions">
                <a class="button secondary" href="<%= receiptPath %>">View Receipt</a>
                <a class="button secondary" href="<%= receiptPath.replace(`/receipt/${encodeURIComponent(booking.id)}`, `/receipt/${encodeURIComponent(booking.id)}/pdf`) %>">Download Receipt</a>
                <a class="button secondary" href="<%= receiptPath.replace(`/receipt/${encodeURIComponent(booking.id)}`, `/receipt/${encodeURIComponent(booking.id)}/calendar.ics`) %>">Download Calendar</a>
            </div>
        </article>

        <aside class="receipt-qr-panel">
            <p class="eyebrow">Scan to Check In</p>
            <img class="qr-code" src="<%= booking.qrCodeDataUrl %>" alt="Check-in QR code for booking <%= booking.id %>">
            <p class="muted"><%= emailSkipped ? 'Use this dynamic QR when checking in.' : 'This is the same attendance QR included in your booking email.' %></p>
            <a class="qr-link" href="<%= booking.checkinUrl %>"><%= booking.checkinUrl %></a>
            <% if (showQrDebug) { %>
                <div class="qr-debug-panel">
                    <p class="eyebrow">QR Debug</p>
                    <p class="muted"><strong>System:</strong> booking-check-in</p>
                    <p class="muted"><strong>Token:</strong> <%= booking.checkinToken %></p>
                    <p class="muted"><strong>Route target:</strong> /checking/<%= booking.checkinToken %></p>
                </div>
            <% } %>
        </aside>
    </div>
</section>

<%- include('partials/footer') %>
