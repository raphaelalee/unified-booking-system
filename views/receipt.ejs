<%- include('partials/header', { title }) %>

<%
    const safeViewerRole = typeof viewerRole !== 'undefined' ? viewerRole : 'customer';
    const returnPath = safeViewerRole === 'admin' ? '/admin/bookings' : (safeViewerRole === 'merchant' ? '/merchant/schedule' : '/services');
    const returnLabel = safeViewerRole === 'admin' ? 'Back to admin' : (safeViewerRole === 'merchant' ? 'Back to schedule' : 'Continue browsing');
%>

<section class="page-title receipt-title">
    <p class="eyebrow"><%= isBooking ? 'Booking receipt' : 'Product receipt' %></p>
    <h1>Receipt #<%= receipt.displayId || receipt.id %></h1>
    <% if (isBooking) { %>
        <p>
            <strong><%= receipt.userName %></strong> booked
            <strong><%= receipt.items[0]?.name || 'a service' %></strong>.
            Status: <strong><%= receipt.status %></strong>.
            <% if (receipt.bookingDate || receipt.bookingTime) { %>
                Appointment: <strong><%= receipt.bookingDate || '' %><%= receipt.bookingTime ? ` at ${receipt.bookingTime}` : '' %></strong>.
            <% } %>
        </p>
    <% } else { %>
        <p>
            <strong><%= receipt.userName %></strong> paid
            <strong>$<%= Number(receipt.totalAmount || 0).toFixed(2) %></strong>
            by <strong><%= receipt.paymentMethod %></strong>.
            <% if (Number(receipt.cashbackRedeemed || 0) > 0) { %>
                Cashback used: <strong>$<%= Number(receipt.cashbackRedeemed || 0).toFixed(2) %></strong>.
            <% } %>
            <% if (isProductPickup) { %>
                Fulfilment: <strong><%= fulfilmentLabel %></strong>.
            <% } %>
        </p>
    <% } %>
    <% if (!pdfMode) { %>
        <div class="hero-actions">
            <a class="button primary" href="/receipt/<%= encodeURIComponent(receipt.id) %>/pdf">Download PDF</a>
            <% if (safeViewerRole === 'customer') { %>
                <a class="button secondary" href="<%= supportRequestPath %>">Need help</a>
            <% } %>
            <a class="button secondary" href="<%= returnPath %>"><%= returnLabel %></a>
        </div>
    <% } %>
</section>

<section class="section compact receipt-section">
    <div class="receipt-layout">
        <article class="receipt-card">
            <% if (lastPaymentHighlight && lastPaymentHighlight.loyaltyAward && lastPaymentHighlight.loyaltyAward.awarded) { %>
                <div class="notice <%= lastPaymentHighlight.loyaltyAward.birthdayApplied ? 'success' : '' %>">
                    <p>
                        You earned <strong><%= Number(lastPaymentHighlight.loyaltyAward.points || 0) %> loyalty points</strong>
                        from this payment.
                        <% if (lastPaymentHighlight.loyaltyAward.birthdayApplied) { %>
                            Birthday month bonus applied:
                            <strong><%= Number(lastPaymentHighlight.loyaltyAward.basePoints || 0) %> base points</strong>
                            plus <strong><%= Number(lastPaymentHighlight.loyaltyAward.bonusPoints || 0) %> bonus points</strong>
                            for <strong>2X rewards</strong>.
                        <% } %>
                    </p>
                </div>
            <% } %>

            <div class="receipt-meta-grid">
                <p><span>User</span><strong><%= receipt.userName %></strong></p>
                <p><span>Receipt ID</span><strong>#<%= receipt.displayId || receipt.id %></strong></p>
                <p><span><%= isBooking ? 'Status' : 'Payment method' %></span><strong><%= isBooking ? receipt.status : receipt.paymentMethod %></strong></p>
                <p><span>Date/time</span><strong><%= paidAtLabel %></strong></p>
                <% if (isBooking) { %>
                    <p><span>Merchant</span><strong><%= receipt.merchantName %></strong></p>
                    <p><span>Appointment</span><strong><%= receipt.bookingDate || '-' %><%= receipt.bookingTime ? ` at ${receipt.bookingTime}` : '' %></strong></p>
                    <% if (receipt.checkedInAt) { %>
                        <p><span>Checked-in At</span><strong><%= new Date(receipt.checkedInAt).toLocaleString('en-SG', { dateStyle: 'medium', timeStyle: 'short' }) %></strong></p>
                    <% } %>
                <% } %>
                <% if (isProductPickup) { %>
                    <p><span>Fulfilment Method</span><strong><%= fulfilmentLabel %></strong></p>
                    <p><span>Pickup Merchant</span><strong><%= pickupMerchantName %></strong></p>
                    <p><span>Pickup Status</span><strong><%= pickupStatusLabel %></strong></p>
                    <% if (receipt.pickupAt) { %>
                        <p><span>Pickup Date/time</span><strong><%= new Date(receipt.pickupAt).toLocaleString('en-SG', { dateStyle: 'medium', timeStyle: 'short' }) %></strong></p>
                    <% } %>
                <% } %>
            </div>

            <div class="admin-table-wrap receipt-table-wrap">
                <table class="admin-table receipt-table">
                    <thead>
                        <tr>
                            <th>Item / service</th>
                            <th>Type</th>
                            <th>Qty</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% receipt.items.forEach((item) => { %>
                            <tr>
                                <td>
                                    <strong><%= item.name %></strong>
                                    <% if (item.detail) { %>
                                        <span><%= item.detail %></span>
                                    <% } %>
                                </td>
                                <td><%= item.type || 'Item' %></td>
                                <td><%= item.quantity || 1 %></td>
                                <td>$<%= Number(item.unitPrice || 0).toFixed(2) %></td>
                                <td>$<%= Number(item.lineTotal || 0).toFixed(2) %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="receipt-total">
                <span>Total amount</span>
                <strong>$<%= Number(receipt.totalAmount || 0).toFixed(2) %></strong>
            </div>
            <% if (Number(receipt.cashbackRedeemed || 0) > 0) { %>
                <div class="receipt-total">
                    <span>Cashback redeemed</span>
                    <strong>-$<%= Number(receipt.cashbackRedeemed || 0).toFixed(2) %></strong>
                </div>
            <% } %>
        </article>

        <aside class="receipt-qr-panel">
            <p class="eyebrow"><%= qrLabel %></p>
            <img class="qr-code" src="<%= qrCodeDataUrl %>" alt="<%= qrLabel %> for receipt <%= receipt.id %>">
            <p class="muted"><%= qrDescription %></p>
            <a class="qr-link" href="<%= verificationUrl %>"><%= verificationUrl %></a>
            <div class="qr-debug-panel">
                <p class="eyebrow">QR Debug</p>
                <p class="muted"><strong>System:</strong> <%= qrSystem %></p>
                <p class="muted"><strong>Token:</strong> <%= checkinToken %></p>
                <p class="muted"><strong>Route target:</strong> <%= qrRouteTarget %></p>
            </div>
        </aside>
    </div>
</section>

<%- include('partials/footer') %>
