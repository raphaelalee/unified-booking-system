<%
    const safePdfMode = typeof pdfMode !== 'undefined' ? Boolean(pdfMode) : false;
%>

<% if (safePdfMode) { %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %> | Vaniday</title>
    <style>
        @page {
            size: A4;
            margin: 14mm 12mm;
        }

        * {
            box-sizing: border-box;
        }

        body.receipt-pdf-body {
            margin: 0;
            background: #ffffff;
            color: #253125;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            line-height: 1.45;
        }

        .receipt-pdf-document {
            width: 100%;
        }

        .receipt-pdf-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            padding: 0 0 18px;
            border-bottom: 2px solid #dce6d7;
        }

        .receipt-pdf-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .receipt-pdf-mark {
            display: inline-grid;
            place-items: center;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #3f513a;
            color: #ffffff;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 26px;
            font-weight: 700;
        }

        .receipt-pdf-brand strong {
            display: block;
            color: #2f3b2d;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 22px;
            line-height: 1;
        }

        .receipt-pdf-brand span,
        .receipt-pdf-reference span,
        .receipt-meta-grid span,
        .receipt-total span,
        .receipt-qr-panel .muted,
        .receipt-table td span {
            color: #64705f;
        }

        .receipt-pdf-brand span,
        .receipt-pdf-reference span {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0;
            text-transform: uppercase;
        }

        .receipt-pdf-reference {
            text-align: right;
        }

        .receipt-pdf-reference strong {
            display: block;
            margin-top: 3px;
            color: #253125;
            font-size: 13px;
        }

        .receipt-title {
            min-height: 0 !important;
            padding: 24px 0 18px !important;
            background: transparent !important;
            color: #253125 !important;
        }

        .receipt-title .eyebrow,
        .receipt-qr-panel .eyebrow {
            margin: 0 0 8px;
            color: #50634a;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0;
            text-transform: uppercase;
        }

        .receipt-title h1 {
            max-width: none !important;
            margin: 0 0 8px;
            color: #1f281f;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 30px;
            line-height: 1.12;
        }

        .receipt-title p {
            max-width: 100%;
            margin: 3px 0;
            color: #43503f;
        }

        .receipt-section {
            padding: 0 !important;
        }

        .receipt-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 190px;
            gap: 16px;
            align-items: start;
        }

        .receipt-card,
        .receipt-qr-panel {
            overflow: hidden;
            border: 1px solid #dce6d7;
            border-radius: 8px;
            background: #fbfcfa;
            color: #253125;
            page-break-inside: avoid;
        }

        .receipt-meta-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
            padding: 14px;
            border-bottom: 1px solid #e2eadf;
        }

        .receipt-meta-grid p {
            min-width: 0;
            margin: 0;
            padding: 10px;
            border-radius: 6px;
            background: #ffffff;
        }

        .receipt-meta-grid span {
            display: block;
            margin-bottom: 3px;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .receipt-meta-grid strong {
            display: block;
            color: #1f281f;
            font-size: 11px;
            overflow-wrap: anywhere;
        }

        .notice {
            margin: 14px;
            padding: 10px 12px;
            border-radius: 6px;
            background: #edf5e9;
            color: #253125;
        }

        .notice p {
            margin: 0;
        }

        .receipt-table-wrap {
            overflow: visible;
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
        }

        .receipt-table {
            width: 100%;
            min-width: 0;
            border-collapse: collapse;
            background: #ffffff;
        }

        .receipt-table th {
            padding: 10px 12px;
            background: #3f513a;
            color: #ffffff;
            font-size: 9px;
            font-weight: 800;
            text-align: left;
            text-transform: uppercase;
        }

        .receipt-table td {
            padding: 11px 12px;
            border-bottom: 1px solid #e2eadf;
            color: #253125;
            vertical-align: top;
        }

        .receipt-table td:nth-child(3),
        .receipt-table td:nth-child(4),
        .receipt-table td:nth-child(5),
        .receipt-table th:nth-child(3),
        .receipt-table th:nth-child(4),
        .receipt-table th:nth-child(5) {
            text-align: right;
            white-space: nowrap;
        }

        .receipt-table td:first-child {
            width: 44%;
        }

        .receipt-table td:first-child strong,
        .receipt-table td:first-child span {
            display: block;
        }

        .receipt-table td:first-child span {
            margin-top: 2px;
            font-size: 10px;
        }

        .receipt-total {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            padding: 10px 14px;
            border-top: 1px solid #e2eadf;
            background: #ffffff;
        }

        .receipt-total strong {
            color: #1f281f;
            text-align: right;
        }

        .receipt-total:last-of-type {
            background: #eef5eb;
        }

        .receipt-card > .muted {
            margin: 0;
            padding: 0 14px 14px;
            color: #64705f;
        }

        .receipt-refund-breakdown {
            padding: 14px;
            border-top: 1px solid #e2eadf;
            background: #ffffff;
        }

        .receipt-refund-breakdown h2 {
            margin: 0 0 10px;
            font-size: 15px;
        }

        .receipt-refund-breakdown article {
            padding: 10px;
            border: 1px solid #e2eadf;
            border-radius: 6px;
        }

        .receipt-refund-breakdown dl {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 6px 12px;
            margin: 8px 0 0;
        }

        .receipt-refund-breakdown dt,
        .receipt-refund-breakdown dd {
            margin: 0;
        }

        .receipt-refund-breakdown dt {
            color: #64705f;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .receipt-qr-panel {
            padding: 14px;
        }

        .receipt-qr-panel .qr-code {
            display: block;
            width: 150px;
            height: 150px;
            margin: 2px auto 12px;
            padding: 8px;
            border: 1px solid #dce6d7;
            border-radius: 8px;
            background: #ffffff;
        }

        .receipt-qr-panel p {
            margin: 0 0 8px;
        }

        .receipt-qr-panel .qr-link {
            display: block;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #e2eadf;
            color: #253125;
            font-size: 8px;
            overflow-wrap: anywhere;
            text-decoration: none;
        }

        .receipt-digital-icon {
            display: grid;
            place-items: center;
            width: 54px;
            height: 54px;
            margin-bottom: 10px;
            border: 1px solid #dce6d7;
            border-radius: 50%;
            background: #ffffff;
            color: #3f513a;
            font-size: 24px;
            font-weight: 800;
        }

        .qr-debug-panel {
            display: none;
        }

        .receipt-pdf-footer {
            margin-top: 18px;
            padding-top: 12px;
            border-top: 1px solid #dce6d7;
            color: #64705f;
            font-size: 9px;
            text-align: center;
        }
    </style>
</head>
<body class="receipt-pdf-body">
    <div class="receipt-pdf-document">
<% } else { %>
<%- include('partials/header', { title }) %>
<% } %>

<%
    const safeViewerRole = typeof viewerRole !== 'undefined' ? viewerRole : 'customer';
    const safeIsGiftCardOnly = typeof isGiftCardOnly !== 'undefined' ? Boolean(isGiftCardOnly) : false;
    const returnPath = safeViewerRole === 'admin' ? '/admin/bookings' : (safeViewerRole === 'merchant' ? '/merchant/schedule' : (safeIsGiftCardOnly ? '/giftcards' : '/services'));
    const returnLabel = safeViewerRole === 'admin' ? 'Back to admin' : (safeViewerRole === 'merchant' ? 'Back to schedule' : 'Continue browsing');
    const paymentLabel = receipt.paymentMethodLabel || receipt.paymentMethod || 'Payment';
    const paymentBreakdown = Array.isArray(receipt.paymentBreakdown) ? receipt.paymentBreakdown : [];
    const refundRows = Array.isArray(receipt.refundRows) ? receipt.refundRows : [];
    const receiptDisplayReference = receipt.displayReference || receipt.order_number || receipt.orderNumber || ('#' + (receipt.displayId || receipt.id));
    const formatStatus = (value) => String(value || 'none').replace(/_/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
    const formatMoney = (value) => `$${Number(value || 0).toFixed(2)}`;
    const formatTitleCase = (value) => String(value || '').replace(/_/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
    const formatPromotionDiscount = (item) => {
        const discountValue = Number(item.promotionDiscountValue || 0);
        const discountType = String(item.promotionDiscountType || '').toLowerCase();

        if (!Number.isFinite(discountValue) || discountValue <= 0) {
            return '';
        }

        if (discountType === 'percentage') {
            return `${discountValue.toFixed(discountValue % 1 === 0 ? 0 : 2)}% off`;
        }

        if (discountType === 'fixed_amount') {
            return `${formatMoney(discountValue)} off`;
        }

        if (discountType === 'fixed_price') {
            return `${formatMoney(discountValue)} deal`;
        }

        return '';
    };
    const formatPromotionLabel = (item) => {
        if (!item.promotionId && !item.promotionTitle && !item.promotionType) {
            return '';
        }

        const parts = [
            formatTitleCase(item.promotionType || 'Promotion'),
            item.promotionTitle || ''
        ].filter(Boolean);
        const discount = formatPromotionDiscount(item);

        return `${parts.join(' - ')}${discount ? ` (${discount})` : ''}`;
    };
    const receiptPromotionLabel = formatPromotionLabel(receipt);
%>

<% if (safePdfMode) { %>
    <header class="receipt-pdf-header">
        <div class="receipt-pdf-brand">
            <span class="receipt-pdf-mark">V</span>
            <div>
                <strong>Vaniday</strong>
                <span>Beauty and wellness receipt</span>
            </div>
        </div>
        <div class="receipt-pdf-reference">
            <span>Receipt reference</span>
            <strong><%= receiptDisplayReference %></strong>
        </div>
    </header>
<% } %>

<section class="page-title receipt-title">
    <p class="eyebrow"><%= isBooking ? 'Booking receipt' : (safeIsGiftCardOnly ? 'Gift card receipt' : 'Product receipt') %></p>
    <h1>Receipt <%= receiptDisplayReference %></h1>
    <% if (isBooking) { %>
        <p><strong><%= receipt.userName %></strong> booked <strong><%= receipt.items[0]?.name || 'a service' %></strong></p>
        <p>Status: <strong><%= receipt.statusLabel || receipt.status %></strong></p>
        <% if (appointmentLabel) { %>
            <p>Appointment: <strong><%= appointmentLabel %></strong></p>
        <% } %>
        <% if (String(receipt.status || '').toLowerCase() === 'completed' && Number(receipt.pointsAwarded || 0) > 0) { %>
            <p><strong><%= Number(receipt.pointsAwarded || 0) %> loyalty points have been added to your wallet.</strong></p>
        <% } %>
    <% } else { %>
        <p>
            <strong><%= receipt.userName %></strong> paid
            <strong>$<%= Number(receipt.paidAmount || receipt.totalAmount || 0).toFixed(2) %></strong>
            by <strong><%= paymentLabel %></strong>.
            <% if (Number(receipt.cashbackRedeemed || 0) > 0) { %>
                Wallet cashback used: <strong>$<%= Number(receipt.cashbackRedeemed || 0).toFixed(2) %></strong>.
            <% } %>
            <% if (Number(receipt.campaignCashbackEarned || 0) > 0) { %>
                Campaign cashback earned: <strong>$<%= Number(receipt.campaignCashbackEarned || 0).toFixed(2) %></strong>.
            <% } %>
            <% if (Number(receipt.pointsDiscount || 0) > 0) { %>
                Points redeemed: <strong><%= Number(receipt.pointsRedeemed || 0) %> pts</strong>.
            <% } %>
            <% if (isProductPickup) { %>
                Fulfilment: <strong><%= fulfilmentLabel %></strong>.
            <% } %>
            <% if (safeIsGiftCardOnly) { %>
                Gift card delivery: <strong>Email</strong>.
            <% } %>
        </p>
    <% } %>
    <% if (!pdfMode) { %>
        <div class="hero-actions">
            <a class="button primary" href="/receipt/<%= encodeURIComponent(receipt.id) %>/pdf">Download Receipt</a>
            <% if (isBooking) { %>
                <a class="button secondary" href="/receipt/<%= encodeURIComponent(receipt.id) %>/google-calendar" target="_blank" rel="noopener">Add to Google Calendar</a>
            <% } %>
            <% if (safeViewerRole === 'customer') { %>
                <a class="button secondary" href="<%= supportRequestPath %>">Need help</a>
            <% } %>
            <a class="button secondary" href="<%= returnPath %>"><%= returnLabel %></a>
        </div>
    <% } %>
</section>

<section class="section compact receipt-section">
    <div class="receipt-layout">
        <article class="receipt-card">
            <% if (lastPaymentHighlight && lastPaymentHighlight.loyaltyAward && lastPaymentHighlight.loyaltyAward.awarded) { %>
                <div class="notice <%= lastPaymentHighlight.loyaltyAward.birthdayApplied ? 'success' : '' %>">
                    <p>
                        You earned <strong><%= Number(lastPaymentHighlight.loyaltyAward.points || 0) %> loyalty points</strong>
                        from this payment.
                        <% if (Number(lastPaymentHighlight.loyaltyAward.platformCashback || lastPaymentHighlight.loyaltyAward.cashback || 0) > 0) { %>
                            Platform cashback earned:
                            <strong>$<%= Number(lastPaymentHighlight.loyaltyAward.platformCashback || lastPaymentHighlight.loyaltyAward.cashback || 0).toFixed(2) %></strong>.
                        <% } %>
                        <% if (lastPaymentHighlight.loyaltyAward.birthdayApplied) { %>
                            Birthday month bonus applied:
                            <strong><%= Number(lastPaymentHighlight.loyaltyAward.basePoints || 0) %> base points</strong>
                            plus <strong><%= Number(lastPaymentHighlight.loyaltyAward.bonusPoints || 0) %> bonus points</strong>
                            for <strong>2X rewards</strong>.
                        <% } %>
                    </p>
                </div>
            <% } %>

            <div class="receipt-meta-grid">
                <% if (isBooking) { %>
                    <p><span>User</span><strong><%= receipt.userName %></strong></p>
                    <p><span>Status</span><strong><%= receipt.statusLabel || receipt.status %></strong></p>
                    <p><span>Merchant</span><strong><%= receipt.merchantName %></strong></p>
                    <p><span>Receipt ID</span><strong><%= receiptDisplayReference %></strong></p>
                    <p><span>Payment method</span><strong>Pay at merchant</strong></p>
                    <p><span>Booking payment</span><strong>You will pay the remaining amount during your appointment</strong></p>
                    <p><span>Refund status</span><strong><%= formatStatus(receipt.refundStatus) %></strong></p>
                    <p><span>Date/Time</span><strong><%= paidAtLabel %></strong></p>
                    <p><span>Appointment</span><strong><%= appointmentLabel || '-' %></strong></p>
                    <% if (receipt.checkedInAt) { %>
                        <p><span>Checked-in At</span><strong><%= checkedInAtLabel || '-' %></strong></p>
                    <% } %>
                    <% if (String(receipt.status || '').toLowerCase() === 'completed' && Number(receipt.pointsAwarded || 0) > 0) { %>
                        <p><span>Loyalty points awarded</span><strong><%= Number(receipt.pointsAwarded || 0) %> pts</strong></p>
                    <% } %>
                <% } else { %>
                    <p><span>User</span><strong><%= receipt.userName %></strong></p>
                    <p><span>Receipt ID</span><strong><%= receiptDisplayReference %></strong></p>
                    <p><span>Payment method</span><strong><%= paymentLabel %></strong></p>
                    <p><span>Payment provider</span><strong><%= receipt.paymentProvider || '-' %></strong></p>
                    <p><span>Payment status</span><strong><%= formatStatus(receipt.paymentStatus) %></strong></p>
                    <p><span>Refund status</span><strong><%= formatStatus(receipt.refundStatus) %></strong></p>
                    <p><span>Date/Time</span><strong><%= paidAtLabel %></strong></p>
                <% } %>
                <% if (isProductPickup) { %>
                    <p><span>Fulfilment Method</span><strong><%= fulfilmentLabel %></strong></p>
                    <p><span>Pickup Merchant</span><strong><%= pickupMerchantName %></strong></p>
                    <p><span>Pickup Status</span><strong><%= pickupStatusLabel %></strong></p>
                    <% if (receipt.pickupAt) { %>
                        <p><span>Pickup Date/Time</span><strong><%= pickupAtLabel || '-' %></strong></p>
                    <% } %>
                <% } else if (safeIsGiftCardOnly) { %>
                    <p><span>Delivery method</span><strong>Email delivery</strong></p>
                    <p><span>Gift card status</span><strong>Sent by email</strong></p>
                <% } %>
            </div>

            <div class="admin-table-wrap receipt-table-wrap">
                <table class="admin-table receipt-table">
                    <thead>
                        <tr>
                            <th>Item / service</th>
                            <th>Type</th>
                            <th>Qty</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% receipt.items.forEach((item) => { %>
                            <tr>
                                <td>
                                    <strong><%= item.name %></strong>
                                    <% if (item.detail) { %>
                                        <span><%= item.detail %></span>
                                    <% } %>
                                </td>
                                <td><%= item.type || 'Item' %></td>
                                <td><%= item.quantity || 1 %></td>
                                <td>$<%= Number(item.unitPrice || 0).toFixed(2) %></td>
                                <td>$<%= Number(item.lineTotal || 0).toFixed(2) %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <% if (Number(receipt.shippingFee || 0) > 0) { %>
                <div class="receipt-total">
                    <span>Items subtotal</span>
                    <strong>$<%= Number(receipt.itemSubtotal || 0).toFixed(2) %></strong>
                </div>
                <div class="receipt-total">
                    <span>Shipping fee</span>
                    <strong>$<%= Number(receipt.shippingFee || 0).toFixed(2) %></strong>
                </div>
                <div class="receipt-total">
                    <span>Total amount</span>
                    <strong>$<%= Number(receipt.totalAmount || 0).toFixed(2) %></strong>
                </div>
            <% } else { %>
                <div class="receipt-total">
                    <span><%= isBooking ? 'Original service price' : 'Total amount' %></span>
                    <strong>$<%= Number(receipt.totalAmount || 0).toFixed(2) %></strong>
                </div>
            <% } %>
            <% if (isBooking && receiptPromotionLabel) { %>
                <div class="receipt-total">
                    <span>Promotion</span>
                    <strong><%= receiptPromotionLabel %></strong>
                </div>
            <% } %>
            <% if (isBooking && Number(receipt.pointsDiscount || 0) > 0) { %>
                <div class="receipt-total">
                    <span>Points discount</span>
                    <strong>-$<%= Number(receipt.pointsDiscount || 0).toFixed(2) %> (<%= Number(receipt.pointsRedeemed || 0) %> pts)</strong>
                </div>
            <% } %>
            <% if (isBooking) { %>
                <div class="receipt-total">
                    <span>Amount payable at merchant</span>
                    <strong>$<%= Number((receipt.amountPayableAtMerchant ?? receipt.totalAmount) || 0).toFixed(2) %></strong>
                </div>
                <% if (String(receipt.status || '').toLowerCase() === 'completed' && Number(receipt.pointsAwarded || 0) > 0) { %>
                    <div class="receipt-total">
                        <span>Loyalty points awarded</span>
                        <strong><%= Number(receipt.pointsAwarded || 0) %> pts</strong>
                    </div>
                <% } %>
                <p class="muted">You will pay the remaining amount during your appointment.</p>
            <% } %>
            <% if (paymentBreakdown.length > 0) { %>
                <div class="receipt-total">
                    <span>Payment breakdown</span>
                    <strong><%= paymentBreakdown.length %> source<%= paymentBreakdown.length === 1 ? '' : 's' %></strong>
                </div>
                <% paymentBreakdown.forEach((paymentSource) => { %>
                    <div class="receipt-total">
                        <span><%= paymentSource.label %></span>
                        <strong>$<%= Number(paymentSource.amount || 0).toFixed(2) %></strong>
                    </div>
                <% }) %>
            <% } %>
            <% if (!isBooking) { %>
                <div class="receipt-total">
                    <span>Total paid</span>
                    <strong>$<%= Number(receipt.paidAmount || receipt.totalAmount || 0).toFixed(2) %></strong>
                </div>
            <% } %>
            <% if (Number(receipt.refundedAmount || 0) > 0) { %>
                <div class="receipt-total">
                    <span>Refunded</span>
                    <strong>-$<%= Number(receipt.refundedAmount || 0).toFixed(2) %></strong>
                </div>
                <div class="receipt-total">
                    <span>Net amount retained</span>
                    <strong>$<%= Number(receipt.remainingPaidAmount || 0).toFixed(2) %></strong>
                </div>
            <% } %>
            <% if (refundRows.length > 0) { %>
                <div class="receipt-refund-breakdown">
                    <h2>Refund history</h2>
                    <% refundRows.forEach((refund) => { %>
                        <article>
                            <div>
                                <strong><%= refund.refundReference || 'Refund' %></strong>
                                <span><%= formatStatus(refund.refundStatus) %><%= refund.providerRefundStatus ? ` / ${formatStatus(refund.providerRefundStatus)}` : '' %></span>
                            </div>
                            <dl>
                                <div><dt>Requested</dt><dd><%= formatMoney(refund.customerRequestedAmount) %></dd></div>
                                <div><dt>Approved</dt><dd><%= Number(refund.approvedPercentage || 0).toFixed(2) %>%</dd></div>
                                <div><dt>Gross refund</dt><dd><%= formatMoney(refund.approvedGrossRefund) %></dd></div>
                                <div><dt>Processing-fee deduction</dt><dd><%= formatMoney(refund.processingFeeDeduction) %></dd></div>
                                <div><dt>External returned</dt><dd><%= formatMoney(refund.netExternalRefund) %></dd></div>
                                <% if (Number(refund.walletRestored || 0) > 0) { %><div><dt>Wallet restored</dt><dd><%= formatMoney(refund.walletRestored) %></dd></div><% } %>
                                <% if (Number(refund.pointsRestored || 0) > 0 || Number(refund.pointsReversed || 0) > 0) { %><div><dt>Points</dt><dd>+<%= Number(refund.pointsRestored || 0) %> / -<%= Number(refund.pointsReversed || 0) %></dd></div><% } %>
                                <% if (Number(refund.cashbackRestored || 0) > 0 || Number(refund.cashbackReversed || 0) > 0) { %><div><dt>Cashback</dt><dd>+<%= formatMoney(refund.cashbackRestored) %> / -<%= formatMoney(refund.cashbackReversed) %></dd></div><% } %>
                                <div><dt>Completed</dt><dd><%= refund.completedAt ? new Date(refund.completedAt).toLocaleString('en-SG') : 'Not completed' %></dd></div>
                            </dl>
                        </article>
                    <% }) %>
                </div>
            <% } %>
            <% if (receipt.paymentTransactionReference) { %>
                <div class="receipt-total">
                    <span>Payment reference</span>
                    <strong><%= receipt.paymentTransactionReference %></strong>
                </div>
            <% } %>
            <% if (receipt.providerRefundReference) { %>
                <div class="receipt-total">
                    <span>Refund reference</span>
                    <strong><%= receipt.providerRefundReference %></strong>
                </div>
            <% } %>
            <% if (Number(receipt.cashbackRedeemed || 0) > 0) { %>
                <div class="receipt-total">
                    <span>Wallet cashback used</span>
                    <strong>-$<%= Number(receipt.cashbackRedeemed || 0).toFixed(2) %></strong>
                </div>
            <% } %>
            <% if (Number(receipt.campaignCashbackEarned || 0) > 0) { %>
                <div class="receipt-total">
                    <span>Campaign cashback earned</span>
                    <strong>+$<%= Number(receipt.campaignCashbackEarned || 0).toFixed(2) %></strong>
                </div>
            <% } %>
            <% if (Number(receipt.campaignCashbackReversed || 0) > 0) { %>
                <div class="receipt-total">
                    <span>Campaign cashback reversed</span>
                    <strong>-$<%= Number(receipt.campaignCashbackReversed || 0).toFixed(2) %></strong>
                </div>
            <% } %>
            <% if (!isBooking && Number(receipt.pointsDiscount || 0) > 0) { %>
                <div class="receipt-total">
                    <span>Points redeemed</span>
                    <strong>-<%= Number(receipt.pointsRedeemed || 0) %> pts / $<%= Number(receipt.pointsDiscount || 0).toFixed(2) %></strong>
                </div>
            <% } %>
        </article>

        <aside class="receipt-qr-panel <%= safeIsGiftCardOnly ? 'receipt-digital-panel' : '' %>">
            <p class="eyebrow"><%= qrLabel %></p>
            <% if (safeIsGiftCardOnly) { %>
                <div class="receipt-digital-icon" aria-hidden="true">@</div>
                <p class="muted"><%= qrDescription %></p>
                <p class="muted">Check the purchaser or recipient inbox for the gift card code and redemption link.</p>
            <% } else if (qrCodeDataUrl) { %>
                <img class="qr-code" src="<%= qrCodeDataUrl %>" alt="<%= qrLabel %> for receipt <%= receipt.id %>">
                <p class="muted"><%= qrDescription %></p>
                <a class="qr-link" href="<%= verificationUrl %>"><%= verificationUrl %></a>
            <% } else { %>
                <p class="muted"><%= qrDescription %></p>
                <% if (isProductPickup) { %>
                    <p class="muted">Your merchant will update the order to Ready for Pickup before verification is allowed.</p>
                <% } else { %>
                    <p class="muted">This is a delivery order. Pickup QR verification is not used.</p>
                <% } %>
            <% } %>
            <% if (showQrDebug && qrCodeDataUrl) { %>
                <div class="qr-debug-panel">
                    <p class="eyebrow">QR Debug</p>
                    <p class="muted"><strong>System:</strong> <%= qrSystem %></p>
                    <p class="muted"><strong>Token:</strong> <%= checkinToken %></p>
                    <p class="muted"><strong>Route target:</strong> <%= qrRouteTarget %></p>
                </div>
            <% } %>
        </aside>
    </div>
</section>

<% if (safePdfMode) { %>
        <footer class="receipt-pdf-footer">
            Generated by Vaniday Booking System
        </footer>
    </div>
</body>
</html>
<% } else { %>
<%- include('partials/footer') %>
<% } %>
