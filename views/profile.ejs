<%- include('partials/header', { title }) %>

<%
    const profileUpcomingBookings = typeof upcomingBookings !== 'undefined' && Array.isArray(upcomingBookings)
        ? upcomingBookings
        : [];
    const profilePastBookings = typeof pastBookings !== 'undefined' && Array.isArray(pastBookings)
        ? pastBookings
        : [];
    const profileCancelledBookings = typeof cancelledBookings !== 'undefined' && Array.isArray(cancelledBookings)
        ? cancelledBookings
        : [];
    const profileBookingAvailability = typeof bookingAvailability !== 'undefined' && bookingAvailability
        ? bookingAvailability
        : {};
    const profileReviewableBookings = typeof reviewableBookings !== 'undefined' && Array.isArray(reviewableBookings)
        ? reviewableBookings
        : [];
    const profileReviewedBookings = typeof reviewedBookings !== 'undefined' && Array.isArray(reviewedBookings)
        ? reviewedBookings
        : [];
    const isProductReviewEntry = (entry) => String(entry.reviewItemType || '') === 'product';
    const profileReviewRewardMax = 70;
    const profileReviewPotential = profileReviewableBookings.length * profileReviewRewardMax;
    const profileReviewEarnedPoints = loyalty && loyalty.displaySummary
        ? Number(loyalty.displaySummary.reviewBonusPointsTotal || 0)
        : 0;
    const formatBookingStatus = (value) => String(value || 'pending').replace(/_/g, ' ');
    const formatBookingDate = (value) => {
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? 'Date TBC' : date.toLocaleDateString('en-SG', { dateStyle: 'medium' });
    };
    const formatBookingDateTime = (value) => {
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? 'Not recorded' : date.toLocaleString('en-SG', { dateStyle: 'medium', timeStyle: 'short' });
    };
    const formatMoney = (value) => `$${Number(value || 0).toFixed(2)}`;
    const formatDuration = (value) => Number(value || 0) > 0 ? `${Number(value)} mins` : 'Duration TBC';
    const formatRefundStatus = (value) => String(value || 'not_requested').replace(/_/g, ' ');
    const formatRefundBadge = (value) => {
        const normalized = String(value || '').toLowerCase();
        if (normalized === 'refunded') return 'Fully Refunded';
        if (normalized === 'partially_refunded') return 'Partially Refunded';
        if (normalized === 'return_required') return 'Return Required';
        if (normalized === 'refund_failed') return 'Refund Failed';
        if (normalized === 'refund_reconciliation_required') return 'Manual Review Required';
        return formatRefundStatus(normalized || 'not_requested');
    };
    const profileImageFallback = '/images/vaniday-service-placeholder.svg';
    const profileGenderOptions = typeof genderOptions !== 'undefined' && Array.isArray(genderOptions) ? genderOptions : [];
    const profileGenderLabel = (profileGenderOptions.find((option) => option.value === profile.gender) || {}).label || 'Not set';
    const profileContactMethodLabels = {
        email: 'Email',
        phone: 'Phone call',
        whatsapp: 'WhatsApp'
    };
    const profileBirthdayPromotion = typeof birthdayPromotion !== 'undefined' && birthdayPromotion
        ? birthdayPromotion
        : { hasBirthday: false, isBirthdayMonth: false, monthName: '', monthEndLabel: '', voucher: null, pointsMultiplier: 1 };
    const profileContactMethodLabel = profileContactMethodLabels[profile.preferredContactMethod] || 'Not set';
    const profilePurchaseHistory = typeof walletHistory !== 'undefined' && Array.isArray(walletHistory) ? walletHistory : [];
    const profileVouchers = typeof userVouchers !== 'undefined' && Array.isArray(userVouchers) ? userVouchers : [];
    const profileEWallet = typeof eWallet !== 'undefined' && eWallet ? eWallet : { balance: 0, currency: 'SGD' };
    const profileEWalletTransactions = typeof eWalletTransactions !== 'undefined' && Array.isArray(eWalletTransactions) ? eWalletTransactions : [];
    const dashboard = typeof profileDashboard !== 'undefined' && profileDashboard ? profileDashboard : {};
    const dashboardOverview = dashboard.overview || {};
    const dashboardWalletMetrics = dashboard.walletMetrics || {};
    const dashboardSpendingMetrics = dashboard.spendingMetrics || {};
    const dashboardAi = dashboard.ai || {};
    const dashboardActivityPreview = dashboard.activityPreview || {};
    const formatProfileDate = (value) => {
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-SG', { dateStyle: 'medium' });
    };
    const voucherIsActive = (voucher) => {
        if (voucher.status !== 'active') {
            return false;
        }

        if (voucher.discountType === 'percentage') {
            return Number(voucher.discountPercent || 0) > 0;
        }

        return Number(voucher.remainingValue || 0) > 0;
    };
    const profileGiftCardRecords = profileVouchers.filter((voucher) => voucher.sourceType === 'gift_card');
    const profileGiftCards = profileGiftCardRecords.filter(voucherIsActive);
    const profileGiftCardBalance = profileGiftCards.reduce((sum, voucher) => sum + Number(voucher.remainingValue || 0), 0);
    const nonGiftProfileVouchers = profileVouchers.filter((voucher) => voucher.sourceType !== 'gift_card');
    const activeProfileVouchers = nonGiftProfileVouchers.filter(voucherIsActive);
    const inactiveProfileVouchers = nonGiftProfileVouchers.filter((voucher) => !voucherIsActive(voucher));
    const usedProfileVouchers = inactiveProfileVouchers.filter((voucher) => {
        const status = String(voucher.status || '').toLowerCase();
        return status !== 'expired' && (status === 'used' || voucher.redeemedAt || voucher.usedAt);
    });
    const expiredProfileVouchers = inactiveProfileVouchers.filter((voucher) => String(voucher.status || '').toLowerCase() === 'expired');
    const otherInactiveProfileVouchers = inactiveProfileVouchers.filter((voucher) => !usedProfileVouchers.includes(voucher) && !expiredProfileVouchers.includes(voucher));
    const activePlatformVouchers = activeProfileVouchers.filter((voucher) =>
        voucher.bookingOnly !== false && voucher.sourceType !== 'reward_shop_merchant'
    );
    const activeGiftCardVouchers = activePlatformVouchers.filter((voucher) => voucher.sourceType === 'gift_card');
    const activeNonGiftPlatformVouchers = activePlatformVouchers.filter((voucher) => voucher.sourceType !== 'gift_card');
    const activeServiceVouchers = activeProfileVouchers.filter((voucher) =>
        voucher.bookingOnly !== false
        && voucher.sourceType === 'reward_shop_merchant'
    );
    const activeProductVouchers = activeProfileVouchers.filter((voucher) => voucher.bookingOnly === false && voucher.sourceType !== 'gift_card');
    const voucherSourceLabel = (voucher) => voucher.sourceType === 'referral'
        ? 'Referral'
        : voucher.sourceType === 'birthday'
            ? 'Birthday'
            : voucher.sourceType === 'gift_card'
                ? 'Gift card'
            : voucher.merchantName
                ? 'Merchant voucher'
                : 'Reward shop';
    const voucherValueLabel = (voucher) => voucher.discountType === 'percentage'
        ? `${Number(voucher.discountPercent || 0)}% OFF`
        : `$${Number(voucher.remainingValue || voucher.voucherValue || 0).toFixed(2)}`;
    const voucherUsageLabel = (voucher) => {
        if (voucher.sourceType === 'gift_card') {
            return 'Gift card balance';
        }

        if (voucher.expiresAt) {
            const expiryLabel = formatProfileDate(voucher.expiresAt);
            if (expiryLabel) {
                return `Expires ${expiryLabel}`;
            }
        }

        if (voucher.merchantName) {
            return voucher.bookingOnly === false
                ? `Product voucher at ${voucher.merchantName}`
                : `Use at ${voucher.merchantName}`;
        }

        if (voucher.firstBookingOnly) {
            return 'First booking only';
        }

        return voucher.bookingOnly === false ? 'Eligible product checkout' : 'Eligible booking payment';
    };
    const voucherStatusLabel = (voucher) => {
        const status = String(voucher.status || '').toLowerCase();

        if (status === 'active') {
            return 'Active';
        }

        if (status === 'used') {
            return `Used ${formatProfileDate(voucher.usedAt || voucher.redeemedAt) || ''}`.trim();
        }

        if (status === 'expired') {
            return `Expired ${formatProfileDate(voucher.expiresAt) || ''}`.trim();
        }

        return status ? status.replace(/_/g, ' ') : 'Inactive';
    };
    const voucherTermsList = (voucher) => {
        const terms = [];

        if (voucher.detail) {
            terms.push(voucher.detail);
        }

        if (voucher.sourceType === 'gift_card') {
            terms.push('Valid on Vaniday booking payments and eligible product checkout items.');
            terms.push('Unused balance stays available until the gift card expires.');
        } else if (voucher.bookingOnly === false) {
            terms.push(voucher.linkedItemName
                ? `Only eligible product offer item: ${voucher.linkedItemName}.`
                : 'Valid only on eligible product checkout items.');
        } else {
            terms.push(voucher.linkedItemName
                ? `Only eligible service offer item: ${voucher.linkedItemName}.`
                : 'Valid only on eligible service booking payments.');
        }

        if (voucher.merchantName) {
            terms.push(`Only valid at ${voucher.merchantName}.`);
        }

        if (Number(voucher.minimumSpend || 0) > 0) {
            terms.push(`Minimum eligible spend $${Number(voucher.minimumSpend || 0).toFixed(2)}.`);
        }

        if (voucher.firstBookingOnly) {
            terms.push('Valid for the first paid booking only.');
        }

        if (voucher.expiresAt) {
            const expiryLabel = formatProfileDate(voucher.expiresAt);
            if (expiryLabel) {
                terms.push(`Expires on ${expiryLabel}.`);
            }
        }

        if (voucher.sourceType !== 'gift_card') {
            terms.push('Applies only to eligible offer items; other items in the cart are not discounted by this voucher.');
        }
        terms.push('Cannot be combined with wallet cashback in the same checkout.');
        terms.push('The best eligible voucher is selected automatically at checkout unless you choose not to use a voucher.');

        return terms;
    };
    const canReviewBooking = (booking) => ['completed', 'checked_in'].includes(String(booking.status || '').toLowerCase());
    const renderStars = (rating) => '&#9733;'.repeat(Number(rating || 0)) + '&#9734;'.repeat(Math.max(0, 5 - Number(rating || 0)));
    const bookingDataFor = (booking) => {
        const availability = profileBookingAvailability[String(booking.id)] || {};
        return encodeURIComponent(JSON.stringify({
            id: booking.id,
            serviceName: booking.service_name,
            merchantName: booking.merchant_name,
            merchantId: booking.merchant_id,
            serviceId: booking.service_id,
            bookingDate: booking.booking_date instanceof Date ? booking.booking_date.toISOString().slice(0, 10) : String(booking.booking_date || '').slice(0, 10),
            bookingTime: booking.booking_time || '',
            duration: formatDuration(booking.duration_mins),
            price: formatMoney(booking.service_price),
            slots: availability.slots || [],
            taken: availability.taken || []
        }));
    };
%>

<section class="section compact account-settings-page profile-redesign-page">
    <% if (success) { %>
        <div class="notice success"><%= success %></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><%= error %></div>
    <% } %>

    <div class="profile-page-heading">
        <div>
            <p class="eyebrow"><%= roleLabel %> Profile</p>
            <h1>My account</h1>
            <p>Manage your bookings, rewards wallet, saved details, and security settings.</p>
        </div>
        <div class="profile-heading-actions">
            <% if (isCustomer) { %>
                <a class="button primary" href="/services">Book services</a>
                <a class="button secondary" href="#history" data-profile-tab-link="history">Purchase history</a>
            <% } else { %>
                <a class="button primary" href="<%= dashboardPath %>">Dashboard</a>
            <% } %>
        </div>
    </div>

    <section class="profile-hero-card">
        <div class="account-avatar profile-hero-avatar<%= profile.profileImage ? ' has-image' : '' %>" aria-hidden="true">
            <% if (profile.profileImage) { %>
                <img src="<%= profile.profileImage %>" alt="">
            <% } else { %>
                <%= (profile.name || roleLabel || 'V').charAt(0).toUpperCase() %>
            <% } %>
        </div>

        <div class="profile-hero-details">
            <span class="account-role-chip"><%= roleLabel %></span>
            <h2><%= profile.name %></h2>
            <p><%= profile.email %> &middot; <%= profile.phone || 'Phone not set' %></p>
            <div class="profile-hero-meta">
                <span><strong>Birthday</strong><%= profile.birthday || 'Not set' %></span>
                <span><strong>Gender</strong><%= profileGenderLabel %></span>
                <span><strong>Postal code</strong><%= profile.postalCode || 'Not set' %></span>
                <span><strong>Contact</strong><%= profileContactMethodLabel %></span>
            </div>
        </div>

        <div class="profile-hero-stats">
            <% if (isCustomer) { %>
                <article>
                    <span>Membership</span>
                    <strong><%= member.tier %></strong>
                </article>
                <article>
                    <span>VaniGlints</span>
                    <strong><%= Number.isFinite(profile.glintsBalance) ? profile.glintsBalance : 0 %></strong>
                </article>
                <article>
                    <span>Cashback</span>
                    <strong>$<%= cashbackBalance %></strong>
                </article>
            <% } else { %>
                <article>
                    <span>Role</span>
                    <strong><%= roleLabel %></strong>
                </article>
            <% } %>
        </div>

        <div class="profile-hero-actions">
            <% if (isCustomer) { %>
                <a class="button secondary full" href="/profile/wallet">E-wallet</a>
                <a class="button secondary full" href="#vouchers">Vouchers</a>
                <a class="button secondary full" href="#membership">Rewards</a>
            <% } else { %>
                <a class="button primary full" href="<%= dashboardPath %>">Back to dashboard</a>
            <% } %>
            <form action="/logout" method="POST">
                <button class="text-button full" type="submit">Log out</button>
            </form>
        </div>
    </section>

    <nav class="profile-tab-nav" aria-label="Profile sections">
        <a href="#profile-details" data-profile-tab="profile-details">Profile</a>
        <% if (isCustomer) { %>
            <a href="#bookings" data-profile-tab="bookings">Bookings</a>
            <a href="#history" data-profile-tab="history">History</a>
            <a href="#wallet" data-profile-tab="wallet">Wallet</a>
            <a href="#vouchers" data-profile-tab="vouchers">Vouchers</a>
            <a href="#membership" data-profile-tab="membership">Rewards</a>
        <% } %>
        <a href="#settings" data-profile-tab="settings">Settings</a>
    </nav>

    <div class="account-layout">
        <div class="account-main-stack">
            <section id="profile-details" class="account-panel profile-tab-panel profile-dashboard-panel" data-profile-panel="profile-details">
                <div class="account-panel-header">
                    <div>
                        <p class="eyebrow">Dashboard</p>
                        <h2>Welcome, <%= dashboardOverview.customerName || profile.name %></h2>
                    </div>
                    <a class="button secondary" href="#settings" data-profile-tab-link="settings">Edit details</a>
                </div>

                <% if (isCustomer) { %>
                    <p class="profile-dashboard-welcome"><%= dashboardOverview.welcomeMessage %></p>

                    <div class="profile-dashboard-metrics">
                        <article>
                            <span>Membership</span>
                            <strong><%= dashboardOverview.membershipTier || member.tier %></strong>
                        </article>
                        <article>
                            <span>E-wallet</span>
                            <strong>$<%= Number(dashboardOverview.eWalletBalance || 0).toFixed(2) %></strong>
                            <small><%= dashboardOverview.eWalletCurrency || 'SGD' %> available</small>
                        </article>
                        <article>
                            <span>Loyalty points</span>
                            <strong><%= Number(dashboardOverview.loyaltyPoints || 0) %></strong>
                        </article>
                        <article>
                            <span>Cashback</span>
                            <strong>$<%= Number(dashboardOverview.cashbackBalance || 0).toFixed(2) %></strong>
                        </article>
                        <% if (Number(dashboardOverview.activeGiftCardBalance || 0) > 0) { %>
                            <article>
                                <span>Gift cards</span>
                                <strong>$<%= Number(dashboardOverview.activeGiftCardBalance || 0).toFixed(2) %></strong>
                                <small>Active balance</small>
                            </article>
                        <% } %>
                    </div>

                    <div class="profile-ai-grid">
                        <section class="profile-ai-panel">
                            <div>
                                <p class="eyebrow">AI Wallet Advisor</p>
                                <h3>Reward use suggestion</h3>
                            </div>
                            <p><%= dashboardAi.walletAdvice %></p>
                            <small><%= dashboardAi.generatedByAi ? 'AI-generated suggestion.' : 'Deterministic account summary.' %> Generated from your account activity.</small>
                            <dl>
                                <div><dt>Redeemable value</dt><dd>$<%= Number(dashboardWalletMetrics.redeemablePointsValue || 0).toFixed(2) %></dd></div>
                                <div><dt>Convert points</dt><dd><%= dashboardWalletMetrics.canConvertPoints ? 'Available' : `${Number(dashboardWalletMetrics.pointsNeededToConvert || 0)} pts away` %></dd></div>
                                <% if (dashboardWalletMetrics.nextTierName) { %>
                                    <div><dt>Next tier</dt><dd><%= dashboardWalletMetrics.pointsToNextTier %> pts to <%= dashboardWalletMetrics.nextTierName %></dd></div>
                                <% } %>
                            </dl>
                        </section>

                        <section class="profile-ai-panel">
                            <div>
                                <p class="eyebrow">AI Spending Insights</p>
                                <h3>Monthly activity</h3>
                            </div>
                            <p><%= dashboardAi.spendingInsight %></p>
                            <small><%= dashboardAi.generatedByAi ? 'AI-generated suggestion.' : 'Deterministic account summary.' %> Generated from your account activity.</small>
                            <dl>
                                <div><dt>This month</dt><dd>$<%= Number(dashboardSpendingMetrics.currentMonthSpending || 0).toFixed(2) %></dd></div>
                                <div><dt>Paid transactions</dt><dd><%= Number(dashboardSpendingMetrics.completedTransactionCount || 0) %></dd></div>
                                <div><dt>Average value</dt><dd>$<%= Number(dashboardSpendingMetrics.averageTransactionValue || 0).toFixed(2) %></dd></div>
                            </dl>
                        </section>
                    </div>

                    <nav class="profile-dashboard-links" aria-label="Dashboard quick links">
                        <a href="#bookings" data-profile-tab-link="bookings">Bookings</a>
                        <a href="#history" data-profile-tab-link="history">Purchase History</a>
                        <a href="#wallet" data-profile-tab-link="wallet">Wallet</a>
                        <a href="#vouchers" data-profile-tab-link="vouchers">Vouchers</a>
                        <a href="#membership" data-profile-tab-link="membership">Rewards</a>
                        <a href="#settings" data-profile-tab-link="settings">Settings</a>
                    </nav>

                    <div class="profile-activity-preview">
                        <section>
                            <span>Next booking</span>
                            <% if (dashboardActivityPreview.nextBooking) { %>
                                <strong><%= dashboardActivityPreview.nextBooking.service_name %></strong>
                                <small><%= dashboardActivityPreview.nextBooking.merchant_name %> &middot; <%= formatBookingDate(dashboardActivityPreview.nextBooking.booking_date) %><%= dashboardActivityPreview.nextBooking.booking_time ? ` at ${dashboardActivityPreview.nextBooking.booking_time}` : '' %></small>
                            <% } else { %>
                                <strong>No upcoming booking</strong>
                                <small>Book a service when you are ready.</small>
                            <% } %>
                        </section>
                        <section>
                            <span>Recent purchase</span>
                            <% if (dashboardActivityPreview.recentPurchase) { %>
                                <strong><%= dashboardActivityPreview.recentPurchase.itemNames || 'Purchase' %></strong>
                                <small><%= formatBookingDateTime(dashboardActivityPreview.recentPurchase.createdAt) %> &middot; $<%= Number(dashboardActivityPreview.recentPurchase.remainingPaidAmount || dashboardActivityPreview.recentPurchase.totalAmount || 0).toFixed(2) %></small>
                            <% } else { %>
                                <strong>No purchase history</strong>
                                <small>Paid bookings and orders will appear here.</small>
                            <% } %>
                        </section>
                        <section>
                            <span>Recent reward</span>
                            <% if (dashboardActivityPreview.recentReward) { %>
                                <strong><%= dashboardActivityPreview.recentReward.displayTitle || 'Reward activity' %></strong>
                                <small><%= dashboardActivityPreview.recentReward.displayPointsDelta || dashboardActivityPreview.recentReward.displayCashbackDelta || 'Recorded' %></small>
                            <% } else { %>
                                <strong>No reward activity</strong>
                                <small>Rewards appear after eligible activity.</small>
                            <% } %>
                        </section>
                    </div>
                <% } else { %>
                    <p class="profile-dashboard-welcome">Manage your account details and security settings.</p>
                    <div class="profile-dashboard-metrics">
                        <article>
                            <span>Role</span>
                            <strong><%= roleLabel %></strong>
                        </article>
                        <article>
                            <span>Email</span>
                            <strong><%= profile.email %></strong>
                        </article>
                    </div>
                <% } %>
            </section>

            <section id="settings" class="profile-tab-panel profile-settings-stack" data-profile-panel="settings">
                <form class="account-panel account-form" action="/profile?_csrf=<%= encodeURIComponent(typeof csrfToken !== 'undefined' ? csrfToken : '') %>" method="POST" enctype="multipart/form-data">
                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">Settings</p>
                            <h2>Personal information</h2>
                        </div>
                    </div>

                    <div class="form-grid">
                        <label class="profile-photo-field">
                            Profile photo
                            <input type="file" name="profileImage" accept="image/*">
                            <small>JPG, PNG, WEBP, or GIF. Maximum 5 MB.</small>
                        </label>

                        <label>
                            Full name
                            <input type="text" name="name" value="<%= profile.name %>" placeholder="Enter your name" autocomplete="name" required>
                        </label>

                        <label>
                            Email
                            <input type="email" name="email" value="<%= profile.email %>" placeholder="name@example.com" autocomplete="email" required>
                        </label>

                        <label>
                            Handphone number
                            <input type="tel" name="phone" value="<%= profile.phone %>" placeholder="81234567" maxlength="8" pattern="[689][0-9]{7}" autocomplete="tel">
                        </label>

                        <label>
                            Age
                            <input type="number" name="age" value="<%= profile.age || '' %>" placeholder="21" min="1" max="120">
                        </label>

                        <label>
                            Birthday
                            <input type="date" name="birthday" value="<%= profile.birthday || '' %>" max="<%= new Date().toISOString().slice(0, 10) %>">
                        </label>

                        <label>
                            Gender
                            <select name="gender">
                                <option value="">Select gender</option>
                                <% profileGenderOptions.forEach((option) => { %>
                                    <option value="<%= option.value %>" <%= profile.gender === option.value ? 'selected' : '' %>><%= option.label %></option>
                                <% }) %>
                            </select>
                        </label>

                        <label>
                            Postal code
                            <input type="text" name="postalCode" value="<%= profile.postalCode || '' %>" placeholder="123456" maxlength="6" inputmode="numeric" pattern="[0-9]{6}">
                        </label>

                        <label>
                            Preferred contact method
                            <select name="preferredContactMethod">
                                <option value="">Select contact method</option>
                                <option value="email" <%= profile.preferredContactMethod === 'email' ? 'selected' : '' %>>Email</option>
                                <option value="phone" <%= profile.preferredContactMethod === 'phone' ? 'selected' : '' %>>Phone call</option>
                                <option value="whatsapp" <%= profile.preferredContactMethod === 'whatsapp' ? 'selected' : '' %>>WhatsApp</option>
                            </select>
                        </label>
                    </div>

                    <div class="account-form-actions">
                        <button class="button primary" type="submit">Save changes</button>
                    </div>
                </form>

                <form class="account-panel account-form" action="/profile/password" method="POST">
                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">Security</p>
                            <h2>Change password</h2>
                        </div>
                    </div>

                    <div class="form-grid">
                        <label>
                            Current password
                            <input type="password" name="currentPassword" placeholder="Current password" autocomplete="current-password" required>
                        </label>

                        <label>
                            New password
                            <input type="password" name="newPassword" placeholder="New password" autocomplete="new-password" minlength="8" required>
                        </label>

                        <label>
                            Confirm new password
                            <input type="password" name="confirmPassword" placeholder="Confirm password" autocomplete="new-password" minlength="8" required>
                        </label>
                    </div>

                    <div class="password-requirements">
                        <span>Current password required</span>
                        <span>8+ characters</span>
                        <span>Letters and numbers</span>
                    </div>

                    <div class="account-form-actions">
                        <button class="button primary" type="submit">Update password</button>
                    </div>
                </form>
            </section>

            <% if (isCustomer) { %>
                <section id="bookings" class="account-panel profile-tab-panel profile-bookings-panel" data-profile-panel="bookings">
                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">Bookings</p>
                            <h2>Upcoming Bookings</h2>
                        </div>
