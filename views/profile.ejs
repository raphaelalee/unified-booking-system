                        const loyaltyDisplaySummary = loyalty && loyalty.displaySummary
                            ? loyalty.displaySummary
                            : { displayCashbackSummary: '$0.00 earned - $0.00 used or reversed' };
                        const walletStartIndex = walletPagination.totalCount > 0
                            ? ((walletPagination.page - 1) * walletPagination.pageSize) + 1
                            : 0;
                        const walletEndIndex = walletPagination.totalCount > 0
                            ? Math.min(walletPagination.totalCount, walletStartIndex + walletTransactions.length - 1)
                            : 0;
