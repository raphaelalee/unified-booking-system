                            <p class="muted">No completed services or products waiting for review.</p>
                        <% } else { %>
                            <div class="profile-review-queue">
                                <% profileReviewableBookings.forEach((entry) => { %>
                                    <% if (isProductReviewEntry(entry)) { %>
                                    <article class="profile-review-queue-card">
                                        <div class="profile-review-queue-card-head">
                                            <strong><%= entry.merchant_name %></strong>
                                            <span>Completed product ready to review</span>
                                        </div>
                                        <div class="profile-review-queue-card-body">
                                            <div class="profile-review-service-thumb" aria-hidden="true">
                                                <span><%= String(entry.product_name || 'P').charAt(0).toUpperCase() %></span>
                                            </div>
                                            <div class="profile-review-service-copy">
                                                <strong><%= entry.product_name %></strong>
                                                <span>
                                                    <%= formatBookingDate(entry.booking_date) %>
                                                    <% if (Number(entry.quantity || 1) > 1) { %>
                                                        &middot; Qty <%= entry.quantity %>
                                                    <% } %>
                                                </span>
                                                <span class="profile-booking-status-row">
                                                    <span class="status-badge status-<%= entry.status %>"><%= formatBookingStatus(entry.status) %></span>
                                                </span>
                                            </div>
                                            <div class="profile-review-service-action">
                                                <span class="profile-review-bonus-pill">Bonus +<%= profileReviewRewardMax %> pts</span>
                                                <a class="button primary" href="/receipt/<%= entry.receiptId %>">View order</a>
                                            </div>
                                        </div>
                                        <div class="profile-review-queue-card-foot">
                                            <span>Rate to earn +10 pts</span>
                                            <span class="profile-review-star-outline" aria-hidden="true">&#9734;&#9734;&#9734;&#9734;&#9734;</span>
                                        </div>
                                        <details class="profile-booking-review-form">
                                            <summary class="button secondary">Write a review</summary>
                                            <form action="/profile/orders/<%= entry.receiptId %>/products/<%= entry.productId %>/review?_csrf=<%= encodeURIComponent(typeof csrfToken !== 'undefined' ? csrfToken : '') %>" method="POST" enctype="multipart/form-data">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <div class="profile-review-reward-strip">
                                                    <p><span>Rate product</span><strong>+10 pts</strong></p>
                                                    <p><span>Add image or video</span><strong>+50 pts</strong></p>
                                                    <p><span>Write 50+ characters</span><strong>+10 pts</strong></p>
                                                </div>
                                                <label>
                                                    Rating
                                                    <span class="profile-star-rating" role="radiogroup" aria-label="Star rating">
                                                        <input type="radio" id="review-product-rating-<%= entry.productId %>-5-<%= entry.receiptId %>" name="rating" value="5" required>
                                                        <label for="review-product-rating-<%= entry.productId %>-5-<%= entry.receiptId %>" title="5 stars">&#9733;</label>
                                                        <input type="radio" id="review-product-rating-<%= entry.productId %>-4-<%= entry.receiptId %>" name="rating" value="4">
                                                        <label for="review-product-rating-<%= entry.productId %>-4-<%= entry.receiptId %>" title="4 stars">&#9733;</label>
                                                        <input type="radio" id="review-product-rating-<%= entry.productId %>-3-<%= entry.receiptId %>" name="rating" value="3">
                                                        <label for="review-product-rating-<%= entry.productId %>-3-<%= entry.receiptId %>" title="3 stars">&#9733;</label>
                                                        <input type="radio" id="review-product-rating-<%= entry.productId %>-2-<%= entry.receiptId %>" name="rating" value="2">
                                                        <label for="review-product-rating-<%= entry.productId %>-2-<%= entry.receiptId %>" title="2 stars">&#9733;</label>
                                                        <input type="radio" id="review-product-rating-<%= entry.productId %>-1-<%= entry.receiptId %>" name="rating" value="1">
                                                        <label for="review-product-rating-<%= entry.productId %>-1-<%= entry.receiptId %>" title="1 star">&#9733;</label>
                                                    </span>
                                                </label>
                                                <label>
                                                    Comment
                                                    <textarea class="review-comment-input" name="comment" rows="3" maxlength="2000" placeholder="Share your experience with this product."></textarea>
                                                </label>
                                                <label>
                                                    Photo
                                                    <input type="file" name="reviewImage" accept="image/*">
                                                </label>
                                                <label>
                                                    Video
                                                    <input type="file" name="reviewVideo" accept="video/*">
                                                </label>
                                                <button class="button primary" type="submit">Submit review</button>
                                            </form>
                                        </details>
                                    </article>
                                    <% } else { %>
                                    <article class="profile-review-queue-card">
                                        <div class="profile-review-queue-card-head">
                                            <strong><%= entry.merchant_name %></strong>
                                            <span>Completed service ready to review</span>
                                        </div>
                                        <div class="profile-review-queue-card-body">
                                            <div class="profile-review-service-thumb" aria-hidden="true">
                                                <span><%= String(entry.service_name || 'S').charAt(0).toUpperCase() %></span>
                                            </div>
                                            <div class="profile-review-service-copy">
                                                <strong><%= entry.service_name %></strong>
                                                <span>
                                                    <%= new Date(entry.booking_date).toLocaleDateString('en-SG', { dateStyle: 'medium' }) %>
                                                    <% if (entry.booking_time) { %>
                                                        at <%= entry.booking_time %>
                                                    <% } %>
                                                </span>
                                                <span class="profile-booking-status-row">
                                                    <span class="status-badge status-<%= entry.status %>"><%= formatBookingStatus(entry.status) %></span>
                                                </span>
                                            </div>
                                            <div class="profile-review-service-action">
                                                <span class="profile-review-bonus-pill">Bonus +<%= profileReviewRewardMax %> pts</span>
                                                <a class="button primary" href="/receipt/<%= entry.id %>">View service</a>
                                            </div>
                                        </div>
                                        <div class="profile-review-queue-card-foot">
                                            <span>Rate to earn +10 pts</span>
                                            <span class="profile-review-star-outline" aria-hidden="true">&#9734;&#9734;&#9734;&#9734;&#9734;</span>
                                        </div>
                                        <div>
                                            <% if (canReviewBooking(entry)) { %>
                                                <details class="profile-booking-review-form">
                                                    <summary class="button secondary">Write a review</summary>
                                                    <form action="/profile/bookings/<%= entry.id %>/review?_csrf=<%= encodeURIComponent(typeof csrfToken !== 'undefined' ? csrfToken : '') %>" method="POST" enctype="multipart/form-data">
                                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                        <div class="profile-review-reward-strip">
                                                            <p><span>Rate service</span><strong>+10 pts</strong></p>
                                                            <p><span>Add image or video</span><strong>+50 pts</strong></p>
                                                            <p><span>Write 50+ characters</span><strong>+10 pts</strong></p>
                                                        </div>
                                                        <label>
                                                            Rating
                                                            <span class="profile-star-rating" role="radiogroup" aria-label="Star rating">
                                                                <input type="radio" id="review-rating-<%= entry.id %>-5" name="rating" value="5" required>
                                                                <label for="review-rating-<%= entry.id %>-5" title="5 stars">&#9733;</label>
                                                                <input type="radio" id="review-rating-<%= entry.id %>-4" name="rating" value="4">
                                                                <label for="review-rating-<%= entry.id %>-4" title="4 stars">&#9733;</label>
                                                                <input type="radio" id="review-rating-<%= entry.id %>-3" name="rating" value="3">
                                                                <label for="review-rating-<%= entry.id %>-3" title="3 stars">&#9733;</label>
                                                                <input type="radio" id="review-rating-<%= entry.id %>-2" name="rating" value="2">
                                                                <label for="review-rating-<%= entry.id %>-2" title="2 stars">&#9733;</label>
                                                                <input type="radio" id="review-rating-<%= entry.id %>-1" name="rating" value="1">
                                                                <label for="review-rating-<%= entry.id %>-1" title="1 star">&#9733;</label>
                                                            </span>
                                                        </label>
                                                        <label>
                                                            Comment
                                                            <textarea class="review-comment-input" name="comment" rows="3" maxlength="2000" placeholder="Share your experience with this service."></textarea>
                                                        </label>
                                                        <label>
                                                            Photo
                                                            <input type="file" name="reviewImage" accept="image/*">
                                                        </label>
                                                        <label>
                                                            Video
                                                            <input type="file" name="reviewVideo" accept="video/*">
                                                        </label>
                                                        <button class="button primary" type="submit">Submit review</button>
                                                    </form>
                                                </details>
                                            <% } %>
                                        </div>
                                    </article>
                                    <% } %>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>

