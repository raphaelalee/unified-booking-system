<%- include('partials/header', { title }) %>

<%
    const profileUpcomingBookings = typeof upcomingBookings !== 'undefined' && Array.isArray(upcomingBookings)
        ? upcomingBookings
        : [];
    const profilePastBookings = typeof pastBookings !== 'undefined' && Array.isArray(pastBookings)
        ? pastBookings
        : [];
    const profileCancelledBookings = typeof cancelledBookings !== 'undefined' && Array.isArray(cancelledBookings)
        ? cancelledBookings
        : [];
    const profileBookingAvailability = typeof bookingAvailability !== 'undefined' && bookingAvailability
        ? bookingAvailability
        : {};
    const profileReviewableBookings = typeof reviewableBookings !== 'undefined' && Array.isArray(reviewableBookings)
        ? reviewableBookings
        : [];
    const profileReviewedBookings = typeof reviewedBookings !== 'undefined' && Array.isArray(reviewedBookings)
        ? reviewedBookings
        : [];
    const profileReviewRewardMax = 70;
    const profileReviewPotential = profileReviewableBookings.length * profileReviewRewardMax;
    const profileReviewEarnedPoints = loyalty && Array.isArray(loyalty.transactions)
        ? loyalty.transactions
            .filter((entry) => String(entry.type || '').toLowerCase() === 'review_bonus')
            .reduce((sum, entry) => sum + Number(entry.pointsDelta || 0), 0)
        : 0;
    const formatBookingStatus = (value) => String(value || 'pending').replace(/_/g, ' ');
    const formatBookingDate = (value) => {
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? 'Date TBC' : date.toLocaleDateString('en-SG', { dateStyle: 'medium' });
    };
    const formatBookingDateTime = (value) => {
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? 'Not recorded' : date.toLocaleString('en-SG', { dateStyle: 'medium', timeStyle: 'short' });
    };
    const formatMoney = (value) => `$${Number(value || 0).toFixed(2)}`;
    const formatDuration = (value) => Number(value || 0) > 0 ? `${Number(value)} mins` : 'Duration TBC';
    const formatRefundStatus = (value) => String(value || 'not_requested').replace(/_/g, ' ');
    const profileImageFallback = '/images/vaniday-service-placeholder.svg';
    const profileGenderOptions = typeof genderOptions !== 'undefined' && Array.isArray(genderOptions) ? genderOptions : [];
    const profileGenderLabel = (profileGenderOptions.find((option) => option.value === profile.gender) || {}).label || 'Not set';
    const profileContactMethodLabels = {
        email: 'Email',
        phone: 'Phone call',
        whatsapp: 'WhatsApp'
    };
    const profileContactMethodLabel = profileContactMethodLabels[profile.preferredContactMethod] || 'Not set';
    const canReviewBooking = (booking) => ['completed', 'checked_in'].includes(String(booking.status || '').toLowerCase());
    const renderStars = (rating) => '&#9733;'.repeat(Number(rating || 0)) + '&#9734;'.repeat(Math.max(0, 5 - Number(rating || 0)));
    const bookingDataFor = (booking) => {
        const availability = profileBookingAvailability[String(booking.id)] || {};
        return encodeURIComponent(JSON.stringify({
            id: booking.id,
            serviceName: booking.service_name,
            merchantName: booking.merchant_name,
            bookingDate: booking.booking_date instanceof Date ? booking.booking_date.toISOString().slice(0, 10) : String(booking.booking_date || '').slice(0, 10),
            bookingTime: booking.booking_time || '',
            duration: formatDuration(booking.duration_mins),
            price: formatMoney(booking.service_price),
            slots: availability.slots || [],
            taken: availability.taken || []
        }));
    };
%>

<section class="section compact account-settings-page profile-redesign-page">
    <% if (success) { %>
        <div class="notice success"><%= success %></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><%= error %></div>
    <% } %>

    <div class="profile-page-heading">
        <div>
            <p class="eyebrow"><%= roleLabel %> Profile</p>
            <h1>Account settings.</h1>
            <p>Keep your contact details and password up to date.</p>
        </div>
        <a class="button secondary" href="<%= isCustomer ? '/services' : dashboardPath %>">&larr; Back</a>
    </div>

    <section class="profile-hero-card">
        <div class="account-avatar profile-hero-avatar" aria-hidden="true">
            <%= (profile.name || roleLabel || 'V').charAt(0).toUpperCase() %>
        </div>

        <div class="profile-hero-details">
            <span class="account-role-chip"><%= roleLabel %></span>
            <h2><%= profile.name %></h2>
            <p><%= profile.email %></p>
            <p><%= profile.phone || 'Phone not set' %></p>
            <p>
                Age: <strong><%= profile.age || 'Not set' %></strong>
                &middot; Birthday: <strong><%= profile.birthday || 'Not set' %></strong>
                &middot; Gender: <strong><%= profileGenderLabel %></strong>
            </p>
            <p>
                Postal code: <strong><%= profile.postalCode || 'Not set' %></strong>
                &middot; Preferred contact: <strong><%= profileContactMethodLabel %></strong>
            </p>
            <% if (isCustomer) { %>
                <p>VaniGlints: <strong><%= Number.isFinite(profile.glintsBalance) ? profile.glintsBalance : 0 %> pts</strong></p>
                <p>Membership: <strong><%= member.tier %></strong></p>
            <% } %>
        </div>

        <div class="profile-hero-actions">
            <% if (isCustomer) { %>
                <a class="button primary full" href="/services">Book services</a>
                <a class="button secondary full" href="#wallet">Rewards wallet</a>
            <% } else { %>
                <a class="button primary full" href="<%= dashboardPath %>">Back to dashboard</a>
            <% } %>
            <form action="/logout" method="POST">
                <button class="text-button full" type="submit">Log out</button>
            </form>
        </div>
    </section>

    <nav class="profile-tab-nav" aria-label="Profile sections">
        <a href="#profile-details" data-profile-tab="profile-details">Profile</a>
        <% if (isCustomer) { %>
            <a href="#bookings" data-profile-tab="bookings">Bookings</a>
            <a href="#to-rate" data-profile-tab="to-rate">To Rate</a>
            <a href="#wallet" data-profile-tab="wallet">Wallet</a>
            <a href="#membership" data-profile-tab="membership">Rewards</a>
        <% } %>
        <a href="#settings" data-profile-tab="settings">Settings</a>
    </nav>

    <div class="account-layout">
        <aside class="account-summary-panel profile-side-summary">
            <div class="account-avatar" aria-hidden="true">
                <%= (profile.name || roleLabel || 'V').charAt(0).toUpperCase() %>
            </div>

            <div class="account-name-block">
                <span class="account-role-chip"><%= roleLabel %></span>
                <h2><%= profile.name %></h2>
                <p><%= profile.email %></p>
            </div>

            <dl class="account-summary-list">
                <div>
                    <dt>Phone</dt>
                    <dd><%= profile.phone || 'Not set' %></dd>
                </div>
                <div>
                    <dt>Age</dt>
                    <dd><%= profile.age || 'Not set' %></dd>
                </div>
                <div>
                    <dt>Birthday</dt>
                    <dd><%= profile.birthday || 'Not set' %></dd>
                </div>
                <div>
                    <dt>Gender</dt>
                    <dd><%= profileGenderLabel %></dd>
                </div>
                <div>
                    <dt>Postal code</dt>
                    <dd><%= profile.postalCode || 'Not set' %></dd>
                </div>
                <div>
                    <dt>Preferred contact</dt>
                    <dd><%= profileContactMethodLabel %></dd>
                </div>
                <% if (isCustomer) { %>
                    <div>
                        <dt>Membership</dt>
                        <dd><%= member.tier %></dd>
                    </div>
                    <div>
                        <dt>VaniGlints</dt>
                        <dd><%= Number.isFinite(profile.glintsBalance) ? profile.glintsBalance : 0 %> pts</dd>
                    </div>
                    <div>
                        <dt>Cashback</dt>
                        <dd>$<%= cashbackBalance %></dd>
                    </div>
                    <% if (referral) { %>
                        <div>
                            <dt>Referral code</dt>
                            <dd><%= referral.code %></dd>
                        </div>
                    <% } %>
                <% } else { %>
                    <div>
                        <dt>Dashboard</dt>
                        <dd><a href="<%= dashboardPath %>">Open dashboard</a></dd>
                    </div>
                <% } %>
            </dl>

            <div class="account-actions">
                <% if (isCustomer) { %>
                    <a class="button primary full" href="/services">Book services</a>
                    <a class="button secondary full" href="/profile/history">Purchase history</a>
                    <a class="button secondary full" href="/rewards-game">Rewards game</a>
                    <a class="button secondary full" href="#wallet">Rewards wallet</a>
                <% } else { %>
                    <a class="button primary full" href="<%= dashboardPath %>">Back to dashboard</a>
                <% } %>
                <form action="/logout" method="POST">
                    <button class="text-button full" type="submit">Log out</button>
                </form>
            </div>
        </aside>

        <div class="account-main-stack">
            <form id="profile-details" class="account-panel account-form profile-tab-panel" data-profile-panel="profile-details" action="/profile" method="POST">
                <div class="account-panel-header">
                    <div>
                        <p class="eyebrow">Details</p>
                        <h2>Personal information</h2>
                    </div>
                </div>

                <div class="form-grid">
                    <label>
                        Full name
                        <input type="text" name="name" value="<%= profile.name %>" placeholder="Enter your name" autocomplete="name" required>
                    </label>

                    <label>
                        Email
                        <input type="email" name="email" value="<%= profile.email %>" placeholder="name@example.com" autocomplete="email" required>
                    </label>

                    <label>
                        Handphone number
                        <input type="tel" name="phone" value="<%= profile.phone %>" placeholder="81234567" maxlength="8" pattern="[689][0-9]{7}" autocomplete="tel">
                    </label>

                    <label>
                        Age
                        <input type="number" name="age" value="<%= profile.age || '' %>" placeholder="21" min="1" max="120">
                    </label>

                    <label>
                        Birthday
                        <input type="date" name="birthday" value="<%= profile.birthday || '' %>" max="<%= new Date().toISOString().slice(0, 10) %>">
                    </label>

                    <label>
                        Gender
                        <select name="gender">
                            <option value="">Select gender</option>
                            <% profileGenderOptions.forEach((option) => { %>
                                <option value="<%= option.value %>" <%= profile.gender === option.value ? 'selected' : '' %>><%= option.label %></option>
                            <% }) %>
                        </select>
                    </label>

                    <label>
                        Postal code
                        <input type="text" name="postalCode" value="<%= profile.postalCode || '' %>" placeholder="123456" maxlength="6" inputmode="numeric" pattern="[0-9]{6}">
                    </label>

                    <label>
                        Preferred contact method
                        <select name="preferredContactMethod">
                            <option value="">Select contact method</option>
                            <option value="email" <%= profile.preferredContactMethod === 'email' ? 'selected' : '' %>>Email</option>
                            <option value="phone" <%= profile.preferredContactMethod === 'phone' ? 'selected' : '' %>>Phone call</option>
                            <option value="whatsapp" <%= profile.preferredContactMethod === 'whatsapp' ? 'selected' : '' %>>WhatsApp</option>
                        </select>
                    </label>
                </div>

                <div class="account-form-actions">
                    <button class="button primary" type="submit">Save changes</button>
                </div>
            </form>

            <form id="settings" class="account-panel account-form profile-tab-panel" data-profile-panel="settings" action="/profile/password" method="POST">
                <div class="account-panel-header">
                    <div>
                        <p class="eyebrow">Security</p>
                        <h2>Change password</h2>
                    </div>
                </div>

                <div class="form-grid">
                    <label>
                        Current password
                        <input type="password" name="currentPassword" placeholder="Current password" autocomplete="current-password" required>
                    </label>

                    <label>
                        New password
                        <input type="password" name="newPassword" placeholder="New password" autocomplete="new-password" minlength="8" required>
                    </label>

                    <label>
                        Confirm new password
                        <input type="password" name="confirmPassword" placeholder="Confirm password" autocomplete="new-password" minlength="8" required>
                    </label>
                </div>

                <div class="password-requirements">
                    <span>Current password required</span>
                    <span>8+ characters</span>
                    <span>Letters and numbers</span>
                </div>

                <div class="account-form-actions">
                    <button class="button primary" type="submit">Update password</button>
                </div>
            </form>

            <% if (isCustomer) { %>
                <section id="bookings" class="account-panel profile-tab-panel profile-bookings-panel" data-profile-panel="bookings">
                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">Bookings</p>
                            <h2>Upcoming Bookings</h2>
                        </div>
                        <a class="button secondary" href="/services">Book services</a>
                    </div>

                    <% if (!profileUpcomingBookings.length) { %>
                        <p class="muted">No upcoming bookings yet.</p>
                    <% } else { %>
                        <div class="profile-booking-grid">
                            <% profileUpcomingBookings.forEach((booking) => { %>
                                <article class="profile-booking-card" data-booking-card="<%= booking.id %>" data-booking="<%- bookingDataFor(booking) %>">
                                    <img class="profile-booking-thumb" src="<%= booking.service_image_url || profileImageFallback %>" alt="<%= booking.service_name %> thumbnail" loading="lazy" onerror="this.src='<%= profileImageFallback %>'">
                                    <div class="profile-booking-card-main">
                                        <div class="profile-booking-card-head">
                                            <div>
                                                <strong data-booking-service><%= booking.service_name %></strong>
                                                <span><%= booking.merchant_name %></span>
                                            </div>
                                            <span class="status-badge status-<%= booking.status %>" data-booking-status><%= formatBookingStatus(booking.status) %></span>
                                        </div>
                                        <dl class="profile-booking-meta">
                                            <div>
                                                <dt>Date &amp; time</dt>
                                                <dd data-booking-datetime><%= formatBookingDate(booking.booking_date) %><%= booking.booking_time ? ` at ${booking.booking_time}` : '' %></dd>
                                            </div>
                                            <div>
                                                <dt>Duration</dt>
                                                <dd><%= formatDuration(booking.duration_mins) %></dd>
                                            </div>
                                            <div>
                                                <dt>Price</dt>
                                                <dd><%= formatMoney(booking.service_price) %></dd>
                                            </div>
                                        </dl>
                                        <div class="profile-booking-actions">
                                            <a class="button secondary" href="/receipt/<%= booking.id %>">View QR</a>
                                            <button class="button secondary" type="button" data-open-reschedule>Reschedule</button>
                                            <button class="button secondary danger-button" type="button" data-open-cancel>Cancel Booking</button>
                                            <a class="button secondary" href="/receipt/<%= booking.id %>">View Receipt</a>
                                        </div>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>

                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">History</p>
                            <h2>Past Bookings</h2>
                        </div>
                    </div>

                    <% if (!profilePastBookings.length) { %>
                        <p class="muted">No past bookings waiting outside the review flow.</p>
                    <% } else { %>
                        <div class="profile-booking-grid compact">
                            <% profilePastBookings.forEach((booking) => { %>
                                <article class="profile-booking-card">
                                    <img class="profile-booking-thumb" src="<%= booking.service_image_url || profileImageFallback %>" alt="<%= booking.service_name %> thumbnail" loading="lazy" onerror="this.src='<%= profileImageFallback %>'">
                                    <div class="profile-booking-card-main">
                                        <div class="profile-booking-card-head">
                                            <div>
                                                <strong><%= booking.service_name %></strong>
                                                <span><%= booking.merchant_name %> &middot; <%= formatBookingDate(booking.booking_date) %><%= booking.booking_time ? ` at ${booking.booking_time}` : '' %></span>
                                            </div>
                                            <span class="status-badge status-<%= booking.status %>"><%= formatBookingStatus(booking.status) %></span>
                                        </div>
                                        <div class="profile-booking-actions">
                                            <a class="button secondary" href="/booking/<%= booking.merchant_id %>?serviceId=<%= booking.service_id %>">Rebook</a>
                                            <% if (canReviewBooking(booking) && !booking.review) { %>
                                                <a class="button secondary" href="#to-rate" data-profile-tab-link="to-rate">Leave Review</a>
                                            <% } %>
                                            <a class="button secondary" href="/receipt/<%= booking.id %>">View Receipt</a>
                                        </div>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>

                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">Cancelled</p>
                            <h2>Cancelled Bookings</h2>
                        </div>
                    </div>

                    <% if (!profileCancelledBookings.length) { %>
                        <p class="muted">No cancelled bookings.</p>
                    <% } else { %>
                        <div class="profile-booking-grid compact">
                            <% profileCancelledBookings.forEach((booking) => { %>
                                <article class="profile-booking-card is-cancelled">
                                    <img class="profile-booking-thumb" src="<%= booking.service_image_url || profileImageFallback %>" alt="<%= booking.service_name %> thumbnail" loading="lazy" onerror="this.src='<%= profileImageFallback %>'">
                                    <div class="profile-booking-card-main">
                                        <div class="profile-booking-card-head">
                                            <div>
                                                <strong><%= booking.service_name %></strong>
                                                <span><%= booking.merchant_name %> &middot; <%= formatBookingDate(booking.booking_date) %><%= booking.booking_time ? ` at ${booking.booking_time}` : '' %></span>
                                            </div>
                                            <span class="status-badge status-<%= booking.status %>"><%= formatBookingStatus(booking.status) %></span>
                                        </div>
                                        <dl class="profile-booking-meta">
                                            <div>
                                                <dt>Cancellation reason</dt>
                                                <dd><%= booking.cancellation_reason || 'Not provided' %></dd>
                                            </div>
                                            <div>
                                                <dt>Refund status</dt>
                                                <dd><%= formatRefundStatus(booking.refund_status) %></dd>
                                            </div>
                                            <div>
                                                <dt>Cancelled</dt>
                                                <dd><%= formatBookingDateTime(booking.cancelled_at) %></dd>
                                            </div>
                                        </dl>
                                        <% if (booking.supportEscalation) { %>
                                            <div class="profile-booking-support">
                                                <span>Need more help?</span>
                                                <a class="button secondary" href="/help-center">Contact Support</a>
                                            </div>
                                        <% } %>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>
                </section>

                <section id="to-rate" class="account-panel profile-tab-panel" data-profile-panel="to-rate">
                    <div class="profile-review-hub">
                        <div class="profile-review-hub-top">
                            <div>
                                <p class="eyebrow">Reviews</p>
                                <h2>My Rating</h2>
                            </div>
                            <p class="muted">Rate completed services and earn reward points.</p>
                        </div>

                        <div class="profile-review-hub-stats">
                            <article>
                                <strong><%= profileReviewableBookings.length %></strong>
                                <span>To rate</span>
                            </article>
                            <article>
                                <strong><%= profileReviewedBookings.length %></strong>
                                <span>My reviews</span>
                            </article>
                            <article>
                                <strong><%= profileReviewEarnedPoints %></strong>
                                <span>Points earned</span>
                            </article>
                        </div>

                        <div class="profile-review-hub-banner">
                            <strong>Review all and earn up to <%= profileReviewPotential %> pts</strong>
                            <span><%= profileReviewableBookings.length %> service<%= profileReviewableBookings.length === 1 ? '' : 's' %> waiting for review</span>
                        </div>

                        <div class="profile-review-hub-switcher" role="tablist" aria-label="Review sections">
                            <button class="is-active" type="button" data-review-tab-control="to-rate" aria-selected="true">To Rate</button>
                            <button type="button" data-review-tab-control="my-reviews" aria-selected="false">My Reviews</button>
                        </div>
                    </div>

                    <div data-review-tab-panel="to-rate">
                        <% if (!profileReviewableBookings.length) { %>
                            <p class="muted">No completed services waiting for review.</p>
                        <% } else { %>
                            <div class="profile-review-queue">
                                <% profileReviewableBookings.forEach((booking) => { %>
                                    <article class="profile-review-queue-card">
                                        <div class="profile-review-queue-card-head">
                                            <strong><%= booking.merchant_name %></strong>
                                            <span>Completed service ready to review</span>
                                        </div>
                                        <div class="profile-review-queue-card-body">
                                            <div class="profile-review-service-thumb" aria-hidden="true">
                                                <span><%= String(booking.service_name || 'S').charAt(0).toUpperCase() %></span>
                                            </div>
                                            <div class="profile-review-service-copy">
                                                <strong><%= booking.service_name %></strong>
                                                <span>
                                                    <%= new Date(booking.booking_date).toLocaleDateString('en-SG', { dateStyle: 'medium' }) %>
                                                    <% if (booking.booking_time) { %>
                                                        at <%= booking.booking_time %>
                                                    <% } %>
                                                </span>
                                                <span class="profile-booking-status-row">
                                                    <span class="status-badge status-<%= booking.status %>"><%= formatBookingStatus(booking.status) %></span>
                                                </span>
                                            </div>
                                            <div class="profile-review-service-action">
                                                <span class="profile-review-bonus-pill">Bonus +<%= profileReviewRewardMax %> pts</span>
                                                <a class="button primary" href="/receipt/<%= booking.id %>">View service</a>
                                            </div>
                                        </div>
                                        <div class="profile-review-queue-card-foot">
                                            <span>Rate to earn +10 pts</span>
                                            <span class="profile-review-star-outline" aria-hidden="true">&#9734;&#9734;&#9734;&#9734;&#9734;</span>
                                        </div>
                                        <div>
                                            <% if (canReviewBooking(booking)) { %>
                                                <details class="profile-booking-review-form">
                                                    <summary class="button secondary">Review now</summary>
                                                    <form action="/profile/bookings/<%= booking.id %>/review?_csrf=<%= encodeURIComponent(typeof csrfToken !== 'undefined' ? csrfToken : '') %>" method="POST" enctype="multipart/form-data">
                                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                        <div class="profile-review-reward-strip">
                                                            <p><span>Rate service</span><strong>+10 pts</strong></p>
                                                            <p><span>Add image or video</span><strong>+50 pts</strong></p>
                                                            <p><span>Write 50+ characters</span><strong>+10 pts</strong></p>
                                                        </div>
                                                        <label>
                                                            Rating
                                                            <span class="profile-star-rating" role="radiogroup" aria-label="Star rating">
                                                                <input type="radio" id="review-rating-<%= booking.id %>-5" name="rating" value="5" required>
                                                                <label for="review-rating-<%= booking.id %>-5" title="5 stars">&#9733;</label>
                                                                <input type="radio" id="review-rating-<%= booking.id %>-4" name="rating" value="4">
                                                                <label for="review-rating-<%= booking.id %>-4" title="4 stars">&#9733;</label>
                                                                <input type="radio" id="review-rating-<%= booking.id %>-3" name="rating" value="3">
                                                                <label for="review-rating-<%= booking.id %>-3" title="3 stars">&#9733;</label>
                                                                <input type="radio" id="review-rating-<%= booking.id %>-2" name="rating" value="2">
                                                                <label for="review-rating-<%= booking.id %>-2" title="2 stars">&#9733;</label>
                                                                <input type="radio" id="review-rating-<%= booking.id %>-1" name="rating" value="1">
                                                                <label for="review-rating-<%= booking.id %>-1" title="1 star">&#9733;</label>
                                                            </span>
                                                        </label>
                                                        <label>
                                                            Comment
                                                            <textarea name="comment" rows="3" maxlength="800" placeholder="Share your experience with this service."></textarea>
                                                        </label>
                                                        <label>
                                                            Photo
                                                            <input type="file" name="reviewImage" accept="image/*">
                                                        </label>
                                                        <label>
                                                            Video
                                                            <input type="file" name="reviewVideo" accept="video/*">
                                                        </label>
                                                        <button class="button primary" type="submit">Submit review</button>
                                                    </form>
                                                </details>
                                            <% } %>
                                        </div>
                                    </article>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>

                    <div id="my-reviews" data-review-tab-panel="my-reviews" hidden>
                        <div class="account-panel-header" style="margin-top: 2rem;">
                            <div>
                                <p class="eyebrow">Reviewed</p>
                                <h2>My Reviews</h2>
                            </div>
                        </div>

                        <% if (!profileReviewedBookings.length) { %>
                            <p class="muted">You have not submitted any reviews yet.</p>
                        <% } else { %>
                            <div class="profile-booking-grid compact">
                                <% profileReviewedBookings.forEach((booking) => { %>
                                    <article class="profile-booking-card profile-booking-card-no-thumb">
                                        <div class="profile-booking-card-main">
                                            <div class="profile-booking-card-head">
                                                <div>
                                                    <strong><%= booking.service_name %></strong>
                                                    <span><%= booking.merchant_name %> &middot; <%= formatBookingDate(booking.booking_date) %><%= booking.booking_time ? ` at ${booking.booking_time}` : '' %></span>
                                                </div>
                                                <span class="status-badge status-<%= booking.status %>"><%= formatBookingStatus(booking.status) %></span>
                                            </div>
                                            <div class="profile-booking-review-block">
                                                <strong>Your review</strong>
                                                <span><%- renderStars(booking.review.rating) %></span>
                                                <% if (booking.review.comment) { %>
                                                    <p><%= booking.review.comment %></p>
                                                <% } %>
                                                <% if (booking.review.imagePath || booking.review.videoPath) { %>
                                                    <div class="profile-review-media">
                                                        <% if (booking.review.imagePath) { %>
                                                            <a href="<%= booking.review.imagePath %>" target="_blank" rel="noopener">
                                                                <img src="<%= booking.review.imagePath %>" alt="Review photo for <%= booking.service_name %>">
                                                            </a>
                                                        <% } %>
                                                        <% if (booking.review.videoPath) { %>
                                                            <video controls preload="metadata">
                                                                <source src="<%= booking.review.videoPath %>">
                                                            </video>
                                                        <% } %>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div class="profile-booking-actions">
                                                <a class="button secondary" href="/receipt/<%= booking.id %>">View Receipt</a>
                                            </div>
                                        </div>
                                    </article>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </section>

                <section id="membership" class="account-panel account-membership-panel profile-tab-panel" data-profile-panel="membership">
                    <%
                        const profileVouchers = typeof userVouchers !== 'undefined' && Array.isArray(userVouchers) ? userVouchers : [];
                        const activeProfileVouchers = profileVouchers.filter((voucher) => voucher.status === 'active' && Number(voucher.remainingValue || 0) > 0);
                        const usedProfileVouchers = profileVouchers.filter((voucher) => voucher.status !== 'active' || Number(voucher.remainingValue || 0) <= 0);
                    %>
                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">Membership</p>
                            <h2>Rewards summary</h2>
                        </div>
                        <span class="membership-tier-badge <%= member.tier.toLowerCase() %>">
                            <span><%= member.tier %></span>
                            <small>Tier</small>
                        </span>
                    </div>

                    <div class="account-membership-strip">
                        <div>
                            <strong><%= member.points %></strong>
                            <span>Points</span>
                        </div>
                        <div>
                            <strong><%= Number.isFinite(profile.glintsBalance) ? profile.glintsBalance : 0 %></strong>
                            <span>VaniGlints</span>
                        </div>
                        <div>
                            <strong>$<%= cashbackBalance %></strong>
                            <span>Cashback</span>
                        </div>
                        <div>
                            <strong><%= favourites.length %></strong>
                            <span>Saved merchants</span>
                        </div>
                        <div>
                            <strong><%= cartCount %></strong>
                            <span>Cart items</span>
                        </div>
                    </div>

                    <div class="account-progress">
                        <div>
                            <span>Bronze</span>
                            <span>Platinum</span>
                        </div>
                        <div class="membership-progress" aria-label="Membership progress">
                            <span style="width:<%= member.progress %>%"></span>
                        </div>
                        <p class="muted">
                            <%= member.next > 0
                                ? member.next + " points to Platinum"
                                : "Maximum tier reached" %>
                        </p>
                    </div>

                    <div class="account-panel-header" style="margin-top: 2rem;">
                        <div>
                            <p class="eyebrow">Vouchers</p>
                            <h2>My rewards vouchers</h2>
                        </div>
                        <a class="button secondary" href="/reward-shop">Open reward shop</a>
                    </div>

                    <% if (!profileVouchers.length) { %>
                        <p class="muted">No vouchers yet. Redeem one from the reward shop or use a referral code at sign up.</p>
                    <% } else { %>
                        <% if (activeProfileVouchers.length) { %>
                            <div class="wallet-overview-grid">
                                <% activeProfileVouchers.forEach((voucher) => { %>
                                    <article class="wallet-balance-card">
                                        <span><%= voucher.sourceType === 'referral' ? 'Referral voucher' : 'Reward shop voucher' %></span>
                                        <strong>$<%= Number(voucher.remainingValue || voucher.voucherValue || 0).toFixed(2) %></strong>
                                        <small><%= voucher.title %> - <%= voucher.code %></small>
                                        <small><%= voucher.firstBookingOnly ? 'First paid booking only' : 'Use on eligible booking payment' %></small>
                                    </article>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="muted">No active vouchers available right now.</p>
                        <% } %>

                        <% if (usedProfileVouchers.length) { %>
                            <div class="wallet-activity-panel" style="margin-top: 1.5rem;">
                                <div class="wallet-section-heading">
                                    <div>
                                        <p class="eyebrow">History</p>
                                        <h3>Used or inactive vouchers</h3>
                                    </div>
                                    <span><%= usedProfileVouchers.length %> item<%= usedProfileVouchers.length === 1 ? '' : 's' %></span>
                                </div>
                                <div class="wallet-activity-list">
                                    <% usedProfileVouchers.forEach((voucher) => { %>
                                        <article class="wallet-activity-row">
                                            <div>
                                                <span class="wallet-activity-date"><%= voucher.redeemedAt ? new Date(voucher.redeemedAt).toLocaleDateString('en-SG', { dateStyle: 'medium' }) : new Date(voucher.createdAt).toLocaleDateString('en-SG', { dateStyle: 'medium' }) %></span>
                                                <strong><%= voucher.title %></strong>
                                                <small><%= voucher.code %></small>
                                            </div>
                                            <div class="wallet-activity-values">
                                                <span>$<%= Number(voucher.voucherValue || 0).toFixed(2) %></span>
                                                <span><%= voucher.status %></span>
                                            </div>
                                        </article>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    <% } %>
                </section>

                <section id="wallet" class="account-panel loyalty-profile-panel profile-tab-panel" data-profile-panel="wallet">
                    <%
                        const walletReceipts = typeof walletHistory !== 'undefined' && Array.isArray(walletHistory)
                            ? walletHistory
                            : [];
                        const walletReceiptMap = walletReceipts.reduce((map, receipt) => {
                            map[String(receipt.receiptId)] = receipt;
                            return map;
                        }, {});
                        const walletTransactions = loyalty && Array.isArray(loyalty.transactions)
                            ? loyalty.transactions
                            : [];
                    %>
                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">Wallet</p>
                            <h2>Loyalty wallet</h2>
                        </div>
                        <a class="button secondary" href="/profile/history">Purchase history</a>
                    </div>

                    <% if (loyalty) { %>
                        <div class="wallet-overview-grid">
                            <article class="wallet-balance-card wallet-balance-card-primary">
                                <span>Available points</span>
                                <strong><%= loyalty.wallet.pointsBalance %></strong>
                                <small><%= loyalty.rules.pointsPerDollar %> pts earned per $1 spent</small>
                            </article>
                            <article class="wallet-balance-card">
                                <span>Cashback balance</span>
                                <strong>$<%= Number(loyalty.wallet.cashbackBalance || 0).toFixed(2) %></strong>
                                <small>Usable during cart checkout</small>
                            </article>
                            <article class="wallet-balance-card">
                                <span>Lifetime points</span>
                                <strong><%= loyalty.wallet.lifetimePoints %></strong>
                                <small>Total rewards earned from paid receipts</small>
                            </article>
                        </div>

                        <div class="wallet-rules-grid">
                            <div>
                                <span>Cashback rate</span>
                                <strong><%= loyalty.rules.cashbackPercent %>%</strong>
                            </div>
                            <div>
                                <span>Minimum redeem</span>
                                <strong><%= loyalty.rules.minPointsToRedeem %> pts</strong>
                            </div>
                            <div>
                                <span>Points value</span>
                                <strong>$<%= Number(loyalty.rules.pointsToCashRate || 0).toFixed(2) %> / pt</strong>
                            </div>
                        </div>

                        <div class="wallet-content-grid">
                            <form class="wallet-redeem-card" action="/customer/wallet/redeem" method="POST">
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <div>
                                    <p class="eyebrow">Redeem</p>
                                    <h3>Convert points into cashback</h3>
                                    <p class="muted">Cashback will be added to your wallet and can be applied at checkout.</p>
                                </div>
                                <label>
                                    Points to convert
                                    <input type="number" name="points" min="<%= loyalty.rules.minPointsToRedeem %>" step="1" max="<%= loyalty.wallet.pointsBalance %>" value="<%= loyalty.wallet.pointsBalance >= loyalty.rules.minPointsToRedeem ? loyalty.rules.minPointsToRedeem : 0 %>" <%= loyalty.wallet.pointsBalance < loyalty.rules.minPointsToRedeem ? 'disabled' : '' %>>
                                </label>
                                <button class="button primary" type="submit" <%= loyalty.wallet.pointsBalance < loyalty.rules.minPointsToRedeem ? 'disabled' : '' %>>Redeem</button>
                            </form>

                            <div class="wallet-receipt-card">
                                <div class="wallet-section-heading">
                                    <div>
                                        <p class="eyebrow">Receipts</p>
                                        <h3>Recent linked receipts</h3>
                                    </div>
                                    <a class="text-button" href="/profile/history">View all</a>
                                </div>

                                <% if (!walletReceipts.length) { %>
                                    <p class="muted">No past paid receipts yet.</p>
                                <% } else { %>
                                    <div class="wallet-receipt-list">
                                        <% walletReceipts.slice(0, 5).forEach((receipt) => { %>
                                            <a class="wallet-receipt-row" href="/receipt/<%= receipt.receiptId %>">
                                                <span>
                                                    <strong>Receipt <%= receipt.id %></strong>
                                                    <small><%= receipt.itemNames %></small>
                                                </span>
                                                <span>
                                                    <strong>$<%= receipt.totalAmount.toFixed(2) %></strong>
                                                    <small><%= new Date(receipt.createdAt).toLocaleDateString('en-SG', { dateStyle: 'medium' }) %></small>
                                                </span>
                                            </a>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <div class="wallet-activity-panel">
                            <div class="wallet-section-heading">
                                <div>
                                    <p class="eyebrow">Activity</p>
                                    <h3>Past wallet activity</h3>
                                </div>
                                <span><%= walletTransactions.length %> entr<%= walletTransactions.length === 1 ? 'y' : 'ies' %></span>
                            </div>

                            <% if (!walletTransactions.length) { %>
                                <p class="muted">No wallet transactions yet. Complete a paid booking or checkout to earn rewards.</p>
                            <% } else { %>
                                <div class="wallet-activity-list">
                                    <% walletTransactions.forEach((entry) => { %>
                                        <% const linkedReceipt = entry.sourceReceiptId ? walletReceiptMap[String(entry.sourceReceiptId)] : null; %>
                                        <article class="wallet-activity-row">
                                            <div>
                                                <span class="wallet-activity-date"><%= new Date(entry.createdAt).toLocaleDateString('en-SG', { dateStyle: 'medium' }) %></span>
                                                <strong><%= entry.description %></strong>
                                                <% if (linkedReceipt) { %>
                                                    <small><%= linkedReceipt.itemNames %></small>
                                                <% } %>
                                            </div>
                                            <div class="wallet-activity-values">
                                                <span class="<%= entry.pointsDelta >= 0 ? 'positive' : 'negative' %>"><%= entry.pointsDelta > 0 ? '+' : '' %><%= entry.pointsDelta %> pts</span>
                                                <span class="<%= entry.cashbackDelta >= 0 ? 'positive' : 'negative' %>"><%= entry.cashbackDelta >= 0 ? '+' : '-' %>$<%= Math.abs(Number(entry.cashbackDelta || 0)).toFixed(2) %></span>
                                                <% if (entry.sourceReceiptId) { %>
                                                    <a class="button secondary" href="/receipt/<%= entry.sourceReceiptId %>">Receipt</a>
                                                <% } %>
                                            </div>
                                        </article>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <p class="muted">Wallet details could not be loaded right now.</p>
                    <% } %>
                </section>

                <% if (referral) { %>
                    <section id="referral" class="account-panel account-referral-panel profile-tab-panel" data-profile-panel="membership">
                        <div class="account-panel-header">
                            <div>
                                <p class="eyebrow">Referral</p>
                                <h2>Your referral code</h2>
                            </div>
                            <a class="button secondary" href="<%= referral.mailto %>">Invite by email</a>
                        </div>

                        <div class="referral-code-card">
                            <span>Share this code with friends</span>
                            <strong><%= referral.code %></strong>
                            <input type="text" value="<%= referral.link %>" readonly aria-label="Referral link">
                        </div>

                        <% if (typeof referralVoucherStatus !== 'undefined' && referralVoucherStatus && referralVoucherStatus.message) { %>
                            <p class="muted" style="margin: 1rem 0 0;">
                                <strong>Referral voucher status:</strong> <%= referralVoucherStatus.message %>
                            </p>
                        <% } %>

                        <div class="referral-metrics">
                            <div>
                                <strong>$<%= referral.discount %></strong>
                                <span>Friend discount</span>
                            </div>
                            <div>
                                <strong><%= referral.reward %></strong>
                                <span>Glints per successful referral</span>
                            </div>
                        </div>

                        <div class="referral-mini-tracker">
                            <div>
                                <span>Successful referrals</span>
                                <strong><%= referral.successfulReferrals || 0 %></strong>
                            </div>
                            <div>
                                <span>VaniGlints earned</span>
                                <strong><%= referral.earnedGlints || 0 %></strong>
                            </div>
                            <div>
                                <span>Next referral reward</span>
                                <strong>+<%= referral.nextReward || referral.reward %></strong>
                            </div>
                        </div>
                    </section>
                <% } %>

                <% if (favourites.length > 0) { %>
                    <section class="account-panel saved-merchants-panel profile-tab-panel" data-profile-panel="profile-details">
                        <div class="account-panel-header">
                            <div>
                                <p class="eyebrow">Saved</p>
                                <h2>Saved merchants</h2>
                            </div>
                            <a class="text-button" href="/services">Find more</a>
                        </div>

                        <div class="saved-merchant-list">
                            <% favourites.slice(0, 3).forEach((merchant) => { %>
                                <article class="saved-merchant-row">
                                    <div>
                                        <strong><%= merchant.name %></strong>
                                        <span><%= merchant.location %> &middot; Rating <%= merchant.rating %></span>
                                    </div>
                                    <a class="button secondary" href="/merchants/<%= merchant.id %>">View</a>
                                </article>
                            <% }) %>
                        </div>
                    </section>
                <% } %>
            <% } %>
        </div>
    </div>
</section>

<div class="profile-booking-modal" data-booking-modal="reschedule" hidden>
    <div class="profile-booking-modal-backdrop" data-close-booking-modal></div>
    <section class="profile-booking-modal-panel" role="dialog" aria-modal="true" aria-labelledby="reschedule-title">
        <button class="profile-modal-close" type="button" data-close-booking-modal aria-label="Close reschedule modal">&times;</button>
        <p class="eyebrow">Reschedule</p>
        <h2 id="reschedule-title">Choose a new appointment slot</h2>
        <p class="muted" data-reschedule-summary></p>
        <div class="profile-suggestion-strip" data-reschedule-suggestions></div>
        <form data-reschedule-form method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="responseType" value="json">
            <label>
                Available date
                <input type="date" name="bookingDate" data-reschedule-date required>
            </label>
            <div>
                <span class="profile-modal-label">Available times</span>
                <div class="profile-slot-grid" data-reschedule-slots></div>
            </div>
            <p class="profile-approval-note">Merchant approval may be required for changes close to the appointment time.</p>
            <p class="profile-modal-feedback" data-reschedule-feedback></p>
            <div class="profile-modal-actions">
                <button class="button secondary" type="button" data-close-booking-modal>Back</button>
                <button class="button primary" type="submit">Submit Reschedule</button>
            </div>
        </form>
    </section>
</div>

<div class="profile-booking-modal" data-booking-modal="cancel" hidden>
    <div class="profile-booking-modal-backdrop" data-close-booking-modal></div>
    <section class="profile-booking-modal-panel" role="dialog" aria-modal="true" aria-labelledby="cancel-title">
        <button class="profile-modal-close" type="button" data-close-booking-modal aria-label="Close cancellation modal">&times;</button>
        <p class="eyebrow">Cancel booking</p>
        <h2 id="cancel-title">Confirm cancellation</h2>
        <p class="muted" data-cancel-summary></p>
        <div class="profile-policy-box">
            <strong>Cancellation policy</strong>
            <span>Cancel at least 24 hours before your appointment for standard refund eligibility. Later cancellations may need merchant or admin review.</span>
        </div>
        <div class="profile-policy-box">
            <strong>Refund eligibility</strong>
            <span data-cancel-refund>Eligibility will be calculated from the appointment time.</span>
        </div>
        <form data-cancel-form method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="responseType" value="json">
            <label>
                Cancellation reason
                <select name="reason" required>
                    <option value="">Select a reason</option>
                    <option value="Unable to attend">Unable to attend</option>
                    <option value="Need a different time">Need a different time</option>
                    <option value="Booked by mistake">Booked by mistake</option>
                    <option value="Payment issue">Payment issue</option>
                    <option value="Other">Other</option>
                </select>
            </label>
            <label class="profile-confirm-check">
                <input type="checkbox" name="finalConfirmation" required>
                <span>I understand this will cancel my booking.</span>
            </label>
            <p class="profile-modal-feedback" data-cancel-feedback></p>
            <div class="profile-modal-actions">
                <button class="button secondary" type="button" data-close-booking-modal>Back</button>
                <button class="button primary danger-button" type="submit">Cancel Booking</button>
            </div>
        </form>
    </section>
</div>

<script>
    (() => {
        const tabs = Array.from(document.querySelectorAll('[data-profile-tab]'));
        const panels = Array.from(document.querySelectorAll('[data-profile-panel]'));
        const reviewTabControls = Array.from(document.querySelectorAll('[data-review-tab-control]'));
        const reviewTabPanels = Array.from(document.querySelectorAll('[data-review-tab-panel]'));

        if (!tabs.length || !panels.length) {
            return;
        }

        const defaultPanel = tabs[0].dataset.profileTab;
        const defaultReviewPanel = reviewTabControls[0]?.dataset.reviewTabControl || 'to-rate';
        const showPanel = (panelName) => {
            const targetPanel = panels.some((panel) => panel.dataset.profilePanel === panelName)
                ? panelName
                : defaultPanel;

            panels.forEach((panel) => {
                panel.hidden = panel.dataset.profilePanel !== targetPanel;
            });

            tabs.forEach((tab) => {
                const isActive = tab.dataset.profileTab === targetPanel;
                tab.classList.toggle('is-active', isActive);
                tab.setAttribute('aria-current', isActive ? 'page' : 'false');
            });
        };

        const showReviewPanel = (panelName) => {
            if (!reviewTabControls.length || !reviewTabPanels.length) {
                return;
            }

            const targetPanel = reviewTabPanels.some((panel) => panel.dataset.reviewTabPanel === panelName)
                ? panelName
                : defaultReviewPanel;

            reviewTabPanels.forEach((panel) => {
                panel.hidden = panel.dataset.reviewTabPanel !== targetPanel;
            });

            reviewTabControls.forEach((control) => {
                const isActive = control.dataset.reviewTabControl === targetPanel;
                control.classList.toggle('is-active', isActive);
                control.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });
        };

        tabs.forEach((tab) => {
            tab.addEventListener('click', (event) => {
                event.preventDefault();
                const panelName = tab.dataset.profileTab;
                history.replaceState(null, '', `#${panelName}`);
                showPanel(panelName);
                if (panelName === 'to-rate') {
                    showReviewPanel('to-rate');
                }
            });
        });

        document.querySelectorAll('[data-profile-tab-link]').forEach((link) => {
            link.addEventListener('click', (event) => {
                event.preventDefault();
                const panelName = link.dataset.profileTabLink;
                history.replaceState(null, '', `#${panelName}`);
                showPanel(panelName);
                if (panelName === 'to-rate') {
                    showReviewPanel('to-rate');
                }
            });
        });

        reviewTabControls.forEach((control) => {
            control.addEventListener('click', () => {
                const panelName = control.dataset.reviewTabControl;
                history.replaceState(null, '', panelName === 'my-reviews' ? '#my-reviews' : '#to-rate');
                showPanel('to-rate');
                showReviewPanel(panelName);
            });
        });

        const hash = window.location.hash.replace('#', '');
        if (hash === 'my-reviews') {
            showPanel('to-rate');
            showReviewPanel('my-reviews');
            return;
        }

        showPanel(hash || defaultPanel);
        showReviewPanel(hash === 'to-rate' ? 'to-rate' : defaultReviewPanel);
    })();

    (() => {
        const rescheduleModal = document.querySelector('[data-booking-modal="reschedule"]');
        const cancelModal = document.querySelector('[data-booking-modal="cancel"]');
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const fallbackSlots = ['10:00', '11:30', '13:00', '14:30', '16:00', '17:30'];
        let activeCard = null;
        let activeBooking = null;

        const parseBooking = (card) => {
            try {
                return JSON.parse(decodeURIComponent(card.dataset.booking || ''));
            } catch (error) {
                return null;
            }
        };

        const toDateKey = (date) => {
            const localDate = new Date(date.getTime() - (date.getTimezoneOffset() * 60000));
            return localDate.toISOString().slice(0, 10);
        };

        const nextDates = (count = 7) => {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            return Array.from({ length: count }, (_, index) => {
                const date = new Date(today);
                date.setDate(today.getDate() + index);
                return toDateKey(date);
            });
        };

        const formatDateLabel = (dateKey) => new Date(`${dateKey}T00:00:00`).toLocaleDateString('en-SG', {
            weekday: 'short',
            month: 'short',
            day: 'numeric'
        });

        const isTaken = (booking, dateKey, slot) => (booking.taken || []).includes(`${dateKey}|${slot}`);

        const closeModals = () => {
            [rescheduleModal, cancelModal].forEach((modal) => {
                if (modal) {
                    modal.hidden = true;
                }
            });
            document.body.classList.remove('profile-modal-open');
        };

        const openModal = (modal) => {
            if (!modal) {
                return;
            }

            modal.hidden = false;
            document.body.classList.add('profile-modal-open');
            modal.querySelector('button, input, select')?.focus();
        };

        const renderSlots = (dateKey) => {
            const slotWrap = rescheduleModal.querySelector('[data-reschedule-slots]');
            const slots = activeBooking.slots?.length ? activeBooking.slots : fallbackSlots;
            slotWrap.innerHTML = '';

            slots.forEach((slot, index) => {
                const id = `reschedule-${activeBooking.id}-${dateKey}-${slot.replace(':', '')}`;
                const label = document.createElement('label');
                label.className = 'profile-slot-choice';
                label.innerHTML = `
                    <input type="radio" name="bookingTime" id="${id}" value="${slot}" ${isTaken(activeBooking, dateKey, slot) ? 'disabled' : ''} ${index === 0 && !isTaken(activeBooking, dateKey, slot) ? 'checked' : ''}>
                    <span>${slot}</span>
                `;
                slotWrap.appendChild(label);
            });
        };

        const renderSuggestions = () => {
            const suggestionWrap = rescheduleModal.querySelector('[data-reschedule-suggestions]');
            const slots = activeBooking.slots?.length ? activeBooking.slots : fallbackSlots;
            const suggestions = [];

            nextDates(10).some((dateKey) => {
                slots.forEach((slot) => {
                    if (suggestions.length < 3 && !isTaken(activeBooking, dateKey, slot)) {
                        suggestions.push({ dateKey, slot });
                    }
                });
                return suggestions.length >= 3;
            });

            suggestionWrap.innerHTML = suggestions.map((item) => `
                <button type="button" data-suggestion-date="${item.dateKey}" data-suggestion-time="${item.slot}">
                    ${item.label ? `<span>${item.label}</span>` : ''}${formatDateLabel(item.dateKey)} <strong>${item.slot}</strong>
                </button>
            `).join('');

            fetch(`/profile/bookings/${activeBooking.id}/reschedule-suggestions`, {
                headers: {
                    Accept: 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then((response) => response.ok ? response.json() : null)
                .then((data) => {
                    if (!data?.success || !Array.isArray(data.suggestions) || !data.suggestions.length) {
                        return;
                    }

                    suggestionWrap.innerHTML = data.suggestions.slice(0, 3).map((item) => `
                        <button type="button" data-suggestion-date="${item.dateKey}" data-suggestion-time="${item.slot}">
                            <span>${item.label || 'Suggested slot'}</span>${formatDateLabel(item.dateKey)} <strong>${item.slot}</strong>
                        </button>
                    `).join('');
                })
                .catch(() => {});
        };

        const updateCancellationRefund = () => {
            const output = cancelModal.querySelector('[data-cancel-refund]');
            const appointment = new Date(`${activeBooking.bookingDate}T${activeBooking.bookingTime || '23:59'}:00`);
            const hours = (appointment.getTime() - Date.now()) / 3600000;
            output.textContent = hours >= 24
                ? 'Eligible for standard refund review.'
                : 'Late cancellation: refund may require merchant or admin review.';
        };

        document.querySelectorAll('[data-open-reschedule]').forEach((button) => {
            button.addEventListener('click', () => {
                activeCard = button.closest('[data-booking-card]');
                activeBooking = parseBooking(activeCard);

                if (!activeBooking) {
                    return;
                }

                rescheduleModal.querySelector('[data-reschedule-summary]').textContent = `${activeBooking.serviceName} at ${activeBooking.merchantName}`;
                rescheduleModal.querySelector('[data-reschedule-form]').action = `/profile/bookings/${activeBooking.id}/reschedule`;
                rescheduleModal.querySelector('[data-reschedule-feedback]').textContent = '';
                const dateInput = rescheduleModal.querySelector('[data-reschedule-date]');
                dateInput.min = toDateKey(new Date());
                dateInput.value = activeBooking.bookingDate || dateInput.min;
                renderSuggestions();
                renderSlots(dateInput.value);
                openModal(rescheduleModal);
            });
        });

        document.querySelectorAll('[data-open-cancel]').forEach((button) => {
            button.addEventListener('click', () => {
                activeCard = button.closest('[data-booking-card]');
                activeBooking = parseBooking(activeCard);

                if (!activeBooking) {
                    return;
                }

                cancelModal.querySelector('[data-cancel-summary]').textContent = `${activeBooking.serviceName} at ${activeBooking.merchantName} on ${activeBooking.bookingDate} ${activeBooking.bookingTime || ''}`;
                cancelModal.querySelector('[data-cancel-form]').action = `/profile/bookings/${activeBooking.id}/cancel`;
                cancelModal.querySelector('[data-cancel-feedback]').textContent = '';
                cancelModal.querySelector('[data-cancel-form]').reset();
                updateCancellationRefund();
                openModal(cancelModal);
            });
        });

        rescheduleModal?.querySelector('[data-reschedule-date]')?.addEventListener('change', (event) => {
            renderSlots(event.target.value);
        });

        rescheduleModal?.querySelector('[data-reschedule-suggestions]')?.addEventListener('click', (event) => {
            const button = event.target.closest('[data-suggestion-date]');
            if (!button) {
                return;
            }

            const dateInput = rescheduleModal.querySelector('[data-reschedule-date]');
            dateInput.value = button.dataset.suggestionDate;
            renderSlots(button.dataset.suggestionDate);
            const radio = rescheduleModal.querySelector(`input[name="bookingTime"][value="${button.dataset.suggestionTime}"]`);
            if (radio && !radio.disabled) {
                radio.checked = true;
            }
        });

        document.querySelectorAll('[data-close-booking-modal]').forEach((button) => {
            button.addEventListener('click', closeModals);
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeModals();
            }
        });

        const submitJsonForm = (form, feedback, onSuccess) => {
            feedback.textContent = '';
            const formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: new URLSearchParams(formData),
                headers: {
                    Accept: 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRF-Token': csrfToken
                }
            })
                .then(async (response) => {
                    const contentType = response.headers.get('content-type') || '';

                    if (response.redirected && response.ok && !contentType.includes('application/json')) {
                        return {
                            success: true,
                            redirected: true,
                            redirectUrl: response.url
                        };
                    }

                    const data = contentType.includes('application/json')
                        ? await response.json()
                        : { message: response.redirected ? 'Your session may have expired. Please refresh and try again.' : await response.text() };

                    if (!response.ok || !data.success) {
                        const message = String(data.message || 'Request failed.')
                            .replace(/<[^>]*>/g, ' ')
                            .replace(/\s+/g, ' ')
                            .trim();
                        throw new Error(message || 'Request failed.');
                    }

                    return data;
                })
                .then(onSuccess)
                .catch((error) => {
                    feedback.textContent = error.message;
                });
        };

        rescheduleModal?.querySelector('[data-reschedule-form]')?.addEventListener('submit', (event) => {
            event.preventDefault();
            submitJsonForm(event.currentTarget, rescheduleModal.querySelector('[data-reschedule-feedback]'), (data) => {
                if (data.redirected) {
                    window.location.href = '/profile#bookings';
                    window.location.reload();
                    return;
                }

                const booking = data.booking || {};
                const statusBadge = activeCard.querySelector('[data-booking-status]');

                if (data.pendingReview) {
                    if (statusBadge) {
                        statusBadge.textContent = 'reschedule review';
                        statusBadge.className = 'status-badge status-pending';
                    }
                    rescheduleModal.querySelector('[data-reschedule-feedback]').textContent = data.message || 'Request sent for merchant review.';
                    setTimeout(closeModals, 900);
                    return;
                }

                const displayDate = new Date(`${booking.bookingDate}T00:00:00`).toLocaleDateString('en-SG', { dateStyle: 'medium' });
                activeCard.querySelector('[data-booking-datetime]').textContent = `${displayDate} at ${booking.bookingTime}`;
                if (statusBadge) {
                    statusBadge.textContent = booking.status || 'pending';
                }
                activeBooking.bookingDate = booking.bookingDate;
                activeBooking.bookingTime = booking.bookingTime;
                activeCard.dataset.booking = encodeURIComponent(JSON.stringify(activeBooking));
                closeModals();
            });
        });

        cancelModal?.querySelector('[data-cancel-form]')?.addEventListener('submit', (event) => {
            event.preventDefault();
            submitJsonForm(event.currentTarget, cancelModal.querySelector('[data-cancel-feedback]'), () => {
                activeCard.remove();
                closeModals();
                window.location.reload();
            });
        });
    })();
</script>

<%- include('partials/footer') %>
