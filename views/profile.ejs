                            <% profilePastBookings.forEach((booking) => { %>
                                <article class="profile-booking-card profile-booking-card-no-thumb">
                                    <div class="profile-booking-card-main">
                                        <div class="profile-booking-card-head">
                                            <div>
                                                <strong><%= booking.service_name %></strong>
                                                <span><%= booking.merchant_name %> &middot; <%= formatBookingDate(booking.booking_date) %><%= booking.booking_time ? ` at ${booking.booking_time}` : '' %></span>
                                            </div>
                                            <span class="status-badge status-<%= booking.status %>"><%= formatBookingStatus(booking.status) %></span>
                                        </div>
                                        <div class="profile-booking-actions">
                                            <a class="button secondary" href="/booking/<%= booking.merchant_id %>?serviceId=<%= booking.service_id %>">Rebook</a>
                                            <% if (canReviewBooking(booking) && !booking.review) { %>
                                                <a class="button secondary" href="#history" data-profile-tab-link="history">Leave Review</a>
                                            <% } %>
                                            <a class="button secondary" href="/receipt/<%= booking.id %>">View Receipt</a>
                                        </div>
                                        <% if (Number(booking.reward_discount_amount || 0) > 0 || (String(booking.status || '').toLowerCase() === 'completed' && Number(booking.booking_points_awarded || 0) > 0)) { %>
                                            <dl class="profile-booking-meta">
                                                <% if (String(booking.status || '').toLowerCase() === 'completed' && Number(booking.booking_points_awarded || 0) > 0) { %>
                                                    <div>
                                                        <dt>Appointment completed</dt>
                                                        <dd><%= Number(booking.booking_points_awarded || 0) %> loyalty points have been added to your wallet</dd>
                                                    </div>
                                                <% } %>
                                                <% if (Number(booking.reward_discount_amount || 0) > 0) { %>
                                                <div>
                                                    <dt>Points discount</dt>
                                                    <dd>-<%= formatMoney(booking.reward_discount_amount) %> (<%= Number(booking.points_redeemed || 0) %> pts)</dd>
                                                </div>
                                                <div>
                                                    <dt>Amount payable at merchant</dt>
                                                    <dd><%= formatMoney(Number(Number(booking.reward_discount_amount || 0) > 0 ? booking.final_amount_payable || 0 : booking.final_amount_payable || booking.service_price || 0)) %></dd>
                                                </div>
                                                <% } %>
                                            </dl>
                                        <% } %>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>

                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">Cancelled</p>
                            <h2>Cancelled Bookings</h2>
                        </div>
                    </div>

                    <% if (!profileCancelledBookings.length) { %>
                        <p class="muted">No cancelled bookings.</p>
                    <% } else { %>
                        <div class="profile-booking-grid compact">
                            <% profileCancelledBookings.forEach((booking) => { %>
                                <article class="profile-booking-card profile-booking-card-no-thumb is-cancelled">
                                    <div class="profile-booking-card-main">
                                        <div class="profile-booking-card-head">
                                            <div>
                                                <strong><%= booking.service_name %></strong>
                                                <span><%= booking.merchant_name %> &middot; <%= formatBookingDate(booking.booking_date) %><%= booking.booking_time ? ` at ${booking.booking_time}` : '' %></span>
                                            </div>
                                            <span class="status-badge status-<%= booking.status %>"><%= formatBookingStatus(booking.status) %></span>
                                        </div>
                                        <dl class="profile-booking-meta">
                                            <div>
                                                <dt>Cancellation reason</dt>
                                                <dd><%= booking.cancellation_reason || 'Not provided' %></dd>
                                            </div>
                                            <div>
                                                <dt>Refund status</dt>
                                                <dd><%= formatRefundStatus(booking.refund_status) %></dd>
                                            </div>
                                            <% if (Number(booking.reward_discount_amount || 0) > 0) { %>
                                                <div>
                                                    <dt>Points discount</dt>
                                                    <dd>-<%= formatMoney(booking.reward_discount_amount) %> (<%= Number(booking.points_redeemed || 0) %> pts)</dd>
                                                </div>
                                                <div>
                                                    <dt>Points refund</dt>
                                                    <dd><%= booking.reward_points_refunded_at ? 'Refunded' : 'Not refunded' %></dd>
                                                </div>
                                            <% } %>
                                            <div>
                                                <dt>Cancelled</dt>
                                                <dd><%= formatBookingDateTime(booking.cancelled_at) %></dd>
                                            </div>
                                        </dl>
                                        <% if (booking.supportEscalation) { %>
                                            <div class="profile-booking-support">
                                                <span>Need more help?</span>
                                                <a class="button secondary" href="/help-center">Contact Support</a>
                                            </div>
                                        <% } %>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>
                </section>

                <section id="history" class="account-panel profile-tab-panel" data-profile-panel="history">
                    <div class="account-panel-header">
                        <div>
                            <p class="eyebrow">Purchase history</p>
                            <h2>Recent purchases</h2>
                        </div>
                        <a class="button secondary" href="/profile/history">View full history</a>
                    </div>

                    <% if (!profilePurchaseHistory.length) { %>
                        <p class="muted">No purchases yet.</p>
                    <% } else { %>
                        <div class="profile-wallet-list profile-history-list">
                            <% profilePurchaseHistory.slice(0, 8).forEach((entry) => { %>
                                <div class="profile-wallet-row">
                                    <div>
                                        <span><%= entry.type %></span>
                                        <strong><%= entry.itemNames || 'Purchase' %></strong>
                                        <small><%= formatBookingDateTime(entry.createdAt) %></small>
                                        <% if (entry.supportEscalation && entry.supportEscalation.status === 'more_information_required') { %>
                                            <small><strong>Refund needs more information</strong></small>
                                        <% } %>
                                    </div>
                                    <div>
                                        <strong><%= formatMoney(Number(entry.remainingPaidAmount || entry.totalAmount || 0)) %></strong>
                                        <small><%= entry.paymentMethodLabel || entry.paymentMethod || 'Payment' %> · <%= entry.paymentStatusLabel || entry.paymentStatus || 'paid' %></small>
                                        <% if (entry.refund && Number(entry.refund.grossRefundTotal || 0) > 0) { %>
                                            <small><strong><%= formatRefundBadge(entry.refundStatus) %></strong></small>
                                            <small>Gross approved <%= formatMoney(entry.refund.grossRefundTotal) %>; external cash <%= formatMoney(entry.refund.externalRefundTotal || entry.refund.netRefundTotal) %></small>
                                            <% if (Number(entry.refund.walletRestoredTotal || 0) > 0) { %>
                                                <small>Wallet restored <%= formatMoney(entry.refund.walletRestoredTotal) %></small>
                                            <% } %>
                                            <% if (Number(entry.refund.pointsRestoredTotal || 0) > 0 || Number(entry.refund.pointsReversedTotal || 0) > 0) { %>
                                                <small>Points restored <%= Number(entry.refund.pointsRestoredTotal || 0) %>; reversed <%= Number(entry.refund.pointsReversedTotal || 0) %></small>
                                            <% } %>
                                            <% if (Number(entry.refund.cashbackRestoredTotal || 0) > 0 || Number(entry.refund.cashbackReversedTotal || 0) > 0) { %>
                                                <small>Cashback restored <%= formatMoney(entry.refund.cashbackRestoredTotal) %>; reversed <%= formatMoney(entry.refund.cashbackReversedTotal) %></small>
                                            <% } %>
                                            <small>Latest refund <%= entry.refund.latestRefundReference || '' %> <%= entry.refund.latestRefundDate ? formatBookingDateTime(entry.refund.latestRefundDate) : '' %></small>
                                        <% } %>
                                        <span class="inline-actions">
                                            <a class="button secondary" href="/receipt/<%= encodeURIComponent(entry.receiptId) %>">Receipt</a>
                                            <% if (entry.supportEscalation && entry.supportEscalation.status === 'more_information_required') { %>
                                                <a class="button primary" href="/help-center#support-tickets">Add Information</a>
                                            <% } else if (entry.supportEscalation) { %>
                                                <a class="button secondary" href="/help-center#support-tickets">Refund Request</a>
                                            <% } %>
                                        </span>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>

                    <div class="profile-history-review-heading">
                        <p class="eyebrow">Reviews</p>
                        <h2>Ratings and reviews</h2>
                    </div>
                    <div class="profile-review-hub">
                        <div class="profile-review-hub-top">
                            <div>
                                <p class="eyebrow">Reviews</p>
                                <h2>My Rating</h2>
                            </div>
                            <p class="muted">Rate completed services and received products to earn reward points.</p>
                        </div>

                        <div class="profile-review-hub-stats">
                            <article>
                                <strong><%= profileReviewableBookings.length %></strong>
                                <span>To rate</span>
                            </article>
                            <article>
                                <strong><%= profileReviewedBookings.length %></strong>
                                <span>My reviews</span>
                            </article>
                            <article>
                                <strong><%= profileReviewEarnedPoints %></strong>
                                <span>Points earned</span>
                            </article>
                        </div>

                        <div class="profile-review-hub-banner">
                            <strong>Review all and earn up to <%= profileReviewPotential %> pts</strong>
