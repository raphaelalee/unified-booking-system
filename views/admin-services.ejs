<%- include('partials/header', { title }) %>

<%
    const serviceList = Array.isArray(services) ? services : [];
    const merchantOptions = [...new Set(serviceList.map((service) => service.salonName).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const categoryOptions = [...new Set(serviceList.map((service) => service.category).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const slotCount = serviceList.reduce((total, service) => total + (Array.isArray(service.slots) ? service.slots.length : 0), 0);
    const packageCount = serviceList.filter((service) => service.packageEnabled).length;
    const hasServicePerformanceData = serviceList.some((service) => {
        return Number(service.sales || 0) > 0
            || Number(service.bookingCount || 0) > 0
            || Number(service.rating || 0) > 0
            || Number(service.reviewCount || 0) > 0;
    });
    const aiFeaturedServicePayload = JSON.stringify({
        serviceStatistics: serviceList.map((service) => ({
            serviceId: service.id,
            serviceName: service.name,
            merchantId: service.salonId,
            merchantName: service.salonName,
            sales: service.sales || 0,
            bookingCount: service.bookingCount || 0,
            rating: service.rating || 0,
            reviewCount: service.reviewCount || 0,
            repeatBookingRate: service.repeatBookingRate || 0,
            cancellationRate: service.cancellationRate || 0,
            profitMargin: service.profitMargin || null,
            currentPromotionStatus: service.currentPromotionStatus || '',
            price: service.price || 0,
            slotCount: Array.isArray(service.slots) ? service.slots.length : 0,
            hasPerformanceData: Boolean(Number(service.sales || 0) > 0
                || Number(service.bookingCount || 0) > 0
                || Number(service.rating || 0) > 0
                || Number(service.reviewCount || 0) > 0)
        })),
        hasPerformanceData: hasServicePerformanceData
    }).replace(/</g, '\\u003c');
%>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <%- include('partials/admin-marketplace-tabs') %>

        <header class="admin-dashboard-header marketplace-admin-header">
            <div>
                <p class="eyebrow">Admin Marketplace</p>
                <h1>Services</h1>
                <p>Create, edit, and review bookable services across every merchant salon. Merchant updates write to this same service catalogue.</p>
            </div>
            <a class="button primary" href="/admin/services/new">Add service</a>
        </header>

        <% if (success) { %><div class="notice success"><p><%= success %></p></div><% } %>
        <% if (error) { %><div class="notice error"><p><%= error %></p></div><% } %>

        <section class="marketplace-admin-panel">
            <div class="marketplace-stat-grid">
                <article><span>Services</span><strong><%= serviceList.length %></strong></article>
                <article><span>Merchants</span><strong><%= merchantOptions.length %></strong></article>
                <article><span>Slots</span><strong><%= slotCount %></strong></article>
                <article><span>Packages</span><strong><%= packageCount %></strong></article>
            </div>

            <section class="admin-panel" data-ai-featured-panel="services">
                <div class="admin-panel-heading">
                    <div>
                        <p class="eyebrow">AI assistant</p>
                        <h2>Featured service recommendations</h2>
                        <p class="muted">Ranks services for admin review. No featured status is changed automatically.</p>
                    </div>
                    <button class="button primary" type="button" data-ai-featured-button="services">Generate recommendations</button>
                </div>
                <div class="notice" data-ai-featured-status="services" hidden></div>
                <div class="service-catalog-grid unified-service-grid" data-ai-featured-results="services" hidden></div>
            </section>

            <div class="marketplace-admin-toolbar">
                <div>
                    <p class="eyebrow">Service Records</p>
                    <h2>Bookable catalogue</h2>
                </div>
                <div class="marketplace-filter-row">
                    <label>
                        <span class="sr-only">Search services</span>
                        <input class="js-marketplace-search" type="search" placeholder="Search service, merchant, category">
                    </label>
                    <label>
                        <span class="sr-only">Filter by merchant</span>
                        <select class="js-marketplace-merchant-filter">
                            <option value="">All merchants</option>
                            <% merchantOptions.forEach((merchantName) => { %>
                                <option value="<%= merchantName %>"><%= merchantName %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        <span class="sr-only">Filter by category</span>
                        <select class="js-marketplace-category-filter">
                            <option value="">All categories</option>
                            <% categoryOptions.forEach((category) => { %>
                                <option value="<%= category %>"><%= category %></option>
                            <% }) %>
                        </select>
                    </label>
                </div>
            </div>

            <% if (serviceList.length === 0) { %>
                <div class="empty-state marketplace-empty-state">
                    <h2>No services yet</h2>
                    <p class="muted">Create a service for a merchant so customers can book appointments.</p>
                    <a class="button primary" href="/admin/services/new">Add service</a>
                </div>
            <% } else { %>
                <div class="admin-table-wrap marketplace-table-wrap">
                    <table class="admin-table marketplace-admin-table">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th>Merchant</th>
                                <th>Category</th>
                                <th>Duration</th>
                                <th>Price</th>
                                <th>Slots</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% serviceList.forEach((service) => { %>
                                <tr class="js-marketplace-row" data-merchant="<%= service.salonName || '' %>" data-category="<%= service.category || '' %>" data-search="<%= `${service.name || ''} ${service.salonName || ''} ${service.category || ''} ${service.description || ''}` %>">
                                    <td>
                                        <strong><%= service.name %></strong>
                                        <small><%= service.description || 'No description set.' %></small>
                                    </td>
                                    <td>
                                        <strong><%= service.salonName %></strong>
                                        <small><%= service.salonAddress || 'No address set' %></small>
                                    </td>
                                    <td><span class="sync-pill"><%= service.category || 'Service' %></span></td>
                                    <td><%= service.duration %></td>
                                    <td>$<%= Number(service.price || 0).toFixed(2) %></td>
                                    <td><%= Array.isArray(service.slots) ? service.slots.length : 0 %></td>
                                    <td>
                                        <div class="marketplace-action-row">
                                            <a class="button secondary compact" href="/admin/services/<%= service.id %>/edit">Edit</a>
                                            <form action="/admin/services/<%= service.id %>/delete" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button class="button secondary compact danger-button" type="submit">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </div>
</section>

<script>
    (() => {
        const aiPayload = <%- aiFeaturedServicePayload %>;
        const aiButton = document.querySelector('[data-ai-featured-button="services"]');
        const aiStatus = document.querySelector('[data-ai-featured-status="services"]');
        const aiResults = document.querySelector('[data-ai-featured-results="services"]');
        const search = document.querySelector('.js-marketplace-search');
        const merchant = document.querySelector('.js-marketplace-merchant-filter');
        const category = document.querySelector('.js-marketplace-category-filter');
        const rows = Array.from(document.querySelectorAll('.js-marketplace-row'));
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
        const setAiStatus = (message, isError = false) => {
            if (!aiStatus) return;
            aiStatus.hidden = !message;
            aiStatus.classList.toggle('error', Boolean(isError));
            aiStatus.textContent = message || '';
        };

        aiButton?.addEventListener('click', async () => {
            aiButton.disabled = true;
            aiButton.textContent = 'Generating...';
            setAiStatus('Generating featured service recommendations...');
            if (aiResults) {
                aiResults.hidden = true;
                aiResults.innerHTML = '';
            }

            try {
                const response = await fetch('/api/ai/featured-services', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
                    body: JSON.stringify(aiPayload)
                });
                const payload = await response.json();
                if (!response.ok) throw new Error(payload.message || 'Featured service recommendations could not be generated.');
                const services = Array.isArray(payload.featuredServices) ? payload.featuredServices : [];
                if (!services.length) {
                    setAiStatus(payload.summary || 'No featured service recommendations were returned.');
                    return;
                }
                aiResults.hidden = false;
                const hasPerformanceData = Boolean(payload.hasPerformanceData || aiPayload.hasPerformanceData);
                aiResults.innerHTML = services.map((service, index) => `
                    <article class="service-catalog-card unified-service-card">
                        <div class="portal-card-header">
                            <span class="tag">${hasPerformanceData ? `${escapeHtml(Math.round(Number(service.score || 0)))} score` : `Rank #${index + 1}`}</span>
                            <span class="service-price slim">${escapeHtml(service.recommendedFeaturePeriod || '')}</span>
                        </div>
                        <h3>${escapeHtml(service.serviceName)}</h3>
                        <p class="muted">${escapeHtml(service.merchantName)}</p>
                        <p>${escapeHtml(service.reason)}</p>
                        <div class="service-card-actions ai-featured-actions">
                            <a class="button primary" href="/admin/services/${encodeURIComponent(service.serviceId)}/edit">Open to feature</a>
                        </div>
                    </article>
                `).join('');
                setAiStatus(hasPerformanceData
                    ? (payload.summary || 'Featured service recommendations generated.')
                    : 'Performance stats are not available yet, so AI ranked services using listing data instead of showing score.');
            } catch (error) {
                setAiStatus(error.message || 'Featured service recommendations could not be generated.', true);
            } finally {
                aiButton.disabled = false;
                aiButton.textContent = 'Generate recommendations';
            }
        });

        const applyFilters = () => {
            const query = (search?.value || '').trim().toLowerCase();
            const selectedMerchant = (merchant?.value || '').trim().toLowerCase();
            const selectedCategory = (category?.value || '').trim().toLowerCase();

            rows.forEach((row) => {
                const haystack = (row.dataset.search || '').toLowerCase();
                const merchantName = (row.dataset.merchant || '').toLowerCase();
                const categoryName = (row.dataset.category || '').toLowerCase();
                row.hidden = Boolean(query && !haystack.includes(query))
                    || Boolean(selectedMerchant && merchantName !== selectedMerchant)
                    || Boolean(selectedCategory && categoryName !== selectedCategory);
            });
        };

        search?.addEventListener('input', applyFilters);
        merchant?.addEventListener('change', applyFilters);
        category?.addEventListener('change', applyFilters);
    })();
</script>

<%- include('partials/footer') %>
