<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title><%= title %> | Vaniday</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <% if ((typeof useBootstrap !== 'undefined' && useBootstrap) || (currentUser && ['merchant', 'admin'].includes(currentUser.role))) { %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <% } %>
    <link rel="stylesheet" href="/css/styles.css?v=sandy-editorial-1">
    <link rel="stylesheet" href="/css/cart.css?v=2">
    <link rel="stylesheet" href="/css/payment.css?v=4">
    <link rel="stylesheet" href="/css/receipt.css?v=1">
    <link rel="stylesheet" href="/css/booking.css?v=5">
    <link rel="stylesheet" href="/css/green-theme.css?v=3">
    <link rel="stylesheet" href="/css/promotions.css?v=1">
    <link rel="stylesheet" href="/css/readability.css?v=16">
    <link rel="stylesheet" href="/css/sage-theme.css?v=50">
    <link rel="stylesheet" href="/css/portal-refresh.css?v=5">
    <link rel="stylesheet" href="/css/notifications.css?v=1">
    <script src="/js/security.js?v=1" defer></script>
    <script src="/js/cart-feedback.js?v=1" defer></script>
</head>
<body>
    <%
        const navUserName = currentUser ? (currentUser.name || currentUser.email || currentUser.role || 'Account') : '';
        const navUserInitial = navUserName ? navUserName.charAt(0).toUpperCase() : 'V';
        const navUserRole = currentUser && currentUser.role ? String(currentUser.role) : '';
    %>
    <header class="site-header">
        <nav class="nav">
            <a class="brand" href="/">
                <span class="brand-mark">V</span>
                <span>Vaniday</span>
            </a>
            <div class="nav-links">
                <% if (currentUser && currentUser.role === 'admin') { %>
                    <button class="admin-nav-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminNavDrawer" aria-controls="adminNavDrawer" aria-label="Open admin navigation">
                        <span></span><span></span><span></span>
                    </button>
                    <%- include('admin-navbar') %>
                <% } else if (currentUser && currentUser.role === 'merchant') { %>
                    <%- include('merchant-navbar') %>
                <% } else { %>
                    <div class="nav-dropdown">
                        <button class="nav-dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="services-menu">
                            <span>Services</span>
                            <span class="nav-dropdown-caret" aria-hidden="true">&#9662;</span>
                        </button>
                        <div class="nav-dropdown-menu" id="services-menu" aria-label="Services menu">
                            <a href="/services?filter=men">Men</a>
                            <a href="/services?filter=women">Women</a>
                            <a href="/services?filter=hair">Hair</a>
                            <a href="/services?filter=nails">Nails</a>
                            <a href="/services?filter=spa">Spa</a>
                            <a href="/services?filter=massage">Massage</a>
                            <a href="/services?filter=packages">Packages</a>
                            <% if (typeof hasPublicPromotions !== 'undefined' ? hasPublicPromotions : (typeof locals !== 'undefined' && locals.hasPublicPromotions)) { %>
                                <a href="/services?filter=promotions">Promotions</a>
                            <% } %>
                            <a href="/services">View All Services</a>
                        </div>
                    </div>
                    <div class="nav-dropdown">
                        <button class="nav-dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="products-menu">
                            <span>Products</span>
                            <span class="nav-dropdown-caret" aria-hidden="true">&#9662;</span>
                        </button>
                        <div class="nav-dropdown-menu" id="products-menu" aria-label="Products menu">
                            <a href="/products/hair">Hair</a>
                            <a href="/products/skincare">Skincare</a>
                            <a href="/products/bodycare">Bodycare</a>
                            <a href="/products/wellness">Wellness</a>
                            <a href="/products/makeup">Makeup</a>
                            <a href="/products/nails">Nails</a>
                            <a href="/products/spa">Spa</a>
                            <a href="/products/massage">Massage</a>
                            <a href="/products/sets">Sets</a>
                            <a href="/products">View All Products</a>
                        </div>
                    </div>
                    <div class="nav-dropdown">
                        <button class="nav-dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="promotions-menu">
                            <span>Promotions</span>
                            <span class="nav-dropdown-caret" aria-hidden="true">&#9662;</span>
                        </button>
                        <div class="nav-dropdown-menu" id="promotions-menu" aria-label="Promotions menu">
                            <a href="/promotions">All Promotions</a>
                            <a href="/promotions/first-trial">First Trial</a>
                            <a href="/promotions/happy-hour">Happy Hour</a>
                            <a href="/promotions/1-for-1">1 For 1</a>
                            <a href="/promotions/featured-salons">Featured Salons</a>
                        </div>
                    </div>
                    <% if (currentUser && currentUser.role === 'customer') { %>
                        <div class="nav-dropdown">
                            <button class="nav-dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="rewards-menu">
                                <span>Rewards</span>
                                <span class="nav-dropdown-caret" aria-hidden="true">&#9662;</span>
                            </button>
                            <div class="nav-dropdown-menu" id="rewards-menu" aria-label="Rewards menu">
                                <a href="/profile#wallet">Wallet</a>
                                <a href="/reward-shop">Reward Shop</a>
                                <a href="/rewards-game">Games</a>
                                <a href="/giftcards">Gift Cards</a>
                            </div>
                        </div>
                    <% } %>
                    <div class="nav-dropdown">
                        <button class="nav-dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="support-menu">
                            <span>Support</span>
                            <span class="nav-dropdown-caret" aria-hidden="true">&#9662;</span>
                        </button>
                        <div class="nav-dropdown-menu" id="support-menu" aria-label="Support menu">
                            <% if (currentUser && currentUser.role === 'customer') { %>
                                <a href="/help-center">Help Center</a>
                            <% } %>
                            <a href="/about">About</a>
                            <a href="/contact">Contact</a>
                        </div>
                    </div>
                <% } %>
            </div>
            <div class="nav-tools">
                <div class="nav-account-links">
                    <% if (currentUser) { %>
                        <a class="notification-link" href="/notifications" aria-label="Notifications">
                            <span class="notification-bell" aria-hidden="true"></span>
                            <span class="notification-link-label">Notifications</span>
                            <% if ((typeof notificationUnreadCount !== 'undefined' ? notificationUnreadCount : 0) > 0) { %>
                                <span class="notification-count"><%= notificationUnreadCount > 9 ? '9+' : notificationUnreadCount %></span>
                            <% } %>
                        </a>
                        <% if (currentUser.role === 'customer') { %>
                            <a class="bag-link nav-bag-link" href="/cart" aria-label="Cart">
                                <span class="bag-icon" aria-hidden="true">
                                    <span class="bag-count" data-cart-count><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
                                </span>
                            </a>
                        <% } %>
                        <div class="nav-dropdown nav-account-menu">
                            <button class="nav-account-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="account-menu">
                                <span class="nav-avatar" aria-hidden="true"><%= navUserInitial %></span>
                                <span class="nav-account-copy">
                                    <strong><%= navUserName %></strong>
                                    <small><%= navUserRole %></small>
                                </span>
                                <span class="nav-dropdown-caret" aria-hidden="true">&#9662;</span>
                            </button>
                            <div class="nav-dropdown-menu nav-account-dropdown" id="account-menu" aria-label="Account menu">
                                <% if (currentUser.role === 'customer') { %>
                                    <a href="/profile">Profile</a>
                                    <a href="/profile#wallet">Wallet</a>
                                    <a href="/profile/history">Purchase History</a>
                                    <a href="/notifications">Notifications</a>
                                <% } else if (currentUser.role === 'merchant') { %>
                                    <a href="/merchant/dashboard">Merchant Dashboard</a>
                                    <a href="/merchant/profile">Merchant Profile</a>
                                    <a href="/merchant/profile#storefront-qr">Storefront QR</a>
                                    <a href="/notifications">Notifications</a>
                                <% } else if (currentUser.role === 'admin') { %>
                                    <a href="/admin/dashboard">Admin Dashboard</a>
                                    <a href="/notifications">Notifications</a>
                                <% } %>
                                <form action="/logout" method="POST">
                                    <button type="submit">Log out</button>
                                </form>
                            </div>
                        </div>
                    <% } else { %>
                        <a class="button secondary nav-login-link" href="/login">Log in</a>
                        <a class="button primary nav-signup-link" href="/signup">Sign up</a>
                    <% } %>
                </div>
            </div>
        </nav>
    </header>
    <main>
        <div class="page-container">
