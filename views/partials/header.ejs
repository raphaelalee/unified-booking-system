<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title><%= title %> | Vaniday</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <% if ((typeof useBootstrap !== 'undefined' && useBootstrap) || (currentUser && ['merchant', 'admin'].includes(currentUser.role))) { %>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <% } %>
    <link rel="stylesheet" href="/css/styles.css?v=sandy-editorial-1">
    <link rel="stylesheet" href="/css/cart.css?v=1">
    <link rel="stylesheet" href="/css/payment.css?v=1">
    <link rel="stylesheet" href="/css/receipt.css?v=1">
    <link rel="stylesheet" href="/css/booking.css?v=2">
    <link rel="stylesheet" href="/css/green-theme.css?v=3">
    <link rel="stylesheet" href="/css/promotions.css?v=1">
    <link rel="stylesheet" href="/css/readability.css?v=16">
    <link rel="stylesheet" href="/css/sage-theme.css?v=38">
    <script src="/js/security.js?v=1" defer></script>
</head>
<body>
    <header class="site-header">
        <nav class="nav">
            <a class="brand" href="/">
                <span class="brand-mark">V</span>
                <span>Vaniday</span>
            </a>
            <div class="nav-links">
                <% if (currentUser && currentUser.role === 'admin') { %>
                    <button class="admin-nav-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminNavDrawer" aria-controls="adminNavDrawer" aria-label="Open admin navigation">
                        <span></span><span></span><span></span>
                    </button>
                <% } else if (currentUser && currentUser.role === 'merchant') { %>
                    <%- include('merchant-navbar') %>
                <% } else { %>
                    <a href="/services">Services</a>
                    <div class="nav-dropdown">
                        <button class="nav-dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="promotions-menu">
                            <span>Promotions</span>
                            <span class="nav-dropdown-caret" aria-hidden="true">&#9662;</span>
                        </button>
                        <div class="nav-dropdown-menu" id="promotions-menu" aria-label="Promotions menu">
                            <a href="/promotions">All Promotions</a>
                            <a href="/promotions/first-trial">First Trial</a>
                            <a href="/promotions/happy-hour">Happy Hour</a>
                            <a href="/promotions/1-for-1">1 For 1</a>
                            <a href="/promotions/featured-salons">Featured Salons</a>
                        </div>
                    </div>
                    <a href="/products">Products</a>
                    <% if (currentUser && currentUser.role === 'customer') { %>
                        <a href="/help-center">Help Center</a>
                        <a href="/rewards-game">Games</a>
                        <a href="/reward-shop">Reward Shop</a>
                        <a href="/cashback">Cashback</a>
                        <a href="/giftcards">Gift Cards</a>
                    <% } %>
                <% } %>
            </div>
            <div class="nav-tools">
                <% if (!currentUser || currentUser.role === 'customer') { %>
                    <div class="nav-support-links">
                        <a href="/about">About</a>
                        <a href="/contact">Contact</a>
                    </div>
                <% } %>
                <div class="nav-account-links">
                    <% if (currentUser) { %>
                        <a class="notification-link" href="/notifications" aria-label="Notifications">
                            <span class="notification-bell" aria-hidden="true"></span>
                            <span class="notification-link-label">Notifications</span>
                            <% if ((typeof notificationUnreadCount !== 'undefined' ? notificationUnreadCount : 0) > 0) { %>
                                <span class="notification-count"><%= notificationUnreadCount > 9 ? '9+' : notificationUnreadCount %></span>
                            <% } %>
                        </a>
                    <% } %>
                    <a class="profile-icon-link" href="/profile" aria-label="Profile">
                        <span class="login-icon" aria-hidden="true"></span>
                    </a>
                    <% if (currentUser) { %>
                        <% if (currentUser.role !== 'customer') { %>
                            <span class="nav-role-pill"><%= currentUser.role %></span>
                        <% } %>
                        <form action="/logout" method="POST">
                            <button class="text-button" type="submit">Log Out</button>
                        </form>
                    <% } else { %>
                        <a class="signup-text-link" href="/signup">Sign Up</a>
                    <% } %>
                </div>
                <% if (currentUser && currentUser.role === 'customer') { %>
                    <div class="nav-commerce-links">
                        <a class="bag-link" href="/cart" aria-label="Cart">
                            <span class="bag-icon" aria-hidden="true">
                                <span class="bag-count"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
                            </span>
                        </a>
                    </div>
                <% } %>
            </div>
        </nav>
    </header>
    <main>
        <div class="page-container">
