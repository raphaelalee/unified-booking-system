<%
    const activePath = typeof currentPath !== 'undefined' ? currentPath : '';
    const isActive = (paths) => paths.some((path) => activePath === path || activePath.startsWith(`${path}/`));
    const navGroups = [
        {
            label: 'Bookings',
            active: activePath === '/merchant/bookings' || activePath === '/merchant/schedule',
            items: [
                { label: 'Approvals & Reschedules', href: '/merchant/bookings' },
                { label: 'Calendar & History', href: '/merchant/schedule' }
            ]
        },
        {
            label: 'Services',
            active: isActive(['/merchant/services']),
            items: [
                { label: 'Service Menu', href: '/merchant/services' },
                { label: 'Add Service', href: '/merchant/services/new' }
            ]
        },
        {
            label: 'Products',
            active: isActive(['/merchant/products', '/merchant/orders']),
            items: [
                { label: 'Inventory', href: '/merchant/products' },
                { label: 'Product Orders', href: '/merchant/orders' },
                { label: 'Add Product', href: '/merchant/products/new' }
            ]
        },
        {
            label: 'Promotions',
            active: isActive(['/merchant/promotions', '/merchant/rewards-game', '/merchant/loyalty', '/merchant/cashback']),
            items: [
                { label: 'Campaigns', href: '/merchant/promotions' },
                { label: 'Cashback', href: '/merchant/cashback' },
                { label: 'Rewards Rules', href: '/merchant/loyalty' },
                { label: 'Game Rewards', href: '/merchant/rewards-game' }
            ]
        },
        {
            label: 'Support',
            active: isActive(['/merchant/support', '/help-center']),
            items: [
                { label: 'Support Overview', href: '/merchant/support' },
                { label: 'Refund Requests', href: '/help-center' }
            ]
        }
    ];
%>

<button class="merchant-nav-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#merchantNavDrawer" aria-controls="merchantNavDrawer" aria-label="Open merchant navigation">
    <span></span>
    <span></span>
    <span></span>
</button>

<nav class="merchant-primary-nav" aria-label="Merchant primary navigation">
    <a class="<%= activePath === '/merchant/dashboard' || activePath === '/merchant' ? 'active' : '' %>" href="/merchant/dashboard">Dashboard</a>
    <% navGroups.forEach((group, index) => { %>
        <div class="dropdown merchant-nav-dropdown">
            <button class="merchant-nav-link dropdown-toggle <%= group.active ? 'active' : '' %>" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <%= group.label %>
            </button>
            <ul class="dropdown-menu">
                <% group.items.forEach((item) => { %>
                    <li><a class="dropdown-item" href="<%= item.href %>"><%= item.label %></a></li>
                <% }) %>
            </ul>
        </div>
    <% }) %>
    <a class="<%= activePath === '/merchant/customers' ? 'active' : '' %>" href="/merchant/customers">Customers</a>
    <a class="<%= activePath === '/merchant/analytics' ? 'active' : '' %>" href="/merchant/analytics">Analytics</a>
    <a class="<%= activePath === '/merchant/profile' ? 'active' : '' %>" href="/merchant/profile">Profile</a>
</nav>

<div class="offcanvas offcanvas-start merchant-nav-drawer" tabindex="-1" id="merchantNavDrawer" aria-labelledby="merchantNavDrawerLabel">
    <div class="offcanvas-header">
        <h2 id="merchantNavDrawerLabel">Merchant Menu</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <a class="merchant-drawer-link <%= activePath === '/merchant/dashboard' || activePath === '/merchant' ? 'active' : '' %>" href="/merchant/dashboard">Dashboard</a>
        <div class="accordion merchant-nav-accordion" id="merchantNavAccordion">
            <% navGroups.forEach((group, index) => { %>
                <div class="accordion-item">
                    <h3 class="accordion-header">
                        <button class="accordion-button <%= group.active ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#merchant-nav-group-<%= index %>" aria-expanded="<%= group.active ? 'true' : 'false' %>" aria-controls="merchant-nav-group-<%= index %>">
                            <%= group.label %>
                        </button>
                    </h3>
                    <div id="merchant-nav-group-<%= index %>" class="accordion-collapse collapse <%= group.active ? 'show' : '' %>" data-bs-parent="#merchantNavAccordion">
                        <div class="accordion-body">
                            <% group.items.forEach((item) => { %>
                                <a href="<%= item.href %>"><%= item.label %></a>
                            <% }) %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        <a class="merchant-drawer-link <%= activePath === '/merchant/customers' ? 'active' : '' %>" href="/merchant/customers">Customers</a>
        <a class="merchant-drawer-link <%= activePath === '/merchant/analytics' ? 'active' : '' %>" href="/merchant/analytics">Analytics</a>
        <a class="merchant-drawer-link <%= activePath === '/merchant/profile' ? 'active' : '' %>" href="/merchant/profile">Profile</a>
    </div>
</div>
