<%
    const activePath = typeof currentPath !== 'undefined' ? currentPath : '';
    const isActive = (paths) => paths.some((path) => activePath === path || activePath.startsWith(`${path}/`));
    const adminGroups = [
        {
            label: 'Users',
            icon: 'U',
            active: isActive(['/admin/merchants', '/admin/users']),
            items: [
                { label: 'Merchant Directory', href: '/admin/merchants' },
                { label: 'User Accounts', href: '/admin/users' },
                { label: 'Platform Health', href: '/admin/platform-health' }
            ]
        },
        {
            label: 'Bookings',
            icon: 'B',
            active: isActive(['/admin/bookings']),
            items: [
                { label: 'Booking Operations', href: '/admin/bookings' }
            ]
        },
        {
            label: 'Marketplace',
            icon: 'M',
            active: isActive(['/admin/services', '/admin/products', '/admin/promotions', '/admin/cashback']),
            items: [
                { label: 'Services', href: '/admin/services' },
                { label: 'Products', href: '/admin/products' },
                { label: 'Promotions', href: '/admin/promotions' },
                { label: 'Cashback Campaigns', href: '/admin/cashback' }
            ]
        },
        {
            label: 'Rewards',
            icon: 'R',
            active: isActive(['/admin/reward-shop', '/admin/loyalty']),
            items: [
                { label: 'Reward Shop', href: '/admin/reward-shop' },
                { label: 'Loyalty Settings', href: '/admin/loyalty' }
            ]
        },
        {
            label: 'Analytics',
            icon: 'A',
            active: isActive(['/admin/analytics', '/admin/platform-health']),
            items: [
                { label: 'Platform Analytics', href: '/admin/analytics' },
                { label: 'Platform Health', href: '/admin/platform-health' }
            ]
        },
        {
            label: 'Moderation',
            icon: 'Q',
            active: isActive(['/admin/reviews']),
            items: [
                { label: 'Review Moderation', href: '/admin/reviews' }
            ]
        },
        {
            label: 'System',
            icon: 'S',
            active: isActive(['/admin/audit-trail']),
            items: [
                { label: 'Audit Trail', href: '/admin/audit-trail' }
            ]
        }
    ];
%>

<aside class="admin-sidebar">
    <a class="admin-sidebar-brand" href="/admin/overview"><span>V</span>Vaniday Admin</a>
    <nav aria-label="Admin primary navigation">
        <a class="<%= activePath === '/admin/overview' || activePath === '/admin' ? 'active' : '' %>" href="/admin/overview"><span class="admin-nav-icon">O</span>Overview</a>
        <% adminGroups.forEach((group, index) => { %>
            <div class="admin-sidebar-group">
                <button class="admin-sidebar-group-toggle <%= group.active ? 'active' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#admin-sidebar-group-<%= index %>" aria-expanded="<%= group.active ? 'true' : 'false' %>" aria-controls="admin-sidebar-group-<%= index %>">
                    <span><span class="admin-nav-icon"><%= group.icon %></span><%= group.label %></span>
                </button>
                <div id="admin-sidebar-group-<%= index %>" class="collapse <%= group.active ? 'show' : '' %>">
                    <% group.items.forEach((item) => { %>
                        <a class="<%= activePath === item.href ? 'active' : '' %>" href="<%= item.href %>"><span class="admin-nav-icon">-</span><%= item.label %></a>
                    <% }) %>
                </div>
            </div>
        <% }) %>
    </nav>
    <div class="admin-sidebar-actions">
        <a class="button primary" href="/admin/merchants/new">Add merchant</a>
        <a class="button secondary" href="/admin/services/new">Add service</a>
    </div>
</aside>

<div class="offcanvas offcanvas-start admin-nav-drawer" tabindex="-1" id="adminNavDrawer" aria-labelledby="adminNavDrawerLabel">
    <div class="offcanvas-header">
        <h2 id="adminNavDrawerLabel">Admin Menu</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <a class="admin-drawer-link <%= activePath === '/admin/overview' || activePath === '/admin' ? 'active' : '' %>" href="/admin/overview">Overview</a>
        <% adminGroups.forEach((group, index) => { %>
            <div class="accordion admin-nav-accordion" id="admin-drawer-group-<%= index %>">
                <div class="accordion-item">
                    <h3 class="accordion-header">
                        <button class="accordion-button <%= group.active ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#admin-drawer-collapse-<%= index %>">
                            <%= group.label %>
                        </button>
                    </h3>
                    <div id="admin-drawer-collapse-<%= index %>" class="accordion-collapse collapse <%= group.active ? 'show' : '' %>">
                        <div class="accordion-body">
                            <% group.items.forEach((item) => { %>
                                <a href="<%= item.href %>"><%= item.label %></a>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>
