    <script src="/js/customer-ux.js?v=1"></script>
    <script src="/js/services-location.js?v=2"></script>
    <script src="/js/booking-service-slots.js?v=7"></script>
    <script src="/js/live-search.js?v=1"></script>
    <script src="/js/site-transitions.js?v=1"></script>
    <% if ((typeof useBootstrap !== 'undefined' && useBootstrap) || (currentUser && ['merchant', 'admin'].includes(currentUser.role))) { %>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            (() => {
                const links = Array.from(document.querySelectorAll('.merchant-primary-nav a[href], .merchant-primary-nav .dropdown-item[href], .merchant-nav-drawer a[href]'));
                if (!links.length) return;

                const setActiveMerchantNav = () => {
                    const current = `${window.location.pathname}${window.location.hash || ''}`;

                    document.querySelectorAll('.merchant-primary-nav .active, .merchant-nav-drawer .active').forEach((item) => {
                        item.classList.remove('active');
                    });

                    links.forEach((link) => {
                        const url = new URL(link.getAttribute('href'), window.location.origin);
                        const target = `${url.pathname}${url.hash || ''}`;
                        const isExact = target === current;
                        const isSection = url.pathname === window.location.pathname && url.hash && url.hash === window.location.hash;

                        if (isExact || isSection || (!window.location.hash && url.pathname === window.location.pathname && !url.hash)) {
                            link.classList.add('active');
                            link.closest('.dropdown')?.querySelector('.merchant-nav-link')?.classList.add('active');
                        }
                    });
                };

                setActiveMerchantNav();
                window.addEventListener('hashchange', setActiveMerchantNav);
            })();
        </script>
    <% } %>
    <script>
        (() => {
            const dropdowns = Array.from(document.querySelectorAll('.nav-dropdown'));

            if (!dropdowns.length) {
                return;
            }

            const setOpen = (dropdown, isOpen) => {
                const trigger = dropdown.querySelector('.nav-dropdown-trigger, .nav-account-trigger');
                dropdown.classList.toggle('is-open', isOpen);
                trigger?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            };

            dropdowns.forEach((dropdown) => {
                const trigger = dropdown.querySelector('.nav-dropdown-trigger, .nav-account-trigger');

                if (!trigger) {
                    return;
                }

                trigger.addEventListener('click', (event) => {
                    event.preventDefault();
                    dropdowns.forEach((item) => {
                        if (item !== dropdown) {
                            setOpen(item, false);
                        }
                    });
                    setOpen(dropdown, !dropdown.classList.contains('is-open'));
                });

                dropdown.addEventListener('focusout', () => {
                    window.setTimeout(() => {
                        if (!dropdown.contains(document.activeElement)) {
                            setOpen(dropdown, false);
                        }
                    }, 0);
                });
            });

            document.addEventListener('click', (event) => {
                dropdowns.forEach((dropdown) => {
                    if (!dropdown.contains(event.target)) {
                        setOpen(dropdown, false);
                    }
                });
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    const activeTrigger = document.querySelector('.nav-dropdown-trigger[aria-expanded="true"], .nav-account-trigger[aria-expanded="true"]');
                    dropdowns.forEach((dropdown) => setOpen(dropdown, false));
                    activeTrigger?.focus();
                }
            });
        })();
    </script>
</body>
