<article class="support-category-card" data-help-card data-help-keywords="<%= category.keywords %>">
    <span class="support-category-icon" aria-hidden="true"><%= category.icon %></span>
    <div>
        <h3><%= category.title %></h3>
        <p><%= category.description %></p>
    </div>
    <a class="support-category-link" href="<%= category.href %>">Open help</a>
</article>
