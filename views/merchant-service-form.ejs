<%- include('partials/header', { title }) %>

<%
    const slotOptions = [];
    for (let hour = 8; hour <= 21; hour += 1) {
        ['00', '30'].forEach((minute) => {
            if (hour === 21 && minute === '30') return;
            slotOptions.push(`${String(hour).padStart(2, '0')}:${minute}`);
        });
    }
    const selectedSlots = String(form.slots || '')
        .split(',')
        .map((slot) => slot.trim())
        .filter(Boolean);
    const selectedRoutineGoals = Array.isArray(form.routineGoalTags) ? form.routineGoalTags : [];
    const selectedRoutineConcerns = Array.isArray(form.routineConcernTags) ? form.routineConcernTags : [];
    const checkedTag = (collection, value) => collection.includes(value) ? 'checked' : '';
    const serviceAiTagOptions = Array.isArray(routineTagOptions) ? routineTagOptions : [];
    const hasInventorySettings = Boolean(form.inventoryProductId || form.inventoryQuantityRequired);
    const hasRoutineSettings = Boolean(
        String(form.routineRecommendationNote || '').trim()
        || String(form.routineBudgetMin || '').trim()
        || String(form.routineBudgetMax || '').trim()
        || selectedRoutineGoals.length
        || selectedRoutineConcerns.length
    );
%>

<section class="section compact merchant-service-form-page">
    <header class="merchant-dashboard-hero merchant-portal-hero merchant-service-form-header">
        <div>
            <p class="eyebrow">Merchant Portal</p>
            <h1><%= service ? 'Edit service' : 'Add service' %></h1>
            <span><%= merchant.name %> can only manage services under this merchant profile.</span>
        </div>
        <a class="button secondary" href="/merchant/services">Back to services</a>
    </header>

    <form class="service-admin-form merchant-service-editor" action="<%= service ? `/merchant/services/${service.id}` : '/merchant/services' %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <% if (errors.length > 0) { %>
            <div class="notice error">
                <% errors.forEach((error) => { %>
                    <p><%= error %></p>
                <% }) %>
            </div>
        <% } %>

        <div class="merchant-service-editor-grid">
            <div class="merchant-service-editor-main">
                <div class="merchant-service-section-heading">
                    <p class="eyebrow">Essentials</p>
                    <h2>Service details</h2>
                </div>

                <label>
                    Service name
                    <input type="text" name="name" value="<%= form.name %>" placeholder="Hydrating Facial" required data-ai-service-name>
                </label>

                <label>
                    Category
                    <select name="categoryId" required data-ai-service-category>
                        <option value="">Select category</option>
                        <% categories.forEach((category) => { %>
                            <option value="<%= category.category_id %>" <%= String(form.categoryId) === String(category.category_id) ? 'selected' : '' %>>
                                <%= category.category_name %>
                            </option>
                        <% }) %>
                    </select>
                </label>

                <details class="ai-service-assistant" data-ai-service-assistant>
                    <summary>
                        <span>
                            <strong>AI Service Assistant</strong>
                            <small>AI-generated draft - review before saving.</small>
                        </span>
                        <span class="button secondary compact" aria-hidden="true">Generate with AI</span>
                    </summary>
                    <div class="ai-service-assistant-body">
                        <label>
                            Optional instruction
                            <textarea rows="2" maxlength="280" placeholder="Premium facial for dry and sensitive skin" data-ai-service-instructions></textarea>
                        </label>
                        <div class="ai-service-assistant-actions">
                            <button class="button secondary" type="button" data-ai-service-generate>Generate suggestions</button>
                            <p class="muted" data-ai-service-status></p>
                        </div>
                        <section class="ai-service-preview" data-ai-service-preview hidden aria-label="AI service suggestions">
                            <div class="ai-service-preview-header">
                                <div>
                                    <p class="eyebrow">AI-generated draft</p>
                                    <h2>Review before saving</h2>
                                </div>
                                <button class="button primary compact" type="button" data-ai-apply-all>Apply all safe suggestions</button>
                            </div>
                            <div class="ai-service-suggestion-list" data-ai-service-suggestion-list></div>
                        </section>
                    </div>
                </details>

                <label>
                    Description
                    <textarea name="description" placeholder="Short service description" data-ai-target-description><%= form.description %></textarea>
                </label>

                <div class="merchant-service-editor-pair">
                    <label>
                        Duration in minutes
                        <input type="number" name="durationMins" value="<%= form.durationMins %>" min="1" step="1" placeholder="60" required data-ai-target-duration>
                    </label>

                    <label>
                        Price
                        <input type="number" name="price" value="<%= form.price %>" min="0" step="0.01" placeholder="68" required data-ai-target-price>
                    </label>
                </div>
            </div>

            <section class="merchant-service-slot-panel" aria-label="Service available times">
                <div>
                    <p class="eyebrow">Available times</p>
                    <h2>Booking slots</h2>
                    <p class="muted">Choose times your merchant can consistently support. AI does not generate or select booking slots.</p>
                </div>
                <input type="hidden" name="slots" value="<%= selectedSlots.join(', ') %>" data-service-slots-value>
                <div class="merchant-slot-presets" aria-label="Common booking slot presets">
                    <button type="button" data-service-slot-preset="10:00, 11:00, 12:00">Morning</button>
                    <button type="button" data-service-slot-preset="13:00, 14:00, 15:00, 16:00">Afternoon</button>
                    <button type="button" data-service-slot-preset="17:00, 18:00, 19:00">Evening</button>
                </div>
                <label>
                    Add timing
                    <div class="merchant-slot-picker">
                        <select data-service-slot-select>
                            <option value="">Select timing</option>
                            <% slotOptions.forEach((slot) => { %>
                                <option value="<%= slot %>"><%= slot %></option>
                            <% }) %>
                        </select>
                        <button class="button secondary" type="button" data-service-slot-add>Add</button>
                    </div>
                </label>
                <div class="merchant-slot-toolbar">
                    <span data-service-slot-count><%= selectedSlots.length %> selected</span>
                    <button type="button" data-service-slot-clear>Clear all</button>
                </div>
                <div class="merchant-selected-slots" data-service-slot-list>
                    <% selectedSlots.forEach((slot) => { %>
                        <button type="button" data-slot="<%= slot %>" aria-label="Remove <%= slot %>"><%= slot %></button>
                    <% }) %>
                </div>
                <p class="muted merchant-slot-empty" data-service-slot-empty <%= selectedSlots.length > 0 ? 'hidden' : '' %>>No timings selected yet.</p>
            </section>

            <details class="merchant-service-slot-panel merchant-package-panel merchant-service-collapsible" <%= form.packageEnabled ? 'open' : '' %>>
                <summary>
                    <span>
                        <p class="eyebrow">Package</p>
                        <h2>Multi-session offer</h2>
                    </span>
                    <small>Optional</small>
                </summary>
                <div class="merchant-service-collapsible-body">
                    <p class="muted">List a prepaid package, such as 10 sessions of Hydrating Facial for $1000.</p>
                    <input type="hidden" name="packageEnabled" value="0">
                    <label class="merchant-package-toggle">
                        <input type="checkbox" name="packageEnabled" value="1" <%= form.packageEnabled ? 'checked' : '' %>>
                        Offer package for this service
                    </label>
                    <div class="merchant-service-editor-pair">
                        <label>
                            Sessions
                            <input type="number" name="packageSessions" value="<%= form.packageSessions || '' %>" min="2" step="1" placeholder="10" data-ai-target-package-sessions>
                        </label>
                        <label>
                            Package price
                            <input type="number" name="packagePrice" value="<%= form.packagePrice || '' %>" min="0" step="0.01" placeholder="1000" data-ai-target-package-price>
                        </label>
                    </div>
                </div>
            </details>

            <details class="merchant-service-slot-panel merchant-package-panel merchant-service-collapsible" <%= hasInventorySettings ? 'open' : '' %>>
                <summary>
                    <span>
                        <p class="eyebrow">Inventory sync</p>
                        <h2>Stock-aware booking</h2>
                    </span>
                    <small>Optional</small>
                </summary>
                <div class="merchant-service-collapsible-body">
                    <p class="muted">Link this service to one tracked product. If stock falls below the required quantity, the service is hidden from customers until inventory is replenished.</p>
                    <label>
                        Linked product
                        <select name="inventoryProductId" data-ai-target-product>
                            <option value="">No linked product</option>
                            <% (products || []).forEach((product) => { %>
                                <option value="<%= product.id %>" data-product-name="<%= product.name %>" <%= String(form.inventoryProductId || '') === String(product.id) ? 'selected' : '' %>>
                                    <%= product.name %> (<%= Number(product.stockQuantity || 0) %> in stock)
                                </option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        Quantity required per booking
                        <input type="number" name="inventoryQuantityRequired" value="<%= form.inventoryQuantityRequired || '' %>" min="1" step="1" placeholder="1">
                    </label>
                </div>
            </details>

            <details class="merchant-service-slot-panel merchant-package-panel merchant-service-collapsible" <%= hasRoutineSettings ? 'open' : '' %>>
                <summary>
                    <span>
                        <p class="eyebrow">Beauty Routine Finder</p>
                        <h2>Recommendation tags</h2>
                    </span>
                    <small>Optional</small>
                </summary>
                <div class="merchant-service-collapsible-body">
                    <p class="muted">Use tags and a short note to help this service appear in the right customer consultations.</p>
                    <label>
                        Recommendation note
                        <input type="text" name="routineRecommendationNote" maxlength="255" value="<%= form.routineRecommendationNote || '' %>" placeholder="Best for first-time facial customers" data-ai-target-recommendation>
                    </label>
                    <div class="merchant-service-editor-pair">
                        <label>
                            Budget minimum
                            <input type="number" name="routineBudgetMin" value="<%= form.routineBudgetMin || '' %>" min="0" step="0.01" placeholder="50" data-ai-target-budget-min>
                        </label>
                        <label>
                            Budget maximum
                            <input type="number" name="routineBudgetMax" value="<%= form.routineBudgetMax || '' %>" min="0" step="0.01" placeholder="120" data-ai-target-budget-max>
                        </label>
                    </div>
                    <div class="routine-merchant-tag-panel">
                        <span>Goal tags</span>
                        <div>
                            <% (routineTagOptions || []).slice(0, 8).forEach((tag) => { %>
                                <label>
                                    <input type="checkbox" name="routineGoalTags" value="<%= tag.value %>" <%= checkedTag(selectedRoutineGoals, tag.value) %>>
                                    <span><%= tag.label %></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                    <div class="routine-merchant-tag-panel">
                        <span>Concern tags</span>
                        <div>
                            <% (routineTagOptions || []).slice(6).forEach((tag) => { %>
                                <label>
                                    <input type="checkbox" name="routineConcernTags" value="<%= tag.value %>" <%= checkedTag(selectedRoutineConcerns, tag.value) %>>
                                    <span><%= tag.label %></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </details>
        </div>

        <div class="form-actions">
            <button class="button primary" type="submit"><%= service ? 'Update service' : 'Create service' %></button>
            <a class="button secondary" href="/merchant/services">Cancel</a>
        </div>
    </form>
</section>

<script>
    (() => {
        const assistant = document.querySelector('[data-ai-service-assistant]');

        if (assistant) {
            const tagOptions = <%- JSON.stringify(serviceAiTagOptions) %>;
            const tagLabelMap = new Map(tagOptions.map((tag) => [tag.value, tag.label]));
            const serviceNameInput = document.querySelector('[data-ai-service-name]');
            const categorySelect = document.querySelector('[data-ai-service-category]');
            const instructionsInput = document.querySelector('[data-ai-service-instructions]');
            const generateButton = document.querySelector('[data-ai-service-generate]');
            const status = document.querySelector('[data-ai-service-status]');
            const preview = document.querySelector('[data-ai-service-preview]');
            const suggestionList = document.querySelector('[data-ai-service-suggestion-list]');
            const applyAllButton = document.querySelector('[data-ai-apply-all]');
            const targets = {
                description: document.querySelector('[data-ai-target-description]'),
                duration: document.querySelector('[data-ai-target-duration]'),
                price: document.querySelector('[data-ai-target-price]'),
                recommendation: document.querySelector('[data-ai-target-recommendation]'),
                budgetMin: document.querySelector('[data-ai-target-budget-min]'),
                budgetMax: document.querySelector('[data-ai-target-budget-max]'),
                packageSessions: document.querySelector('[data-ai-target-package-sessions]'),
                packagePrice: document.querySelector('[data-ai-target-package-price]'),
                product: document.querySelector('[data-ai-target-product]')
            };
            let latestSuggestions = null;

            const formatMoney = (value) => Number(value).toFixed(2);
            const hasValue = (value) => value !== null && value !== undefined && String(value).trim() !== '';
            const tagLabels = (values = []) => values.map((value) => tagLabelMap.get(value) || value).join(', ');
            const setStatus = (message, isError = false) => {
                if (!status) return;
                status.textContent = message || '';
                status.classList.toggle('error-text', Boolean(isError));
            };
            const dispatchEditEvents = (field) => {
                field.dispatchEvent(new Event('input', { bubbles: true }));
                field.dispatchEvent(new Event('change', { bubbles: true }));
            };
            const applyField = (field, value, label) => {
                if (!field || !hasValue(value)) return false;
                const next = String(value);
                const current = String(field.value || '').trim();

                if (current && current !== next && !window.confirm(`Replace existing ${label}?`)) {
                    return false;
                }

                field.value = next;
                dispatchEditEvents(field);
                return true;
            };
            const applyTags = (name, values = [], label) => {
                if (!Array.isArray(values) || values.length === 0) return false;
                const boxes = Array.from(document.querySelectorAll(`input[name="${name}"]`));
                const current = boxes.filter((box) => box.checked).map((box) => box.value).sort().join('|');
                const next = [...values].sort().join('|');

                if (current && current !== next && !window.confirm(`Replace existing ${label}?`)) {
                    return false;
                }

                boxes.forEach((box) => {
                    box.checked = values.includes(box.value);
                    dispatchEditEvents(box);
                });
                boxes[0]?.closest('details')?.setAttribute('open', '');
                return true;
            };
            const applyProduct = () => {
                if (!targets.product || !latestSuggestions?.linkedProductName) return false;
                const expected = String(latestSuggestions.linkedProductName).trim().toLowerCase();
                const option = Array.from(targets.product.options).find((entry) => {
                    return String(entry.dataset.productName || '').trim().toLowerCase() === expected;
                });

                if (!option) return false;

                if (targets.product.value && targets.product.value !== option.value && !window.confirm('Replace existing linked product?')) {
                    return false;
                }

                targets.product.value = option.value;
                dispatchEditEvents(targets.product);
                targets.product.closest('details')?.setAttribute('open', '');
                return true;
            };
            const applyDescription = () => applyField(targets.description, latestSuggestions?.description, 'description');
            const applyDuration = () => applyField(targets.duration, latestSuggestions?.durationMinutes, 'duration');
            const applyPrice = () => applyField(targets.price, latestSuggestions?.suggestedPrice, 'price');
            const applyRecommendation = () => {
                let changed = false;
                changed = applyField(targets.recommendation, latestSuggestions?.recommendationNote, 'recommendation note') || changed;
                changed = applyField(targets.budgetMin, latestSuggestions?.budgetMinimum, 'budget minimum') || changed;
                changed = applyField(targets.budgetMax, latestSuggestions?.budgetMaximum, 'budget maximum') || changed;
                if (changed) targets.recommendation?.closest('details')?.setAttribute('open', '');
                return changed;
            };
            const applySuggestedTags = () => {
                let changed = false;
                changed = applyTags('routineGoalTags', latestSuggestions?.goalTags, 'goal tags') || changed;
                changed = applyTags('routineConcernTags', latestSuggestions?.concernTags, 'concern tags') || changed;
                return changed;
            };
            const applyPackage = () => {
                let changed = false;
                changed = applyField(targets.packageSessions, latestSuggestions?.packageSessions, 'package sessions') || changed;
                changed = applyField(targets.packagePrice, latestSuggestions?.packagePrice, 'package price') || changed;
                if (changed) targets.packageSessions?.closest('details')?.setAttribute('open', '');
                return changed;
            };
            const applyAll = () => {
                applyDescription();
                applyDuration();
                applyPrice();
                applyRecommendation();
                applySuggestedTags();
                applyPackage();
                applyProduct();
                setStatus('Suggestions applied to editable fields. Review the form before saving.');
            };
            const addSuggestion = (title, value, applyText, applyHandler, note = '') => {
                if (!hasValue(value)) return;
                const article = document.createElement('article');
                const heading = document.createElement('h3');
                const body = document.createElement('p');
                const action = document.createElement('button');

                heading.textContent = title;
                body.textContent = value;
                action.className = 'button secondary compact';
                action.type = 'button';
                action.textContent = applyText;
                action.addEventListener('click', () => {
                    if (applyHandler()) {
                        setStatus(`${title} applied. Review before saving.`);
                    }
                });
                article.append(heading, body);

                if (note) {
                    const small = document.createElement('small');
                    small.textContent = note;
                    article.appendChild(small);
                }

                article.appendChild(action);
                suggestionList.appendChild(article);
            };
            const renderSuggestions = (suggestions) => {
                latestSuggestions = suggestions || {};
                suggestionList.innerHTML = '';
                addSuggestion('Description', latestSuggestions.description, 'Apply description', applyDescription);
                addSuggestion('Duration', hasValue(latestSuggestions.durationMinutes) ? `${latestSuggestions.durationMinutes} minutes` : '', 'Apply duration', applyDuration, 'Suggestion only.');
                addSuggestion(
                    'Price guidance',
                    hasValue(latestSuggestions.suggestedPrice)
                        ? `$${formatMoney(latestSuggestions.suggestedPrice)}${latestSuggestions.priceExplanation ? ` - ${latestSuggestions.priceExplanation}` : ''}`
                        : '',
                    'Apply price',
                    applyPrice,
                    'This is not real-time market pricing.'
                );
                addSuggestion(
                    'Recommendation details',
                    [
                        latestSuggestions.recommendationNote,
                        hasValue(latestSuggestions.budgetMinimum) ? `Budget min: $${formatMoney(latestSuggestions.budgetMinimum)}` : '',
                        hasValue(latestSuggestions.budgetMaximum) ? `Budget max: $${formatMoney(latestSuggestions.budgetMaximum)}` : ''
                    ].filter(Boolean).join(' '),
                    'Apply recommendation details',
                    applyRecommendation
                );
                addSuggestion(
                    'Tags',
                    [
                        latestSuggestions.goalTags?.length ? `Goals: ${tagLabels(latestSuggestions.goalTags)}` : '',
                        latestSuggestions.concernTags?.length ? `Concerns: ${tagLabels(latestSuggestions.concernTags)}` : ''
                    ].filter(Boolean).join(' '),
                    'Apply tags',
                    applySuggestedTags
                );
                addSuggestion(
                    'Package suggestion',
                    latestSuggestions.packageRecommended
                        ? `${latestSuggestions.packageSessions} sessions, $${formatMoney(latestSuggestions.packagePrice)} package`
                        : '',
                    'Apply package fields',
                    applyPackage,
                    'Package checkbox remains unchanged.'
                );
                addSuggestion(
                    'Linked product suggestion',
                    latestSuggestions.linkedProductName,
                    'Apply linked product',
                    applyProduct,
                    'Only existing merchant products can be selected.'
                );

                preview.hidden = suggestionList.children.length === 0;
                setStatus(suggestionList.children.length ? 'AI-generated draft - review before saving.' : 'No safe suggestions were returned. You can continue manually.');
            };

            generateButton?.addEventListener('click', async () => {
                const serviceName = serviceNameInput?.value.trim() || '';

                if (!serviceName) {
                    serviceNameInput?.focus();
                    setStatus('Enter a service name first.', true);
                    return;
                }

                const originalText = generateButton.textContent;
                generateButton.disabled = true;
                generateButton.textContent = 'Generating...';
                setStatus('Generating suggestions...');

                try {
                    const response = await fetch('/api/ai/service-setup', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            serviceName,
                            categoryId: categorySelect?.value || '',
                            instructions: instructionsInput?.value || ''
                        })
                    });
                    const responseText = await response.text();
                    let data;

                    try {
                        data = JSON.parse(responseText);
                    } catch (parseError) {
                        throw new Error('AI suggestions are currently unavailable. You can continue completing the service manually.');
                    }

                    if (!response.ok || !data.success) {
                        throw new Error(data.message || 'AI suggestions are currently unavailable. You can continue completing the service manually.');
                    }

                    renderSuggestions(data.suggestions || {});
                } catch (error) {
                    preview.hidden = true;
                    setStatus(error.message || 'AI suggestions are currently unavailable. You can continue completing the service manually.', true);
                } finally {
                    generateButton.disabled = false;
                    generateButton.textContent = originalText;
                }
            });

            applyAllButton?.addEventListener('click', applyAll);
        }
    })();

    (() => {
        const valueField = document.querySelector('[data-service-slots-value]');
        const select = document.querySelector('[data-service-slot-select]');
        const addButton = document.querySelector('[data-service-slot-add]');
        const list = document.querySelector('[data-service-slot-list]');
        const emptyState = document.querySelector('[data-service-slot-empty]');
        const presetButtons = Array.from(document.querySelectorAll('[data-service-slot-preset]'));
        const clearButton = document.querySelector('[data-service-slot-clear]');
        const countLabel = document.querySelector('[data-service-slot-count]');

        if (!valueField || !select || !addButton || !list) {
            return;
        }

        const getSlots = () => valueField.value
            .split(',')
            .map((slot) => slot.trim())
            .filter(Boolean);

        const sync = (slots) => {
            const uniqueSlots = Array.from(new Set(slots)).sort();
            valueField.value = uniqueSlots.join(', ');
            list.innerHTML = '';
            uniqueSlots.forEach((slot) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.dataset.slot = slot;
                button.setAttribute('aria-label', `Remove ${slot}`);
                button.textContent = slot;
                list.appendChild(button);
            });
            if (emptyState) {
                emptyState.hidden = uniqueSlots.length > 0;
            }
            if (countLabel) {
                countLabel.textContent = `${uniqueSlots.length} selected`;
            }
        };

        addButton.addEventListener('click', () => {
            const slot = select.value.trim();
            if (!slot) return;
            sync([...getSlots(), slot]);
            select.value = '';
        });

        list.addEventListener('click', (event) => {
            const button = event.target.closest('[data-slot]');
            if (!button) return;
            sync(getSlots().filter((slot) => slot !== button.dataset.slot));
        });

        presetButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const presetSlots = String(button.dataset.serviceSlotPreset || '')
                    .split(',')
                    .map((slot) => slot.trim())
                    .filter(Boolean);
                sync([...getSlots(), ...presetSlots]);
            });
        });

        clearButton?.addEventListener('click', () => {
            if (getSlots().length === 0 || window.confirm('Clear all selected booking slots?')) {
                sync([]);
            }
        });

        sync(getSlots());
    })();
</script>

<%- include('partials/footer') %>
