<%- include('partials/header', { title }) %>

<%
    const promotionList = Array.isArray(promotions) ? promotions : [];
    const typeLabels = {
        first_trial: 'First Trial',
        happy_hour: 'Happy Hour',
        one_for_one: '1 For 1',
        featured: 'Featured'
    };
    const merchantOptions = [...new Set(promotionList.map((promotion) => promotion.salonName).filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const activeCount = promotionList.filter((promotion) => promotion.status === 'active').length;
    const redemptionCount = promotionList.reduce((total, promotion) => total + Number(promotion.redemptionCount || 0), 0);
    const formatPromotionDate = (value) => {
        const date = value instanceof Date ? value : new Date(value);
        if (Number.isNaN(date.getTime())) return '';
        return date.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' });
    };
%>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <%- include('partials/admin-marketplace-tabs') %>

        <header class="admin-dashboard-header marketplace-admin-header">
            <div>
                <p class="eyebrow">Admin Marketplace</p>
                <h1>Promotions</h1>
                <p>Manage merchant promotions in one table. Merchant-created offers update this same list and remain tied to their own salon.</p>
            </div>
            <a class="button primary" href="/admin/promotions/new">Add promotion</a>
        </header>

        <% if (success) { %><div class="notice success"><p><%= success %></p></div><% } %>
        <% if (error) { %><div class="notice error"><p><%= error %></p></div><% } %>

        <section class="marketplace-admin-panel">
            <div class="marketplace-stat-grid">
                <article><span>Promotions</span><strong><%= promotionList.length %></strong></article>
                <article><span>Active</span><strong><%= activeCount %></strong></article>
                <article><span>Merchants</span><strong><%= merchantOptions.length %></strong></article>
                <article><span>Redeemed</span><strong><%= redemptionCount %></strong></article>
            </div>

            <div class="marketplace-admin-toolbar">
                <div>
                    <p class="eyebrow">Promotion Records</p>
                    <h2>Offer catalogue</h2>
                </div>
                <div class="marketplace-filter-row">
                    <label>
                        <span class="sr-only">Search promotions</span>
                        <input class="js-marketplace-search" type="search" placeholder="Search promotion or merchant">
                    </label>
                    <label>
                        <span class="sr-only">Filter by merchant</span>
                        <select class="js-marketplace-merchant-filter">
                            <option value="">All merchants</option>
                            <% merchantOptions.forEach((merchantName) => { %>
                                <option value="<%= merchantName %>"><%= merchantName %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        <span class="sr-only">Filter by type</span>
                        <select class="js-marketplace-type-filter">
                            <option value="">All types</option>
                            <% Object.keys(typeLabels).forEach((type) => { %>
                                <option value="<%= type %>"><%= typeLabels[type] %></option>
                            <% }) %>
                        </select>
                    </label>
                </div>
            </div>

            <% if (promotionList.length === 0) { %>
                <div class="empty-state marketplace-empty-state">
                    <h2>No promotions yet</h2>
                    <p class="muted">Create a promotion for a merchant or wait for merchants to add their own.</p>
                    <a class="button primary" href="/admin/promotions/new">Add promotion</a>
                </div>
            <% } else { %>
                <div class="admin-table-wrap marketplace-table-wrap">
                    <table class="admin-table marketplace-admin-table">
                        <thead>
                            <tr>
                                <th>Promotion</th>
                                <th>Merchant</th>
                                <th>Type</th>
                                <th>Discount</th>
                                <th>Dates</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% promotionList.forEach((promotion) => { %>
                                <tr class="js-marketplace-row" data-merchant="<%= promotion.salonName || '' %>" data-type="<%= promotion.type %>" data-search="<%= `${promotion.title || ''} ${promotion.salonName || ''} ${promotion.serviceName || ''} ${promotion.description || ''}` %>">
                                    <td>
                                        <strong><%= promotion.title %></strong>
                                        <small><%= promotion.serviceName || 'All merchant services' %></small>
                                    </td>
                                    <td><%= promotion.salonName %></td>
                                    <td><span class="sync-pill"><%= typeLabels[promotion.type] || promotion.type %></span></td>
                                    <td>
                                        <%= promotion.discountType.replace(/_/g, ' ') %>
                                        <% if (promotion.discountValue !== null) { %>
                                            <small><%= promotion.discountValue %></small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <%= formatPromotionDate(promotion.startDate) %>
                                        <small>to <%= formatPromotionDate(promotion.endDate) %></small>
                                    </td>
                                    <td><span class="sync-pill"><%= promotion.status %></span></td>
                                    <td>
                                        <div class="marketplace-action-row">
                                            <a class="button secondary compact" href="/admin/promotions/<%= promotion.id %>/edit">Edit</a>
                                            <form action="/admin/promotions/<%= promotion.id %>/delete" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button class="button secondary compact danger-button" type="submit">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </div>
</section>

<script>
    (() => {
        const search = document.querySelector('.js-marketplace-search');
        const merchant = document.querySelector('.js-marketplace-merchant-filter');
        const type = document.querySelector('.js-marketplace-type-filter');
        const rows = Array.from(document.querySelectorAll('.js-marketplace-row'));

        const applyFilters = () => {
            const query = (search?.value || '').trim().toLowerCase();
            const selectedMerchant = (merchant?.value || '').trim().toLowerCase();
            const selectedType = (type?.value || '').trim().toLowerCase();

            rows.forEach((row) => {
                const haystack = (row.dataset.search || '').toLowerCase();
                const merchantName = (row.dataset.merchant || '').toLowerCase();
                const rowType = (row.dataset.type || '').toLowerCase();
                row.hidden = Boolean(query && !haystack.includes(query))
                    || Boolean(selectedMerchant && merchantName !== selectedMerchant)
                    || Boolean(selectedType && rowType !== selectedType);
            });
        };

        search?.addEventListener('input', applyFilters);
        merchant?.addEventListener('change', applyFilters);
        type?.addEventListener('change', applyFilters);
    })();
</script>

<%- include('partials/footer') %>
