<%- include('partials/header', { title }) %>

<section class="admin-dashboard-v2">
    <%- include('partials/admin-sidebar') %>
    <div class="admin-main-panel">
        <%- include('partials/admin-marketplace-tabs') %>

        <header class="admin-dashboard-header marketplace-admin-header">
            <div>
                <p class="eyebrow">Admin Marketplace</p>
                <h1><%= product ? 'Edit product' : 'Add product' %></h1>
                <p>Products belong to one merchant salon. Updates here change the same catalogue record shown in the merchant portal and customer shop.</p>
            </div>
            <a class="button secondary" href="/admin/products">Back to products</a>
        </header>

        <section class="admin-panel marketplace-crud-panel">
            <form class="marketplace-admin-form" action="<%= product ? `/admin/products/${product.id}` : '/admin/products' %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                <% if (errors.length > 0) { %>
                    <div class="notice error">
                        <% errors.forEach((error) => { %>
                            <p><%= error %></p>
                        <% }) %>
                    </div>
                <% } %>

                <div class="marketplace-form-grid">
                    <label>
                        <span>Merchant salon</span>
                        <select name="salonId" required>
                            <option value="">Select merchant salon</option>
                            <% salons.forEach((salon) => { %>
                                <option value="<%= salon.salon_id %>" <%= String(form.salonId) === String(salon.salon_id) ? 'selected' : '' %>>
                                    <%= salon.salon_name %> - <%= salon.owner_email %>
                                </option>
                            <% }) %>
                        </select>
                    </label>

                    <label>
                        <span>Product name</span>
                        <input type="text" name="name" value="<%= form.name %>" placeholder="Hydrating Glow Serum" required>
                    </label>

                    <label>
                        <span>Price</span>
                        <input type="number" name="price" value="<%= form.price %>" min="0" step="0.01" placeholder="38.00" required>
                    </label>

                    <label>
                        <span>Stock quantity</span>
                        <input type="number" name="stockQuantity" value="<%= form.stockQuantity %>" min="0" step="1" placeholder="25" required>
                    </label>
                </div>

                <label>
                    <span>Image URL or path</span>
                    <input type="text" name="imageUrl" value="<%= form.imageUrl %>" placeholder="/uploads/products/example.jpg">
                </label>

                <label>
                    <span>Description</span>
                    <textarea name="description" rows="4" placeholder="Short product description for customers"><%= form.description %></textarea>
                </label>

                <div class="marketplace-form-grid">
                    <label>
                        <span>Ingredients</span>
                        <textarea name="ingredients" rows="5" placeholder="Key ingredients or materials"><%= form.ingredients %></textarea>
                    </label>

                    <label>
                        <span>How to use</span>
                        <textarea name="howToUse" rows="5" placeholder="Usage directions for customers"><%= form.howToUse %></textarea>
                    </label>
                </div>

                <div class="form-actions">
                    <button class="button primary" type="submit"><%= product ? 'Update product' : 'Create product' %></button>
                    <a class="button secondary" href="/admin/products">Cancel</a>
                </div>
            </form>
        </section>
    </div>
</section>

<%- include('partials/footer') %>
