<%- include('partials/header', { title }) %>

<section class="page-title cart-title">
    <p class="eyebrow">Cart</p>
    <h1>Your beauty & wellness basket</h1>
    <p>Review items, apply rewards, and checkout in one streamlined flow.</p>
</section>

<section class="section compact cart-page cart-workspace">
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="notice success"><%= success %></div>
    <% } %>

    <% if (cart.length === 0) { %>
        <div class="empty-state" id="empty-cart-state">
            <h2>Your cart is empty.</h2>
            <p class="muted">Add salon, spa, grooming services, or beauty products.</p>
            <div class="hero-actions">
                <a class="button primary" href="/services">Browse services</a>
                <a class="button secondary" href="/products">Shop products</a>
            </div>
        </div>
    <% } else { %>
        <%
            const productCount = cart.filter((item) => item.type === 'Product').reduce((sum, item) => sum + Number(item.quantity || 1), 0);
            const giftCardCount = cart.filter((item) => item.type === 'Gift Card').length;
            const serviceCount = cart.filter((item) => item.type !== 'Product' && item.type !== 'Gift Card').length;
            const cartVoucherList = typeof availableVouchers !== 'undefined' && Array.isArray(availableVouchers) ? availableVouchers : [];
            const cartGiftCardList = cartVoucherList.filter((voucher) => voucher.sourceType === 'gift_card');
            const cartPromoVoucherList = cartVoucherList.filter((voucher) => voucher.sourceType !== 'gift_card');
        %>

        <div class="cart-layout cart-organized-layout">
            <div class="cart-list cart-main-panel">
                <header class="cart-toolbar cart-control-bar">
                    <div class="cart-toolbar-left">
                        <div class="cart-bulk-actions">
                            <label class="cart-select-all">
                                <input type="checkbox" id="select-all" checked>
                                <span>Select all items</span>
                            </label>
                            <button
                                class="button secondary compact cart-clear-selected-button"
                                type="submit"
                                form="cart-checkout-form"
                                formaction="/cart/delete-selected"
                                formmethod="POST"
                                data-cart-clear-selected>
                                Clear selected
                            </button>
                        </div>
                        <p class="muted">Toggle the items you want to checkout now.</p>
                    </div>
                    <div class="cart-toolbar-counts">
                        <span><%= itemCount %> item<%= itemCount === 1 ? '' : 's' %></span>
                        <% if (serviceCount > 0) { %><span><%= serviceCount %> service<%= serviceCount === 1 ? '' : 's' %></span><% } %>
                        <% if (productCount > 0) { %><span><%= productCount %> product<%= productCount === 1 ? '' : 's' %></span><% } %>
                        <% if (giftCardCount > 0) { %><span><%= giftCardCount %> gift card<%= giftCardCount === 1 ? '' : 's' %></span><% } %>
                    </div>
                </header>

                <div class="cart-list-head" aria-hidden="true">
                    <span>Item</span>
                    <span>Quantity</span>
                    <span>Unit</span>
                    <span>Subtotal</span>
                    <span>Actions</span>
                </div>

                <div class="cart-item-stack">
                    <% cart.forEach((item) => { %>
                        <% const bookingPath = item.merchantId ? `/booking/${item.merchantId}/${item.merchantQrToken}?serviceId=${item.serviceId}` : ''; %>
                        <% const itemImage = item.imageUrl || item.image || item.thumbnail || item.photoUrl || ''; %>
                        <% const itemType = item.type || 'Service'; %>
                        <% const placeholderLabel = String(itemType || 'Item').charAt(0).toUpperCase(); %>
                        <article class="cart-item compact cart-line-item">
                            <input
                                type="checkbox"
                                class="cart-item-check"
                                form="cart-checkout-form"
                                name="selectedItemIds"
                                value="<%= item.id %>"
                                data-line-total="<%= Number(item.lineTotal || 0).toFixed(2) %>"
                                data-quantity="<%= Number(item.quantity || 1) %>"
                                data-is-product="<%= item.type === 'Product' ? '1' : '0' %>"
                                data-merchant-id="<%= item.merchantId || '' %>"
                                data-merchant-name="<%= item.merchantName || '' %>"
                                checked
                                aria-label="Select <%= item.serviceName %>">

                            <div class="cart-item-thumbnail" aria-hidden="true">
                                <% if (itemImage) { %>
                                    <img src="<%= itemImage %>" alt="">
                                <% } else { %>
                                    <span><%= placeholderLabel %></span>
                                <% } %>
                            </div>

                            <div class="cart-item-copy">
                                <div class="cart-item-labels">
                                    <span class="eyebrow"><%= itemType %><% if (item.merchantName) { %> &middot; <%= item.merchantName %><% } %></span>
                                    <h2><%= item.serviceName %></h2>
                                    <% if (item.type !== 'Product' && item.type !== 'Gift Card' && item.duration) { %>
                                        <p class="muted"><%= item.duration %></p>
                                    <% } %>
                                </div>
                            </div>

                            <div class="cart-line-qty" data-label="Quantity">
                                <% if (item.type === 'Product') { %>
                                    <form class="cart-quantity-form" action="/cart/update/<%= item.id %>" method="POST">
                                        <div class="cart-quantity-controls" aria-label="Edit quantity for <%= item.serviceName %>">
                                            <button class="quantity-button" type="submit" name="quantityDelta" value="-1" aria-label="Decrease quantity">-</button>
                                            <input class="quantity-input" type="number" name="quantity" min="1" max="99" value="<%= item.quantity %>" aria-label="Quantity">
                                            <button class="quantity-button" type="submit" name="quantityDelta" value="1" aria-label="Increase quantity">+</button>
                                        </div>
                                    </form>
                                <% } else { %>
                                    <span class="cart-static-qty">Qty <strong><%= Number(item.quantity || 1) %></strong></span>
                                <% } %>
                            </div>

                            <div class="cart-line-price" data-label="Unit">
                                <span>$<%= Number(item.price || 0).toFixed(2) %></span>
                            </div>

                            <div class="cart-line-total" data-label="Subtotal">
                                <strong>$<%= Number(item.lineTotal).toFixed(2) %></strong>
                            </div>

                            <div class="cart-item-actions" data-label="Actions">
                                <% if (item.merchantId && item.type !== 'Product') { %>
                                    <a class="button secondary compact" href="<%= bookingPath %>">Book time</a>
                                <% } %>

                                <form class="remove-icon-form" action="/cart/remove/<%= item.id %>" method="POST">
                                    <button class="remove-icon-button" type="submit" title="Remove <%= item.serviceName %>" aria-label="Remove <%= item.serviceName %>">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path d="M3 6h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M10 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M14 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </div>

            <aside class="booking-panel cart-summary-card cart-checkout-panel">
                <form id="cart-checkout-form" action="/checkout" method="POST" novalidate>
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div class="cart-summary-heading">
                        <p class="eyebrow">Checkout</p>
                        <h2 id="cart-summary-total">$<%= Number(total).toFixed(2) %></h2>
                        <p class="muted"><span id="cart-summary-count"><%= itemCount %></span> selected item<span id="cart-summary-count-plural"><%= itemCount === 1 ? '' : 's' %></span></p>
                    </div>

                    <%
                        const cashbackBalance = loyalty ? Number(loyalty.wallet.cashbackBalance || 0) : 0;
                        const cashbackApplied = Math.min(cashbackBalance, Number(total || 0));
                        const campaignCashbackView = typeof campaignCashback !== 'undefined' && campaignCashback ? campaignCashback : { total: 0, breakdown: [] };
                        const campaignCashbackTotal = Number(campaignCashbackView.total || 0);
                    %>

                    <section class="cart-rewards-section">
                        <div class="cart-voucher-heading">
                            <div>
                                <strong>Gift cards & rewards</strong>
                                <small>Use gift card balance first, or choose a promo voucher.</small>
                            </div>
                            <span><%= cartGiftCardList.length %> gift card<%= cartGiftCardList.length === 1 ? '' : 's' %> · <%= cartPromoVoucherList.length %> voucher<%= cartPromoVoucherList.length === 1 ? '' : 's' %></span>
                        </div>

                        <% if (cartVoucherList.length) { %>
                            <div class="cart-voucher-choice-list">
                                <label class="cart-voucher-choice">
                                    <input type="radio" name="selectedVoucherId" value="none" data-discount-type="none" data-source-type="none" checked required>
                                    <span>
                                        <strong>No gift card or promo voucher</strong>
                                        <small>Merchant smart vouchers are still checked at checkout.</small>
                                    </span>
                                </label>
                                <% if (cartGiftCardList.length) { %>
                                    <p class="cart-voucher-group-label">Gift card balance</p>
                                <% } %>
                                <% cartGiftCardList.forEach((voucher) => { %>
                                    <label class="cart-voucher-choice">
                                        <input
                                            type="radio"
                                            name="selectedVoucherId"
                                            value="<%= voucher.id %>"
                                            data-discount-type="<%= voucher.discountType || 'fixed' %>"
                                            data-discount-percent="<%= Number(voucher.discountPercent || 0) %>"
                                            data-discount-value="<%= Number(voucher.remainingValue || voucher.voucherValue || 0).toFixed(2) %>"
                                            data-source-type="<%= voucher.sourceType || '' %>"
                                            required>
                                        <span>
                                            <strong>Gift card balance</strong>
                                            <small><%= voucher.code %> · Remaining $<%= Number(voucher.remainingValue || 0).toFixed(2) %></small>
                                        </span>
                                        <b><%= voucher.discountType === 'percentage' ? `${Number(voucher.discountPercent || 0)}% OFF` : `$${Number(voucher.remainingValue || voucher.voucherValue || 0).toFixed(2)}` %></b>
                                    </label>
                                <% }) %>
                                <% if (cartPromoVoucherList.length) { %>
                                    <p class="cart-voucher-group-label">Promo vouchers</p>
                                <% } %>
                                <% cartPromoVoucherList.forEach((voucher) => { %>
                                    <label class="cart-voucher-choice">
                                        <input
                                            type="radio"
                                            name="selectedVoucherId"
                                            value="<%= voucher.id %>"
                                            data-discount-type="<%= voucher.discountType || 'fixed' %>"
                                            data-discount-percent="<%= Number(voucher.discountPercent || 0) %>"
                                            data-discount-value="<%= Number(voucher.remainingValue || voucher.voucherValue || 0).toFixed(2) %>"
                                            data-source-type="<%= voucher.sourceType || '' %>"
                                            required>
                                        <span>
                                            <strong><%= voucher.title %></strong>
                                            <small>Voucher ID: <%= voucher.id %> · Code: <%= voucher.code %></small>
                                        </span>
                                        <b><%= voucher.discountType === 'percentage' ? `${Number(voucher.discountPercent || 0)}% OFF` : `$${Number(voucher.remainingValue || voucher.voucherValue || 0).toFixed(2)}` %></b>
                                    </label>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <input type="hidden" name="selectedVoucherId" value="none">
                            <p class="muted">No eligible gift cards or promo vouchers for the selected cart items.</p>
                        <% } %>

                        <div class="loyalty-redemption-card cart-cashback-card">
                            <% if (cashbackBalance > 0) { %>
                                <label>
                                    <input id="cart-use-cashback" type="checkbox" name="redeemCashback" value="on" data-cashback-balance="<%= cashbackBalance.toFixed(2) %>" checked>
                                    <span>
                                        <strong>Use cashback rewards</strong>
                                        <small>Available $<%= cashbackBalance.toFixed(2) %>. Applying <span id="cart-cashback-copy">$<%= cashbackApplied.toFixed(2) %></span>.</small>
                                    </span>
                                </label>
                                <button class="button secondary compact" type="submit" formaction="/customer/checkout/apply-cashback" formmethod="POST">Apply cashback</button>
                            <% } else { %>
                                <span>
                                    <strong>No cashback available yet</strong>
                                    <small>Complete this checkout to earn rewards for your next purchase.</small>
                                </span>
                            <% } %>
                        </div>
                    </section>

                    <div class="cart-totals cart-summary-totals">
                        <p><span>Items subtotal</span><strong id="cart-subtotal-value">$<%= Number(total).toFixed(2) %></strong></p>
                        <p id="cart-voucher-row" style="display:none;"><span id="cart-voucher-label">Voucher</span><strong id="cart-voucher-value">-$0.00</strong></p>
                        <% if (cashbackApplied > 0) { %>
                            <p><span>Wallet cashback used</span><strong id="cart-cashback-value">-$<%= cashbackApplied.toFixed(2) %></strong></p>
                        <% } %>
                        <% if (campaignCashbackTotal > 0) { %>
                            <p><span>Campaign cashback earned</span><strong>+$<%= campaignCashbackTotal.toFixed(2) %></strong></p>
                        <% } %>
                        <p class="cart-total-line"><span>Total due</span><strong id="cart-due-value">$<%= Math.max(Number(total || 0) - cashbackApplied, 0).toFixed(2) %></strong></p>
                    </div>

                    <div class="cart-payment-badges" aria-label="Accepted payment methods">
                        <span class="cart-payment-chip">VISA</span>
                        <span class="cart-payment-chip">Mastercard</span>
                        <span class="cart-payment-chip">PayPal</span>
                        <span class="cart-payment-chip">NETS</span>
                    </div>

                    <input type="hidden" name="_totalAmount" value="<%= Number(total).toFixed(2) %>">
                    <button class="button primary full cart-checkout-button" type="submit">Continue to checkout</button>
                </form>

                <div class="cart-summary-links">
                    <a class="button secondary full" href="/services">Add services</a>
                    <a class="button secondary full" href="/products">Shop products</a>
                </div>
            </aside>
        </div>
    <% } %>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const selectAll = document.getElementById('select-all');
    const checks = Array.from(document.querySelectorAll('.cart-item-check'));
    const summaryTotal = document.getElementById('cart-summary-total');
    const summaryCount = document.getElementById('cart-summary-count');
    const summaryCountPlural = document.getElementById('cart-summary-count-plural');
    const subtotalValue = document.getElementById('cart-subtotal-value');
    const voucherRow = document.getElementById('cart-voucher-row');
    const voucherLabel = document.getElementById('cart-voucher-label');
    const voucherValue = document.getElementById('cart-voucher-value');
    const cashbackValue = document.getElementById('cart-cashback-value');
    const dueValue = document.getElementById('cart-due-value');
    const cashbackCopy = document.getElementById('cart-cashback-copy');
    const cashbackToggle = document.getElementById('cart-use-cashback');
    const checkoutForm = document.getElementById('cart-checkout-form');
    const voucherInputs = Array.from(document.querySelectorAll('input[type="radio"][name="selectedVoucherId"]'));

    function formatMoney(value) {
        return '$' + Number(value || 0).toFixed(2);
    }

    function getSelectedChecks() {
        return checks.filter((check) => check.checked);
    }

    function getVoucherDiscount(subtotal) {
        const selectedVoucher = voucherInputs.find((input) => input.checked);
        if (!selectedVoucher || selectedVoucher.value === 'none') {
            return 0;
        }

        const discountType = selectedVoucher.dataset.discountType || 'fixed';
        const discountPercent = Number(selectedVoucher.dataset.discountPercent || 0);
        const discountValue = Number(selectedVoucher.dataset.discountValue || 0);

        return discountType === 'percentage'
            ? Math.min(subtotal * (discountPercent / 100), subtotal)
            : Math.min(discountValue, subtotal);
    }

    function updateSummary() {
        const selectedChecks = getSelectedChecks();
        const selectedVoucher = voucherInputs.find((input) => input.checked);
        const lineCount = selectedChecks.length;
        const unitCount = selectedChecks.reduce((sum, check) => sum + Number(check.dataset.quantity || 1), 0);
        const subtotal = selectedChecks.reduce((sum, check) => sum + Number(check.dataset.lineTotal || 0), 0);
        const voucherDiscount = getVoucherDiscount(subtotal);
        const grossTotal = Math.max(subtotal - voucherDiscount, 0);
        const cashbackBalance = cashbackToggle ? Number(cashbackToggle.dataset.cashbackBalance || 0) : 0;
        const cashbackApplied = cashbackToggle && cashbackToggle.checked && voucherDiscount <= 0
            ? Math.min(cashbackBalance, grossTotal)
            : 0;
        const due = Math.max(grossTotal - cashbackApplied, 0);

        if (summaryTotal) summaryTotal.textContent = formatMoney(due);
        if (summaryCount) summaryCount.textContent = String(lineCount);
        if (summaryCountPlural) summaryCountPlural.textContent = lineCount === 1 ? '' : 's';
        if (subtotalValue) subtotalValue.textContent = formatMoney(subtotal);
        if (voucherRow) voucherRow.style.display = voucherDiscount > 0 ? '' : 'none';
        if (voucherLabel && selectedVoucher) {
            voucherLabel.textContent = selectedVoucher.dataset.sourceType === 'gift_card'
                ? 'Gift card balance'
                : 'Promo voucher';
        }
        if (voucherValue) voucherValue.textContent = '-' + formatMoney(voucherDiscount);
        if (cashbackValue) cashbackValue.textContent = '-' + formatMoney(cashbackApplied);
        if (dueValue) dueValue.textContent = formatMoney(due);
        if (cashbackCopy) cashbackCopy.textContent = formatMoney(cashbackApplied);
        if (cashbackToggle) cashbackToggle.disabled = voucherDiscount > 0;
    }

    function syncSelectAll() {
        if (!selectAll || !checks.length) return;
        selectAll.checked = checks.every((check) => check.checked);
        selectAll.indeterminate = checks.some((check) => check.checked) && !selectAll.checked;
        updateSummary();
    }

    if (selectAll && checks.length) {
        selectAll.addEventListener('change', function () {
            checks.forEach((check) => {
                check.checked = selectAll.checked;
            });
            updateSummary();
        });
        checks.forEach((check) => check.addEventListener('change', syncSelectAll));
        syncSelectAll();
    }

    if (cashbackToggle) {
        cashbackToggle.addEventListener('change', updateSummary);
    }
    voucherInputs.forEach((input) => input.addEventListener('change', updateSummary));

    if (checkoutForm) {
        checkoutForm.addEventListener('submit', function (event) {
            const submitter = event.submitter || document.activeElement;
            const isDeleteSelected = Boolean(submitter && submitter.matches('[data-cart-clear-selected]'));

            if (getSelectedChecks().length === 0) {
                event.preventDefault();
                alert(isDeleteSelected ? 'Please select at least one item to clear.' : 'Please select at least one item to checkout.');
                return;
            }

            if (isDeleteSelected) {
                const selectedCount = getSelectedChecks().length;
                if (!confirm('Clear ' + selectedCount + ' selected item' + (selectedCount === 1 ? '' : 's') + ' from your cart?')) {
                    event.preventDefault();
                }
                return;
            }

            if (voucherInputs.length && !voucherInputs.some((input) => input.checked)) {
                event.preventDefault();
                alert('Please choose a voucher or select "Do not use a voucher".');
                return;
            }
        });
    }

    updateSummary();
});
</script>

<%- include('partials/footer') %>
