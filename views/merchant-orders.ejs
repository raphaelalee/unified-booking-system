<%- include('partials/header', { title }) %>

<%
    const sales = salesReport || {};
    const allOrders = Array.isArray(sales.allOrders) ? sales.allOrders : [];
    const isCompletedOrder = (order) => {
        const deliveryStatus = String(order.deliveryStatus || '').toLowerCase();
        const pickupStatus = String(order.pickupStatus || '').toLowerCase();
        return deliveryStatus === 'completed' || ['picked_up', 'collected'].includes(pickupStatus);
    };
    const orders = allOrders.filter((order) => !isCompletedOrder(order));
    const completedOrders = allOrders.filter(isCompletedOrder);
    const payoutSummary = sales.payoutSummary || {
        grossOrderSales: 0,
        totalCommissionDeducted: 0,
        totalNetPayout: 0
    };
    const deliveryStatusOptions = [
        { value: 'processing', label: 'Processing' },
        { value: 'packed', label: 'Packed' },
        { value: 'shipped', label: 'Shipped' },
        { value: 'out_for_delivery', label: 'Out for Delivery' },
        { value: 'delivered', label: 'Delivered' },
        { value: 'completed', label: 'Completed' },
        { value: 'cancelled', label: 'Cancelled' }
    ];
    const pickupStatusOptions = [
        { value: 'processing', label: 'Processing' },
        { value: 'packed', label: 'Packed' },
        { value: 'ready_for_pickup', label: 'Ready for Pickup' },
        { value: 'delivered_to_pickup_location', label: 'Delivered to Pickup Location' },
        { value: 'completed', label: 'Completed' },
        { value: 'cancelled', label: 'Cancelled' }
    ];
    const statusLabels = [...deliveryStatusOptions, ...pickupStatusOptions, { value: 'completed', label: 'Completed' }, { value: 'picked_up', label: 'Picked Up' }].reduce((labels, option) => {
        labels[option.value] = option.label;
        return labels;
    }, {});
    const formatCurrency = (value) => Number(value || 0).toFixed(2);
    const formatOrderDate = (value) => {
        if (!value) return 'Date unavailable';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return String(value).slice(0, 10);
        return date.toLocaleString('en-SG', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    };
    const compactOrderDate = (value) => {
        if (!value) return '-';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return String(value).slice(0, 10);
        return date.toLocaleDateString('en-SG', { day: '2-digit', month: 'short' });
    };
%>

<section class="section compact merchant-analytics-page merchant-orders-page">
    <% if (success) { %>
        <div class="notice success"><p><%= success %></p></div>
    <% } %>
    <% if (error) { %>
        <div class="notice error"><p><%= error %></p></div>
    <% } %>

    <div class="merchant-analytics-shell">
        <header class="merchant-dashboard-hero">
            <div>
                <p class="eyebrow">Product Orders</p>
                <h1>Orders</h1>
                <span>Update fulfilment and review payout at a glance.</span>
            </div>
            <div class="merchant-hero-actions">
                <a class="button secondary" href="/merchant/products">Inventory</a>
                <a class="button primary" href="/merchant/dashboard">Dashboard</a>
            </div>
        </header>

        <section class="merchant-payout-summary-grid" aria-label="Product order payout summary">
            <article class="merchant-payout-summary-card">
                <span>Orders</span>
                <strong><%= orders.length %></strong>
                <small>Assigned to you</small>
            </article>
            <article class="merchant-payout-summary-card">
                <span>Gross sales</span>
                <strong>$<%= formatCurrency(payoutSummary.grossOrderSales) %></strong>
                <small>Before commission</small>
            </article>
            <article class="merchant-payout-summary-card">
                <span>Net payout</span>
                <strong>$<%= formatCurrency(payoutSummary.totalNetPayout) %></strong>
                <small>Estimated</small>
            </article>
        </section>

        <section class="merchant-product-orders-panel merchant-orders-management-panel">
            <div class="merchant-card-heading">
                <div>
                    <p class="eyebrow">Queue</p>
                    <h2>Product orders</h2>
                </div>
                <span><%= orders.length %> total</span>
            </div>

            <% if (!orders.length) { %>
                <div class="merchant-empty-state">
                    <span>PO</span>
                    <strong>No paid product orders yet</strong>
                    <a class="text-button" href="/merchant/products">Review product catalogue</a>
                </div>
            <% } else { %>
                <div class="merchant-order-management-list">
                    <% orders.forEach((order) => {
                        const isPickupOrder = String(order.fulfilmentType || 'pickup').toLowerCase() === 'pickup';
                        const currentStatus = String(order.deliveryStatus || 'processing');
                        const statusOptions = isPickupOrder ? pickupStatusOptions : deliveryStatusOptions;
                        const pickupVerified = Boolean(order.pickupVerifiedAt || order.pickupQrUsed || String(order.pickupStatus || '').toLowerCase() === 'picked_up');
                        const orderReference = order.order_number || order.orderNumber || ('#' + order.id);
                        const itemCount = (order.items || []).reduce((total, item) => total + Number(item.quantity || 1), 0);
                    %>
                        <article class="merchant-order-management-card">
                            <div class="merchant-order-management-main">
                                <div class="merchant-order-identity">
                                    <span class="merchant-order-id"><%= orderReference %></span>
                                    <strong><%= order.customerName || 'Customer' %></strong>
                                    <small><%= compactOrderDate(order.createdAt) %> · <%= isPickupOrder ? 'Pickup' : 'Delivery' %> · <%= order.paymentMethod || 'Payment' %></small>
                                </div>
                                <div class="merchant-order-quick-meta">
                                    <span><%= itemCount %> item<%= itemCount === 1 ? '' : 's' %></span>
                                    <strong>$<%= formatCurrency(order.grossAmount || order.totalAmount) %></strong>
                                </div>
                                <span class="merchant-status-badge status-<%= currentStatus.replace(/\s+/g, '_') %>">
                                    <%= statusLabels[currentStatus] || currentStatus %>
                                </span>
                            </div>

                            <% if (isPickupOrder && pickupVerified) { %>
                                <p class="merchant-order-alert">Pickup verified<%= order.pickupVerifiedAt ? ` · ${formatOrderDate(order.pickupVerifiedAt)}` : '' %></p>
                            <% } %>

                            <div class="merchant-order-management-items">
                                <% (order.items || []).slice(0, 2).forEach((item) => { %>
                                    <p>
                                        <span><%= item.name %></span>
                                        <strong>x<%= item.quantity %></strong>
                                        <em>$<%= formatCurrency(item.lineTotal) %></em>
                                    </p>
                                <% }) %>
                                <% if ((order.items || []).length > 2) { %>
                                    <p class="merchant-order-more-items">
                                        <span>More items</span>
                                        <strong>+<%= (order.items || []).length - 2 %></strong>
                                        <em>view receipt</em>
                                    </p>
                                <% } %>
                            </div>

                            <div class="merchant-order-management-footer">
                                <div>
                                    <span>Gross</span>
                                    <strong>$<%= formatCurrency(order.grossAmount || order.totalAmount) %></strong>
                                </div>
                                <div>
                                    <span>Commission</span>
                                    <strong>$<%= formatCurrency(order.commissionAmount) %></strong>
                                </div>
                                <div>
                                    <span>Net payout</span>
                                    <strong>$<%= formatCurrency(order.payoutAmount || order.totalAmount) %></strong>
                                </div>
                                <form action="/merchant/orders/<%= order.id %>/status" method="POST" class="merchant-order-status-form">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <label>
                                        <span>Status</span>
                                        <select data-readable-select name="deliveryStatus" <%= pickupVerified ? 'disabled' : '' %>>
                                            <% statusOptions.forEach((option) => { %>
                                                <option value="<%= option.value %>" <%= option.value === currentStatus ? 'selected' : '' %>><%= option.label %></option>
                                            <% }) %>
                                        </select>
                                    </label>
                                    <button class="button primary" type="submit" <%= pickupVerified ? 'disabled' : '' %>>Update</button>
                                </form>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>

        <section class="merchant-product-orders-panel merchant-orders-management-panel">
            <div class="merchant-card-heading">
                <div>
                    <p class="eyebrow">History</p>
                    <h2>Completed product orders</h2>
                </div>
                <span><%= completedOrders.length %> completed</span>
            </div>

            <% if (!completedOrders.length) { %>
                <div class="merchant-empty-state">
                    <span>OK</span>
                    <strong>No completed product orders yet</strong>
                    <p class="muted">Orders will move here after you mark them as completed.</p>
                </div>
            <% } else { %>
                <div class="merchant-order-management-list">
                    <% completedOrders.forEach((order) => {
                        const isPickupOrder = String(order.fulfilmentType || 'pickup').toLowerCase() === 'pickup';
                        const currentStatus = String(order.deliveryStatus || 'completed');
                        const orderReference = order.order_number || order.orderNumber || ('#' + order.id);
                        const itemCount = (order.items || []).reduce((total, item) => total + Number(item.quantity || 1), 0);
                    %>
                        <article class="merchant-order-management-card">
                            <div class="merchant-order-management-main">
                                <div class="merchant-order-identity">
                                    <span class="merchant-order-id"><%= orderReference %></span>
                                    <strong><%= order.customerName || 'Customer' %></strong>
                                    <small><%= compactOrderDate(order.createdAt) %> Â· <%= isPickupOrder ? 'Pickup' : 'Delivery' %> Â· <%= order.paymentMethod || 'Payment' %></small>
                                </div>
                                <div class="merchant-order-quick-meta">
                                    <span><%= itemCount %> item<%= itemCount === 1 ? '' : 's' %></span>
                                    <strong>$<%= formatCurrency(order.grossAmount || order.totalAmount) %></strong>
                                </div>
                                <span class="merchant-status-badge status-completed">
                                    <%= statusLabels[currentStatus] || 'Completed' %>
                                </span>
                            </div>

                            <div class="merchant-order-management-items">
                                <% (order.items || []).slice(0, 2).forEach((item) => { %>
                                    <p>
                                        <span><%= item.name %></span>
                                        <strong>x<%= item.quantity %></strong>
                                        <em>$<%= formatCurrency(item.lineTotal) %></em>
                                    </p>
                                <% }) %>
                                <% if ((order.items || []).length > 2) { %>
                                    <p class="merchant-order-more-items">
                                        <span>More items</span>
                                        <strong>+<%= (order.items || []).length - 2 %></strong>
                                        <em>completed</em>
                                    </p>
                                <% } %>
                            </div>

                            <div class="merchant-order-management-footer">
                                <div>
                                    <span>Gross</span>
                                    <strong>$<%= formatCurrency(order.grossAmount || order.totalAmount) %></strong>
                                </div>
                                <div>
                                    <span>Commission</span>
                                    <strong>$<%= formatCurrency(order.commissionAmount) %></strong>
                                </div>
                                <div>
                                    <span>Net payout</span>
                                    <strong>$<%= formatCurrency(order.payoutAmount || order.totalAmount) %></strong>
                                </div>
                                <div class="merchant-order-completed-note">
                                    <span>Status</span>
                                    <strong>Completed</strong>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </div>
</section>

<%- include('partials/footer') %>

