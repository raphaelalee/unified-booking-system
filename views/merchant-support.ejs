<%- include('partials/header', { title }) %>

<%
    const supportSteps = [
        'Customer submits a refund request from Help Center.',
        'Vaniday admin reviews the case and forwards eligible requests.',
        'Merchant approves or declines with a clear reason.',
        'Admin issues the final refund decision and the customer is notified.'
    ];
%>

<section class="section compact merchant-analytics-page">
    <div class="merchant-analytics-shell">
        <header class="merchant-dashboard-hero">
            <div>
                <p class="eyebrow">Support</p>
                <h1>Merchant support center</h1>
                <span>Handle merchant-facing refund work and open the shared Help Center queue for <%= merchant.name %>.</span>
            </div>
            <div class="merchant-hero-actions">
                <a class="button primary" href="/help-center">Open refund requests</a>
            </div>
        </header>

        <section class="merchant-dashboard-lower-grid">
            <article class="merchant-alert-card">
                <div class="merchant-card-heading"><div><p class="eyebrow">Refund Workflow</p><h2>How requests move</h2></div></div>
                <div class="merchant-alert-list">
                    <% supportSteps.forEach((step) => { %>
                        <p><%= step %></p>
                    <% }) %>
                </div>
            </article>
            <article class="merchant-actions-card">
                <div class="merchant-card-heading"><div><p class="eyebrow">Support Tools</p><h2>Merchant queue</h2></div></div>
                <p class="muted">Refund requests themselves live in Help Center so every reply, note, and final decision stays in one auditable place.</p>
                <div class="merchant-quick-actions">
                    <a class="button secondary" href="/notifications">View notifications</a>
                </div>
            </article>
        </section>
    </div>
</section>

<%- include('partials/footer') %>
